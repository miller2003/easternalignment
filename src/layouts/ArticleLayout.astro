---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AuthorBio from '../components/AuthorBio.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar.astro';
import EndCTA from '../components/EndCTA.astro';

interface Props {
  title: string;
  description: string;
  category?: string;
  publishDate: string;
  updatedDate?: string;
  breadcrumbParent?: { label: string; href: string };
  // SEO meta fields
  metaRobots?: string;
  canonicalUrl?: string;
  ogImage?: string;
  seoTitle?: string;
  metaDescription?: string;
  // Article Schema (manual)
  schemaHeadline?: string;
  schemaDescription?: string;
  schemaAuthor?: string;
  schemaDatePublished?: string;
  // Custom / FAQPage schema
  customSchema?: string;
  entities?: string[];
}

const {
  title,
  description,
  category,
  publishDate,
  updatedDate,
  breadcrumbParent = { label: 'Guides', href: '/guides/' },
  metaRobots,
  canonicalUrl,
  ogImage,
  seoTitle,
  metaDescription,
  schemaHeadline,
  schemaDescription,
  schemaAuthor,
  schemaDatePublished,
  customSchema,
  entities,
} = Astro.props;

const displayDate = updatedDate || publishDate;
const formattedDate = new Date(displayDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const SITE_URL = 'https://easternalignment.com';
const canonical = canonicalUrl || new URL(Astro.url.pathname, SITE_URL).href;

// Build Article JSON-LD from manual fields (with fallbacks)
const articleSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": schemaHeadline || title,
  "description": schemaDescription || description,
  "author": {
    "@type": "Person",
    "name": schemaAuthor || "Sarah",
    "url": "https://easternalignment.com/about/",
  },
  "datePublished": schemaDatePublished || publishDate,
  ...(updatedDate ? { "dateModified": updatedDate } : {}),
  ...(ogImage ? { "image": ogImage } : {}),
  "publisher": {
    "@type": "Organization",
    "name": "Eastern Alignment",
    "url": "https://easternalignment.com",
    "logo": "https://easternalignment.com/logo.jpg",
  },
  ...(entities ? { "about": entities.map(e => ({ "@type": "Thing", "name": e })) } : {}),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonical
  }
};

const noindex = metaRobots ? metaRobots.includes('noindex') : false;
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  jsonLd={articleSchema}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  noindex={noindex}
  seoTitle={seoTitle}
  metaDescription={metaDescription}
  customSchema={customSchema}
>
  <!-- Full-page 3-column grid: sidebars span the entire page height -->
  <div class="page-with-sidebars">
    <!-- LEFT SIDEBAR -->
    <LeftSidebar />

    <!-- MAIN COLUMN: breadcrumb + hero + content -->
    <div class="main-col">
      <!-- Breadcrumb -->
      <div class="article-breadcrumb">
        <Breadcrumb items={[
          breadcrumbParent,
          { label: title }
        ]} />
      </div>

      <!-- Article Hero -->
      <header class="article-hero">
        <div class="article-hero-meta">
          {category && <span class="badge badge--sage">{category}</span>}
          <span class="article-date">
            {updatedDate ? 'Updated' : 'Published'} {formattedDate}
          </span>
        </div>

        <h1 class="article-title">{title}</h1>

        <p class="article-excerpt">{description}</p>

        <div class="article-author-line">
          <img src="/sarah-avatar.jpg" alt="Sarah" class="author-avatar-sm" width="32" height="32" loading="lazy" />
          <span class="author-name-sm">Sarah</span>
        </div>

        <a href="/reviews/" class="article-hero-cta btn btn--primary" data-cta-source="hero">
          See My Tested Platform Picks &rarr;
        </a>
      </header>

      <!-- Article Content -->
      <article class="article-content">
        <div class="prose">
          <slot />
        </div>

        <!-- End-of-article offer block: captures the highest-intent moment -->
        <EndCTA subheading="I’ve personally tested each platform with my own money. Pick the one that fits your question — every link is an independent recommendation." />

        <AuthorBio />
      </article>
    </div>

    <!-- RIGHT SIDEBAR -->
    <RightSidebar />
  </div>
</BaseLayout>

<style>
  /* ── Full-page 3-column layout ── */
  .page-with-sidebars {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 3.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-6) var(--space-12);
  }

  /* ── Centre column ── */
  .main-col {
    flex: 1;
    min-width: 0;
    max-width: var(--max-width-content);
    transition: max-width 0.3s ease;
  }

  .article-breadcrumb {
    margin-bottom: var(--space-4);
  }

  /* ── Hero ── */
  .article-hero {
    padding: var(--space-4) 0 var(--space-6);
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: var(--space-6);
  }

  .article-hero-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .article-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .article-title {
    margin-bottom: var(--space-4);
  }

  .article-excerpt {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
    max-width: 600px;
  }

  .article-author-line {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .article-hero-cta {
    display: inline-flex;
    align-items: center;
    margin-top: var(--space-5);
  }

  .author-avatar-sm {
    display: block;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 20%;
    border: 1.5px solid var(--color-border-light);
  }

  .author-name-sm {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }

  /* ── Content ── */
  .article-content {
    padding-bottom: var(--space-8);
  }

  .prose {
    max-width: 100%;
  }

  /* ── Responsive ── */
  @media (max-width: 1300px) {
    .page-with-sidebars {
      gap: 2rem;
    }
  }

  @media (max-width: 1100px) {
    .page-with-sidebars {
      justify-content: center;
      padding-top: var(--space-6);
    }
  }

  @media (max-width: 768px) {
    .page-with-sidebars {
      flex-direction: column;
      align-items: center;
      padding-left: var(--space-4);
      padding-right: var(--space-4);
      gap: var(--space-8);
    }

    .main-col {
      width: 100%;
      max-width: 100%;
    }

    .article-hero {
      padding-top: 0;
    }

    .article-title {
      font-size: var(--text-3xl);
    }

    .article-excerpt {
      font-size: var(--text-base);
    }
  }
</style>
