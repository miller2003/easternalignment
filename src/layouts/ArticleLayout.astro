---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AuthorBio from '../components/AuthorBio.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar.astro';
import EndCTA from '../components/EndCTA.astro';
import InlineCta from '../components/InlineCta.astro';
import { PLATFORM_OFFERS } from '../lib/offers';

interface Props {
  title: string;
  description: string;
  category?: string;
  publishDate: string;
  updatedDate?: string;
  breadcrumbParent?: { label: string; href: string };
  /** Optional cluster level between parent and title, e.g.
   *  Guides › Love & Relationship Readings › {title} (2026-08-28). */
  breadcrumbMiddle?: { label: string; href: string };
  // SEO meta fields
  metaRobots?: string;
  canonicalUrl?: string;
  ogImage?: string;
  seoTitle?: string;
  metaDescription?: string;
  // Article Schema (manual)
  schemaHeadline?: string;
  schemaDescription?: string;
  schemaAuthor?: string;
  schemaDatePublished?: string;
  // Custom / FAQPage schema
  customSchema?: string;
  entities?: string[];
  /** Editorial score for the page's single named platform — powers the SERP
   *  star snippet (Review + aggregateRating) and the hero score badge. The
   *  value MUST equal the same platform's score on its /reviews/ page. */
  rating?: number;
  // Contextual CTA overrides. Raw frontmatter values may be outside the
  // union (e.g. "cross-platform") — they are normalised to a PlatformKey below.
  platform?: string;
  affiliateUrl?: string;
  /**
   * Pure-content mode (2026-09-02): suppresses every affiliate CTA on the
   * page — top offer bar, left deal cards, hero button, inline CTA, end
   * block, right-rail deal card, and the edge tab. For trust/GEO articles
   * that must read as zero-commercial. TOC navigation and AuthorBio stay.
   */
  noCta?: boolean;
}

const {
  title,
  description,
  category,
  publishDate,
  updatedDate,
  breadcrumbParent = { label: 'Guides', href: '/guides/' },
  breadcrumbMiddle,
  metaRobots,
  canonicalUrl,
  ogImage,
  seoTitle,
  metaDescription,
  schemaHeadline,
  schemaDescription,
  schemaAuthor,
  schemaDatePublished,
  customSchema,
  entities,
  rating,
  noCta = false,
} = Astro.props;

const displayDate = updatedDate || publishDate;
const formattedDate = new Date(displayDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const SITE_URL = 'https://easternalignment.com';
const canonical = canonicalUrl || new URL(Astro.url.pathname, SITE_URL).href;

/* Only a handful of articles declare ogImage in frontmatter, but `image` is a
 * required property for Article rich results. Falling back to the site default
 * keeps the property present on every article instead of omitting it. */
const DEFAULT_OG_IMAGE = `${SITE_URL}/og-default.jpg`;

// Build Article JSON-LD from manual fields (with fallbacks).
// Top-tier: entity-linked author/publisher (@id), articleSection, and a
// SpeakableSpecification so voice assistants (Google Assistant, etc.) can read
// the headline + body aloud — an alive 2026 rich-result surface.
const articleSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${canonical}#article`,
  "headline": schemaHeadline || title,
  "description": schemaDescription || description,
  "author": {
    "@type": "Person",
    "@id": "https://easternalignment.com/#sarah",
    "name": schemaAuthor || "Sarah",
    "url": "https://easternalignment.com/about/",
    "jobTitle": "Reviewer & Researcher",
    "image": `${SITE_URL}/sarah-avatar.jpg`,
  },
  "publisher": { "@id": "https://easternalignment.com/#organization" },
  "datePublished": schemaDatePublished || publishDate,
  ...(updatedDate ? { "dateModified": updatedDate } : {}),
  "image": ogImage || DEFAULT_OG_IMAGE,
  ...(category ? { "articleSection": category } : {}),
  ...(entities ? { "about": entities.map(e => ({ "@type": "Thing", "name": e })) } : {}),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonical
  },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", ".article-content"]
  }
};

const noindex = metaRobots ? metaRobots.includes('noindex') : false;

/* ── BreadcrumbList ──────────────────────────────────────────────────────
 * The visible breadcrumb above the title renders this same trail, so the
 * markup mirrors it exactly. Lets Google draw the section path in the SERP
 * instead of a bare URL. */
const breadcrumbTrail = [
  breadcrumbParent.href
    ? { "@type": "ListItem", "position": 1, "name": breadcrumbParent.label, "item": new URL(breadcrumbParent.href, SITE_URL).href }
    : null,
  ...(breadcrumbMiddle?.href
    ? [{ "@type": "ListItem", "position": 2, "name": breadcrumbMiddle.label, "item": new URL(breadcrumbMiddle.href, SITE_URL).href }]
    : []),
  { "@type": "ListItem", "position": breadcrumbMiddle?.href ? 3 : 2, "name": title, "item": canonical },
].filter(Boolean) as Record<string, unknown>[];

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbTrail,
};


// ── Contextual Offer Resolution ──────────────────────────────────────────────
// Determine which platform this article primarily targets to route the hero CTA
// and sticky CTA directly to the affiliate link instead of the /reviews/ hub.
// Frontmatter may carry values outside the union (e.g. "cross-platform") —
// normalise anything unrecognised to 'kasamba' (the site-wide default No.1
// recommendation since the 2026-08-25 priority reset). Explicit 'keen' or
// 'purple-garden' frontmatter is always honoured.
const rawPlatform = Astro.props.platform as string | undefined;
const pagePlatform: 'keen' | 'kasamba' | 'purple-garden' =
  rawPlatform === 'keen' || rawPlatform === 'purple-garden' ? rawPlatform : 'kasamba';
const defaultGoLink = Astro.props.affiliateUrl || `/go/${pagePlatform}/`;

const articleStickyCta = {
  slug: defaultGoLink,
  platform: pagePlatform as 'keen' | 'kasamba' | 'purple-garden',
};

// Desktop right-rail sticky deal card follows the guide's target platform.
const guideOffer = PLATFORM_OFFERS[pagePlatform as keyof typeof PLATFORM_OFFERS];
const sidebarDeal = guideOffer
  ? { platform: pagePlatform as 'keen' | 'kasamba' | 'purple-garden', href: defaultGoLink }
  : undefined;

/* ── Review + aggregateRating (SERP star snippet) ────────────────────────
 * Only for guides that name exactly ONE platform and carry an editorial
 * score. Three hard rules keep it eligible:
 *   1. the hero badge renders the same number — markup matches visible text;
 *   2. the score equals the platform's own /reviews/ page (one entity, one
 *      score site-wide — a second value reads as a contradiction to Google);
 *   3. cross-platform roundups are excluded: there is no single item being
 *      rated, and faking one is a rich-result manual-action risk. */
const PLATFORM_LABELS: Record<string, string> = {
  kasamba: 'Kasamba',
  keen: 'Keen',
  'purple-garden': 'Purple Garden',
};
const isSinglePlatform =
  rawPlatform === 'kasamba' || rawPlatform === 'keen' || rawPlatform === 'purple-garden';
const platformLabel = isSinglePlatform ? PLATFORM_LABELS[rawPlatform] : undefined;

const reviewSchema = rating && platformLabel
  ? {
      "@type": "Review",
      "headline": schemaHeadline || title,
      "author": { "@id": "https://easternalignment.com/#sarah" },
      "publisher": { "@id": "https://easternalignment.com/#organization" },
      "itemReviewed": {
        "@type": "Product",
        "name": platformLabel,
        "url": `${SITE_URL}/reviews/${rawPlatform}/`,
        "image": `${SITE_URL}/logo.jpg`,
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": rating,
          "bestRating": 5,
          "worstRating": 1,
          "reviewCount": 1,
        },
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": rating,
        "bestRating": 5,
        "worstRating": 1,
      },
    }
  : null;

/* Article + BreadcrumbList (+ Review) ship as one @graph with shared @id
 * references instead of three disconnected blobs. */
const jsonLdOut = {
  "@context": "https://schema.org",
  "@graph": [articleSchema, breadcrumbSchema, ...(reviewSchema ? [reviewSchema] : [])],
};
---


<BaseLayout
  title={title}
  description={description}
  ogType="article"
  jsonLd={jsonLdOut}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  noindex={noindex}
  seoTitle={seoTitle}
  metaDescription={metaDescription}
  customSchema={customSchema}
  topOfferPlatform={noCta ? undefined : pagePlatform}
  stickyCta={noCta ? undefined : articleStickyCta}
  noCta={noCta}
>
  <!-- Full-page 3-column grid: sidebars span the entire page height -->
  <div class="page-with-sidebars">
    <!-- LEFT SIDEBAR -->
    {!noCta && <LeftSidebar platform={pagePlatform} />}

    <!-- MAIN COLUMN: breadcrumb + hero + content -->
    <div class="main-col">
      <!-- Breadcrumb -->
      <div class="article-breadcrumb">
        <Breadcrumb items={[
          breadcrumbParent,
          ...(breadcrumbMiddle ? [breadcrumbMiddle] : []),
          { label: title }
        ]} />
      </div>

      <!-- Article Hero -->
      <header class="article-hero">
        <div class="article-hero-meta">
          {category && <span class="badge badge--sage">{category}</span>}
          {rating && platformLabel && (
            <span class="article-rating" aria-label={`${platformLabel} editorial score ${rating} out of 5`}>
              <span class="article-rating__star" aria-hidden="true">★</span>
              {rating}/5 · {platformLabel} score
            </span>
          )}
          <span class="article-date">
            {updatedDate ? 'Updated' : 'Published'} {formattedDate}
          </span>
        </div>

        <h1 class="article-title">{title}</h1>

        <p class="article-excerpt">{description}</p>

        <div class="article-author-line">
          <img src="/sarah-avatar.jpg" alt="Sarah" class="author-avatar-sm" width="32" height="32" loading="lazy" />
          <span class="author-name-sm">Sarah</span>
        </div>

        {!noCta && (
          <div class="article-hero-cta-wrap">
            <a href={defaultGoLink} class="article-hero-cta btn btn--primary" rel="nofollow sponsored" target="_blank" data-cta-source="hero">
              {pagePlatform === 'kasamba' ? 'Get 3 Free Minutes on Kasamba →' :
               pagePlatform === 'purple-garden' ? 'Claim $30 Credit on Purple Garden →' :
               'Get 5 Minutes for $1 on Keen →'}
            </a>
            {guideOffer && <p class="article-hero-cta-note">{guideOffer.microLine}</p>}
          </div>
        )}
      </header>

      <!-- Article Content -->
      <article class="article-content">
        <div class="prose">
          <slot />
        </div>

        {/* Mid-article CTA: auto-injected before the 2nd H2 inside .prose */}
        {!noCta && <InlineCta platform={pagePlatform} href={defaultGoLink} />}

        <!-- End-of-article offer block: captures the highest-intent moment.
             primarySlug follows the page's platform context (defaulting to
             Kasamba, the site-wide No.1) so the featured card matches the
             article's theme while still showing all three platforms. -->
        {!noCta && (
          <EndCTA
            primarySlug={pagePlatform}
            subheading="I’ve personally tested each platform with my own money. Pick the one that fits your question — every link is an independent recommendation."
          />
        )}

        <AuthorBio />
      </article>
    </div>

    <!-- RIGHT SIDEBAR -->
    <RightSidebar deal={noCta ? undefined : sidebarDeal} />
  </div>
</BaseLayout>

<style>
  /* ── Full-page 3-column layout ── */
  .page-with-sidebars {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 3.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-6) var(--space-12);
  }

  /* ── Centre column ── */
  .main-col {
    flex: 1;
    min-width: 0;
    max-width: var(--max-width-content);
    transition: max-width 0.3s ease;
  }

  .article-breadcrumb {
    margin-bottom: var(--space-4);
  }

  /* ── Hero ── */
  .article-hero {
    padding: var(--space-4) 0 var(--space-6);
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: var(--space-6);
  }

  .article-hero-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .article-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Hero score badge — the visible twin of the Review/aggregateRating markup.
   * Same number, same page: that pairing is what keeps the star snippet
   * eligible. Fixed amber fallback because --color-warning is not guaranteed
   * in every theme bundle. */
  .article-rating {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium, 500);
    color: var(--color-warning, #b45309);
    white-space: nowrap;
  }

  .article-rating__star {
    font-size: 0.9375rem;
  }

  .article-title {
    margin-bottom: var(--space-4);
  }

  .article-excerpt {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
    max-width: 600px;
  }

  .article-author-line {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .article-hero-cta {
    display: inline-flex;
    align-items: center;
  }

  .article-hero-cta-wrap {
    margin-top: var(--space-5);
  }

  .article-hero-cta-note {
    margin: var(--space-2) 0 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .author-avatar-sm {
    display: block;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 20%;
    border: 1.5px solid var(--color-border-light);
  }

  .author-name-sm {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }

  /* ── Content ── */
  .article-content {
    padding-bottom: var(--space-8);
  }

  .prose {
    max-width: 100%;
  }

  /* ── Responsive ── */
  @media (max-width: 1300px) {
    .page-with-sidebars {
      gap: 2rem;
    }
  }

  @media (max-width: 1100px) {
    .page-with-sidebars {
      justify-content: center;
      padding-top: var(--space-6);
    }
  }

  @media (max-width: 768px) {
    .page-with-sidebars {
      flex-direction: column;
      align-items: center;
      padding-left: var(--space-4);
      padding-right: var(--space-4);
      gap: var(--space-8);
    }

    .main-col {
      width: 100%;
      max-width: 100%;
    }

    .article-hero {
      padding-top: 0;
    }

    .article-title {
      font-size: var(--text-3xl);
    }

    .article-excerpt {
      font-size: var(--text-base);
    }
  }
</style>
