---
/**
 * EsReviewLayout — Spanish reader review layout.
 * Full visual parity with ReviewLayout.astro.
 * All UI strings are in Spanish (controlled vocabulary).
 */
import EsBaseLayout from './EsBaseLayout.astro';
import EsBreadcrumb from '../components/es/EsBreadcrumb.astro';
import StarRating from '../components/StarRating.astro';
import EsSpanishCTA from '../components/es/EsSpanishCTA.astro';

import EsLeftSidebar from '../components/es/EsLeftSidebar.astro';

interface Props {
  title: string;
  description: string;
  platformName: string;  // e.g. "Psíquicos Web: María Luz"
  platform: 'psiquicos' | 'purple-garden-es';
  rating: number;
  verdict: string;
  freeOffer?: string;
  avatarUrl?: string;
  publishDate: string;
  updatedDate?: string;
  // SEO
  metaRobots?: string;
  canonicalUrl?: string;
  ogImage?: string;
  seoTitle?: string;
  metaDescription?: string;
  schemaDatePublished?: string;
  customSchema?: string;
  entities?: string[];
  hreflangEn?: string;
  /** Reader slug (md filename) for per-reader deep links in the hero CTA */
  readerSlug?: string;
}

const {
  title,
  description,
  platformName,
  platform,
  rating,
  verdict,
  freeOffer,
  avatarUrl,
  publishDate,
  updatedDate,
  metaRobots,
  canonicalUrl,
  ogImage,
  seoTitle,
  metaDescription,
  schemaDatePublished,
  customSchema,
  entities,
  hreflangEn,
  readerSlug,
} = Astro.props;

const SITE_URL = 'https://easternalignment.com';

// Detect reader-level review (e.g. "Psíquicos Web: María Luz")
const isReaderReview = platformName.includes(':');
const parentPlatformLabel = isReaderReview ? platformName.split(':')[0].trim() : null;
const readerLabel = isReaderReview ? platformName.split(':').pop()?.trim() : platformName;

// Platform path segment for breadcrumb links
const platformPath = platform === 'psiquicos' ? 'psiquicos-web' : 'purple-garden-es';

// Avatar fallback
const readerInitials = readerLabel
  ?.split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase())
  .join('') || 'L';

const avatarFallbackSvg = `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 96 96" role="img" aria-label="${readerInitials}"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#6EE7B7"/><stop offset="55%" stop-color="#60A5FA"/><stop offset="100%" stop-color="#A78BFA"/></linearGradient><filter id="s" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#000" flood-opacity=".18"/></filter></defs><circle cx="48" cy="48" r="44" fill="url(#g)" filter="url(#s)"/><circle cx="48" cy="48" r="43" fill="none" stroke="rgba(255,255,255,.35)"/><text x="48" y="54" text-anchor="middle" font-family="ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial" font-size="34" font-weight="700" fill="rgba(255,255,255,.95)">${readerInitials}</text></svg>`)}`;

// Breadcrumb
const breadcrumbItems = isReaderReview
  ? [
      { label: 'Reseñas', href: '/es/resenas/' },
      { label: parentPlatformLabel!, href: `/es/resenas/${platformPath}/` },
      { label: readerLabel! },
    ]
  : [
      { label: 'Reseñas', href: '/es/resenas/' },
      { label: platformName },
    ];

const canonical = canonicalUrl || new URL(Astro.url.pathname, SITE_URL).href;
const absoluteAvatarUrl = avatarUrl ? new URL(avatarUrl, SITE_URL).href : undefined;

// Date formatting — Spanish locale
const displayDate = updatedDate || publishDate;
const formattedDate = new Date(displayDate).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Spanish-localized Review Schema
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "Review",
  "headline": title,
  "description": description,
  "inLanguage": "es",
  "author": {
    "@type": "Organization",
    "name": "Eastern Alignment",
    "url": "https://easternalignment.com",
  },
  "datePublished": schemaDatePublished || publishDate,
  ...(updatedDate ? { "dateModified": updatedDate } : {}),
  ...(ogImage ? { "image": ogImage } : {}),
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": rating,
    "bestRating": 5,
    "worstRating": 1,
  },
  "itemReviewed": {
    "@type": "Product",
    "name": readerLabel || platformName,
    "image": absoluteAvatarUrl || ogImage || `${SITE_URL}/logo.jpg`,
    "description": description,
    ...(isReaderReview ? {
      "brand": {
        "@type": "Brand",
        "name": parentPlatformLabel || platformName
      }
    } : {})
  },
  "publisher": {
    "@type": "Organization",
    "name": "Eastern Alignment",
    "url": SITE_URL,
    "logo": `${SITE_URL}/logo.jpg`
  },
  ...(entities ? { "about": entities.map(e => ({ "@type": "Thing", "name": e })) } : {}),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonical
  }
};

const noindex = metaRobots ? metaRobots.includes('noindex') : false;

// Spanish CTA variant based on freeOffer
let ctaVariant: 'default' | 'discount' | 'book' | 'explore' = 'book';
if (freeOffer) {
  const lowOffer = freeOffer.toLowerCase();
  if (lowOffer.includes('descuento') || lowOffer.includes('primera') || lowOffer.includes('gratis')) {
    ctaVariant = 'discount';
  }
}
---

<EsBaseLayout
  title={title}
  description={description}
  ogType="article"
  jsonLd={reviewSchema}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  noindex={noindex}
  seoTitle={seoTitle}
  metaDescription={metaDescription}
  customSchema={customSchema}
  hreflangEn={hreflangEn}
  breadcrumbs={breadcrumbItems}
  dateModified={updatedDate || publishDate}
>
  <div class="page-with-sidebars">
    <!-- LEFT SIDEBAR -->
    <EsLeftSidebar />

    <!-- MAIN COLUMN -->
    <div class="main-col">
      <!-- Breadcrumb -->
      <div class="review-breadcrumb">
        <EsBreadcrumb items={breadcrumbItems} />
      </div>

      <!-- Review Hero -->
      <header class="review-hero">
        <div class="review-hero-meta">
          <span class="badge badge--sage">Reseña</span>
          <span class="review-date">
            {updatedDate ? 'Actualizado' : 'Publicado'} el {formattedDate}
          </span>
        </div>

        <div class="review-hero-header">
          <h1 class="review-title">{title}</h1>
        </div>

        <div class="review-identity">
          {isReaderReview && (
            <img
              class="reader-avatar-lg"
              src={avatarUrl || avatarFallbackSvg}
              alt={avatarUrl ? `${readerLabel} foto de perfil` : `Avatar de ${readerLabel}`}
              width="72"
              height="72"
              loading="eager"
              decoding="async"
            />
          )}
          <div class="review-identity-text">
            {isReaderReview && parentPlatformLabel && readerLabel && (
              <div class="reader-subline">
                <a href={`/es/resenas/${platformPath}/`} class="badge badge--outline badge--link">
                  {parentPlatformLabel}
                </a>
                <span class="reader-subline-text">Perfil de la lectora/el lector: {readerLabel}</span>
              </div>
            )}
            <div class="reader-rating-summary">
              <StarRating rating={rating} size="md" showValue={false} />
              <span class="rating-score">{rating}</span>
              <span class="rating-label">Calificación de Experto</span>
            </div>
          </div>
        </div>

        <p class="review-verdict">{verdict}</p>

        <div class="review-hero-cta">
          <EsSpanishCTA
            platform={platform}
            variant={ctaVariant}
            readerName={readerLabel}
            readerSlug={readerSlug}
            size="lg"
            source="hero"
          />
          {freeOffer && (
            <p class="review-hero-cta-note">
              Oferta para nuevos usuarios: <strong>{freeOffer}</strong> — aplicada en tu primera compra. Crea una cuenta, activa la oferta y conecta en minutos.
            </p>
          )}
        </div>
      </header>

      <!-- Review Content -->
      <article class="review-content">
        <div class="prose">
          <slot />
        </div>

        <!-- Author/Platform attribution block -->
        <div class="author-bio card">
          <div class="author-bio-inner">
            <img
              src="/logo.jpg"
              alt="Eastern Alignment"
              class="author-bio-avatar"
              width="48"
              height="48"
              loading="lazy"
            />
            <div class="author-bio-text">
              <span class="author-bio-name">Eastern Alignment</span>
              <p class="author-bio-desc">
                Plataforma independiente de análisis y reseñas de servicios de lectura psíquica. Nuestras evaluaciones se basan en datos verificados de usuarios reales, historial documentado de la plataforma y métricas públicas. Sin relaciones de patrocinio con las plataformas evaluadas.
              </p>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</EsBaseLayout>

<style>
  .page-with-sidebars {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 3.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-6) var(--space-12);
  }

  .main-col {
    flex: 1;
    min-width: 0;
    max-width: 760px;
    width: 100%;
  }

  .review-breadcrumb { margin-bottom: var(--space-4); }

  .review-hero {
    padding: var(--space-2) 0 var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: var(--space-5);
  }

  .review-hero-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .review-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .review-title {
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .review-identity {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .review-identity-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .reader-avatar-lg {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #fff;
    box-shadow:
      0 0 0 3px var(--color-accent, #c4956a),
      0 8px 22px rgba(120, 80, 40, 0.28);
    flex: 0 0 auto;
    transition: transform var(--transition-base, 0.2s ease);
  }
  .reader-avatar-lg:hover { transform: scale(1.04); }

  .reader-rating-summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: 2px;
  }

  .rating-score {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    line-height: 1;
  }

  .rating-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-primary-dark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-sage-100);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .reader-subline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .badge--link {
    text-decoration: none;
    transition: all var(--transition-fast);
    cursor: pointer;
  }
  .badge--link:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }

  .reader-subline-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .review-verdict {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
    max-width: 600px;
  }

  .review-hero-cta { margin-bottom: var(--space-4); }

  .review-hero-cta-note {
    margin: var(--space-2) 0 0;
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    max-width: 480px;
  }

  .review-content { padding-bottom: var(--space-8); }
  .prose { max-width: 100%; }

  /* Author Bio block */
  .author-bio {
    margin-top: var(--space-8);
    padding: var(--space-5);
  }
  .author-bio-inner {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .author-bio-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: contain;
    flex-shrink: 0;
    mix-blend-mode: multiply;
  }
  .author-bio-name {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }
  .author-bio-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .page-with-sidebars {
      flex-direction: column;
      align-items: center;
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }
    .main-col { width: 100%; max-width: 100%; }
    .review-hero { padding-top: 0; }
    .review-identity {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-4);
    }
    .reader-rating-summary { justify-content: center; }
    .reader-subline { justify-content: center; }
    .reader-avatar-lg { width: 72px; height: 72px; }
    .review-title { font-size: var(--text-2xl); }
    .review-verdict { font-size: var(--text-base); }
    .review-hero-cta .es-cta { width: 100%; text-align: center; }
    .review-hero-cta-note { text-align: center; margin-left: auto; margin-right: auto; }
    .author-bio-inner { flex-direction: column; }
  }
</style>
