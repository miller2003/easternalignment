---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AuthorBio from '../components/AuthorBio.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar.astro';
import EndCTA from '../components/EndCTA.astro';
import InlineCta from '../components/InlineCta.astro';
import { PLATFORM_OFFERS } from '../lib/offers';
import { platformFromName } from '../lib/platform';

interface Props {
  title: string;
  description: string;
  platforms: string[];
  winner?: string;
  publishDate: string;
  updatedDate?: string;
  seoTitle?: string;
  metaDescription?: string;
  canonicalUrl?: string;
  customSchema?: string;
  /** Absolute or root-relative social/hero image for this page. */
  ogImage?: string;
}

const {
  title,
  description,
  platforms,
  winner,
  publishDate,
  updatedDate,
  seoTitle,
  metaDescription,
  canonicalUrl,
  customSchema,
  ogImage,
} = Astro.props;

const SITE_URL = 'https://easternalignment.com';
const articleImage = ogImage
  ? new URL(ogImage, SITE_URL).href
  : `${SITE_URL}/og-default.jpg`;

const displayDate = updatedDate || publishDate;

// Map the comparison "winner" string to a platform slug so the end CTA
// promotes the page's actual pick. Falls back to Kasamba (the site-wide
// default No.1 since the 2026-08-25 priority reset) when no winner is set.
const winnerSlug: 'keen' | 'kasamba' | 'purple-garden' =
  winner?.toLowerCase().includes('kasamba') ? 'kasamba'
  : winner?.toLowerCase().includes('purple') ? 'purple-garden'
  : 'kasamba';
const formattedDate = new Date(displayDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// ── Focused sticky-CTA: the comparison winner drives the bottom bar ──────────
const comparisonStickCopy: Record<'keen' | 'kasamba' | 'purple-garden', { label: string; prompt: string }> = {
  keen:            { label: 'Try Keen · 5 min for $1 →',         prompt: '5 min for $1' },
  kasamba:         { label: 'Try Kasamba · 3 free + 50% off →',  prompt: '3 free + 50% off' },
  'purple-garden': { label: 'Try Purple Garden · $30 credit →',  prompt: '$30 free credit' },
};
const stickyCta = {
  slug: `/go/${winnerSlug}/`,
  platform: winnerSlug,
  label: comparisonStickCopy[winnerSlug].label,
  prompt: comparisonStickCopy[winnerSlug].prompt,
};

// Winner's offer data drives the hero button + right-rail deal card.
const winnerOffer = PLATFORM_OFFERS[winnerSlug];
const sidebarDeal = {
  platform: winnerSlug,
  label: 'Comparison winner',
  heading: `${winnerOffer.name} · ${winnerOffer.offer}`,
};

const articleSchema = {
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": {
    "@type": "Person",
    "name": "Sarah",
  },
  "publisher": { "@id": `${SITE_URL}/#organization` },
  "datePublished": publishDate,
  ...(updatedDate ? { "dateModified": updatedDate } : {}),
  // Google's Article rich result requires `image`; without it every comparison
  // page reported "missing field" and lost eligibility. og-default.jpg is the
  // same asset BaseLayout falls back to for og:image, so the two never diverge.
  "image": articleImage,
};

// ── Editorial scores are UI-only (ScorePanels) ─────────────────────────────
// They are deliberately NOT emitted as schema.org aggregateRating. An expert
// editorial score is not a user-review aggregate; labelling it as one violates
// Review-snippet policy (self-serving reviews) and risks spam classification.
// SERP rating markup stays limited to Review.reviewRating on single-entity
// pages. The comparison schema below carries ItemList + entity links only.
const comparisonItemList = {
  "@type": "ItemList",
  "name": title,
  "numberOfItems": platforms.length,
  "itemListElement": platforms.map((p, i) => {
    const key = platformFromName(p);
    return {
      "@type": "ListItem",
      "position": i + 1,
      // ── @type: WebPage, not Product ──────────────────────────────────────
      // These entries point at OUR review page for the platform, so the item
      // really is a page. It used to be `Product`, but a Product node with no
      // `offers` / `aggregateRating` / `review` is invalid for Google's Product
      // rich result — it produced a "missing field" warning on every comparison
      // page while returning nothing. We deliberately do NOT add offers or
      // ratings here: the editorial score is an expert opinion, and dressing it
      // up as a user-review aggregate is the exact thing the comment above warns
      // about. WebPage carries no required fields, so the ItemList stays valid.
      "item": {
        "@type": "WebPage",
        "name": p,
        ...(key ? { "url": `${SITE_URL}/reviews/${key}/` } : {}),
      },
    };
  }),
};

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [articleSchema, comparisonItemList],
};
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  jsonLd={schemaGraph}
  seoTitle={seoTitle}
  metaDescription={metaDescription}
  canonicalUrl={canonicalUrl}
  customSchema={customSchema}
  topOfferPlatform={winnerSlug}
  stickyCta={stickyCta}
>
  <!-- Full-page 3-column grid: sidebars span the entire page height -->
  <div class="page-with-sidebars">
    <!-- LEFT SIDEBAR -->
    <LeftSidebar platform={winnerSlug} />

    <!-- MAIN COLUMN: breadcrumb + hero + content -->
    <div class="main-col">
      <!-- Breadcrumb -->
      <div class="comparison-breadcrumb">
        <Breadcrumb items={[
          { label: 'Comparisons', href: '/comparisons/' },
          { label: platforms.join(' vs ') }
        ]} />
      </div>

      <!-- Comparison Hero -->
      <header class="comparison-hero">
        <div class="comparison-hero-meta">
          <span class="badge badge--primary">Comparison</span>
          <span class="comparison-date">
            {updatedDate ? 'Updated' : 'Published'} {formattedDate}
          </span>
        </div>

        <h1 class="comparison-title">{title}</h1>

        {winner && (
          <div class="comparison-winner">
            <span class="winner-label">My Pick:</span>
            <span class="winner-name">{winner}</span>
          </div>
        )}

        <div class="comparison-hero-cta-wrap">
          <a href={`/go/${winnerOffer.goSlug}/`} class="comparison-hero-cta btn btn--primary" rel="nofollow sponsored" target="_blank" data-cta-source="hero">
            {winnerOffer.ctaLabel}
          </a>
          <p class="comparison-hero-cta-note">{winnerOffer.microLine}</p>
        </div>

        <AffiliateDisclosure variant="inline" />
      </header>

      <!-- Comparison Content -->
      <article class="comparison-content">
        <div class="prose">
          <slot />
        </div>

        {/* Mid-article CTA promoting the comparison winner */}
        <InlineCta
          platform={winnerSlug}
          hook={`Still torn? Here's the shortcut — my pick is ${winnerOffer.name}, and new clients get ${winnerOffer.offer}.`}
        />

        <!-- End-of-article offer block: promotes the page's winning pick -->
        <EndCTA
          primarySlug={winnerSlug}
          heading={`My pick: ${winner || 'Kasamba'}`}
          subheading="I’ve personally tested each platform with my own money. Start with my recommendation, or compare the others — every link is an independent pick."
        />

        <AuthorBio />
      </article>
    </div>

    <!-- RIGHT SIDEBAR -->
    <RightSidebar deal={sidebarDeal} />
  </div>
</BaseLayout>

<style>
  /* ── Full-page 3-column layout ── */
  .page-with-sidebars {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 3.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-6) var(--space-12);
  }

  /* ── Centre column ── */
  .main-col {
    flex: 1;
    min-width: 0;
    max-width: var(--max-width-content);
    transition: max-width 0.3s ease;
  }

  .comparison-breadcrumb {
    margin-bottom: var(--space-4);
  }

  /* ── Hero ── */
  .comparison-hero {
    padding: var(--space-4) 0 var(--space-6);
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: var(--space-6);
  }

  .comparison-hero-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .comparison-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .comparison-title {
    margin-bottom: var(--space-6);
  }

  .comparison-winner {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background: var(--color-success-bg);
    border: 1px solid rgba(107, 143, 94, 0.2);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }

  .comparison-hero-cta {
    display: inline-flex;
    align-items: center;
  }

  .comparison-hero-cta-wrap {
    margin-bottom: var(--space-6);
  }

  .comparison-hero-cta-note {
    margin: var(--space-2) 0 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .winner-label {
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }

  .winner-name {
    font-weight: var(--weight-bold);
    color: var(--color-sage);
  }

  /* ── Content ── */
  .comparison-content {
    padding-bottom: var(--space-8);
  }

  .prose {
    max-width: 100%;
  }

  /* ── Responsive ── */
  @media (max-width: 1300px) {
    .page-with-sidebars {
      gap: 2rem;
    }
  }

  @media (max-width: 1100px) {
    .page-with-sidebars {
      justify-content: center;
      padding-top: var(--space-6);
    }
  }

  @media (max-width: 768px) {
    .page-with-sidebars {
      flex-direction: column;
      align-items: center;
      padding-left: var(--space-4);
      padding-right: var(--space-4);
      gap: var(--space-8);
    }

    .main-col {
      width: 100%;
      max-width: 100%;
    }

    .comparison-hero {
      padding-top: 0;
    }

    .comparison-title {
      font-size: var(--text-2xl);
    }

    .comparison-winner {
      width: 100%;
      justify-content: center;
    }
  }
</style>
