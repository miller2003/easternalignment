---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AuthorBio from '../components/AuthorBio.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar.astro';

interface Props {
  title: string;
  description: string;
  platforms: string[];
  winner?: string;
  publishDate: string;
  updatedDate?: string;
}

const {
  title,
  description,
  platforms,
  winner,
  publishDate,
  updatedDate,
} = Astro.props;

const displayDate = updatedDate || publishDate;
const formattedDate = new Date(displayDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": {
    "@type": "Person",
    "name": "Sarah",
  },
  "datePublished": publishDate,
  ...(updatedDate ? { "dateModified": updatedDate } : {}),
};
---

<BaseLayout title={title} description={description} ogType="article" jsonLd={articleSchema}>
  <!-- Full-page 3-column grid: sidebars span the entire page height -->
  <div class="page-with-sidebars">
    <!-- LEFT SIDEBAR -->
    <LeftSidebar />

    <!-- MAIN COLUMN: breadcrumb + hero + content -->
    <div class="main-col">
      <!-- Breadcrumb -->
      <div class="comparison-breadcrumb">
        <Breadcrumb items={[
          { label: 'Comparisons', href: '/comparisons/' },
          { label: platforms.join(' vs ') }
        ]} />
      </div>

      <!-- Comparison Hero -->
      <header class="comparison-hero">
        <div class="comparison-hero-meta">
          <span class="badge badge--primary">Comparison</span>
          <span class="comparison-date">
            {updatedDate ? 'Updated' : 'Published'} {formattedDate}
          </span>
        </div>

        <h1 class="comparison-title">{title}</h1>

        {winner && (
          <div class="comparison-winner">
            <span class="winner-label">My Pick:</span>
            <span class="winner-name">{winner}</span>
          </div>
        )}

        <AffiliateDisclosure variant="inline" />
      </header>

      <!-- Comparison Content -->
      <article class="comparison-content">
        <div class="prose">
          <slot />
        </div>
        <AuthorBio />
      </article>
    </div>

    <!-- RIGHT SIDEBAR -->
    <RightSidebar />
  </div>
</BaseLayout>

<style>
  /* ── Full-page 3-column layout ── */
  .page-with-sidebars {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 3.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-6) var(--space-12);
  }

  /* ── Centre column ── */
  .main-col {
    flex: 1;
    min-width: 0;
    max-width: var(--max-width-content);
    transition: max-width 0.3s ease;
  }

  .comparison-breadcrumb {
    margin-bottom: var(--space-4);
  }

  /* ── Hero ── */
  .comparison-hero {
    padding: var(--space-4) 0 var(--space-6);
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: var(--space-6);
  }

  .comparison-hero-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .comparison-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .comparison-title {
    margin-bottom: var(--space-6);
  }

  .comparison-winner {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background: var(--color-success-bg);
    border: 1px solid rgba(107, 143, 94, 0.2);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }

  .winner-label {
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }

  .winner-name {
    font-weight: var(--weight-bold);
    color: var(--color-sage);
  }

  /* ── Content ── */
  .comparison-content {
    padding-bottom: var(--space-8);
  }

  .prose {
    max-width: 100%;
  }

  /* ── Responsive ── */
  @media (max-width: 1300px) {
    .page-with-sidebars {
      gap: 2rem;
    }
  }

  @media (max-width: 1100px) {
    .page-with-sidebars {
      justify-content: center;
      padding-top: var(--space-6);
    }
  }

  @media (max-width: 768px) {
    .page-with-sidebars {
      flex-direction: column;
      align-items: center;
      padding-left: var(--space-4);
      padding-right: var(--space-4);
      gap: var(--space-8);
    }

    .main-col {
      width: 100%;
      max-width: 100%;
    }

    .comparison-hero {
      padding-top: 0;
    }

    .comparison-title {
      font-size: var(--text-2xl);
    }

    .comparison-winner {
      width: 100%;
      justify-content: center;
    }
  }
</style>
