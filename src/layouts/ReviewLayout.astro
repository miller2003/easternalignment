---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import StarRating from '../components/StarRating.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AuthorBio from '../components/AuthorBio.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar.astro';

interface Props {
  title: string;
  description: string;
  platformName: string;
  rating: number;
  verdict: string;
  affiliateUrl?: string;
  freeOffer?: string;
  avatarUrl?: string;
  publishDate: string;
  updatedDate?: string;
  // SEO meta fields
  metaRobots?: string;
  canonicalUrl?: string;
  ogImage?: string;
  seoTitle?: string;
  metaDescription?: string;
  schemaAuthor?: string;
  schemaDatePublished?: string;
  customSchema?: string;
  entities?: string[];
}

const {
  title,
  description,
  platformName,
  rating,
  verdict,
  affiliateUrl = '#',
  freeOffer,
  avatarUrl,
  publishDate,
  updatedDate,
  metaRobots,
  canonicalUrl,
  ogImage,
  seoTitle,
  metaDescription,
  schemaAuthor,
  schemaDatePublished,
  customSchema,
  entities,
} = Astro.props;

const displayDate = updatedDate || publishDate;
const formattedDate = new Date(displayDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Detect whether this is a reader-level review (e.g., "Keen: arradaza")
const isReaderReview = platformName.includes(':');
const parentPlatform = isReaderReview ? platformName.split(':')[0].trim().toLowerCase() : null;
const parentPlatformLabel = isReaderReview ? platformName.split(':')[0].trim() : null;
const readerLabel = isReaderReview ? platformName.split(':').pop()?.trim() : platformName;

// Build breadcrumb items dynamically
const breadcrumbItems = isReaderReview
  ? [
      { label: 'Reviews', href: '/reviews/' },
      { label: parentPlatformLabel!, href: `/reviews/${parentPlatform}/` },
      { label: readerLabel! },
    ]
  : [
      { label: 'Reviews', href: '/reviews/' },
      { label: platformName },
    ];

const SITE_URL = 'https://easternalignment.com';
const canonical = canonicalUrl || new URL(Astro.url.pathname, SITE_URL).href;
const absoluteAvatarUrl = avatarUrl ? new URL(avatarUrl, SITE_URL).href : undefined;

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "Review",
  "headline": title,
  "description": description,
  "author": {
    "@type": "Person",
    "name": schemaAuthor || "Sarah",
    "url": "https://easternalignment.com/about/",
  },
  "datePublished": schemaDatePublished || publishDate,
  ...(updatedDate ? { "dateModified": updatedDate } : {}),
  ...(ogImage ? { "image": ogImage } : {}),
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": rating,
    "bestRating": 5,
    "worstRating": 1,
  },
  "itemReviewed": {
    "@type": "Product",
    "name": readerLabel || platformName,
    "url": affiliateUrl !== '#' ? affiliateUrl : undefined,
    "image": absoluteAvatarUrl || ogImage || "https://easternalignment.com/logo.jpg",
    "description": description,
    ...(isReaderReview ? {
      "brand": {
        "@type": "Brand",
        "name": parentPlatformLabel || "Keen"
      }
    } : {})
  },
  "publisher": {
    "@type": "Organization",
    "name": "Eastern Alignment",
    "url": "https://easternalignment.com",
    "logo": "https://easternalignment.com/logo.jpg"
  },
  ...(entities ? { "about": entities.map(e => ({ "@type": "Thing", "name": e })) } : {}),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonical
  }
};

const noindex = metaRobots ? metaRobots.includes('noindex') : false;

// Generate compact CTA based on offer
let ctaText = isReaderReview && readerLabel ? `Book ${readerLabel} →` : `Visit ${platformName} →`;
if (freeOffer) {
  const lowOffer = freeOffer.toLowerCase();
  if (lowOffer.includes('3 free minutes')) ctaText = 'Get 3 Mins Free';
  else if (lowOffer.includes('5 minutes for $1')) ctaText = 'Get 5 Mins for $1';
  else if (lowOffer.includes('3 minutes absolutely free')) ctaText = 'Get 3 Mins Free';
  else ctaText = 'Start Free Trial';
}
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  jsonLd={reviewSchema}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  noindex={noindex}
  seoTitle={seoTitle}
  metaDescription={metaDescription}
  customSchema={customSchema}
>
  <!-- Full-page 3-column grid: sidebars span the entire page height -->
  <div class="page-with-sidebars">
    <!-- LEFT SIDEBAR -->
    <LeftSidebar />

    <!-- MAIN COLUMN: breadcrumb + hero + content -->
    <div class="main-col">
      <!-- Breadcrumb -->
      <div class="review-breadcrumb">
        <Breadcrumb items={breadcrumbItems} />
      </div>

      <!-- Review Hero -->
      <header class="review-hero">
        <div class="review-hero-meta">
          <span class="badge badge--sage">Review</span>
          <span class="review-date">
            {updatedDate ? 'Updated' : 'Published'} {formattedDate}
          </span>
        </div>

        <div class="review-hero-header">
          <h1 class="review-title">{title}</h1>
        </div>

        <div class="review-identity">
          {isReaderReview && avatarUrl && (
            <img
              class="reader-avatar-lg"
              src={avatarUrl}
              alt={`${readerLabel} profile photo`}
              width="72"
              height="72"
              loading="eager"
              decoding="async"
            />
          )}
          <div class="review-identity-text">
            {isReaderReview && parentPlatform && parentPlatformLabel && readerLabel && (
              <div class="reader-subline">
                <a href={`/reviews/${parentPlatform}/`} class="badge badge--outline badge--link">
                  {parentPlatformLabel}
                </a>
                <span class="reader-subline-text">Reader profile: {readerLabel}</span>
              </div>
            )}
            <div class="reader-rating-summary">
              <StarRating rating={rating} size="md" showValue={false} />
              <span class="rating-score">{rating}</span>
              <span class="rating-label">Expert Rating</span>
            </div>
          </div>
        </div>

        <p class="review-verdict">{verdict}</p>

        <div class="review-hero-cta">
          <a href={affiliateUrl} class="btn btn--primary btn--lg" rel="nofollow sponsored" target="_blank">
            {ctaText}
          </a>
        </div>
      </header>

      <!-- Review Content -->
      <article class="review-content">
        <div class="prose">
          <slot />
        </div>
        <AuthorBio />
      </article>
    </div>

    <!-- RIGHT SIDEBAR -->
    <RightSidebar />
  </div>
</BaseLayout>

<style>
  /* ── Full-page 3-column layout ── */
  .page-with-sidebars {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 3.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-6) var(--space-12);
  }

  /* ── Centre column ── */
  .main-col {
    flex: 1;
    min-width: 0;
    max-width: var(--max-width-content);
    transition: max-width 0.3s ease;
  }

  .review-breadcrumb {
    margin-bottom: var(--space-4);
  }

  /* ── Hero ── */
  .review-hero {
    padding: var(--space-2) 0 var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: var(--space-5);
  }

  .review-hero-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .review-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .review-title {
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .review-identity {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .review-identity-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .reader-avatar-lg {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--color-bg-alt);
    box-shadow: var(--shadow-sm);
    flex: 0 0 auto;
  }

  .reader-rating-summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: 2px;
  }

  .rating-score {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    line-height: 1;
  }

  .rating-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-primary-dark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-sage-100);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .reader-subline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .badge--link {
    text-decoration: none;
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .badge--link:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }

  .reader-subline-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .review-hero-rating {
    margin-bottom: var(--space-4);
  }

  .review-verdict {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
    max-width: 600px;
  }

  .review-offer {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--color-warning-bg);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-primary-dark);
    margin-bottom: var(--space-4);
  }

  .review-hero-cta {
    margin-bottom: var(--space-4);
  }

  /* ── Content ── */
  .review-content {
    padding-bottom: var(--space-8);
  }

  .prose {
    max-width: 100%;
  }

  /* ── Responsive ── */
  @media (max-width: 1300px) {
    .page-with-sidebars {
      gap: 2rem;
    }
  }

  @media (max-width: 1100px) {
    .page-with-sidebars {
      justify-content: center;
      padding-top: var(--space-6);
    }
  }

  @media (max-width: 768px) {
    .page-with-sidebars {
      flex-direction: column;
      align-items: center;
      padding-left: var(--space-4);
      padding-right: var(--space-4);
      gap: var(--space-8);
    }

    .main-col {
      width: 100%;
      max-width: 100%;
    }

    .review-hero {
      padding-top: 0;
    }

    .review-identity {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-4);
    }

    .reader-rating-summary {
      justify-content: center;
    }

    .reader-subline {
      justify-content: center;
    }

    .reader-avatar-lg {
      width: 72px;
      height: 72px;
    }

    .review-title {
      font-size: var(--text-2xl);
    }

    .review-verdict {
      font-size: var(--text-base);
    }

    .review-hero-cta .btn {
      width: 100%;
    }
  }
</style>
