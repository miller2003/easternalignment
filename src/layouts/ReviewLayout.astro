---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import StarRating from '../components/StarRating.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AuthorBio from '../components/AuthorBio.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar.astro';
import DealStrip from '../components/DealStrip.astro';
import InlineCta from '../components/InlineCta.astro';
import CtaTip from '../components/CtaTip.astro';
import { platformFromName } from '../lib/platform';
import { PLATFORM_OFFERS, proofTooltip } from '../lib/offers';

interface Props {
  title: string;
  description: string;
  platformName: string;
  rating: number;
  verdict: string;
  /**
   * Number of individual assessments behind the editorial rating, rendered as
   * aggregateRating.reviewCount in the JSON-LD. Platform hubs pass their
   * reader-review count (49/35/30 — the real number of published reader
   * reviews). Individual reader pages omit it and default to 1 (a single
   * expert review — factually accurate, never fabricated).
   */
  reviewCount?: number;
  affiliateUrl?: string;
  freeOffer?: string;
  ctaOverride?: string;
  avatarUrl?: string;
  hideSidebarDeal?: boolean;
  publishDate: string;
  updatedDate?: string;
  // SEO meta fields
  metaRobots?: string;
  canonicalUrl?: string;
  ogImage?: string;
  seoTitle?: string;
  metaDescription?: string;
  schemaAuthor?: string;
  schemaDatePublished?: string;
  customSchema?: string;
  entities?: string[];
  hreflangEs?: string;
}

const {
  title,
  description,
  platformName,
  rating,
  verdict,
  reviewCount,
  affiliateUrl = '#',
  freeOffer,
  ctaOverride,
  avatarUrl,
  hideSidebarDeal,
  publishDate,
  updatedDate,
  metaRobots,
  canonicalUrl,
  ogImage,
  seoTitle,
  metaDescription,
  schemaAuthor,
  schemaDatePublished,
  customSchema,
  entities,
  hreflangEs,
} = Astro.props;

const displayDate = updatedDate || publishDate;
const formattedDate = new Date(displayDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Detect whether this is a reader-level review (e.g., "Keen: arradaza")
const isReaderReview = platformName.includes(':');
// NOTE: must be slugified — "Purple Garden" contains a space, and without the
// `.replace()` below the breadcrumb/badge hrefs render as `/reviews/purple garden/`,
// a dead link on every Purple Garden reader page (46 pages). Verified 2026-08-30.
const parentPlatform = isReaderReview
  ? platformName.split(':')[0].trim().toLowerCase().replace(/\s+/g, '-')
  : null;
const parentPlatformLabel = isReaderReview ? platformName.split(':')[0].trim() : null;
const readerLabel = isReaderReview ? platformName.split(':').pop()?.trim() : platformName;

// Generate initials fallback for reader avatar
const readerInitials = readerLabel
  ?.split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase())
  .join('') || 'R';

const avatarFallbackSvg = `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 96 96" role="img" aria-label="${readerInitials}"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#6EE7B7"/><stop offset="55%" stop-color="#60A5FA"/><stop offset="100%" stop-color="#A78BFA"/></linearGradient><filter id="s" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#000" flood-opacity=".18"/></filter></defs><circle cx="48" cy="48" r="44" fill="url(#g)" filter="url(#s)"/><circle cx="48" cy="48" r="43" fill="none" stroke="rgba(255,255,255,.35)"/><text x="48" y="54" text-anchor="middle" font-family="ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial" font-size="34" font-weight="700" fill="rgba(255,255,255,.95)">${readerInitials}</text></svg>`)}`;

// Build breadcrumb items dynamically
const breadcrumbItems = isReaderReview
  ? [
      { label: 'Reviews', href: '/reviews/' },
      { label: parentPlatformLabel!, href: `/reviews/${parentPlatform}/` },
      { label: readerLabel! },
    ]
  : [
      { label: 'Reviews', href: '/reviews/' },
      { label: platformName },
    ];

const SITE_URL = 'https://easternalignment.com';
const canonical = canonicalUrl || new URL(Astro.url.pathname, SITE_URL).href;
const absoluteAvatarUrl = avatarUrl ? new URL(avatarUrl, SITE_URL).href : undefined;

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "Review",
  "headline": title,
  "description": description,
  "author": {
    "@type": "Person",
    "name": schemaAuthor || "Sarah",
    "url": "https://easternalignment.com/about/",
  },
  "datePublished": schemaDatePublished || publishDate,
  ...(updatedDate ? { "dateModified": updatedDate } : {}),
  ...(ogImage ? { "image": ogImage } : {}),
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": rating,
    "bestRating": 5,
    "worstRating": 1,
  },
  "itemReviewed": {
    "@type": "Product",
    "name": readerLabel || platformName,
    "url": affiliateUrl !== '#' ? new URL(affiliateUrl, SITE_URL).href : undefined,
    "image": absoluteAvatarUrl || ogImage || "https://easternalignment.com/logo.jpg",
    "description": description,
    // aggregateRating is what Google reads for SERP star snippets. reviewCount
    // is the real number of published assessments (hubs: reader-review count;
    // reader pages: 1 single expert review) — never a fabricated volume.
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": rating,
      "bestRating": 5,
      "worstRating": 1,
      "reviewCount": reviewCount ?? 1,
    },
    ...(isReaderReview ? {
      "brand": {
        "@type": "Brand",
        "name": parentPlatformLabel || "Keen"
      }
    } : {})
  },
  "publisher": {
    "@type": "Organization",
    "name": "Eastern Alignment",
    "url": "https://easternalignment.com",
    "logo": "https://easternalignment.com/logo.jpg"
  },
  ...(entities ? { "about": entities.map(e => ({ "@type": "Thing", "name": e })) } : {}),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonical
  }
};

const noindex = metaRobots ? metaRobots.includes('noindex') : false;

// Generate compact CTA based on offer
let ctaText = isReaderReview && readerLabel ? `Book ${readerLabel} →` : `Visit ${platformName} →`;
if (freeOffer) {
  const lowOffer = freeOffer.toLowerCase();
  if (lowOffer.includes('$30') || lowOffer.includes('30 credit') || lowOffer.includes('30 free')) ctaText = 'Claim $30 Free Credit →';
  else if (lowOffer.includes('$10') || lowOffer.includes('10 credit') || lowOffer.includes('10 free')) ctaText = 'Claim $10 Free Credit →';
  else if (lowOffer.includes('3 free minute') || lowOffer.includes('3 minutes free')) ctaText = 'Get 3 Mins Free →';
  else if (lowOffer.includes('5 minute') || (lowOffer.includes('$1') && !lowOffer.includes('$10') && !lowOffer.includes('$30'))) ctaText = 'Get 5 Mins for $1 →';
  else if (lowOffer.includes('free trial') || lowOffer.includes('free minutes')) ctaText = 'Start Free Trial →';
  else ctaText = isReaderReview && readerLabel ? `Book ${readerLabel} →` : 'Visit Official Site →';
}
// Explicit override (e.g. a reader who left the platform — point to live roster)
const displayCta = ctaOverride || ctaText;

// ── Focused sticky-CTA config ────────────────────────────────────────────────
// On a reader-specific page (e.g. /reviews/kasamba/master-enigma-.../) the
// sticky bottom bar must promote THAT reader's affiliate deeplink, not a
// generic platform CTA or the legacy dual-button layout. On platform-level
// pages it promotes the platform's own /go/<platform>/ offer instead.
type StickyCtaConfig = {
  slug: string;
  label?: string;
  prompt?: string;
  platform?: 'keen' | 'kasamba' | 'purple-garden';
};

const platformKey = platformFromName(platformName || '');
const platformOffers: Record<'keen' | 'kasamba' | 'purple-garden', { label: string; prompt: string }> = {
  keen:            { label: 'Try Keen · 5 min for $1 →',         prompt: '5 min for $1' },
  kasamba:         { label: 'Try Kasamba · 3 free + 50% off →',  prompt: '3 free + 50% off' },
  'purple-garden': { label: 'Try Purple Garden · $30 credit →',  prompt: '$30 free credit' },
};

let stickyCtaConfig: StickyCtaConfig | undefined;
if (affiliateUrl && affiliateUrl !== '#' && platformKey) {
  const copy = platformOffers[platformKey];
  stickyCtaConfig = {
    slug: affiliateUrl,
    platform: platformKey,
    label: copy.label,
    prompt: copy.prompt,
  };
}

// ── CTA context shared by the new conversion surfaces ───────────────────────
// Available on every page with a resolvable platform + real affiliate link.
const hasCtaContext = !!(platformKey && affiliateUrl && affiliateUrl !== '#');
const offerData = platformKey ? PLATFORM_OFFERS[platformKey] : null;
// Desktop right-rail sticky deal card (reader-level deeplink when relevant).
const sidebarDeal = hasCtaContext
  ? {
      platform: platformKey!,
      rating,
      label: isReaderReview ? 'This page’s reader' : 'This page’s pick',
      href: affiliateUrl,
      heading: isReaderReview && readerLabel ? `${readerLabel} · ${offerData!.offer}` : undefined,
    }
  : undefined;
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  jsonLd={reviewSchema}
  ogImage={ogImage}
  canonicalUrl={canonicalUrl}
  noindex={noindex}
  seoTitle={seoTitle}
  metaDescription={metaDescription}
  customSchema={customSchema}
  hreflangEs={hreflangEs}
  topOfferPlatform={platformKey ?? 'kasamba'}
  stickyCta={stickyCtaConfig}
>
  <!-- Full-page 3-column grid: sidebars span the entire page height -->
  <div class="page-with-sidebars">
    <!-- LEFT SIDEBAR -->
    <LeftSidebar platform={platformKey ?? undefined} />

    <!-- MAIN COLUMN: breadcrumb + hero + content -->
    <div class="main-col">
      <!-- Breadcrumb -->
      <div class="review-breadcrumb">
        <Breadcrumb items={breadcrumbItems} />
      </div>

      <!-- Review Hero -->
      <header class="review-hero">
        <div class="review-hero-meta">
          <span class="badge badge--sage">Review</span>
          <span class="review-date">
            {updatedDate ? 'Updated' : 'Published'} {formattedDate}
          </span>
        </div>

        <div class="review-hero-header">
          <h1 class="review-title">{title}</h1>
        </div>

        <div class="review-identity">
          {isReaderReview && (
            <img
              class="reader-avatar-lg"
              src={avatarUrl || avatarFallbackSvg}
              alt={avatarUrl ? `${readerLabel} profile photo` : `${readerLabel} initials avatar`}
              width="72"
              height="72"
              loading="eager"
              decoding="async"
            />
          )}
          <div class="review-identity-text">
            {isReaderReview && parentPlatform && parentPlatformLabel && readerLabel && (
              <div class="reader-subline">
                <a href={`/reviews/${parentPlatform}/`} class="badge badge--outline badge--link">
                  {parentPlatformLabel}
                </a>
                <span class="reader-subline-text">Reader profile: {readerLabel}</span>
              </div>
            )}
            <div class="reader-rating-summary">
              <StarRating rating={rating} size="md" showValue={false} />
              <span class="rating-score">{rating}</span>
              <span class="rating-label">Expert Rating</span>
            </div>
          </div>
        </div>

        <p class="review-verdict">{verdict}</p>

        <div class="review-hero-cta">
          <div class="review-hero-trust">
            <span class="trust-chip">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Independently tested
            </span>
            {freeOffer && (
              <span class="trust-chip trust-chip--offer">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2L4.09 12.35a.6.6 0 00.46.98H11l-1.8 8.02c-.13.6.63.95 1.03.48L20.91 10.6a.6.6 0 00-.46-.98H13l1.8-7.14c.14-.57-.6-.93-1.03-.48L13 2z"/></svg>
                {freeOffer}
              </span>
            )}
          </div>
          {platformKey ? (
            <CtaTip text={proofTooltip(platformKey)}>
              <a href={affiliateUrl} class="btn btn--primary btn--lg" rel="nofollow sponsored" target="_blank" data-cta-source="hero">
                {displayCta}
              </a>
            </CtaTip>
          ) : (
            <a href={affiliateUrl} class="btn btn--primary btn--lg" rel="nofollow sponsored" target="_blank" data-cta-source="hero">
              {displayCta}
            </a>
          )}
          {offerData && (
            <p class="review-hero-cta-note">{offerData.microLine}</p>
          )}
          {hasCtaContext && (
            <DealStrip platform={platformKey!} source="hero" href={affiliateUrl} />
          )}
        </div>
      </header>

      <!-- Review Content -->
      <article class="review-content">
        <div class="prose">
          <slot />
        </div>
        {/* Mid-article CTA: auto-injected before the 2nd H2 inside .prose.
            Closes the conversion dead zone between hero and end CTA. */}
        {hasCtaContext && (
          <InlineCta platform={platformKey!} href={affiliateUrl} />
        )}
        <AuthorBio />
      </article>
    </div>

    <!-- RIGHT SIDEBAR -->
    <RightSidebar deal={hideSidebarDeal ? undefined : sidebarDeal} />
  </div>
</BaseLayout>

<style>
  /* ── Full-page 3-column layout ── */
  .page-with-sidebars {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 3.5rem;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-6) var(--space-12);
  }

  /* ── Centre column ── */
  .main-col {
    flex: 1;
    min-width: 0;
    max-width: var(--max-width-content);
    transition: max-width 0.3s ease;
  }

  .review-breadcrumb {
    margin-bottom: var(--space-4);
  }

  /* ── Hero ── */
  .review-hero {
    padding: var(--space-2) 0 var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: var(--space-5);
  }

  .review-hero-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .review-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .review-title {
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .review-identity {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .review-identity-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .reader-avatar-lg {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #fff;
    box-shadow:
      0 0 0 3px var(--color-accent, #c4956a),
      0 8px 22px rgba(120, 80, 40, 0.28);
    flex: 0 0 auto;
    transition: transform var(--transition-base, 0.2s ease);
  }

  .reader-avatar-lg:hover {
    transform: scale(1.04);
  }

  .reader-rating-summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: 2px;
  }

  .rating-score {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    line-height: 1;
  }

  .rating-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-primary-dark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-sage-100);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .reader-subline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .badge--link {
    text-decoration: none;
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .badge--link:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }

  .reader-subline-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .review-hero-rating {
    margin-bottom: var(--space-4);
  }

  .review-verdict {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
    max-width: 600px;
  }

  .review-offer {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--color-warning-bg);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-primary-dark);
    margin-bottom: var(--space-4);
  }

  .review-hero-cta {
    margin-bottom: var(--space-4);
  }

  .review-hero-trust {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .trust-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-primary-dark, #6b5438);
    background: var(--color-sage-100, #eef2e9);
    border: 1px solid rgba(107, 143, 94, 0.25);
    padding: 3px 10px;
    border-radius: 9999px;
  }

  .trust-chip--offer {
    color: var(--color-accent-hover, #b07f55);
    background: var(--color-warning-bg, #fdf5ec);
    border-color: var(--color-accent-light, #e8cdb0);
  }

  .review-hero-cta-note {
    margin: var(--space-2) 0 0;
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    max-width: 480px;
  }

  @media (max-width: 768px) {
    .review-hero-cta-note {
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }
  }

  /* ── Content ── */
  .review-content {
    padding-bottom: var(--space-8);
  }

  .prose {
    max-width: 100%;
  }

  /* ── Responsive ── */
  @media (max-width: 1300px) {
    .page-with-sidebars {
      gap: 2rem;
    }
  }

  @media (max-width: 1100px) {
    .page-with-sidebars {
      justify-content: center;
      padding-top: var(--space-6);
    }
  }

  @media (max-width: 768px) {
    .page-with-sidebars {
      flex-direction: column;
      align-items: center;
      padding-left: var(--space-4);
      padding-right: var(--space-4);
      gap: var(--space-8);
    }

    .main-col {
      width: 100%;
      max-width: 100%;
    }

    .review-hero {
      padding-top: 0;
    }

    .review-identity {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-4);
    }

    .reader-rating-summary {
      justify-content: center;
    }

    .reader-subline {
      justify-content: center;
    }

    .reader-avatar-lg {
      width: 72px;
      height: 72px;
    }

    .review-title {
      font-size: var(--text-2xl);
    }

    .review-verdict {
      font-size: var(--text-base);
    }

    .review-hero-cta .btn {
      width: 100%;
    }
  }
</style>
