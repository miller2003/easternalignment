---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import StarRating from '../components/StarRating.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AuthorBio from '../components/AuthorBio.astro';

interface Props {
  title: string;
  description: string;
  platformName: string;
  rating: number;
  verdict: string;
  affiliateUrl?: string;
  freeOffer?: string;
  publishDate: string;
  updatedDate?: string;
}

const {
  title,
  description,
  platformName,
  rating,
  verdict,
  affiliateUrl = '#',
  freeOffer,
  publishDate,
  updatedDate,
} = Astro.props;

const displayDate = updatedDate || publishDate;
const formattedDate = new Date(displayDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "Review",
  "name": title,
  "description": description,
  "author": {
    "@type": "Person",
    "name": "Sarah",
    "url": "https://easternalignment.com/about/",
  },
  "datePublished": publishDate,
  ...(updatedDate ? { "dateModified": updatedDate } : {}),
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": rating,
    "bestRating": 5,
    "worstRating": 1,
  },
  "itemReviewed": {
    "@type": "Service",
    "name": platformName,
  },
  "publisher": {
    "@type": "Organization",
    "name": "EasternAlignment",
    "url": "https://easternalignment.com",
  },
};
---

<BaseLayout title={title} description={description} ogType="article" jsonLd={reviewSchema}>
  <div class="review-page">
    <!-- Breadcrumb -->
    <div class="container container--narrow">
      <Breadcrumb items={[
        { label: 'Reviews', href: '/reviews/' },
        { label: platformName }
      ]} />
    </div>

    <!-- Review Hero -->
    <header class="review-hero">
      <div class="container container--narrow">
        <div class="review-hero-meta">
          <span class="badge badge--sage">Review</span>
          <span class="review-date">
            {updatedDate ? 'Updated' : 'Published'} {formattedDate}
          </span>
        </div>

        <h1 class="review-title">{title}</h1>

        <div class="review-hero-rating">
          <StarRating rating={rating} size="lg" label="Overall" />
        </div>

        <p class="review-verdict">{verdict}</p>

        {freeOffer && (
          <div class="review-offer">
            <span class="offer-icon">🎁</span>
            <span><strong>Special Offer:</strong> {freeOffer}</span>
          </div>
        )}

        <div class="review-hero-cta">
          <a href={affiliateUrl} class="btn btn--primary btn--lg" rel="nofollow sponsored" target="_blank">
            Visit {platformName} →
          </a>
        </div>

        <AffiliateDisclosure variant="inline" />
      </div>
    </header>

    <!-- Review Content -->
    <article class="review-content container container--narrow">
      <div class="prose">
        <slot />
      </div>

      <AuthorBio />
    </article>
  </div>
</BaseLayout>

<style>
  .review-page {
    padding-top: var(--space-4);
  }

  .review-hero {
    padding: var(--space-4) 0 var(--space-6);
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: var(--space-6);
  }

  .review-hero-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .review-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .review-title {
    margin-bottom: var(--space-4);
  }

  .review-hero-rating {
    margin-bottom: var(--space-4);
  }

  .review-verdict {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
    max-width: 600px;
  }

  .review-offer {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background: var(--color-warning-bg);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-primary-dark);
    margin-bottom: var(--space-6);
  }

  .review-hero-cta {
    margin-bottom: var(--space-6);
  }

  .review-content {
    padding-bottom: var(--space-4);
  }
</style>
