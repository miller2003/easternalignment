---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TopDisclosureBar from '../components/TopDisclosureBar.astro';
import PostHog from '../components/PostHog.astro';
import StickyCTA from '../components/StickyCTA.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  jsonLd?: object;
  // Manual SEO overrides from frontmatter
  seoTitle?: string;
  metaDescription?: string;
  customSchema?: string;
  /** URL of the corresponding Spanish page (if one exists) */
  hreflangEs?: string;
}

const {
  title,
  description,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  canonicalUrl,
  noindex = false,
  jsonLd,
  seoTitle,
  metaDescription,
  customSchema,
  hreflangEs,
} = Astro.props;

const SITE_NAME = 'Eastern Alignment';
const SITE_URL  = 'https://easternalignment.com';

const baseTitle = seoTitle || title;
// Smart title length protection: only append the brand suffix when the
// page title is short enough to stay under ~63 characters total. Long
// keyword-first titles keep their full keyword payload without dilution.
const fullTitle = baseTitle === SITE_NAME
  ? baseTitle
  : baseTitle.length > 42
    ? baseTitle
    : `${baseTitle} — ${SITE_NAME}`;
const metaDesc = metaDescription || description;

// Robust Canonical: Always point to the production domain, forcing HTTPS and preserving the path
const canonical = canonicalUrl || new URL(Astro.url.pathname, SITE_URL).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage.replace('http://', 'https://') : new URL(ogImage, SITE_URL).href;

// ── hreflang: Default to English, with x-default
const hreflangSelf = canonical; // en
const hreflangXDefault = canonical; // x-default defaults to English version

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": SITE_NAME,
  "url": SITE_URL,
  "description": "Honest reviews and guidance for online psychic reading platforms. Independently tested by real users.",
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": SITE_NAME,
  "url": SITE_URL,
  "logo": `${SITE_URL}/logo.jpg`,
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Sarah",
  "url": `${SITE_URL}/about/`,
  "jobTitle": "Reviewer & Researcher"
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name='impact-site-verification' value='9b281445-730b-4b8f-ae89-484d7da8e36e'>
    <PostHog />

    <!-- Primary Meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <!-- hreflang cluster -->
    <link rel="alternate" hreflang="en" href={hreflangSelf} />
    <link rel="alternate" hreflang="x-default" href={hreflangXDefault} />
    {hreflangEs && (
      <>
        <link rel="alternate" hreflang="es" href={hreflangEs} />
        <link rel="alternate" hreflang="es-419" href={hreflangEs} />
      </>
    )}

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Google Fonts: DM Serif Display + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    {customSchema && customSchema.trim() && (
      <script type="application/ld+json" set:html={customSchema} />
    )}
  </head>
  <body>
    <TopDisclosureBar />
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <!-- Mobile/tablet persistent CTA (hidden >= 1100px where the sidebar shows) -->
    <StickyCTA />
  </body>
</html>