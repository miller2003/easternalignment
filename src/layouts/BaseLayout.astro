---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TopDisclosureBar from '../components/TopDisclosureBar.astro';
import TopOfferBar from '../components/TopOfferBar.astro';
import PostHog from '../components/PostHog.astro';
import StickyCTA from '../components/StickyCTA.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  jsonLd?: object;
  // Manual SEO overrides from frontmatter
  seoTitle?: string;
  metaDescription?: string;
  customSchema?: string;
  /** URL of the corresponding Spanish page (if one exists) */
  hreflangEs?: string;
  /**
   * Platform context for the top offer bar. Layouts pass the page's
   * platform so the promo strip matches the content (a Kasamba page shows
   * the Kasamba deal). Omit to hide the bar (legal/utility pages).
   */
  topOfferPlatform?: 'keen' | 'kasamba' | 'purple-garden';
  /**
   * Optional focused-CTA config for the bottom sticky bar. When provided, the
   * StickyCTA collapses to a single primary button pointing at this page's
   * platform/reader deeplink (e.g. /go/kasamba-master-enigma/). When omitted,
   * the legacy dual-button (Keen + Kasamba) layout is used.
   */
  stickyCta?: {
    slug: string;
    label?: string;
    prompt?: string;
    platform?: 'keen' | 'kasamba' | 'purple-garden';
  };
}

const {
  title,
  description,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  canonicalUrl,
  noindex = false,
  jsonLd,
  seoTitle,
  metaDescription,
  customSchema,
  hreflangEs,
  topOfferPlatform,
  stickyCta,
} = Astro.props;

const SITE_NAME = 'Eastern Alignment';
const SITE_URL  = 'https://easternalignment.com';

const baseTitle = seoTitle || title;
// Smart title length protection: only append the brand suffix when the
// page title is short enough to stay under ~63 characters total. Long
// keyword-first titles keep their full keyword payload without dilution.
const fullTitle = baseTitle === SITE_NAME
  ? baseTitle
  : baseTitle.length > 42
    ? baseTitle
    : `${baseTitle} — ${SITE_NAME}`;
const metaDesc = metaDescription || description;

// Robust Canonical: Always point to the production domain, forcing HTTPS and preserving the path
const canonical = canonicalUrl || new URL(Astro.url.pathname, SITE_URL).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage.replace('http://', 'https://') : new URL(ogImage, SITE_URL).href;

// ── hreflang: Default to English, with x-default
const hreflangSelf = canonical; // en
const hreflangXDefault = canonical; // x-default defaults to English version

// ── Site Name + Organization entity graph ────────────────────────────────────
// These three nodes (WebSite / Organization / Person) are the structured-data
// foundation for Google's "Site Name" feature — the thing that decides whether
// the SERP shows "Eastern Alignment" or the bare domain. They are weakly linked
// via shared @id so the brand resolves to one entity.
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://easternalignment.com/#website",
  "name": SITE_NAME,
  "alternateName": "Eastern Alignment Psychic Reviews",
  "url": SITE_URL,
  "description": "Honest, independently tested reviews and guidance for online psychic reading platforms.",
  "inLanguage": "en-US",
  "publisher": { "@id": "https://easternalignment.com/#organization" },
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://easternalignment.com/#organization",
  "name": SITE_NAME,
  "alternateName": "Eastern Alignment Psychic Reviews",
  "url": SITE_URL,
  "logo": {
    "@type": "ImageObject",
    "@id": "https://easternalignment.com/#logo",
    "url": `${SITE_URL}/logo.jpg`,
    "width": 1024,
    "height": 817,
  },
  "image": `${SITE_URL}/logo.jpg`,
  "description": "Independent review site for online psychic reading platforms — Kasamba, Purple Garden, and Keen — tested by real users.",
  // TODO: add real social profile URLs here to unlock the Google Knowledge Panel.
  // "sameAs": ["https://www.facebook.com/...", "https://www.instagram.com/...", "..."],
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://easternalignment.com/#sarah",
  "name": "Sarah",
  "url": `${SITE_URL}/about/`,
  "jobTitle": "Reviewer & Researcher",
  "worksFor": { "@id": "https://easternalignment.com/#organization" },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="application-name" content={SITE_NAME} />
    <meta name='impact-site-verification' value='9b281445-730b-4b8f-ae89-484d7da8e36e'>
    <PostHog />

    <!-- Primary Meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <!-- hreflang cluster -->
    <link rel="alternate" hreflang="en" href={hreflangSelf} />
    <link rel="alternate" hreflang="x-default" href={hreflangXDefault} />
    {hreflangEs && (
      <>
        <link rel="alternate" hreflang="es" href={hreflangEs} />
        <link rel="alternate" hreflang="es-419" href={hreflangEs} />
      </>
    )}

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Google Fonts: DM Serif Display + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={metaDesc.slice(0, 100)} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    {customSchema && customSchema.trim() && (
      <script type="application/ld+json" set:html={customSchema} />
    )}
  </head>
  <body>
    <TopDisclosureBar />
    {topOfferPlatform && <TopOfferBar platform={topOfferPlatform} />}
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <!-- Mobile/tablet persistent CTA (hidden >= 1100px where the sidebar shows).
         Pages may pass `stickyCta` to switch this into "focused" mode: a single
         primary button that deep-links to that page's reader-level affiliate URL
         (e.g. /go/kasamba-master-enigma/) instead of the generic dual-button. -->
    <StickyCTA
      slug={stickyCta?.slug}
      label={stickyCta?.label}
      prompt={stickyCta?.prompt}
      platform={stickyCta?.platform}
    />
  </body>
</html>