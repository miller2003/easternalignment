---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TopDisclosureBar from '../components/TopDisclosureBar.astro';
import TopOfferBar from '../components/TopOfferBar.astro';
import PostHog from '../components/PostHog.astro';
import SideOfferTab from '../components/SideOfferTab.astro';
import { affiliateLinks } from '../data/affiliateLinks';
import '../styles/global.css';

// 预连接目标：联盟跳转的落地主机（从 affiliateLinks 自动推导，不写死）。
// 用户点击 CTA 后要经历「本站 → /go 中转页 → 联盟主机」两次跳转，
// 而联盟主机是跨域的，DNS + TLS 握手通常要 150–400ms（移动端更久）。
// 在内容页就把连接预热好，点击时可直接复用，省掉这段握手时间。
const affiliateOrigins = Array.from(
  new Set(
    Object.values(affiliateLinks)
      .map((u) => {
        try { return new URL(u).origin; } catch { return null; }
      })
      .filter(Boolean) as string[]
  )
).slice(0, 3); // 预连接超过 3 个会互相抢占，反而变慢

const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  jsonLd?: object;
  // Manual SEO overrides from frontmatter
  seoTitle?: string;
  metaDescription?: string;
  customSchema?: string;
  /** URL of the corresponding Spanish page (if one exists) */
  hreflangEs?: string;
  /**
   * Platform context for the top offer bar. Layouts pass the page's
   * platform so the promo strip matches the content (a Kasamba page shows
   * the Kasamba deal). Omit to hide the bar (legal/utility pages).
   */
  topOfferPlatform?: 'keen' | 'kasamba' | 'purple-garden';
  /**
   * Optional focused-CTA config for the right-edge offer tab. When provided,
   * the tab promotes a single primary platform and deep-links to that page's
   * platform/reader affiliate URL (e.g. /go/kasamba-master-enigma/). When
   * omitted, the tab falls back to the site-wide No.1 (Kasamba).
   * `prompt` is accepted for backwards compatibility but unused — the tab
   * renders one short vertical line of copy, not a panel.
   */
  stickyCta?: {
    slug: string;
    label?: string;
    prompt?: string;
    platform?: 'keen' | 'kasamba' | 'purple-garden';
  };
  /**
   * Pure-content mode (2026-09-02): when true, suppresses every affiliate
   * CTA surface — the right-edge SideOfferTab and (via the caller omitting
   * topOfferPlatform) the top promo bar. Used for trust/GEO articles that
   * must carry zero commercial components. Header, Footer, and the
   * disclosure bar are NOT CTAs and stay.
   */
  noCta?: boolean;
}

const {
  title,
  description,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  canonicalUrl,
  noindex = false,
  jsonLd,
  seoTitle,
  metaDescription,
  customSchema,
  hreflangEs,
  topOfferPlatform,
  stickyCta,
  noCta = false,
} = Astro.props;

const SITE_NAME = 'Eastern Alignment';
const SITE_URL  = 'https://easternalignment.com';

const baseTitle = seoTitle || title;
// Smart title length protection: only append the brand suffix when the
// page title is short enough to stay under ~63 characters total. Long
// keyword-first titles keep their full keyword payload without dilution.
const fullTitle = baseTitle === SITE_NAME
  ? baseTitle
  : baseTitle.length > 42
    ? baseTitle
    : `${baseTitle} — ${SITE_NAME}`;
const metaDesc = metaDescription || description;

// Robust Canonical: Always point to the production domain, forcing HTTPS and preserving the path
const canonical = canonicalUrl || new URL(Astro.url.pathname, SITE_URL).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage.replace('http://', 'https://') : new URL(ogImage, SITE_URL).href;

// ── hreflang: Default to English, with x-default
const hreflangSelf = canonical; // en
const hreflangXDefault = canonical; // x-default defaults to English version

// ── Site Name + Organization entity graph ────────────────────────────────────
// These three nodes (WebSite / Organization / Person) are the structured-data
// foundation for Google's "Site Name" feature — the thing that decides whether
// the SERP shows "Eastern Alignment" or the bare domain. They are weakly linked
// via shared @id so the brand resolves to one entity.
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://easternalignment.com/#website",
  "name": SITE_NAME,
  "alternateName": "Eastern Alignment Psychic Reviews",
  "url": SITE_URL,
  "description": "Honest, independently researched reviews and guidance for online psychic reading platforms.",
  "inLanguage": "en-US",
  "publisher": { "@id": "https://easternalignment.com/#organization" },
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://easternalignment.com/#organization",
  "name": SITE_NAME,
  "alternateName": "Eastern Alignment Psychic Reviews",
  "url": SITE_URL,
  "logo": {
    "@type": "ImageObject",
    "@id": "https://easternalignment.com/#logo",
    "url": `${SITE_URL}/logo.jpg`,
    "width": 1024,
    "height": 817,
  },
  "image": `${SITE_URL}/logo.jpg`,
  "description": "Independent review site for online psychic reading platforms — Kasamba, Purple Garden, and Keen — tested by real users.",
  // TODO: add real social profile URLs here to unlock the Google Knowledge Panel.
  // "sameAs": ["https://www.facebook.com/...", "https://www.instagram.com/...", "..."],
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://easternalignment.com/#sarah",
  "name": "Sarah",
  "url": `${SITE_URL}/about/`,
  "image": `${SITE_URL}/sarah-avatar.jpg`,
  "jobTitle": "Reviewer & Researcher",
  "worksFor": { "@id": "https://easternalignment.com/#organization" },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="application-name" content={SITE_NAME} />
    <meta name='impact-site-verification' value='9b281445-730b-4b8f-ae89-484d7da8e36e'>
    <PostHog />

    <!-- Primary Meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <!-- hreflang cluster -->
    <link rel="alternate" hreflang="en" href={hreflangSelf} />
    <link rel="alternate" hreflang="x-default" href={hreflangXDefault} />
    {hreflangEs && (
      <>
        <link rel="alternate" hreflang="es" href={hreflangEs} />
        <link rel="alternate" hreflang="es-419" href={hreflangEs} />
      </>
    )}

    <!-- Favicons -->
    <!-- Google renders the favicon at ~16px. Declare the 96px and 192px PNGs first
         (both multiples of 48, per Google's guidance) so the high-quality source is
         picked instead of an upscaled 16px ICO. The .ico keeps multi-size frames as
         a legacy fallback. Note: no sizes="any" - that hint is for SVG and can make
         a raster ICO look like the preferred source. -->
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <!-- Google Fonts: DM Serif Display + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- 联盟跳转主机预热：点击 CTA 时省掉 DNS + TLS 握手（2026-09-10） -->
    {affiliateOrigins.map((origin) => (
      <>
        <link rel="dns-prefetch" href={origin} />
        <link rel="preconnect" href={origin} crossorigin />
      </>
    ))}

    <!-- PostHog 事件上报主机预热：让点击事件与 /go 到达事件更快发出 -->
    <link rel="dns-prefetch" href={posthogHost} />
    <link rel="preconnect" href={posthogHost} crossorigin />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={metaDesc.slice(0, 100)} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    {customSchema && customSchema.trim() && (
      <script type="application/ld+json" set:html={customSchema} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <TopDisclosureBar />
    {topOfferPlatform && <TopOfferBar platform={topOfferPlatform} />}
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <!-- Slim right-edge offer tab: the persistent CTA surface. Replaces both
         the old full-width bottom bar (which covered the last lines of every
         article) and the sliding dock panel. It IS the affiliate link — no
         panel, no toggle, no JavaScript. Pages may pass `stickyCta` to point
         the tab at that page's own platform/reader URL
         (e.g. /go/kasamba-master-enigma/). Suppressed entirely in noCta mode.

         NOTE: `stickyCta.label` is deliberately NOT forwarded. Layouts still
         supply horizontal-button copy ("Try Keen · 5 min for $1 →") which is
         far too long for a 40px vertical tab — the tab derives its own short
         line from `stickyCta.platform` instead. -->
    {!noCta && (
      <SideOfferTab
        slug={stickyCta?.slug}
        platform={stickyCta?.platform}
      />
    )}
  </body>
</html>