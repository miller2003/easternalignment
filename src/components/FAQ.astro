---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  title?: string;
  generateSchema?: boolean;
}

const {
  items,
  title = 'Frequently Asked Questions',
  generateSchema = true,
} = Astro.props;

/**
 * 2026-09-10 修复：答案里的 HTML 过去被 Astro 默认转义，页面上直接显示了
 * `<a href="/go/kasamba/">Kasamba</a>` 这样的原始标签——链接点不动、加粗不生效。
 * 首页 FAQ 有 5 条中招。
 *
 * 现在只对「确实含标签」的答案走 set:html 渲染，纯文本答案维持原样转义，
 * 避免影响其余页面的既有行为。
 */
const hasMarkup = (s: string) => /<[a-z][^>]*>/i.test(s || '');

/** schema.org 的 FAQPage.text 必须是纯文本，不能带标签（否则富结果校验会报错） */
const stripTags = (s: string) =>
  (s || '').replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();

/* Generate FAQ schema JSON-LD */
const faqSchema = generateSchema ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": stripTags(item.answer),
    }
  }))
} : null;
---

<section class="faq-section" id="faq">
  <h2 class="faq-title">{title}</h2>

  <div class="faq-list">
    {items.map((item, index) => (
      <details class="faq-item" id={`faq-${index}`}>
        <summary class="faq-question">
          <span class="faq-question-text">{item.question}</span>
          <span class="faq-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </summary>
        <div class="faq-answer">
          {hasMarkup(item.answer)
            ? <p set:html={item.answer} />
            : <p>{item.answer}</p>}
        </div>
      </details>
    ))}
  </div>
</section>

{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

<style>
  .faq-section {
    margin: var(--space-6) 0;
  }

  .faq-title {
    margin-bottom: var(--space-4);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .faq-item[open] {
    border-color: var(--color-primary-light);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    cursor: pointer;
    list-style: none;
    font-weight: var(--weight-medium);
    font-size: var(--text-base);
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::marker {
    content: '';
  }

  .faq-question:hover {
    color: var(--color-primary);
  }

  .faq-icon {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform var(--transition-base);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 var(--space-6) var(--space-6);
    animation: fadeIn 0.3s ease;
  }

  .faq-answer p {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
