---
interface Props {
  name?: string;
  title?: string;
  bio?: string;
  experience?: string;
}

const {
  name = 'Sarah',
  title = 'Spiritual Wellness Researcher',
  bio = "After a life-changing experience with an online psychic during one of the darkest periods of my life, I dedicated myself to reviewing and testing these platforms so you don't have to. I've spent over 3 years and hundreds of hours connecting with psychics across major platforms — so I can give you the honest truth about what works, what doesn't, and where your money is best spent.",
  experience = '3+ years reviewing psychic platforms',
} = Astro.props;
---

<div class="author-bio card">
  <div class="author-bio-inner">
    <div class="author-avatar">
      <img src="/sarah-avatar.jpg" alt="Sarah" class="avatar-img" width="64" height="64" loading="lazy" />
    </div>
    <div class="author-info">
      <div class="author-meta">
        <span class="text-xs text-uppercase text-muted">Written by</span>
        <h4 class="author-name">
          <a href="/about/">{name}</a>
        </h4>
        <p class="author-title">{title}</p>
      </div>
      <p class="author-bio-text">{bio}</p>
      <div class="author-credentials">
        <span class="credential-badge badge badge--sage">
          ✦ {experience}
        </span>
      </div>
    </div>
  </div>
</div>

<style>
  .author-bio {
    margin-top: var(--space-12);
    padding: var(--space-8);
  }

  .author-bio-inner {
    display: flex;
    gap: var(--space-6);
  }

  .author-avatar {
    flex-shrink: 0;
  }

  .avatar-img {
    display: block;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 20%;
    border: 2px solid var(--color-border-light);
  }

  .author-info {
    flex: 1;
  }

  .author-name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    margin: var(--space-1) 0 0 0;
  }

  .author-name a {
    text-decoration: none;
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .author-name a:hover {
    color: var(--color-primary);
  }

  .author-title {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3) 0;
  }

  .author-bio-text {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4) 0;
  }

  .author-credentials {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .author-bio-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .author-credentials {
      justify-content: center;
    }
  }
</style>
