---
/**
 * InfiniteContentFlow — Appends a related guide article below the current page.
 * Uses IntersectionObserver to update the browser URL when the user scrolls
 * into the guide section, creating a "seamless" content flow experience.
 * 
 * This is the technique used by sites like Medium and major content publishers
 * to maximize session duration.
 */

interface Props {
  guideTitle: string;
  guideDescription: string;
  guideSlug: string;
  guideCategory?: string;
}

const { guideTitle, guideDescription, guideSlug, guideCategory } = Astro.props;
---

<section
  class="infinite-flow"
  id="infinite-flow-section"
  data-guide-url={`/guides/${guideSlug}/`}
  data-guide-title={guideTitle}
  aria-label={`Continue reading: ${guideTitle}`}
>
  <div class="infinite-flow-divider">
    <span class="infinite-flow-divider-line"></span>
    <span class="infinite-flow-divider-label">Continue Reading</span>
    <span class="infinite-flow-divider-line"></span>
  </div>

  <div class="infinite-flow-header">
    {guideCategory && <span class="badge badge--sage">{guideCategory}</span>}
    <h2 class="infinite-flow-title">{guideTitle}</h2>
    <p class="infinite-flow-desc">{guideDescription}</p>
  </div>

  <div class="infinite-flow-content prose">
    <slot />
  </div>

  <div class="infinite-flow-footer">
    <a href={`/guides/${guideSlug}/`} class="btn btn--secondary">
      View Full Guide →
    </a>
  </div>
</section>

<style>
  .infinite-flow {
    margin-top: var(--space-16);
    padding-top: var(--space-4);
    position: relative;
  }

  .infinite-flow-divider {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .infinite-flow-divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-border), transparent);
  }

  .infinite-flow-divider-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-light);
    white-space: nowrap;
    padding: var(--space-2) var(--space-4);
    background: var(--color-bg-alt);
    border-radius: var(--radius-full);
  }

  .infinite-flow-header {
    margin-bottom: var(--space-8);
  }

  .infinite-flow-title {
    font-size: var(--text-3xl);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .infinite-flow-desc {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 600px;
  }

  .infinite-flow-content {
    /* Inherits .prose styles from global */
  }

  .infinite-flow-footer {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-light);
    text-align: center;
  }
</style>

<script>
  // IntersectionObserver to update the URL when the user scrolls into the guide
  const flowSection = document.getElementById('infinite-flow-section');
  
  if (flowSection) {
    const guideUrl = flowSection.dataset.guideUrl;
    const guideTitle = flowSection.dataset.guideTitle;
    const originalUrl = window.location.href;
    const originalTitle = document.title;
    let isInGuide = false;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.intersectionRatio > 0.15) {
            // User has scrolled into the guide section
            if (!isInGuide && guideUrl) {
              isInGuide = true;
              // Quietly update the URL without navigation
              window.history.replaceState(
                { scrolledGuide: true, originalUrl },
                '',
                guideUrl
              );
              if (guideTitle) {
                document.title = `${guideTitle} — EasternAlignment`;
              }
            }
          } else {
            // User scrolled back up
            if (isInGuide) {
              isInGuide = false;
              window.history.replaceState(
                { scrolledGuide: false },
                '',
                originalUrl
              );
              document.title = originalTitle;
            }
          }
        });
      },
      {
        // Trigger when 15% of the section is visible
        threshold: 0.15,
        rootMargin: '-80px 0px 0px 0px',
      }
    );

    observer.observe(flowSection);
  }
</script>
