---
/**
 * src/components/ReaderMatch.astro
 *
 * Standalone embeddable Reader Match System component.
 * Powers the situation-based matching on both the Homepage (below Hero)
 * and the dedicated /match page.
 */

import { clientReaders, MATCH_READERS_URL } from '../lib/matchReaders';
import '../match/styles/match.css';

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  compact?: boolean;
  /**
   * inline (default): the quiz renders directly inside this section
   *   (the dedicated /match/ page).
   * modal: the section shows an invitation launch card; the quiz runs
   *   in a full-screen bottom-sheet overlay (homepage, iPhone-tuned).
   *   All elements with [data-match-open] anywhere on the page open it.
   */
  mode?: 'inline' | 'modal';
  /**
   * Renders the section eyebrow/title/subtitle above the app. The modal
   * launch card already repeats title + subtitle, so hosts that introduce
   * the tool themselves (homepage) pass false to avoid saying it twice.
   */
  showHeader?: boolean;
  /**
   * Modal mode only. 'card' (default) renders the invitation launch card;
   * 'none' renders no visible section at all — the host page supplies its
   * own [data-match-open] trigger(s) (the /match/ page hero button).
   */
  launcher?: 'card' | 'none';
}

const {
  id = 'match',
  eyebrow = 'Situation-Based Precision Matching',
  title = 'Find the Exact Psychic Advisor for Your Situation',
  subtitle = 'Tell us what’s going on and get a short reading of your situation, then the three advisors, out of 240+ audited on Kasamba, Purple Garden and Keen, best suited to your question and the way you like to be read.',
  compact = false,
  mode = 'inline',
  showHeader = true,
  launcher = 'card',
} = Astro.props;

const isModal = mode === 'modal';
const headless = isModal && launcher === 'none';

---

{headless ? (
  <Fragment>
  <!-- Headless modal host: invisible mount point; the page's own
       [data-match-open] buttons open the quiz overlay -->
  <div id="ea-match-root" data-match-mode="modal" data-readers-src={MATCH_READERS_URL} data-reader-count={clientReaders.length} hidden></div>
    <noscript>
      <div class="ea-match-card" style="text-align: center; margin: 1rem auto; max-width: 640px;">
        <p class="text-muted text-sm">The match runs in your browser and needs JavaScript. You can browse our platform reviews instead:</p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="/reviews/kasamba/" class="btn btn--primary btn--sm">Kasamba Review</a>
          <a href="/reviews/purple-garden/" class="btn btn--secondary btn--sm">Purple Garden Review</a>
          <a href="/reviews/keen/" class="btn btn--secondary btn--sm">Keen Review</a>
        </div>
      </div>
    </noscript>
  </Fragment>
) : (
<section class={`ea-match-section section ${compact ? 'section--sm' : ''}`} id={id}>
  <div class="container">
    {showHeader && (
      <div class="section-header ea-match-section-head">
        <span class="section-eyebrow text-xs text-uppercase text-muted">{eyebrow}</span>
        <h2 class="section-title">{title}</h2>
        <p class="section-desc text-muted">{subtitle}</p>
      </div>
    )}

    <!-- Match App Container -->
    <div id="ea-match-root" class="ea-match-container" data-match-mode={isModal ? 'modal' : undefined} data-readers-src={MATCH_READERS_URL} data-reader-count={clientReaders.length}>
      {isModal ? (
        <!-- Modal host: invitation launch card; the quiz runs in a
             bottom-sheet overlay opened by any [data-match-open] trigger -->
        <div class="ea-match-launch">
          <span class="ea-match-launch-flag">Free · 2 minutes</span>
          <div class="ea-match-launch-icon" aria-hidden="true">✦</div>
          <h3 class="ea-match-launch-title">{title}</h3>
          <p class="ea-match-launch-sub">{subtitle}</p>
          <div class="ea-match-launch-meta">
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              About 2 minutes
            </span>
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.4-3 8.4-7 10-4-1.6-7-5.6-7-10V6l7-3z"/></svg>
              Private — stays in your browser
            </span>
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.5l5 5 10-11"/></svg>
              {clientReaders.length} audited advisors
            </span>
          </div>
          <button type="button" class="btn btn--primary btn--lg" data-match-open>
            <span data-match-open-label>Match My Situation →</span>
          </button>
          <p class="ea-match-launch-resume" data-match-retake-wrap style="display: none;">
            Want a clean read?
            <button type="button" data-match-retake>Start over</button>
          </p>
        </div>
      ) : (
        <!-- Inline host: SSR placeholder while the client engine mounts -->
        <div class="ea-match-card">
          <div class="ea-match-computing">
            <div class="ea-computing-orb-wrapper">
              <div class="ea-computing-orb">
                <div class="ea-computing-ring"></div>
                <div class="ea-computing-core"></div>
              </div>
            </div>
            <h3 class="ea-computing-status">Initializing Situation Match Engine…</h3>
            <p class="ea-computing-sub">Screening {clientReaders.length} Audited Advisor Profiles</p>
          </div>
        </div>
      )}
    </div>

    <noscript>
      <div class="ea-match-card" style="text-align: center; margin-top: 1rem;">
        <h3 style="font-family: var(--font-heading); margin-bottom: 0.5rem;">Interactive Match Requires JavaScript</h3>
        <p class="text-muted text-sm" style="max-width: 520px; margin: 0 auto 1rem;">
          Our situation-based match engine runs entirely client-side in your browser to maintain 100% privacy for your answers.
          You can also browse our top-rated platform reviews directly:
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="/reviews/kasamba/" class="btn btn--primary btn--sm">Kasamba Review (3 Free Mins)</a>
          <a href="/reviews/purple-garden/" class="btn btn--secondary btn--sm">Purple Garden Review ($30 Credit)</a>
          <a href="/reviews/keen/" class="btn btn--secondary btn--sm">Keen Review ($1 Trial)</a>
        </div>
      </div>
    </noscript>
  </div>
</section>
)}

<script>
  import '../match/app';
</script>

<style>
  .ea-match-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
    position: relative;
  }

  .ea-match-section-head {
    max-width: 740px;
    margin: 0 auto var(--space-8);
    text-align: center;
  }

  .ea-match-section-head .section-title {
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }
</style>
