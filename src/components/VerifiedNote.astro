---
/**
 * VerifiedNote — subtle "re-verified, no changes needed" stamp rendered
 * under the article title. Only pages whose frontmatter carries
 * `verifiedDate` display it (pages with real content updates don't set it).
 */
interface Props {
  date: string;
  lang?: 'en' | 'es';
}

const { date, lang = 'en' } = Astro.props;
const d = new Date(date + 'T00:00:00');
const formatted = lang === 'es'
  ? d.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })
  : d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const text = lang === 'es'
  ? `Reverificado el ${formatted} sobre fuentes actuales: sin novedades relevantes, cambios de precios ni correcciones que comunicar; el contenido sigue vigente tal como está.`
  : `Re-verified ${formatted} against current sources: no new developments, pricing changes, or corrections to report — this page remains current as written.`;
---

<p class="verified-note" role="note">
  <svg class="verified-note__icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
    <circle cx="8" cy="8" r="7.2" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
    <path d="M4.9 8.3l2 2 4.2-4.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span>{text}</span>
</p>

<style>
  .verified-note {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 0 0 26px;
    padding: 9px 14px;
    background: #f2f9f4;
    border: 1px solid #d5e9dc;
    border-left: 3px solid #3d8a5f;
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.55;
    color: #41584a;
  }
  .verified-note__icon {
    flex: 0 0 auto;
    margin-top: 2px;
    color: #3d8a5f;
  }
</style>
