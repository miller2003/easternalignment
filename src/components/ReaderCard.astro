---
import StarRating from './StarRating.astro';

interface Props {
  name: string;
  slug: string;
  platform: string;
  rating: number;
  verdict: string;
  pricing?: string;
  bestFor?: string;
  affiliateUrl?: string;
  freeOffer?: string;
}

const {
  name,
  slug,
  platform,
  rating,
  verdict,
  pricing,
  bestFor,
  affiliateUrl = '#',
  freeOffer,
} = Astro.props;

// Extract readable reader name from platformName (e.g., "Keen: arradaza" → "arradaza")
const readerDisplayName = name.includes(':') ? name.split(':').pop()?.trim() : name;
---

<article class="reader-card card card--elevated" id={`reader-${slug}`}>
  <div class="reader-card-header">
    <div class="reader-info">
      <h3 class="reader-name">
        <a href={`/reviews/${platform}/${slug}/`}>{readerDisplayName}</a>
      </h3>
      <StarRating rating={rating} size="md" />
    </div>
    {pricing && <span class="reader-price badge badge--outline">{pricing}</span>}
  </div>

  <p class="reader-verdict">{verdict.length > 200 ? verdict.substring(0, 200) + '…' : verdict}</p>

  {bestFor && (
    <div class="reader-best-for">
      <span class="best-for-label">Best for:</span>
      <span class="best-for-value">{bestFor.length > 100 ? bestFor.substring(0, 100) + '…' : bestFor}</span>
    </div>
  )}

  {freeOffer && (
    <div class="reader-offer">
      <span class="offer-icon">🎁</span>
      <span>{freeOffer}</span>
    </div>
  )}

  <div class="reader-actions">
    <a href={affiliateUrl} class="btn btn--primary btn--sm" rel="nofollow sponsored" target="_blank">
      Book Now →
    </a>
    <a href={`/reviews/${platform}/${slug}/`} class="btn btn--ghost btn--sm">
      Read Full Review
    </a>
  </div>
</article>

<style>
  .reader-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
  }

  .reader-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .reader-info {
    flex: 1;
    min-width: 200px;
  }

  .reader-name {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-1) 0;
  }

  .reader-name a {
    text-decoration: none;
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .reader-name a:hover {
    color: var(--color-primary);
  }

  .reader-price {
    white-space: nowrap;
    font-size: var(--text-xs);
    margin-top: var(--space-1);
  }

  .reader-verdict {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .reader-best-for {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .best-for-label {
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .best-for-value {
    color: var(--color-sage);
    font-weight: var(--weight-medium);
  }

  .reader-offer {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--color-warning-bg);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-primary-dark);
  }

  .reader-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-1);
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .reader-actions {
      flex-direction: column;
    }

    .reader-actions .btn {
      text-align: center;
    }
  }
</style>
