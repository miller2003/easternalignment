---
import StarRating from './StarRating.astro';

interface Props {
  name: string;
  slug: string;
  platform: string;
  rating: number;
  verdict: string;
  pricing?: string;
  bestFor?: string;
  affiliateUrl?: string;
  freeOffer?: string;
  avatarUrl?: string;
}

const {
  name,
  slug,
  platform,
  rating,
  verdict,
  pricing,
  bestFor,
  affiliateUrl = '#',
  freeOffer,
  avatarUrl,
} = Astro.props;

// Extract readable reader name from platformName (e.g., "Keen: arradaza" → "arradaza")
const readerDisplayName = name.includes(':') ? name.split(':').pop()?.trim() : name;

// Clean up pricing string (e.g., "$3.59/min (Love & Relationships profile)" -> "$3.59/min")
const cleanPrice = pricing 
  ? pricing.split('(')[0].replace(/chat|phone/i, '').trim() 
  : '';

// Generate compact CTA based on offer
let ctaText = 'Book Now';
if (freeOffer) {
  const lowOffer = freeOffer.toLowerCase();
  if (lowOffer.includes('$30') || lowOffer.includes('30 credit') || lowOffer.includes('30 free')) ctaText = 'Claim $30 Credit';
  else if (lowOffer.includes('$10') || lowOffer.includes('10 credit') || lowOffer.includes('10 free')) ctaText = 'Claim $10 Credit';
  else if (lowOffer.includes('3 free minute') || lowOffer.includes('3 minutes free')) ctaText = 'Get 3 Mins Free';
  else if (lowOffer.includes('5 minute') || (lowOffer.includes('$1') && !lowOffer.includes('$10') && !lowOffer.includes('$30'))) ctaText = 'Get 5 Mins for $1';
  else if (lowOffer.includes('free trial') || lowOffer.includes('free minutes')) ctaText = 'Start Free Trial';
  else ctaText = 'Book Now';
}

const initials =
  readerDisplayName
    ?.split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase())
    .join('') || 'R';

const avatarSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 96 96" role="img" aria-label="${initials}">
  <defs>
    <linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#6EE7B7"/>
      <stop offset="55%" stop-color="#60A5FA"/>
      <stop offset="100%" stop-color="#A78BFA"/>
    </linearGradient>
    <filter id="s" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#000" flood-opacity=".18"/>
    </filter>
  </defs>
  <circle cx="48" cy="48" r="44" fill="url(#g)" filter="url(#s)"/>
  <circle cx="48" cy="48" r="43" fill="none" stroke="rgba(255,255,255,.35)" />
  <text x="48" y="54" text-anchor="middle" font-family="ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial" font-size="34" font-weight="700" fill="rgba(255,255,255,.95)">${initials}</text>
</svg>`;

const fallbackAvatarSrc = `data:image/svg+xml,${encodeURIComponent(avatarSvg)}`;
---

<article class="reader-card" id={`reader-${slug}`}>
  <div class="reader-card-content">
    <div class="reader-card-header">
      <a class="reader-avatar-wrapper" href={`/reviews/${platform}/${slug}/`} aria-label={`Read ${readerDisplayName} review`}>
        <img
          class="reader-avatar"
          src={avatarUrl || fallbackAvatarSrc}
          alt={avatarUrl ? `${readerDisplayName} avatar` : `${readerDisplayName} initials avatar`}
          loading="lazy"
          decoding="async"
          width="56"
          height="56"
        />
      </a>
  
      <div class="reader-info">
        <h3 class="reader-name">
          <a href={`/reviews/${platform}/${slug}/`}>{readerDisplayName}</a>
        </h3>
        <div class="reader-meta">
          <StarRating rating={rating} size="sm" />
          {cleanPrice && <span class="reader-price">{cleanPrice}</span>}
        </div>
      </div>
    </div>
  
    <p class="reader-verdict">{verdict}</p>
  
    {bestFor && (
      <div class="reader-best-for">
        <span class="best-for-label">Best for:</span>
        <p class="best-for-value">{bestFor}</p>
      </div>
    )}
  

  </div>

  <div class="reader-actions">
    <a href={affiliateUrl} class="btn-book" rel="nofollow sponsored" target="_blank">
      {ctaText}
      <svg class="btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </a>
    <a href={`/reviews/${platform}/${slug}/`} class="btn-review">
      Full Review
    </a>
  </div>
</article>

<style>
  .reader-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    height: 100%;
    transition: all var(--transition-base);
    position: relative;
    overflow: hidden;
  }

  .reader-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-light);
    box-shadow: var(--shadow-lg);
  }

  .reader-card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Header Section */
  .reader-card-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-1);
  }

  .reader-avatar-wrapper {
    flex: 0 0 auto;
    position: relative;
  }

  .reader-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-bg-alt);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast);
  }

  .reader-card:hover .reader-avatar {
    transform: scale(1.05);
  }

  .reader-info {
    flex: 1;
    min-width: 0;
  }

  .reader-name {
    font-size: var(--text-lg);
    font-family: var(--font-heading);
    margin: 0 0 2px 0;
    line-height: 1.2;
  }

  .reader-name a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .reader-name a:hover {
    color: var(--color-primary);
  }

  .reader-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .reader-price {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-text-light);
    background: var(--color-bg-alt);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    letter-spacing: 0.02em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Verdict & Description */
  .reader-verdict {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .reader-best-for {
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  .best-for-label {
    display: block;
    font-weight: var(--weight-bold);
    color: var(--color-primary-dark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2px;
  }

  .best-for-value {
    color: var(--color-sage);
    margin: 0;
    font-weight: var(--weight-medium);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Offer Badge */
  .reader-offer {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--color-warning-bg);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-warning);
  }

  .offer-text {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-primary-dark);
  }

  /* Action Buttons */
  .reader-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-light);
  }

  .btn-book, .btn-review {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
    text-align: center;
  }

  .btn-book {
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-hover) 100%);
    color: #FFFFFF !important;
    text-decoration: none !important;
    white-space: nowrap;
    box-shadow: 0 2px 6px rgba(196, 149, 106, 0.2);
  }

  .btn-book:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(196, 149, 106, 0.3);
  }

  .btn-review {
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-primary-light);
  }

  .btn-review:hover {
    background: var(--color-bg-alt);
    border-color: var(--color-primary);
  }

  .btn-icon {
    transition: transform var(--transition-fast);
  }

  .btn-book:hover .btn-icon {
    transform: translateX(2px);
  }

  @media (max-width: 480px) {
    .reader-card {
      padding: var(--space-5);
    }

    .reader-actions {
      grid-template-columns: 1fr;
    }
  }
</style>
