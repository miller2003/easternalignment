---
/* Article card for the guides hub + topic pages (2026-10-02 redesign).
 * `featured` renders the wide hero variant used for a topic's lead guide. */
import { guideKind, formatDate, type HubGuide } from '../../lib/guideHub';

interface Props {
  guide: HubGuide;
  featured?: boolean;
  accent?: string;
  tint?: string;
  icon?: string;
}

const { guide, featured = false, accent = 'var(--color-primary)', tint = 'var(--color-bg-alt)', icon } = Astro.props;
const kind = guideKind(guide);
const date = formatDate(guide.date);
const rating = Number(guide.rating) || 0;
---

<a
  href={`/guides/${guide.slug}/`}
  class:list={['gcard', { 'gcard--featured': featured }]}
  data-kind={kind}
  style={`--accent:${accent};--tint:${tint}`}
>
  {featured && (
    <div class="gcard__visual" aria-hidden="true">
      {rating > 0 ? (
        <div class="gcard__score">
          <span class="gcard__score-num">{rating.toFixed(1)}</span>
          <span class="gcard__score-stars">★★★★★</span>
          {guide.platformName && <span class="gcard__score-plat">{guide.platformName}</span>}
        </div>
      ) : icon ? (
        <svg viewBox="0 0 24 24" class="gcard__visual-icon" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
      ) : null}
    </div>
  )}
  <div class="gcard__body">
    <div class="gcard__top">
      {featured && <span class="gcard__flag">Editor's pick</span>}
      <span class="gcard__kind">{kind}</span>
      {!featured && guide.platformName && <span class="gcard__plat">{guide.platformName}</span>}
    </div>
    <h3 class="gcard__title">{guide.title}</h3>
    {guide.description && <p class="gcard__desc">{guide.description}</p>}
    <div class="gcard__meta">
      <span>{guide.minutes} min read</span>
      {date && <><span class="gcard__dot" aria-hidden="true">·</span><span>Updated {date}</span></>}
      <span class="gcard__go" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </span>
    </div>
  </div>
</a>

<style>
  .gcard {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: var(--color-text);
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }
  .gcard::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--accent);
    opacity: 0;
    transition: opacity var(--transition-base);
  }
  .gcard:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--color-border));
  }
  .gcard:hover::before { opacity: 1; }
  .gcard:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .gcard__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
    padding: var(--space-6);
  }

  .gcard__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .gcard__kind,
  .gcard__plat,
  .gcard__flag {
    font-size: 0.7rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-full);
  }
  .gcard__kind {
    background: var(--tint);
    color: var(--accent);
  }
  .gcard__plat {
    background: var(--color-bg);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-light);
  }
  .gcard__flag {
    background: var(--accent);
    color: #fff;
  }

  .gcard__title {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.3rem;
    line-height: var(--leading-snug);
    color: var(--color-text);
    transition: color var(--transition-fast);
  }
  .gcard:hover .gcard__title { color: var(--accent); }

  .gcard__desc {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .gcard__meta {
    margin-top: auto;
    padding-top: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-light);
    border-top: 1px solid var(--color-border-light);
  }
  .gcard__dot { opacity: 0.6; }
  .gcard__go {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--tint);
    color: var(--accent);
    transition: transform var(--transition-base), background var(--transition-base), color var(--transition-base);
  }
  .gcard__go svg { width: 16px; height: 16px; }
  .gcard:hover .gcard__go {
    background: var(--accent);
    color: #fff;
    transform: translateX(2px);
  }

  /* ── Featured (wide) ── */
  .gcard--featured {
    flex-direction: row-reverse;
    border-color: color-mix(in srgb, var(--accent) 25%, var(--color-border));
  }
  .gcard--featured .gcard__body {
    padding: var(--space-8);
    gap: var(--space-4);
  }
  .gcard--featured .gcard__title { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.1rem); }
  .gcard--featured .gcard__desc {
    font-size: var(--text-base);
    -webkit-line-clamp: 4;
  }
  .gcard__visual {
    flex: 0 0 34%;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.7), transparent 60%),
      linear-gradient(150deg, var(--tint), color-mix(in srgb, var(--accent) 22%, var(--tint)));
    color: var(--accent);
  }
  .gcard__visual-icon {
    width: 45%;
    max-width: 140px;
    opacity: 0.85;
  }
  .gcard__score {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
  }
  .gcard__score-num {
    font-family: var(--font-heading);
    font-size: 4rem;
    line-height: 1;
    color: var(--accent);
  }
  .gcard__score-stars {
    color: var(--color-star);
    letter-spacing: 0.15em;
    font-size: 1.05rem;
  }
  .gcard__score-plat {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .gcard--featured { flex-direction: column; }
    .gcard__visual {
      flex: none;
      height: 112px;
    }
    .gcard__visual-icon { width: auto; height: 72px; }
    .gcard__score { flex-direction: row; gap: var(--space-3); }
    .gcard__score-num { font-size: 2.75rem; }
    .gcard__score-plat { margin-top: 0; }
    .gcard--featured .gcard__body { padding: var(--space-5); gap: var(--space-3); }
    .gcard--featured .gcard__desc { -webkit-line-clamp: 3; font-size: var(--text-sm); }
  }

  @media (max-width: 640px) {
    .gcard { border-radius: var(--radius-lg); }
    .gcard__body { padding: var(--space-5); gap: var(--space-2); }
    .gcard__title { font-size: 1.15rem; }
    .gcard__desc { -webkit-line-clamp: 2; }
    .gcard:hover { transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gcard, .gcard__go { transition: none; }
    .gcard:hover { transform: none; }
  }
</style>
