---
/**
 * EsTopOfferBar.astro — Barra promocional superior del subsitio /es
 * (espejo exacto de TopOfferBar.astro, copy en español).
 *
 * Comportamiento idéntico al original:
 *  - Consciente de plataforma: cada página promueve SU oferta.
 *  - Descartable (X); la elección persiste en sessionStorage.
 *  - Toda la barra es UN enlace /go/ (gated + tracked, data-cta-source="topbar").
 *  - Slim (40px escritorio / 36px móvil).
 *  - Sticky: el Header se estaciona DEBAJO de la barra vía --top-offer-h.
 */

import { ES_PLATFORM_OFFERS, esGoPath, esPlatformLogo, type EsPlatformKey } from '../../lib/esOffers';

interface Props {
  platform: EsPlatformKey;
}

const { platform } = Astro.props;
const offer = ES_PLATFORM_OFFERS[platform];
---

<!-- CLS: visible en SSR; si ya fue cerrada en esta sesión se oculta de forma síncrona. -->
<div class="top-offer-bar" id="top-offer-bar">
  <a
    href={esGoPath(platform)}
    class="top-offer-bar__link"
    rel="nofollow sponsored"
    target="_blank"
    data-cta-source="topbar"
  >
    <span class="top-offer-bar__gift" aria-hidden="true">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 12 20 22 4 22 4 12"></polyline>
        <rect x="2" y="7" width="20" height="5"></rect>
        <line x1="12" y1="22" x2="12" y2="7"></line>
        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
      </svg>
    </span>
    <img
      src={esPlatformLogo(platform)}
      alt=""
      class="top-offer-bar__logo"
      width="18"
      height="18"
      loading="lazy"
      aria-hidden="true"
    />
    <span class="top-offer-bar__text">{offer.topBarLine}</span>
    <span class="top-offer-bar__cta" aria-hidden="true">Aprovechar →</span>
  </a>
  <button
    type="button"
    class="top-offer-bar__close"
    id="top-offer-bar-close"
    aria-label="Cerrar oferta especial"
  >
    &times;
  </button>
</div>
<script is:inline>
  try { if (sessionStorage.getItem('ea_top_offer_dismissed') === '1') document.getElementById('top-offer-bar').setAttribute('hidden', ''); } catch (e) {}
</script>

<style is:global>
  :root { --top-offer-h: 40px; }
  @media (max-width: 640px) { :root { --top-offer-h: 36px; } }
</style>

<style>
  .top-offer-bar {
    position: sticky;
    top: 0;
    background: linear-gradient(90deg, var(--color-primary-dark, #6b5438) 0%, var(--color-accent, #c4956a) 100%);
    color: #ffffff;
    /* El Header tiene z-index 100; nos colocamos encima para que el header
       pase por DEBAJO al hacer scroll. */
    z-index: 110;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .top-offer-bar__link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    padding: 6px 44px 6px 16px;
    color: #ffffff;
    text-decoration: none;
    text-align: center;
    transition: background 0.15s ease;
  }

  .top-offer-bar__link:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  .top-offer-bar__gift {
    display: inline-flex;
    flex-shrink: 0;
  }

  .top-offer-bar__logo {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: #fff;
    padding: 1px;
    flex-shrink: 0;
  }

  .top-offer-bar__text {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .top-offer-bar__cta {
    flex-shrink: 0;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(255, 255, 255, 0.18);
    padding: 3px 10px;
    border-radius: 9999px;
  }

  .top-offer-bar__close {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.75);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    border-radius: 50%;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .top-offer-bar__close:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }

  @media (max-width: 640px) {
    .top-offer-bar__link {
      min-height: 36px;
      padding: 4px 36px 4px 12px;
      gap: 6px;
    }
    .top-offer-bar__cta { display: none; }
    .top-offer-bar__text {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-size: 12px;
      line-height: 1.2;
    }
    .top-offer-bar__logo { width: 16px; height: 16px; }
    .top-offer-bar__close { width: 28px; height: 28px; right: 4px; }
  }

  @media (max-width: 380px) {
    .top-offer-bar__gift { display: none; }
    .top-offer-bar__text { font-size: 11.5px; }
  }
</style>

<script>
  (function () {
    var bar = document.getElementById('top-offer-bar');
    var closeBtn = document.getElementById('top-offer-bar-close');
    if (!bar) return;
    var KEY = 'ea_top_offer_dismissed';
    var dismissed = false;
    try { dismissed = sessionStorage.getItem(KEY) === '1'; } catch (e) {}
    var root = document.documentElement;

    /*
       Protocolo de apilamiento sticky con el Header del sitio:
       ─ Header.site-header está DEBAJO de la barra en el DOM y es
         position:sticky. Su `top` lee --top-offer-h (en :root), así el
         header queda justo bajo la barra mientras esté visible, y sube a
         top:0 cuando el usuario la cierra.
       ─ Re-medimos en cada resize porque la altura difiere entre
         escritorio (40px) y móvil ≤640px (36px).
    */
    // 2026-10-03: sin leer offsetHeight en la carga (reflow forzado); la altura inicial
    // viene de los valores por defecto de --top-offer-h (40px / 36px en ≤640px).
    if (dismissed) bar.setAttribute('hidden', '');

    if (dismissed) root.style.setProperty('--top-offer-h', '0px');
    else if ('ResizeObserver' in window) {
      new ResizeObserver(function () {
        if (!bar.hasAttribute('hidden')) root.style.setProperty('--top-offer-h', bar.offsetHeight + 'px');
      }).observe(bar);
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        dismissed = true;
        bar.setAttribute('hidden', '');
        try { sessionStorage.setItem(KEY, '1'); } catch (err) {}
        root.style.setProperty('--top-offer-h', '0px');
      });
    }
  })();
</script>
