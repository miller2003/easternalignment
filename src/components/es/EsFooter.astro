---
/**
 * EsFooter — Spanish-only footer.
 * ALL links point to /es/... paths only.
 * Visual design mirrors main Footer (same CSS tokens).
 */
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-brand-col">
        <a href="/es/" class="footer-brand">
          <img src="/logo.jpg" alt="Eastern Alignment" class="brand-icon" width="32" height="32" loading="lazy" />
          <span class="brand-text">Eastern Alignment</span>
        </a>
        <p class="footer-tagline">
          Análisis independiente y reseñas honestas de servicios de lectura psíquica en línea. Evaluamos plataformas con datos reales de usuarios verificados.
        </p>
      </div>

      <!-- Reseñas Column -->
      <div class="footer-col">
        <h4 class="footer-heading">Reseñas de Plataformas</h4>
        <ul class="footer-links">
          <li><a href="/es/resenas/psiquicos-web/">Psíquicos Web</a></li>
          <li><a href="/es/resenas/purple-garden-es/">Purple Garden</a></li>
          <li><a href="/es/resenas/">Todas las Reseñas</a></li>
        </ul>
      </div>

      <!-- Información Column -->
      <div class="footer-col">
        <h4 class="footer-heading">Información</h4>
        <ul class="footer-links">
          <li><a href="/es/acerca-de/">Acerca de</a></li>
          <li><a href="/es/divulgacion/">Cómo Funciona Este Sitio</a></li>
          <li><a href="/es/privacidad/">Política de Privacidad</a></li>
          <li><a href="/es/terminos/">Términos de Uso</a></li>
        </ul>
      </div>
    </div>

    <hr class="footer-divider" />

    <!-- Mission Statement — Spanish, objective platform identity -->
    <div class="footer-disclosure">
      <p>
        <strong>Nuestra misión:</strong> Eastern Alignment es una plataforma de evaluación independiente de servicios psíquicos en línea. Nuestros análisis se basan en datos verificados de usuarios reales, historial documentado y métricas públicas de cada plataforma. <a href="/es/divulgacion/">Conoce cómo funcionamos</a>.
      </p>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {currentYear} Eastern Alignment. Todos los derechos reservados.
      </p>
      <p class="footer-disclaimer">
        Con fines informativos y de entretenimiento. No es sustituto de asesoramiento profesional.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-text);
    color: var(--color-celestial-light);
    padding: var(--space-12) 0 var(--space-6);
    margin-top: var(--space-12);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: var(--space-8);
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    margin-bottom: var(--space-4);
  }

  .footer-brand .brand-icon {
    width: 32px;
    height: 32px;
    object-fit: contain;
    mix-blend-mode: screen;
  }

  .footer-brand .brand-text {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--color-surface);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-celestial);
    max-width: 300px;
  }

  .footer-heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-light);
    margin-bottom: var(--space-4);
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .footer-links li { margin-bottom: 0; }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-sm);
    color: var(--color-celestial);
    text-decoration: none;
    transition: color var(--transition-fast);
    padding: 3px 0;
  }
  .footer-links a:hover { color: var(--color-accent-light); }

  .footer-divider {
    border: none;
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin: var(--space-6) 0 var(--space-4);
  }

  .footer-disclosure { margin-bottom: var(--space-6); }
  .footer-disclosure p {
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--color-text-light);
    max-width: 800px;
  }
  .footer-disclosure a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-copyright { font-size: var(--text-xs); color: var(--color-text-light); }
  .footer-disclaimer { font-size: var(--text-xs); color: var(--color-text-light); font-style: italic; }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
    .footer-brand-col { grid-column: 1 / -1; }
    .footer-bottom { flex-direction: column; text-align: center; }
  }

  @media (max-width: 480px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
