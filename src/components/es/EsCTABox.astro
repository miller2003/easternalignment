---
/**
 * EsCTABox — Spanish CTA box that wraps EsSpanishCTA.
 * Used at the end of reader reviews as an action block.
 */
import EsSpanishCTA from './EsSpanishCTA.astro';

interface Props {
  title: string;
  description?: string;
  platform: 'psiquicos' | 'purple-garden-es';
  ctaVariant?: 'default' | 'discount' | 'book' | 'explore' | 'custom';
  ctaLabel?: string;
  readerName?: string;
  readerSlug?: string;
  variant?: 'highlight' | 'plain';
}

const {
  title,
  description,
  platform,
  ctaVariant = 'default',
  ctaLabel,
  readerName,
  readerSlug,
  variant = 'highlight',
} = Astro.props;
---

<div class={`cta-box cta-box--${variant}`}>
  <div class="cta-box-inner">
    <h3 class="cta-box-title">{title}</h3>
    {description && <p class="cta-box-desc">{description}</p>}
    <EsSpanishCTA
      platform={platform}
      variant={ctaVariant}
      label={ctaLabel}
      readerName={readerName}
      readerSlug={readerSlug}
      size="lg"
      source="cta-box"
    />
  </div>
</div>

<style>
  .cta-box {
    margin: var(--space-8) 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .cta-box--highlight {
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, var(--color-sage-100, #f0faf4) 100%);
    border: 1px solid var(--color-sage, #4a8a6a);
    border-left: 4px solid var(--color-sage, #4a8a6a);
  }
  .cta-box--plain {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .cta-box-inner {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .cta-box-title {
    font-size: var(--text-xl);
    color: var(--color-text);
    margin: 0;
  }
  .cta-box-desc {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin: 0;
    line-height: var(--leading-relaxed);
  }
  @media (max-width: 600px) {
    .cta-box-inner { padding: var(--space-6); }
    .cta-box-inner .es-cta { width: 100%; text-align: center; justify-content: center; }
  }
</style>
