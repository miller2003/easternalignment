---
/**
 * TopOfferBar.astro — Site-wide top promo bar (mysticmag pattern).
 *
 * mysticmag runs a persistent full-width offer strip above the navigation
 * (gift icon + "<Platform> Special Offer" + the deal line with FREE in
 * caps). This is the highest-visibility CTA real estate on the site: it is
 * the first thing every visitor sees on every page, before any content.
 *
 * Behaviour:
 *  - Platform-aware: layouts pass the page's platform context, so a Kasamba
 *    page promotes the Kasamba deal, not a generic one.
 *  - Dismissible (X); the choice persists in sessionStorage.
 *  - The whole bar is ONE /go/ link (gated + tracked, data-cta-source="topbar").
 *  - Slim (40px desktop / 36px mobile) so it never fights the header.
 *  - Sticky at viewport top: when present the Header parks directly BELOW the
 *    bar (Header sticks at `top: var(--top-offer-h)`); when the user closes
 *    the bar, the script writes 0px into that var and the Header smoothly
 *    reclaims the top slot. See syncHeight() in the inline <script>.
 */

import { PLATFORM_OFFERS, goPath, platformLogo, type PlatformKey } from '../lib/offers';

interface Props {
  platform: PlatformKey;
}

const { platform } = Astro.props;
const offer = PLATFORM_OFFERS[platform];
---

<div class="top-offer-bar" id="top-offer-bar" hidden>
  <a
    href={goPath(platform)}
    class="top-offer-bar__link"
    rel="nofollow sponsored"
    target="_blank"
    data-cta-source="topbar"
  >
    <span class="top-offer-bar__gift" aria-hidden="true">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 12 20 22 4 22 4 12"></polyline>
        <rect x="2" y="7" width="20" height="5"></rect>
        <line x1="12" y1="22" x2="12" y2="7"></line>
        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
      </svg>
    </span>
    <img
      src={platformLogo(platform, 64)}
      alt=""
      class="top-offer-bar__logo"
      width="18"
      height="18"
      loading="lazy"
      aria-hidden="true"
    />
    <span class="top-offer-bar__text">{offer.topBarLine}</span>
    <span class="top-offer-bar__cta" aria-hidden="true">Claim →</span>
  </a>
  <button
    type="button"
    class="top-offer-bar__close"
    id="top-offer-bar-close"
    aria-label="Dismiss special offer"
  >
    &times;
  </button>
</div>

<style>
  .top-offer-bar {
    position: sticky;
    top: 0;
    background: linear-gradient(90deg, var(--color-primary-dark, #6b5438) 0%, var(--color-accent, #c4956a) 100%);
    color: #ffffff;
    /* Header is z-index 100; we sit above it so the header scrolls UNDER us. */
    z-index: 110;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .top-offer-bar__link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    padding: 6px 44px 6px 16px;
    color: #ffffff;
    text-decoration: none;
    text-align: center;
    transition: background 0.15s ease;
  }

  .top-offer-bar__link:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  .top-offer-bar__gift {
    display: inline-flex;
    flex-shrink: 0;
  }

  .top-offer-bar__logo {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: #fff;
    padding: 1px;
    flex-shrink: 0;
  }

  .top-offer-bar__text {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .top-offer-bar__cta {
    flex-shrink: 0;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(255, 255, 255, 0.18);
    padding: 3px 10px;
    border-radius: 9999px;
  }

  .top-offer-bar__close {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.75);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    border-radius: 50%;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .top-offer-bar__close:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }

  @media (max-width: 640px) {
    /* Pinned bar on mobile: keep it single-line + compact so it doesn't
       eat vertical real estate. Logo stays; CTA pill dropped; text ellipsis. */
    .top-offer-bar__link {
      min-height: 36px;
      padding: 4px 36px 4px 12px;
      gap: 6px;
    }
    .top-offer-bar__cta { display: none; }
    .top-offer-bar__text {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-size: 12px;
      line-height: 1.2;
    }
    .top-offer-bar__logo { width: 16px; height: 16px; }
    .top-offer-bar__close { width: 28px; height: 28px; right: 4px; }
  }

  @media (max-width: 380px) {
    /* Very small screens: drop the gift icon for headroom; trim font further. */
    .top-offer-bar__gift { display: none; }
    .top-offer-bar__text { font-size: 11.5px; }
  }
</style>

<script>
  (function () {
    var bar = document.getElementById('top-offer-bar');
    var closeBtn = document.getElementById('top-offer-bar-close');
    if (!bar) return;
    var KEY = 'ea_top_offer_dismissed';
    var dismissed = false;
    try { dismissed = sessionStorage.getItem(KEY) === '1'; } catch (e) {}
    var root = document.documentElement;

    /*
       Sticky-stacking protocol with the site Header:
       ─ Header.site-header sits BELOW the offer bar in the DOM and is itself
         position:sticky. Its `top` value reads --top-offer-h (set on :root),
         so when the offer bar is visible the header parks directly under it,
         and when the bar is closed the header slides up to top:0.
       ─ We re-measure on every resize because the bar's rendered height
         differs between desktop (40px) and mobile ≤640px (36px).
    */
    function syncHeight() {
      var h = (dismissed || bar.hasAttribute('hidden')) ? 0 : bar.offsetHeight;
      root.style.setProperty('--top-offer-h', h + 'px');
    }

    if (dismissed) {
      bar.setAttribute('hidden', '');
    } else {
      bar.removeAttribute('hidden');
    }

    // Sync after layout settles (font load, media-query swap, etc.)
    syncHeight();
    requestAnimationFrame(syncHeight);
    setTimeout(syncHeight, 250);
    window.addEventListener('resize', syncHeight, { passive: true });

    if (closeBtn) {
      closeBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        dismissed = true;
        bar.setAttribute('hidden', '');
        try { sessionStorage.setItem(KEY, '1'); } catch (err) {}
        syncHeight();
        requestAnimationFrame(syncHeight);
      });
    }
  })();
</script>
