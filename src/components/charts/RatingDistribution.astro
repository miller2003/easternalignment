---
/**
 * RatingDistribution — Pure SVG horizontal bar chart
 * Displays star rating breakdown (5★ to 1★) for a reader review.
 * Zero JS dependency. Server-rendered SVG.
 */
interface Props {
  /** Distribution array: [fiveStar, fourStar, threeStar, twoStar, oneStar] counts */
  distribution: [number, number, number, number, number];
  /** Total number of ratings (auto-calculated if omitted) */
  total?: number;
  /** Reader name for the caption */
  readerName?: string;
}

const { distribution, total: propTotal, readerName } = Astro.props;

const total = propTotal || distribution.reduce((a, b) => a + b, 0);
const maxCount = Math.max(...distribution);

const labels = ['5★', '4★', '3★', '2★', '1★'];
const colors = [
  '#6B8F5E', // 5-star — green
  '#7A8B6F', // 4-star — sage
  '#C4956A', // 3-star — accent
  '#B85C4A', // 2-star — muted red
  '#8B6F4E', // 1-star — primary
];

const barHeight = 22;
const barGap = 10;
const labelWidth = 36;
const countWidth = 56;
const chartPadding = { top: 16, right: 16, bottom: 16, left: 16 };
const barMaxWidth = 320;

const chartHeight = chartPadding.top + distribution.length * (barHeight + barGap) - barGap + chartPadding.bottom;
const chartWidth = chartPadding.left + labelWidth + barMaxWidth + countWidth + chartPadding.right;

const rows = distribution.map((count, i) => {
  const pct = total > 0 ? ((count / total) * 100).toFixed(1) : '0.0';
  const barWidth = maxCount > 0 ? (count / maxCount) * barMaxWidth : 0;
  const y = chartPadding.top + i * (barHeight + barGap);
  return {
    label: labels[i],
    count,
    pct,
    barWidth,
    y,
    color: colors[i],
  };
});
---

<figure class="rating-distribution" aria-label={`Rating distribution for ${readerName || 'reader'}`}>
  {readerName && (
    <figcaption class="rating-distribution__title">
      <span class="rating-distribution__label">Rating Breakdown</span>
      <span class="rating-distribution__subtitle">{total.toLocaleString()} verified ratings</span>
    </figcaption>
  )}

  <div class="rating-distribution__chart">
    <svg
      viewBox={`0 0 ${chartWidth} ${chartHeight}`}
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label={`${readerName || 'Reader'}: ${total} ratings. 5-star: ${distribution[0]}, 4-star: ${distribution[1]}, 3-star: ${distribution[2]}, 2-star: ${distribution[3]}, 1-star: ${distribution[4]}`}
    >
      {/* Background */}
      <rect x="0" y="0" width={chartWidth} height={chartHeight} rx="10" fill="var(--color-surface, #FFFFFF)" />

      {rows.map((row) => (
        <g>
          {/* Label */}
          <text
            x={chartPadding.left + labelWidth - 8}
            y={row.y + barHeight / 2 + 4}
            text-anchor="end"
            font-size="13"
            font-weight="600"
            fill="var(--color-text-muted, #7A746B)"
            font-family="Inter, system-ui, sans-serif"
          >{row.label}</text>

          {/* Track background */}
          <rect
            x={chartPadding.left + labelWidth}
            y={row.y}
            width={barMaxWidth}
            height={barHeight}
            rx={barHeight / 2}
            fill="var(--color-bg-alt, #F3EDE7)"
          />

          {/* Bar */}
          <rect
            x={chartPadding.left + labelWidth}
            y={row.y}
            width={Math.max(row.barWidth, 4)}
            height={barHeight}
            rx={barHeight / 2}
            fill={row.color}
            opacity="0.92"
          />

          {/* Count + percentage */}
          <text
            x={chartPadding.left + labelWidth + barMaxWidth + 10}
            y={row.y + barHeight / 2 + 4}
            font-size="12"
            font-weight="500"
            fill="var(--color-text, #2D2A26)"
            font-family="Inter, system-ui, sans-serif"
          >
            {row.count.toLocaleString()}
            <tspan font-size="11" fill="var(--color-text-light, #9E9689)"> ({row.pct}%)</tspan>
          </text>
        </g>
      ))}
    </svg>
  </div>
</figure>

<style>
  .rating-distribution {
    margin: var(--space-8) 0;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: box-shadow var(--transition-base);
  }

  .rating-distribution:hover {
    box-shadow: var(--shadow-md);
  }

  .rating-distribution__title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }

  .rating-distribution__label {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-text);
  }

  .rating-distribution__subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .rating-distribution__chart {
    width: 100%;
    max-width: 520px;
  }

  .rating-distribution__chart svg {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 640px) {
    .rating-distribution {
      padding: var(--space-4);
    }

    .rating-distribution__title {
      flex-direction: column;
      gap: var(--space-1);
    }
  }
</style>
