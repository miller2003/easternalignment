---
/**
 * SideOfferTab.astro — Slim right-edge offer tab (the whole CTA surface).
 *
 * History: this replaces BOTH the old full-width bottom bar (StickyCTA.astro,
 * which covered the last lines of every article) and the sliding SideDock
 * panel (over-designed — the expanding card was too much furniture for what
 * is fundamentally one link).
 *
 * What it is now: a single vertical tab pinned to the right edge of the
 * viewport, vertically centred, that IS the affiliate link. No panel, no
 * toggle, no scroll listener, no JavaScript at all.
 *
 * Why zero JS: the entrance is a CSS animation on the independent `translate`
 * property, which leaves `transform` / `scale` free for hover. Nothing can
 * fail, nothing waits on hydration, and the tab renders on first paint.
 *
 * Offer copy is never invented here — it is read from lib/offers.ts (the
 * single source of truth) so wording stays truthful site-wide. Keen's deal
 * is 5 minutes for $1, NOT free, so its tab copy says "$1" — never "free".
 */
interface Props {
  /** Affiliate deeplink slug including /go/ prefix and trailing slash. */
  slug?: string | null;
  /** Override for the vertical tab text (keep it short — it renders vertically). */
  label?: string;
  /** Platform context; sniffed from `slug` when omitted. */
  platform?: 'keen' | 'kasamba' | 'purple-garden' | null;
}

import { platformLogo, PLATFORM_OFFERS, PLATFORM_PRIORITY, goPath } from '../lib/offers';

const props = Astro.props as Props;
const explicitSlug = (props.slug ?? '').trim();

function detectPlatformFromSlug(slug: string): 'keen' | 'kasamba' | 'purple-garden' | null {
  const s = slug.toLowerCase();
  if (s.includes('kasamba')) return 'kasamba';
  if (s.includes('purple-garden') || s.includes('purplegarden')) return 'purple-garden';
  if (s.includes('keen')) return 'keen';
  return null;
}

/* Primary platform: explicit prop → sniffed from slug → site-wide No.1 (Kasamba). */
const key = (props.platform ?? detectPlatformFromSlug(explicitSlug) ?? PLATFORM_PRIORITY[0]) as
  | 'keen' | 'kasamba' | 'purple-garden';

const primary = PLATFORM_OFFERS[key];
const href = explicitSlug || goPath(key);

/* ── Tab copy ────────────────────────────────────────────────────────────────
   Concrete, not a vague invitation ("Have a try"). A 40px-wide vertical tab
   has one job: say exactly what you get. Override per page via `label`. ── */
const defaultLabels: Record<'keen' | 'kasamba' | 'purple-garden', string> = {
  kasamba: '3 Free Minutes',
  'purple-garden': '$30 Free Credit',
  keen: '5 Min for $1',
};

const label = (props.label && props.label.trim()) || defaultLabels[key];
const ctaSource = `side-tab-${primary.goSlug}`;
---

<a
  class="side-tab"
  id="side-offer-tab"
  href={href}
  target="_blank"
  rel="nofollow sponsored"
  data-cta-source={ctaSource}
  aria-label={`${primary.name} new-client offer: ${primary.offer} (opens in a new tab)`}
>
  <img
    class="side-tab__logo"
    src={platformLogo(key, 64)}
    alt=""
    width="24"
    height="24"
    loading="lazy"
    aria-hidden="true"
  />
  <span class="side-tab__label">{label}</span>
  <svg class="side-tab__arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M5.5 10.5L10.5 5.5M6.4 5.5h4.1v4.1" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>

<style>
  .side-tab {
    position: fixed;
    top: 50%;
    right: 0;
    z-index: 70;

    /* Entrance: parked off-screen, then slides in once. Animating the
       independent `translate` property keeps `transform` free for hover. */
    translate: 100% -50%;
    animation: sd-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.55s forwards;

    width: 40px;
    min-height: 168px;
    padding: 14px 0 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;

    border-radius: 13px 0 0 13px;
    background: linear-gradient(168deg, #8b6f4e 0%, #6b5438 60%, #54402a 100%);
    color: #ffffff;
    text-decoration: none;
    overflow: hidden;
    box-shadow:
      inset 1px 0 0 rgba(255, 255, 255, 0.16),
      -8px 0 22px rgba(84, 64, 42, 0.20);
    transition: filter 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease, scale 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  @keyframes sd-in { to { translate: 0 -50%; } }

  .side-tab:hover {
    filter: brightness(1.09);
    transform: translateX(-3px);
    box-shadow:
      inset 1px 0 0 rgba(255, 255, 255, 0.2),
      -12px 0 30px rgba(84, 64, 42, 0.28);
  }
  .side-tab:active { scale: 0.97; }
  .side-tab:focus-visible { outline: 2px solid #e8cdb0; outline-offset: -4px; }

  /* Slow light sweep across the tab — catches the eye once, never blinks. */
  .side-tab::after {
    content: '';
    position: absolute;
    inset: -30% -60%;
    background: linear-gradient(
      100deg,
      transparent 34%,
      rgba(255, 255, 255, 0.22) 48%,
      transparent 62%
    );
    animation: sd-sweep 5.2s ease-in-out 1.6s infinite;
    pointer-events: none;
  }
  @keyframes sd-sweep {
    0%        { transform: translateY(-70%); }
    38%, 100% { transform: translateY(70%); }
  }

  .side-tab__logo {
    width: 24px;
    height: 24px;
    border-radius: 8px;
    background: #ffffff;
    padding: 2px;
    flex-shrink: 0;
    box-shadow: 0 1px 4px rgba(40, 28, 16, 0.28);
  }

  .side-tab__label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);   /* reads bottom-to-top, the right-edge convention */
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    white-space: nowrap;
    text-shadow: 0 1px 2px rgba(40, 28, 16, 0.35);
  }

  .side-tab__arrow {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    opacity: 0.85;
  }

  @media (max-width: 600px) {
    .side-tab { width: 36px; min-height: 152px; }
    .side-tab__label { font-size: 11.5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .side-tab { animation: none; translate: 0 -50%; }
    .side-tab::after { animation: none; }
  }
</style>
