---
/**
 * SideOfferTab.astro — Slim edge-docked offer tab (the whole CTA surface).
 *
 * What it is: a single vertical tab docked to a screen edge that IS the
 * affiliate link. No panel, no toggle UI.
 *
 * Mobile interaction model (2026-09-06, user directive — full AssistiveTouch):
 *   • GLOBAL DRAG: the tab follows the finger 1:1 anywhere on screen
 *     (Pointer Events + capture, transitions killed while dragging). On
 *     release it springs — on an iOS-style curve (0.32, 0.72, 0, 1) — to
 *     the NEAREST edge, left or right. Vertical drags reposition it along
 *     the docked edge with rubber-band resistance past the clamps.
 *   • TUCK: pushing the tab INTO its docked edge (or flicking toward it)
 *     hides all but a 14px handle with a chevron grip. Tap the handle →
 *     springs back out. A pull away from the edge peels it back out live.
 *   • DEFAULT is fully expanded on the right edge — the offer is the point
 *     of the element. Collapse/re-dock NEVER happens automatically; only
 *     explicit gestures change state. side + y + tucked persist in
 *     sessionStorage, so the tab never plays hide-and-seek per navigation.
 *   • LEFT DOCK mirrors everything: corner radius, grip side + chevron
 *     direction, hairline/shadow direction, and the vertical label flips
 *     to read top-to-bottom (the left-edge convention).
 *   • Tap on the expanded tab navigates (plain <a target="_blank">); taps
 *     are separated from drags by a 9px / 500ms threshold.
 *   • No entrance fly-in, no light sweep, no sticky :hover on touch.
 *
 * Fallbacks: without JS (or on desktop) the tab stays on the right edge —
 * CSS bottom anchor (Android) / `.side-tab--ios` top anchor (iOS), entrance
 * animation and sweep intact on desktop.
 *
 * Offer copy is never invented here — it is read from lib/offers.ts (the
 * single source of truth) so wording stays truthful site-wide. Keen's deal
 * is 5 minutes for $1, NOT free, so its tab copy says "$1" — never "free".
 */
interface Props {
  /** Affiliate deeplink slug including /go/ prefix and trailing slash. */
  slug?: string | null;
  /** Override for the vertical tab text (keep it short — it renders vertically). */
  label?: string;
  /** Platform context; sniffed from `slug` when omitted. */
  platform?: 'keen' | 'kasamba' | 'purple-garden' | null;
}

import { platformLogo, PLATFORM_OFFERS, PLATFORM_PRIORITY, goPath } from '../lib/offers';

const props = Astro.props as Props;
const explicitSlug = (props.slug ?? '').trim();

function detectPlatformFromSlug(slug: string): 'keen' | 'kasamba' | 'purple-garden' | null {
  const s = slug.toLowerCase();
  if (s.includes('kasamba')) return 'kasamba';
  if (s.includes('purple-garden') || s.includes('purplegarden')) return 'purple-garden';
  if (s.includes('keen')) return 'keen';
  return null;
}

/* Primary platform: explicit prop → sniffed from slug → site-wide No.1 (Kasamba). */
const key = (props.platform ?? detectPlatformFromSlug(explicitSlug) ?? PLATFORM_PRIORITY[0]) as
  | 'keen' | 'kasamba' | 'purple-garden';

const primary = PLATFORM_OFFERS[key];
const href = explicitSlug || goPath(key);

/* ── Tab copy ────────────────────────────────────────────────────────────────
   Concrete, not a vague invitation. A 40px-wide vertical tab has one job:
   say exactly what you get. Override per page via `label`. A label may be a
   [string, string] pair: two SHORT vertical lines side by side, which keeps
   the tab compact when the offer carries two facts (free mins + discount). ── */
const defaultLabels: Record<'keen' | 'kasamba' | 'purple-garden', string | [string, string]> = {
  kasamba: ['3 FREE MINS', '+50% OFF'],
  'purple-garden': '$30 Free Credit',
  keen: '5 Min for $1',
};

const rawLabel = (props.label && props.label.trim()) || defaultLabels[key];
const labelLines = Array.isArray(rawLabel) ? rawLabel : [rawLabel];
const ctaSource = `side-tab-${primary.goSlug}`;
---

<a
  class="side-tab"
  id="side-offer-tab"
  href={href}
  target="_blank"
  rel="nofollow sponsored"
  data-cta-source={ctaSource}
  aria-label={`${primary.name} new-client offer: ${primary.offer} (opens in a new tab)`}
>
  <img
    class="side-tab__logo"
    src={platformLogo(key, 64)}
    alt=""
    width="24"
    height="24"
    loading="lazy"
    aria-hidden="true"
  />
  <span class:list={['side-tab__label', { 'side-tab__label--dual': labelLines.length > 1 }]}>
    {labelLines.map(line => <span class="side-tab__label-line">{line}</span>)}
  </span>
  <svg class="side-tab__arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M5.5 10.5L10.5 5.5M6.4 5.5h4.1v4.1" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <svg class="side-tab__grip" viewBox="0 0 9 16" aria-hidden="true" focusable="false">
    <path d="M6.5 2.5 L1.8 8 L6.5 13.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>

<script is:inline>
  (function () {
    var tab = document.getElementById('side-offer-tab');
    if (!tab) return;

    var isNarrow = window.matchMedia('(max-width: 768px)').matches;
    var isTouch = window.matchMedia('(pointer: coarse)').matches;

    /* The UA class only drives the no-JS fallback anchor (iOS gets a top
       anchor because its collapsing toolbar sits at the bottom). */
    var ua = navigator.userAgent || '';
    var isIOS = /iPad|iPhone|iPod/.test(ua) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    if (isIOS) tab.classList.add('side-tab--ios');

    if (!isNarrow || !isTouch) return; /* desktop: CSS-only, unchanged */

    /* ── Touch interaction engine (full AssistiveTouch model) ─────────────
       One coordinate space: `left` px from the viewport's left edge, so the
       tab can travel the whole screen. State: side + y + tucked. While a
       finger is down, transitions are off and the tab tracks 1:1; on
       release it springs to the nearest edge. */
    var KEY = 'ea_side_tab_v1';
    var TUCK = 22; /* px hidden when tucked: 36px tab - 14px handle */

    function W() { return window.innerWidth; }
    function H() { return window.innerHeight; }
    function tw() { return tab.offsetWidth || 36; }
    function tabH() { return tab.offsetHeight || 130; }
    function minY() { return 96; } /* below the sticky offer-bar + header */
    function maxY() { return Math.max(minY(), H() - tabH() - 16); }
    function clamp(v, a, b) { return v < a ? a : (v > b ? b : v); }
    function defaultY() {
      if (isIOS) return Math.round(H() * 0.42);
      /* mirror the old CSS rule: bottom offset = max(6.5rem, 15vh) */
      return Math.round(H() - Math.max(104, H() * 0.15) - tabH());
    }
    function dockX(side, tucked) {
      return side === 'right'
        ? (tucked ? W() - tw() + TUCK : W() - tw())
        : (tucked ? -TUCK : 0);
    }

    var restored = null;
    try { restored = JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch (e) {}
    var side = (restored && restored.side === 'left') ? 'left' : 'right';
    var y = (restored && typeof restored.y === 'number')
      ? clamp(restored.y, minY(), maxY())
      : clamp(defaultY(), minY(), maxY());
    var tucked = !!(restored && restored.tucked);

    function save() {
      try { sessionStorage.setItem(KEY, JSON.stringify({ side: side, y: Math.round(y), tucked: tucked })); } catch (e) {}
    }
    function render() {
      tab.style.left = Math.round(dockX(side, tucked)) + 'px';
      tab.style.top = Math.round(y) + 'px';
      tab.dataset.side = side;
      tab.dataset.tucked = tucked ? 'true' : 'false';
    }

    tab.classList.add('side-tab--js');
    tab.dataset.boot = 'true';   /* suppress transitions until after first paint */
    render();
    /* Two frames later the spring physics come online for gestures — the
       tab must APPEAR at its restored state, never glide there on load. */
    requestAnimationFrame(function () {
      requestAnimationFrame(function () { tab.dataset.boot = 'false'; });
    });

    var pid = null, dragging = false;
    var sx = 0, sy = 0, baseX = 0, baseY = 0, moved = 0, t0 = 0;
    var curX = 0, lastPX = 0, lastPY = 0, lastT = 0, vX = 0, vY = 0;

    /* Floating state: while the tab is away from a dock (mid-drag, or
       gliding to one), it wears a fully rounded shape; the flush one-sided
       radius returns once the spring has landed. */
    var floatTimer = null;
    function setFloating(on) {
      if (floatTimer) { clearTimeout(floatTimer); floatTimer = null; }
      tab.dataset.floating = on ? 'true' : 'false';
    }
    function dockSoon() {
      if (floatTimer) clearTimeout(floatTimer);
      floatTimer = setTimeout(function () {
        tab.dataset.floating = 'false';
        floatTimer = null;
      }, 480); /* slightly past the 0.42s spring so it stays rounded mid-glide */
    }

    tab.addEventListener('pointerdown', function (e) {
      if (!e.isPrimary || dragging) return;
      pid = e.pointerId;
      try { tab.setPointerCapture(pid); } catch (err) {}
      sx = e.clientX; sy = e.clientY;
      baseX = dockX(side, tucked); baseY = y;
      curX = baseX;
      moved = 0; t0 = performance.now();
      lastPX = sx; lastPY = sy; lastT = t0; vX = 0; vY = 0;
      dragging = true;
      tab.dataset.dragging = 'true';
      setFloating(true);
    });

    tab.addEventListener('pointermove', function (e) {
      if (!dragging || e.pointerId !== pid) return;
      var dx = e.clientX - sx, dy = e.clientY - sy;
      var total = Math.abs(dx) + Math.abs(dy);
      if (total > moved) moved = total;

      /* horizontal: 1:1 global follow, clamped so the tab never leaves
         the screen further than its tucked position on either edge. */
      curX = clamp(baseX + dx, -TUCK, W() - tw() + TUCK);

      /* vertical: 1:1 follow, rubber-band resistance past the clamps */
      var raw = baseY + dy, ny;
      if (raw < minY()) ny = minY() - (minY() - raw) * 0.28;
      else if (raw > maxY()) ny = maxY() + (raw - maxY()) * 0.28;
      else ny = raw;
      y = ny;

      tab.style.left = Math.round(curX) + 'px';
      tab.style.top = Math.round(y) + 'px';

      var now = performance.now(), dt = now - lastT;
      if (dt > 0) {
        vX = 0.7 * vX + 0.3 * ((e.clientX - lastPX) / dt);
        vY = 0.7 * vY + 0.3 * ((e.clientY - lastPY) / dt);
      }
      lastPX = e.clientX; lastPY = e.clientY; lastT = now;
    });

    function finish(e) {
      if (!dragging || (e && e.pointerId !== pid)) return;
      dragging = false;
      tab.dataset.dragging = 'false';

      var dt = performance.now() - t0;
      var isTap = moved < 9 && dt < 500;

      if (isTap) {
        /* snap back from any rubber-band offset; click handler does the rest */
        y = clamp(y, minY(), maxY());
        render();
        dockSoon();
        return;
      }

      /* settle vertical with a hint of momentum, then clamp hard */
      y = clamp(y + vY * 90, minY(), maxY());

      /* horizontal: project the flick, dock to the nearest edge. A gesture
         that ends INTO the edge becomes a tuck; anything else stays
         expanded. Thresholds are deliberately forgiving (curved-screen
         edges make long edge swipes laborious), yet sit well outside the
         9px tap zone so taps never misfire. */
      var expandedW = W() - tw();
      var proj = curX + vX * 160;
      if (proj <= expandedW / 2) {
        side = 'left';
        tucked = proj < -8;
      } else {
        side = 'right';
        tucked = proj > expandedW + 8;
      }
      render();
      save();
      dockSoon();
    }

    tab.addEventListener('pointerup', finish);
    tab.addEventListener('pointercancel', finish);

    tab.addEventListener('click', function (e) {
      if (moved >= 9) {                       /* it was a drag, not a tap */
        e.preventDefault();
        e.stopPropagation();
        moved = 0;
        return;
      }
      if (tucked) {                           /* tap on the handle: spring out */
        e.preventDefault();
        e.stopPropagation();
        tucked = false;
        render();
        save();
      }
      /* expanded tap: default <a target="_blank"> navigation proceeds */
    });

    window.addEventListener('resize', function () {
      y = clamp(y, minY(), maxY());
      render();
    }, { passive: true });
  })();
</script>

<style>
  .side-tab {
    position: fixed;
    top: 50%;
    right: 0;
    z-index: 70;

    /* Entrance: parked off-screen, then slides in once. Animating the
       independent `translate` property keeps `transform` free for hover. */
    translate: 100% -50%;
    animation: sd-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0s forwards;

    width: 40px;
    min-height: 168px;
    padding: 14px 0 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;

    border-radius: 14px 0 0 14px;
    background: linear-gradient(165deg, #8f7350 0%, #6b5438 55%, #4f3c26 100%);
    color: #ffffff;
    text-decoration: none;
    overflow: hidden;
    box-shadow:
      inset 1px 0 0 rgba(255, 255, 255, 0.16),
      0 10px 28px rgba(61, 43, 24, 0.22),
      0 2px 8px rgba(61, 43, 24, 0.14);
    transition: filter 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease, scale 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  @keyframes sd-in { to { translate: 0 -50%; } }

  /* Hover only where hover truly exists — touch devices keep no sticky state. */
  @media (hover: hover) and (pointer: fine) {
    .side-tab:hover {
      filter: brightness(1.09);
      transform: translateX(-3px);
      box-shadow:
        inset 1px 0 0 rgba(255, 255, 255, 0.2),
        0 14px 34px rgba(61, 43, 24, 0.28),
        0 3px 10px rgba(61, 43, 24, 0.16);
    }
  }
  .side-tab:active { scale: 0.96; }
  .side-tab:focus-visible { outline: 2px solid #e8cdb0; outline-offset: -4px; }

  /* Slow light sweep across the tab — catches the eye once, never blinks.
     Desktop only: on mobile it costs permanent GPU compositing on a fixed
     element, which is felt as scroll jank. */
  .side-tab::after {
    content: '';
    position: absolute;
    inset: -30% -60%;
    background: linear-gradient(
      100deg,
      transparent 34%,
      rgba(255, 255, 255, 0.22) 48%,
      transparent 62%
    );
    animation: sd-sweep 5.2s ease-in-out 1.6s infinite;
    pointer-events: none;
  }
  @keyframes sd-sweep {
    0%        { transform: translateY(-70%); }
    38%, 100% { transform: translateY(70%); }
  }

  .side-tab__logo {
    width: 24px;
    height: 24px;
    border-radius: 8px;
    background: #ffffff;
    padding: 2px;
    flex-shrink: 0;
    box-shadow: 0 1px 4px rgba(40, 28, 16, 0.28);
  }

  .side-tab__label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1px;
    font-family: var(--font-body);
  }
  .side-tab__label-line {
    writing-mode: vertical-rl;
    transform: rotate(180deg);   /* reads bottom-to-top, the right-edge convention */
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    white-space: nowrap;
    text-shadow: 0 1px 2px rgba(40, 28, 16, 0.35);
  }
  /* Dual-line labels run slightly smaller with tight leading so the two
     columns sit close together and the block stays short. */
  .side-tab__label--dual .side-tab__label-line {
    font-size: 11.5px;
    letter-spacing: 0.05em;
    line-height: 1.05;
  }

  .side-tab__arrow {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    opacity: 0.85;
  }

  /* Chevron grip shown only in the tucked (handle) state — see mobile rules. */
  .side-tab__grip { display: none; }

  /* ── Mobile: right-edge anchored by default (Android-friendly); iOS gets
     the top anchor via `.side-tab--ios`. With JS the tab switches to
     explicit px positioning (`--js`) and becomes globally draggable —
     see the inline script for the full interaction model.

     The tab stays fully expanded by default (collapse/re-dock is
     user-initiated only). At 36px wide it overlaps the last ~20px of the
     text column on mobile; that is accepted deliberately — indenting the
     article to make room was rejected because it wrecked the left/right
     symmetry. ── */
  @media (max-width: 768px) {
    .side-tab {
      top: auto;
      bottom: calc(max(6.5rem, 15vh) + env(safe-area-inset-bottom, 0px));
      right: env(safe-area-inset-right, 0px);
      translate: none;
      animation: none;                 /* appear instantly — no per-page fly-in */
      width: 36px;
      min-height: 0;                   /* content-sized: dual-line label stays compact */
      padding: 12px 0;
      gap: 8px;
      touch-action: none;              /* the tab owns its gestures */
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: none;
    }

    .side-tab::after { display: none; }  /* no sweep on mobile (GPU/jank) */
    .side-tab__arrow { display: none; }  /* arrow costs 23px of vertical space */

    /* iOS Safari (incl. iPadOS) keeps its address bar at the BOTTOM, so the
       no-JS fallback anchors to the top where iOS never moves the viewport
       edge. */
    .side-tab--ios {
      top: 42vh;
      bottom: auto;
    }

    /* JS engine active: explicit px left/top + iOS-style spring transitions.
       Layout-property transitions are fine here — the element is a 36px
       fixed chip with its own compositor layer. */
    .side-tab--js {
      top: 0;
      bottom: auto;
      right: auto;
      left: 0;
      transition:
        top 0.42s cubic-bezier(0.32, 0.72, 0, 1),
        left 0.42s cubic-bezier(0.32, 0.72, 0, 1),
        transform 0.42s cubic-bezier(0.32, 0.72, 0, 1),
        box-shadow 0.3s ease,
        opacity 0.3s ease,
        border-radius 0.25s ease;
      will-change: top, left;
    }
    .side-tab--js[data-dragging="true"] {
      transition: none;                /* direct manipulation: 1:1 finger track */
    }
    .side-tab--js[data-boot="true"] {
      transition: none !important;     /* page load: appear AT the restored state */
    }

    /* Tucked handle: quieter shadow, slight transparency (idle AssistiveTouch
       look), plus an invisible ::before that widens the 14px handle's tap
       area so it stays easy to hit. */
    .side-tab--js[data-tucked="true"] {
      opacity: 0.88;
      box-shadow:
        inset 1px 0 0 rgba(255, 255, 255, 0.16),
        -3px 0 12px rgba(61, 43, 24, 0.18);
    }
    .side-tab--js[data-tucked="true"]::before {
      content: '';
      position: absolute;
      inset: -6px 0 -6px -14px;
    }
    .side-tab--js[data-tucked="true"] .side-tab__grip {
      display: block;
      position: absolute;
      left: 2.5px;
      top: 50%;
      translate: 0 -50%;
      width: 9px;
      height: 16px;
      opacity: 0.75;
    }

    /* ── Left-edge docking: mirror the chrome. Radius flips to the inner
       (right) side, hairline/shadow flip direction, the grip moves to the
       right with a mirrored chevron, and the vertical label flips to read
       top-to-bottom (the left-edge convention). ── */
    .side-tab--js[data-side="left"] {
      border-radius: 0 14px 14px 0;
      box-shadow:
        inset -1px 0 0 rgba(255, 255, 255, 0.16),
        0 10px 28px rgba(61, 43, 24, 0.22),
        0 2px 8px rgba(61, 43, 24, 0.14);
    }
    .side-tab--js[data-side="left"][data-tucked="true"] {
      box-shadow:
        inset -1px 0 0 rgba(255, 255, 255, 0.16),
        3px 0 12px rgba(61, 43, 24, 0.18);
    }
    .side-tab--js[data-side="left"][data-tucked="true"]::before {
      inset: -6px -14px -6px 0;
    }
    .side-tab--js[data-side="left"] .side-tab__grip {
      left: auto;
      right: 2.5px;
      transform: scaleX(-1);
    }
    .side-tab--js[data-side="left"] .side-tab__label-line {
      transform: rotate(0deg);
    }

    /* Mid-drag (or gliding toward a dock) the tab is floating free of
       either edge, so it renders as a fully rounded chip — the flush,
       one-sided radius only returns once it has docked. Placed after the
       per-side radius rules so it wins for BOTH dock sides. */
    .side-tab--js[data-floating="true"] {
      border-radius: 14px;
    }

    @media (prefers-reduced-motion: reduce) {
      .side-tab--js { transition: none; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .side-tab { animation: none; }
    .side-tab::after { animation: none; }
  }
</style>
