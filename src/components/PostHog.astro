---
const POSTHOG_KEY = import.meta.env.PUBLIC_POSTHOG_KEY || 'REPLACE_ME_POSTHOG_KEY';
const POSTHOG_HOST = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com';
---

<script is:inline define:vars={{ POSTHOG_KEY, POSTHOG_HOST }}>
  if (POSTHOG_KEY !== 'REPLACE_ME_POSTHOG_KEY') {
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys onSessionId setPersonProperties".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
    posthog.init(POSTHOG_KEY, {
      api_host: POSTHOG_HOST,
      person_profiles: 'identified_only', // or 'always' to create profiles for anonymous users as well
      autocapture: true,
      capture_pageview: true
    });

    // ── Affiliate click gating + per-page attribution ──────────────────────
    // We ONLY treat a click as a real affiliate click when:
    //   1. it is a trusted, human-initiated event (e.isTrusted === true)
    //   2. the link points at one of our /go/ affiliate slugs
    // Bots, prefetches, and scripted clicks never reach the affiliate URL,
    // so the affiliate network stops counting fake clicks. We then navigate
    // to /go/<slug>/ which performs the actual (TUNE) redirect for real users.
    document.addEventListener('DOMContentLoaded', () => {
      document.body.addEventListener('click', (e) => {
        if (!e.isTrusted) return;                 // ignore non-human / synthetic clicks
        const link = e.target.closest('a');
        if (!link) return;
        const href = link.getAttribute('href') || '';
        const m = href.match(/\/go\/([^/?#]+)/);
        if (!m) return;                           // not an affiliate link -> let it behave normally
        const slug = m[1];

        e.preventDefault();                        // take over navigation (bot-proof)

        // Mark this session so the /go/ page knows it's a genuine click.
        try { sessionStorage.setItem('ea_aff_click', slug); } catch (_) {}

        const distinctId = (window.posthog && typeof posthog.get_distinct_id === 'function')
          ? posthog.get_distinct_id()
          : '';

        // CTA placement attribution: where on the page the click originated
        // (hero | end | sticky | sidebar | inline). Falls back to 'unknown'.
        const ctaSource = link.getAttribute('data-cta-source')
          || (link.closest('[data-cta-source]') && link.closest('[data-cta-source]').getAttribute('data-cta-source'))
          || 'unknown';

        // Per-page attribution: location = the page the click came FROM.
        if (window.posthog) {
          posthog.capture('affiliate_link_click', {
            slug: slug,
            location: window.location.pathname,
            ctaSource: ctaSource,
            target_blank: link.target === '_blank',
            text: (link.innerText || '').trim().slice(0, 80),
            click_id: distinctId || null
          });
        }

        // Route through /go/<slug>/ (which does the real TUNE redirect).
        // The ?ea_sub=<id> token proves this is a genuine click; the /go/ page
        // also accepts a same-origin referrer, so we keep it (no `noreferrer`).
        const dest = '/go/' + slug + '/' + (distinctId ? ('?ea_sub=' + encodeURIComponent(distinctId)) : '');
        if (link.target === '_blank') {
          window.open(dest, '_blank', 'noopener');
        } else {
          window.location.href = dest;
        }
      });
    });
  } else {
    console.warn("PostHog Analytics: PUBLIC_POSTHOG_KEY is not set. Analytics disabled.");
  }
</script>
