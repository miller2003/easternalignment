---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <!-- Main Footer Content -->
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-brand-col">
        <a href="/" class="footer-brand">
          <img src="/logo.jpg" alt="EasternAlignment Logo" class="brand-icon" width="32" height="32" loading="lazy" />
          <span class="brand-text">EasternAlignment</span>
        </a>
        <p class="footer-tagline">
          Honest reviews and guidance to help you find the right psychic reading service. I've personally tested every platform I recommend.
        </p>
      </div>

      <!-- Explore Column -->
      <div class="footer-col">
        <h4 class="footer-heading">Explore</h4>
        <ul class="footer-links">
          <li><a href="/reviews/">Platform Reviews</a></li>
          <li><a href="/comparisons/">Comparisons</a></li>
          <li><a href="/guides/">Guides & Resources</a></li>
          <li><a href="/blogs/">Blog</a></li>
        </ul>
      </div>

      <!-- About Column -->
      <div class="footer-col">
        <h4 class="footer-heading">About</h4>
        <ul class="footer-links">
          <li><a href="/about/">About Sarah</a></li>
          <li><a href="/disclosure/">How This Site Works</a></li>
          <li><a href="mailto:sarah@easternalignment.com">Contact</a></li>
        </ul>
      </div>

      <!-- Legal Column -->
      <div class="footer-col">
        <h4 class="footer-heading">Legal</h4>
        <ul class="footer-links">
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Use</a></li>
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <hr class="footer-divider" />

    <!-- Mission Statement -->
    <div class="footer-disclosure">
      <p>
        <strong>My Mission:</strong> I built EasternAlignment because I was tired of fake "review" sites that are just ads in disguise. Every review here is based on my real experience — paid for with my own money, with no special treatment from platforms. If a platform is bad, I'll tell you. <a href="/disclosure/">Here's how it works</a>.
      </p>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {currentYear} EasternAlignment. All rights reserved.
      </p>
      <p class="footer-disclaimer">
        For entertainment purposes. Not a substitute for professional advice.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-text);
    color: var(--color-celestial-light);
    padding: var(--space-16) 0 var(--space-8);
    margin-top: var(--space-24);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: var(--space-10);
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    margin-bottom: var(--space-4);
  }

  .footer-brand .brand-icon {
    width: 32px;
    height: 32px;
    object-fit: contain;
    mix-blend-mode: screen; /* blends white bg against dark footer */
  }

  .footer-brand .brand-text {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--color-surface);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-celestial);
    max-width: 300px;
  }

  .footer-heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-light);
    margin-bottom: var(--space-4);
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-links li {
    margin-bottom: var(--space-2);
  }

  .footer-links a {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--color-celestial);
    text-decoration: none;
    transition: color var(--transition-fast);
    min-height: 44px;
    line-height: 44px;
  }

  .footer-links a:hover {
    color: var(--color-accent-light);
  }

  .footer-divider {
    border: none;
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin: var(--space-10) 0 var(--space-6);
  }

  .footer-disclosure {
    margin-bottom: var(--space-6);
  }

  .footer-disclosure p {
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--color-text-light);
    max-width: 800px;
  }

  .footer-disclosure a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-copyright {
    font-size: var(--text-xs);
    color: var(--color-text-light);
  }

  .footer-disclaimer {
    font-size: var(--text-xs);
    color: var(--color-text-light);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }

    .footer-brand-col {
      grid-column: 1 / -1;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
