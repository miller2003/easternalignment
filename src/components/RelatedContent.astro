---
/**
 * RelatedContent — Cross-linking section shown at the bottom of pages.
 * Displays related guides, platform reviews, and reader reviews
 * to maximize internal linking and session duration.
 */

interface RelatedItem {
  title: string;
  href: string;
  description?: string;
  badge?: string;
  badgeVariant?: 'primary' | 'sage' | 'outline';
}

interface Props {
  title?: string;
  items: RelatedItem[];
  columns?: 1 | 2;
  hideBorder?: boolean;
}

const {
  title = 'Continue Reading',
  items,
  columns = 2,
  hideBorder = false,
} = Astro.props;
---

{items.length > 0 && (
  <section class:list={['related-content', { 'related-content--no-border': hideBorder }]} aria-label={title}>
    <h2 class="related-title">{title}</h2>
    <div class:list={['related-grid', `related-grid--${columns}`]}>
      {items.map(item => (
        <a href={item.href} class="related-card" id={`related-${item.href.replace(/\//g, '-').slice(1, -1)}`}>
          {item.badge && (
            <span class:list={['badge', `badge--${item.badgeVariant || 'sage'}`]}>{item.badge}</span>
          )}
          <h3 class="related-card-title">{item.title}</h3>
          {item.description && (
            <p class="related-card-desc">{item.description}</p>
          )}
          <span class="related-card-link">Read More →</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-content {
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .related-content--no-border {
    border-top: none;
    padding-top: 0;
  }

  .related-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-6);
    color: var(--color-text);
  }

  .related-grid {
    display: grid;
    gap: var(--space-4);
  }

  .related-grid--1 {
    grid-template-columns: 1fr;
  }

  .related-grid--2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .related-card:hover {
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .related-card-title {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    margin: 0;
    transition: color var(--transition-fast);
    line-height: var(--leading-snug);
  }

  .related-card:hover .related-card-title {
    color: var(--color-primary);
  }

  .related-card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-card-link {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-primary);
    margin-top: auto;
  }

  @media (max-width: 640px) {
    .related-grid--2 {
      grid-template-columns: 1fr;
    }
  }
</style>
