---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const readerModules = import.meta.glob('../content/readers/**/*.md', { eager: true });
const totalReaders = Object.keys(readerModules).length;

const methodologySchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "How Eastern Alignment Tests & Reviews Psychic Services",
  "description": "Our complete testing standards, evidence requirements, scoring framework, and editorial independence policy. Every methodology decision is documented and open to scrutiny.",
  "url": "https://easternalignment.com/methodology/",
  "author": {
    "@type": "Person",
    "@id": "https://easternalignment.com/#sarah",
    "name": "Sarah",
    "url": "https://easternalignment.com/about/"
  },
  "publisher": {
    "@id": "https://easternalignment.com/#organization"
  },
  "datePublished": "2026-09-07",
  "dateModified": "2026-09-07",
  "inLanguage": "en-US",
  "isPartOf": {
    "@id": "https://easternalignment.com/#website"
  }
};
---

<BaseLayout
  title="How We Test & Review Psychic Services — Methodology & Editorial Standards"
  description="Eastern Alignment's complete methodology: our 7-step testing protocol, weighted scoring framework, evidence classification system, editorial independence policy, and the documented limitations of our approach. No black boxes."
  jsonLd={methodologySchema}
  noCta={true}
>
  <div class="methodology-page section">
    <div class="container container--narrow">
      <Breadcrumb items={[{ label: 'Methodology' }]} />

      <!-- ═══════════════════════════════════════════════
           HERO
      ═══════════════════════════════════════════════ -->
      <header class="meth-hero">
        <span class="badge badge--sage">Editorial Standards</span>
        <h1>How Eastern Alignment Tests & Reviews Psychic Services</h1>
        <p class="meth-subtitle text-muted">
          Our testing standards, evidence requirements, scoring framework, and editorial independence policy. Every methodology decision documented below is open to scrutiny.
        </p>
        <p class="meth-positioning">
          We don't rank psychic platforms from their marketing pages. We use them as paying customers, document the experience, apply a consistent evaluation framework, and update our findings when the evidence changes.
        </p>
      </header>

      <!-- ═══════════════════════════════════════════════
           FIVE QUESTIONS
      ═══════════════════════════════════════════════ -->
      <div class="five-q card">
        <div class="five-q-item">
          <span class="five-q-label">Who</span>
          <span class="five-q-answer"><a href="/about/">Sarah</a> — sole tester, researcher, and editor. All assessments are conducted and authored by one person, not a rotating staff of anonymous freelancers.</span>
        </div>
        <div class="five-q-item">
          <span class="five-q-label">What</span>
          <span class="five-q-answer">Online psychic platforms, individual readers, reading formats (chat, phone, video), customer experience, pricing mechanics, safety, and satisfaction guarantees.</span>
        </div>
        <div class="five-q-item">
          <span class="five-q-label">How</span>
          <span class="five-q-answer">Real accounts → real money → multiple sessions → documented observations → follow-up verification → cross-referencing with community data.</span>
        </div>
        <div class="five-q-item">
          <span class="five-q-label">What we measure</span>
          <span class="five-q-answer">Reading quality, unprompted specificity, communication, value, platform transparency, consumer protection, customer support, and documented outcomes.</span>
        </div>
        <div class="five-q-item">
          <span class="five-q-label">What we don't claim</span>
          <span class="five-q-answer">We do not claim to scientifically prove or disprove whether any reader possesses supernatural abilities. We evaluate what you actually get when you spend money on these services.</span>
        </div>
      </div>

      <!-- ═══════════════════════════════════════════════
           TESTING IN NUMBERS
      ═══════════════════════════════════════════════ -->
      <section class="meth-section" id="testing-in-numbers">
        <h2>Our Research at a Glance</h2>
        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-number">3</span>
            <span class="stat-label">Platforms covered in depth</span>
            <a href="/reviews/" class="stat-evidence">View platform reviews →</a>
          </div>
          <div class="stat-card">
            <span class="stat-number">{totalReaders}+</span>
            <span class="stat-label">Reader profiles published</span>
            <a href="/reviews/" class="stat-evidence">Browse reader reviews →</a>
          </div>
          <div class="stat-card">
            <span class="stat-number">7</span>
            <span class="stat-label">Steps in our testing protocol</span>
            <a href="#testing-protocol" class="stat-evidence">See the protocol ↓</a>
          </div>
          <div class="stat-card">
            <span class="stat-number">A–D</span>
            <span class="stat-label">Evidence classification levels</span>
            <a href="#evidence-standards" class="stat-evidence">See evidence levels ↓</a>
          </div>
          <div class="stat-card">
            <span class="stat-number">5</span>
            <span class="stat-label">Weighted scoring dimensions</span>
            <a href="#scoring-framework" class="stat-evidence">See scoring framework ↓</a>
          </div>
          <div class="stat-card">
            <span class="stat-number">Ongoing</span>
            <span class="stat-label">Continuously updated research</span>
          </div>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════════
           THREE CONTENT TYPES
      ═══════════════════════════════════════════════ -->
      <section class="meth-section" id="content-types">
        <h2>Three Types of Content, Three Distinct Methodologies</h2>
        <p>Eastern Alignment publishes three structurally different categories of content. Each follows its own research protocol because the evidence requirements are fundamentally different. We never apply a platform-level methodology to a reader-level assessment, or vice versa.</p>

        <div class="content-type-grid">
          <div class="content-type-card card">
            <div class="ct-icon">📊</div>
            <h3>Platform Reviews</h3>
            <p class="text-muted text-sm">Full-lifecycle testing of the platform as a product: signup, payment, reader discovery, session experience, customer support, refund handling, and policy verification. Requires real accounts, real spending, and multi-reader sampling.</p>
            <a href="#platform-methodology" class="ct-link text-primary text-sm">See platform methodology ↓</a>
          </div>
          <div class="content-type-card card">
            <div class="ct-icon">👤</div>
            <h3>Reader Assessments</h3>
            <p class="text-muted text-sm">Individual reader profiles evaluated on specificity, communication, question handling, value, and documented track record. Combines direct session observations with verified public data (ratings, session counts, review distributions).</p>
            <a href="#reader-methodology" class="ct-link text-primary text-sm">See reader methodology ↓</a>
          </div>
          <div class="content-type-card card">
            <div class="ct-icon">📖</div>
            <h3>Guides & Comparisons</h3>
            <p class="text-muted text-sm">Research-driven editorial content synthesizing firsthand testing data, community intelligence, and verified platform information into actionable buyer guidance. Not firsthand testing — structured aggregation with declared sources.</p>
            <a href="#guide-methodology" class="ct-link text-primary text-sm">See guide methodology ↓</a>
          </div>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════════
           TESTING PROTOCOL
      ═══════════════════════════════════════════════ -->
      <section class="meth-section" id="testing-protocol">
        <h2>Our Testing Protocol</h2>
        <p>Every platform review on Eastern Alignment follows this 7-step protocol. Steps are executed in sequence; we do not skip steps or reorder them based on the platform being tested.</p>

        <div class="protocol-steps">
          <div class="protocol-step">
            <div class="step-marker">01</div>
            <div class="step-content">
              <h3>We Create a Normal Customer Account</h3>
              <p>We sign up with standard consumer email addresses. We do not announce ourselves as reviewers, request press accounts, or accept platform-provisioned credentials. The platform does not know we are evaluating them. This is non-negotiable: any special treatment would invalidate the firsthand evidence.</p>
            </div>
          </div>

          <div class="protocol-step">
            <div class="step-marker">02</div>
            <div class="step-content">
              <h3>We Pay With Our Own Money</h3>
              <p>No complimentary readings. No sponsored credits. No paid editorial placements. Every session we reference was paid for at standard consumer rates. We do not publicize our total testing expenditure, but it is real money spent out of pocket — not a marketing number.</p>
            </div>
          </div>

          <div class="protocol-step">
            <div class="step-marker">03</div>
            <div class="step-content">
              <h3>We Sample Multiple Readers</h3>
              <p>A single reader's performance cannot represent an entire platform. We sample across different specialties (tarot, astrology, mediumship, intuitive counseling), pricing tiers (budget through premium), communication formats (chat, phone, video where available), and rating levels. The goal is to test the platform's <em>range</em>, not just its best performer.</p>
            </div>
          </div>

          <div class="protocol-step">
            <div class="step-marker">04</div>
            <div class="step-content">
              <h3>We Use a Consistent Question Framework</h3>
              <p>We prepare question categories in advance so that sessions can be compared across readers and platforms without changing the standard. Categories include: relationship dynamics, career direction, decision-making, and general life guidance. We do not feed readers pre-scripted answers or test them on verifiable trivia — we evaluate how they handle the kind of open, emotionally complex questions that real customers bring.</p>
              <p class="text-sm text-muted"><strong>Note:</strong> We do not publish the exact question wording to prevent readers from preparing rehearsed responses if they become aware of this site.</p>
            </div>
          </div>

          <div class="protocol-step">
            <div class="step-marker">05</div>
            <div class="step-content">
              <h3>We Document the Session</h3>
              <p>We preserve transcripts (where the platform permits, e.g. Kasamba's automatic chat logs), timestamps, pricing charged, reader profile information, promotional terms used, and session notes. For phone and video sessions where transcripts are not available, we take contemporaneous notes during or immediately after the session. Sensitive personal information is redacted before any content is published or referenced.</p>
            </div>
          </div>

          <div class="protocol-step">
            <div class="step-marker">06</div>
            <div class="step-content">
              <h3>We Evaluate Immediately</h3>
              <p>Within 24 hours of the session, we record structured assessments on: unprompted specificity, relevance to the stated question, communication quality, value relative to cost, and any red flags (pressure tactics, upselling, fear-based statements). Immediate evaluation prevents memory distortion — we do not score sessions weeks later from faded impressions.</p>
            </div>
          </div>

          <div class="protocol-step">
            <div class="step-marker">07</div>
            <div class="step-content">
              <h3>We Revisit When Claims Can Be Verified</h3>
              <p>If a reader makes a time-bound claim ("you will hear from this person within three weeks"), we record the claim and its stated window, then revisit it after the window closes. We do not treat predictions as automatically true or false at the time of the session. A vague statement is never counted as a successful prediction simply because it feels relevant after the fact — that is hindsight bias, and we explicitly guard against it.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════════
           WHAT WE ACTUALLY TEST — FOUR LAYERS
      ═══════════════════════════════════════════════ -->
      <section class="meth-section" id="what-we-test">
        <h2>What We Actually Test</h2>
        <p>We don't just "test the psychic." We evaluate the full service lifecycle across four distinct layers. Each layer has its own evidence requirements and contributes independently to our assessment.</p>

        <div class="test-layers">
          <div class="test-layer card">
            <h3><span class="layer-num">1</span> The Reader</h3>
            <div class="layer-metrics">
              <span class="metric-tag">Unprompted specificity</span>
              <span class="metric-tag">Relevance to question</span>
              <span class="metric-tag">Internal consistency</span>
              <span class="metric-tag">Communication quality</span>
              <span class="metric-tag">Question handling</span>
              <span class="metric-tag">Transparency</span>
              <span class="metric-tag">Pressure tactics (red flag)</span>
              <span class="metric-tag">Session value</span>
            </div>
          </div>

          <div class="test-layer card">
            <h3><span class="layer-num">2</span> The Platform</h3>
            <div class="layer-metrics">
              <span class="metric-tag">Reader discovery & filtering</span>
              <span class="metric-tag">Pricing transparency</span>
              <span class="metric-tag">Availability & wait times</span>
              <span class="metric-tag">Introductory offers</span>
              <span class="metric-tag">Review system integrity</span>
              <span class="metric-tag">Reader profiles depth</span>
              <span class="metric-tag">Transcript/record availability</span>
              <span class="metric-tag">Payment flow</span>
              <span class="metric-tag">Refund & satisfaction policy</span>
              <span class="metric-tag">Customer support</span>
            </div>
          </div>

          <div class="test-layer card">
            <h3><span class="layer-num">3</span> The Transaction</h3>
            <div class="layer-metrics">
              <span class="metric-tag">Advertised vs. actual cost</span>
              <span class="metric-tag">Intro offer usability</span>
              <span class="metric-tag">Hidden fees or charges</span>
              <span class="metric-tag">Terms clarity</span>
              <span class="metric-tag">Cancellation process</span>
              <span class="metric-tag">Refund request outcome</span>
              <span class="metric-tag">Support resolution quality</span>
            </div>
          </div>

          <div class="test-layer card">
            <h3><span class="layer-num">4</span> The Aftermath</h3>
            <div class="layer-metrics">
              <span class="metric-tag">Prediction follow-up</span>
              <span class="metric-tag">Outcome documentation</span>
              <span class="metric-tag">Transcript re-audit</span>
              <span class="metric-tag">Platform policy changes</span>
              <span class="metric-tag">Long-term reader consistency</span>
            </div>
            <p class="text-sm text-muted layer-note">This layer is what separates a review from a reaction. Most review sites evaluate the moment; we evaluate the service lifecycle.</p>
          </div>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════════
           WHAT "ACCURACY" MEANS TO US
      ═══════════════════════════════════════════════ -->
      <section class="meth-section" id="accuracy-definition">
        <h2>What "Accuracy" Means to Us</h2>
        <p>We do not treat psychic ability as a scientifically established quantity that can be reduced to a single percentage. You will never see us claim "87% psychic accuracy" — that framing is misleading and unverifiable. Instead, we assess the <strong>information quality</strong> of a reading: whether the reader delivers content that is specific, relevant, internally consistent, and — where applicable — later checkable against observable reality.</p>

        <p>When a reader makes statements during a session, we classify them into four categories:</p>

        <div class="accuracy-taxonomy">
          <div class="taxonomy-item card">
            <div class="taxonomy-badge taxonomy-a">Specific & Verifiable</div>
            <p class="taxonomy-example">"You will receive a job-related communication from someone in the healthcare sector within the next 30 days."</p>
            <p class="taxonomy-note text-sm text-muted">Time-bound, domain-specific, independently checkable. We record these and revisit after the stated window.</p>
          </div>
          <div class="taxonomy-item card">
            <div class="taxonomy-badge taxonomy-b">Specific but Not Yet Verifiable</div>
            <p class="taxonomy-example">"A person from your past — someone connected to your early twenties — will re-enter your life."</p>
            <p class="taxonomy-note text-sm text-muted">Contains specifics but no clear verification timeline. We record without scoring.</p>
          </div>
          <div class="taxonomy-item card">
            <div class="taxonomy-badge taxonomy-c">Subjective / Interpretive</div>
            <p class="taxonomy-example">"You are entering a period of emotional renewal and shedding old patterns."</p>
            <p class="taxonomy-note text-sm text-muted">Potentially meaningful to the individual but not independently scorable. We evaluate these on therapeutic usefulness, not predictive accuracy.</p>
          </div>
          <div class="taxonomy-item card">
            <div class="taxonomy-badge taxonomy-d">Non-Verifiable</div>
            <p class="taxonomy-example">"You have an old soul." / "Your energy is very purple."</p>
            <p class="taxonomy-note text-sm text-muted">Untestable by any method. We note whether a reader relies heavily on this category — a session dominated by non-verifiable statements is a red flag for vagueness.</p>
          </div>
        </div>

        <p class="meth-callout"><strong>Key principle:</strong> A vague statement is never counted as a successful prediction simply because it feels relevant after the fact. That is <a href="https://en.wikipedia.org/wiki/Barnum_effect" target="_blank" rel="noopener">the Barnum effect</a>, and we explicitly guard against it in our evaluation process.</p>
      </section>

      <!-- ═══════════════════════════════════════════════
           SCORING FRAMEWORK
      ═══════════════════════════════════════════════ -->
      <section class="meth-section" id="scoring-framework">
        <h2>Scoring Framework</h2>

        <h3 id="platform-methodology">Platform Review Scoring</h3>
        <p>Platform reviews receive an overall score on a 5.0 scale derived from five weighted dimensions. Weights are fixed before testing begins and do not change based on the platform being evaluated. The overall score is a weighted average rounded to two decimal places (e.g. 4.88) when the second decimal is non-zero, or one decimal place (e.g. 4.9) when it is.</p>

        <div class="score-table-wrapper">
          <table class="score-table">
            <thead>
              <tr>
                <th>Dimension</th>
                <th>Weight</th>
                <th>What Earns a High Score (4.5–5.0)</th>
                <th>What Earns a Low Score (1.0–2.5)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Reading Quality</strong></td>
                <td>25%</td>
                <td>Multiple readers deliver unprompted, specific details relevant to the question within the first 2–3 minutes. Statements are internally consistent across sessions. Verifiable claims show documented follow-through.</td>
                <td>Readers rely on Barnum statements, ask excessive clarifying questions (cold reading), or deliver contradictory information across sessions. Specificity is absent.</td>
              </tr>
              <tr>
                <td><strong>Trust & Safety</strong></td>
                <td>20%</td>
                <td>No pressure tactics, no fear-based upselling, clear refund policy honored in practice, transparent pricing with no hidden charges, robust reader vetting process.</td>
                <td>Readers employ scare tactics ("you have a curse"), platform resists legitimate refunds, pricing is misleading, or the platform accepts readers with no meaningful vetting.</td>
              </tr>
              <tr>
                <td><strong>Value</strong></td>
                <td>20%</td>
                <td>Per-minute cost is competitive for the quality delivered. Introductory offers are genuinely usable (not bait-and-switch). Session depth justifies the price — you leave with actionable insight, not filler.</td>
                <td>High per-minute rates with generic output. Intro offers have hidden conditions. Sessions feel padded with pleasantries to run up the clock.</td>
              </tr>
              <tr>
                <td><strong>Platform Experience</strong></td>
                <td>20%</td>
                <td>Reader discovery is intuitive with useful filters. Wait times are reasonable. Profile information helps informed selection. Transcript or session records are available. Payment flow is clear.</td>
                <td>Poor search/filter functionality, excessive wait times, thin reader profiles, no session records, confusing checkout or auto-billing.</td>
              </tr>
              <tr>
                <td><strong>Communication</strong></td>
                <td>15%</td>
                <td>Readers listen actively, respond to the actual question asked, provide clarity without jargon, manage session time respectfully, and close with actionable takeaways.</td>
                <td>Readers monologue, ignore the stated question, use excessive jargon, or rush the session without checking comprehension.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3 id="reader-methodology">Reader Assessment Scoring</h3>
        <p>Individual reader assessments use the same 5.0 scale but with dimensions calibrated to the individual rather than the platform. Readers are assessed on the basis of direct session observation (where available) combined with verified public data.</p>

        <div class="score-table-wrapper">
          <table class="score-table">
            <thead>
              <tr>
                <th>Dimension</th>
                <th>Weight</th>
                <th>Data Source</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Specificity & Relevance</strong></td>
                <td>30%</td>
                <td>Direct session observation + transcript analysis (where available)</td>
              </tr>
              <tr>
                <td><strong>Communication Quality</strong></td>
                <td>20%</td>
                <td>Direct session observation</td>
              </tr>
              <tr>
                <td><strong>Verified Track Record</strong></td>
                <td>20%</td>
                <td>Public rating, total sessions, rating distribution, years active — all verified from the platform</td>
              </tr>
              <tr>
                <td><strong>Value</strong></td>
                <td>15%</td>
                <td>Per-minute rate vs. platform average, session depth per minute spent</td>
              </tr>
              <tr>
                <td><strong>Professionalism & Safety</strong></td>
                <td>15%</td>
                <td>Presence or absence of red flags: pressure tactics, fear-based statements, dependency creation, upselling</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="meth-callout"><strong>One-strike rule:</strong> Any reader who employs documented scare tactics (e.g. "you have a curse that needs removal"), attempts to create emotional dependency, or engages in demonstrable cold-reading manipulation receives a 0 on Professionalism & Safety regardless of other scores. This is not a weighted reduction — it is a categorical disqualification.</p>

        <h3 id="guide-methodology">Guide & Comparison Methodology</h3>
        <p>Guides and comparison articles are not firsthand testing reports. They are <strong>structured research syntheses</strong> that aggregate data from our platform reviews, reader assessments, verified platform information, and community intelligence into actionable buyer guidance. We are transparent about this distinction because the evidence basis is different:</p>

        <div class="guide-method-grid">
          <div class="guide-method-item card">
            <h4>Data Sources for Guides</h4>
            <ul>
              <li><strong>Our own platform reviews & reader assessments</strong> — firsthand testing data from the protocols described above</li>
              <li><strong>Verified platform data</strong> — pricing, roster size, feature availability, policies (independently confirmed, not copied from marketing)</li>
              <li><strong>Community intelligence</strong> — user experiences aggregated from forums, Reddit threads, review aggregators, and social platforms, with AI-assisted processing to surface patterns and filter noise</li>
              <li><strong>Published research</strong> — academic and journalistic sources where relevant to claims about the industry</li>
            </ul>
          </div>
          <div class="guide-method-item card">
            <h4>What Guides Are Not</h4>
            <ul>
              <li>They are not firsthand testing reports (those are platform reviews and reader assessments)</li>
              <li>They are not rewritten platform marketing copy</li>
              <li>They are not fabricated testimonials or invented user stories</li>
              <li>They do not present aggregated community data as our own firsthand experience</li>
            </ul>
            <p class="text-sm text-muted">When a guide references a finding from our firsthand testing, it links directly to the underlying review. When it references community data, it says so.</p>
          </div>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════════
           EVIDENCE LEVELS
      ═══════════════════════════════════════════════ -->
      <section class="meth-section" id="evidence-standards">
        <h2>Evidence Classification System</h2>
        <p>Not all evidence is equally strong. We classify every material claim in our reviews by its evidence basis so you can immediately gauge how hard the underlying data is.</p>

        <div class="evidence-levels">
          <div class="evidence-level card">
            <div class="ev-badge ev-a">Level A</div>
            <div class="ev-content">
              <h4>Directly Verified</h4>
              <p>We tested, measured, or confirmed it ourselves through firsthand interaction with the platform or reader.</p>
              <p class="text-sm text-muted"><strong>Examples:</strong> Pricing paid, session experience, refund outcome, signup process, feature availability, customer support response time.</p>
            </div>
          </div>

          <div class="evidence-level card">
            <div class="ev-badge ev-b">Level B</div>
            <div class="ev-content">
              <h4>Independently Corroborated</h4>
              <p>Confirmed through multiple reliable third-party sources, even if not directly tested by us.</p>
              <p class="text-sm text-muted"><strong>Examples:</strong> Platform policies documented across multiple user reports, published pricing confirmed by independent shoppers, app store ratings.</p>
            </div>
          </div>

          <div class="evidence-level card">
            <div class="ev-badge ev-c">Level C</div>
            <div class="ev-content">
              <h4>User-Reported</h4>
              <p>Sourced from individual user accounts (forums, reviews, social media). Informative but not independently fully verifiable by us.</p>
              <p class="text-sm text-muted"><strong>Examples:</strong> Individual customer testimonials, specific reader experiences shared on Reddit, user-reported wait times.</p>
            </div>
          </div>

          <div class="evidence-level card">
            <div class="ev-badge ev-d">Level D</div>
            <div class="ev-content">
              <h4>Platform Claim</h4>
              <p>Stated by the platform itself and not independently verified. We include it when useful but label it clearly.</p>
              <p class="text-sm text-muted"><strong>Examples:</strong> "500+ advisors" (platform self-report), "satisfaction guarantee" (terms not stress-tested), claimed screening process details.</p>
            </div>
          </div>
        </div>

        <p>When a platform claims "500+ advisors," we label it as a platform claim (Level D). When we independently browse the directory and count available readers, that becomes Level A. This distinction matters — and you deserve to know which one you're reading.</p>
      </section>

      <!-- ═══════════════════════════════════════════════
           OBJECTIVE vs. SUBJECTIVE DISCLOSURE
      ═══════════════════════════════════════════════ -->
      <section class="meth-section" id="evidence-types">
        <h2>Objective vs. Editorial Metrics</h2>
        <p>Some of our evaluation metrics can be objectively measured. Others require editorial judgment. We disclose which is which — because "unbiased" means nothing without showing your work.</p>

        <div class="score-table-wrapper">
          <table class="score-table">
            <thead>
              <tr>
                <th>Metric</th>
                <th>Evidence Type</th>
