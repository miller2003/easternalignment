---
/**
 * Platform-level review dynamic route — /reviews/[slug]/
 * 
 * Now that platform reviews have dedicated hub pages (/reviews/keen/, /reviews/kasamba/),
 * this route handles any remaining review slugs that don't match a platform hub.
 * For platform slugs (keen, kasamba), visitors are redirected to the hub pages.
 */
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import ProsCons from '../../components/ProsCons.astro';
import CTABox from '../../components/CTABox.astro';
import FAQ from '../../components/FAQ.astro';
import RelatedContent from '../../components/RelatedContent.astro';

/* Platform slugs that now have dedicated hub pages */
const PLATFORM_HUBS = ['keen', 'kasamba', 'purple-garden'];

export async function getStaticPaths() {
  const posts = import.meta.glob('../../content/reviews/*.md');
  const paths = [];
  for (const path in posts) {
    const post = await posts[path]();
    const slug = path.split('/').pop().replace('.md', '');
    
    // Skip slugs that have dedicated hub pages
    if (['keen', 'kasamba', 'purple-garden'].includes(slug)) continue;
    
    paths.push({
      params: { slug },
      props: post,
    });
  }
  return paths;
}

const { default: Content, frontmatter } = Astro.props;
const currentSlug = Astro.params.slug;

/* Fetch guides for cross-linking */
const guideModules = import.meta.glob('../../content/guides/*.md', { eager: true });
const guides = Object.entries(guideModules).map(([path, mod]: [string, any]) => ({
  ...mod.frontmatter,
  slug: path.split('/').pop()?.replace('.md', ''),
}));

/* Load readers to show count per platform */
const readerModules = import.meta.glob('../../content/readers/**/*.md', { eager: true });
const readersByPlatform: Record<string, number> = {};
Object.entries(readerModules).forEach(([path, mod]: [string, any]) => {
  const platform = mod.frontmatter?.platform || 'unknown';
  readersByPlatform[platform] = (readersByPlatform[platform] || 0) + 1;
});

const relatedItems = [
  {
    title: 'Keen Psychics Review 2026',
    href: '/reviews/keen/',
    description: `Full platform review with ${readersByPlatform['keen'] || 0} individual reader assessments.`,
    badge: 'Platform',
    badgeVariant: 'primary' as const,
  },
  {
    title: 'Kasamba Review 2026',
    href: '/reviews/kasamba/',
    description: `Full platform review with ${readersByPlatform['kasamba'] || 0} individual reader assessments.`,
    badge: 'Platform',
    badgeVariant: 'primary' as const,
  },
  ...guides.map(g => ({
    title: g.title,
    href: `/guides/${g.slug}/`,
    description: g.description,
    badge: g.category || 'Guide',
    badgeVariant: 'sage' as const,
  })),
];

const faqItems = [
  {
    question: `Is ${frontmatter.platformName} legitimate?`,
    answer: `Yes. ${frontmatter.platformName} is one of the longest-running online psychic reading platforms and has served millions of users. I've personally tested it through multiple paid sessions over an extended period.`
  },
  {
    question: `How much does ${frontmatter.platformName} cost?`,
    answer: `${frontmatter.platformName} pricing starts from ${frontmatter.pricing || '$1.99/min'} and varies depending on the psychic's experience level. ${frontmatter.freeOffer ? `New users can take advantage of ${frontmatter.freeOffer}.` : ''}`
  },
  {
    question: `Does ${frontmatter.platformName} offer a money-back guarantee?`,
    answer: `${frontmatter.platformName} does offer a satisfaction guarantee. If you're unhappy with your reading, you can reach out to customer support for credit or resolution. Check their current terms for specific details.`
  },
];
---

<ReviewLayout
  title={frontmatter.title}
  description={frontmatter.description}
  seoTitle={frontmatter.seoTitle || `${frontmatter.platformName} Review (2026)`}
  metaDescription={frontmatter.metaDescription}
  platformName={frontmatter.platformName}
  rating={frontmatter.rating}
  verdict={frontmatter.verdict}
  affiliateUrl={frontmatter.affiliateUrl}
  freeOffer={frontmatter.freeOffer}
  publishDate={frontmatter.publishDate}
  updatedDate={frontmatter.updatedDate}
>
  <Content />

  {(frontmatter.pros?.length > 0 || frontmatter.cons?.length > 0) && (
    <ProsCons pros={frontmatter.pros || []} cons={frontmatter.cons || []} />
  )}

  <CTABox
    title={`Ready to try ${frontmatter.platformName}?`}
    description={frontmatter.freeOffer ? `Take advantage of their current offer: ${frontmatter.freeOffer}` : 'Get started with your first reading today.'}
    buttonText={`Visit ${frontmatter.platformName} →`}
    buttonUrl={frontmatter.affiliateUrl || '#'}
    variant="highlight"
  />

  <FAQ items={faqItems} title={`${frontmatter.platformName} FAQ`} />

  <RelatedContent title="Related Reading" items={relatedItems} />

  <div class="all-reviews-cta">
    <a href="/reviews/" class="btn btn--ghost">← Back to All Platform Reviews</a>
  </div>
</ReviewLayout>

<style>
  .all-reviews-cta {
    margin-top: var(--space-8);
    text-align: center;
  }
</style>
