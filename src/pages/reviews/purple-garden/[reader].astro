---
/**
 * Individual Reader Review Page — /reviews/purple-garden/[reader]/
 * 
 * Spoke pages in the Hub & Spoke model. Each reader review links back
 * to the Purple Garden platform hub and cross-links to other readers.
 */
import ReviewLayout from '../../../layouts/ReviewLayout.astro';
import ProsCons from '../../../components/ProsCons.astro';
import CTABox from '../../../components/CTABox.astro';
import FAQ from '../../../components/FAQ.astro';
import ReaderCard from '../../../components/ReaderCard.astro';
import ReaderEndCTA from '../../../components/ReaderEndCTA.astro';
import RelatedContent from '../../../components/RelatedContent.astro';
import InfiniteContentFlow from '../../../components/InfiniteContentFlow.astro';
import { pickRelatedReaders, pickRelatedGuides } from '../../../lib/relatedReaders';

export async function getStaticPaths() {
  const posts = import.meta.glob('../../../content/readers/purple-garden/*.md');
  const paths = [];
  for (const path in posts) {
    const post = await posts[path]();
    const slug = path.split('/').pop().replace('.md', '');
    paths.push({
      params: { reader: slug },
      props: post,
    });
  }
  return paths;
}

const { default: Content, frontmatter } = Astro.props;
const currentSlug = Astro.params.reader;

/* Fetch all Purple Garden readers for cross-linking */
const allReaderModules = import.meta.glob('../../../content/readers/purple-garden/*.md', { eager: true });
const allReaders = Object.entries(allReaderModules)
  .map(([path, mod]: [string, any]) => ({
    ...mod.frontmatter,
    slug: path.split('/').pop()?.replace('.md', ''),
  }));

/* Pick related readers with the fair + topically-aware selector (replaces the old
   first-3-in-file-order, which meant readers added later never appeared). */
const currentReader = {
  slug: currentSlug,
  rating: frontmatter.rating,
  entities: frontmatter.entities,
  bestFor: frontmatter.bestFor,
  platformName: frontmatter.platformName,
};
const otherReaders = pickRelatedReaders(currentReader, allReaders, 4);

/* Fetch guides for the infinite content flow */
const guideModules = import.meta.glob('../../../content/guides/*.md', { eager: true });
const guides = Object.entries(guideModules).map(([path, mod]: [string, any]) => ({
  ...mod.frontmatter,
  slug: path.split('/').pop()?.replace('.md', ''),
  Content: mod.default,
}));

/* Intent-matched guide picks (2026-08-28): niche overlap + same-platform
 * bonus. Top pick feeds the InfiniteContentFlow "continue reading" article —
 * previously HARDCODED to the PG platform audit for every reader, which
 * leaked retention. The next 4 fill the bottom grid (no URL appears twice). */
const guidePicks = pickRelatedGuides(currentReader, guides, 5, 'purple-garden',
  [...allReaders].sort((a, b) => a.slug.localeCompare(b.slug)).findIndex(r => r.slug === currentSlug));
const flowGuide = guidePicks[0] || guides[0];
const gridGuides = guidePicks.slice(1, 5);

/* Extract clean reader name for FAQ generation */
const readerDisplayName = frontmatter.platformName?.includes(':') 
  ? frontmatter.platformName.split(':').pop()?.trim() 
  : frontmatter.title?.split(' ')[0] || 'This reader';

/* Advisor delisted from Purple Garden? Honour it in CTA copy + FAQ,
 * mirroring the keen/[reader].astro pattern (2026-09-02 CTA audit).
 * Clicks still land live: affiliateLinks.ts repoints the reader's slug
 * to the generic PG offer — this switch only keeps the copy honest. */
const unavailable = frontmatter.unavailable === true;

const readerFaqItems = unavailable
  ? [
      {
        question: `Was ${readerDisplayName} a legitimate psychic reader on Purple Garden?`,
        answer: `${readerDisplayName} was a reader on Purple Garden and the subject of my review, based on their documented track record and client feedback. Note: ${readerDisplayName} is no longer listed on Purple Garden. You can browse the platform's current live advisors via the button below.`
      },
      {
        question: `How much did a reading with ${readerDisplayName} cost?`,
        answer: `${readerDisplayName}'s prior rate was ${frontmatter.pricing || 'rates vary'}. Since they are no longer listed on Purple Garden, that rate no longer applies — browse the platform's live advisors for current pricing and the new-client offer.`
      },
      {
        question: `How do I find a similar reader on Purple Garden?`,
        answer: `${readerDisplayName} is no longer on Purple Garden, but the platform still has many advisors with a comparable style. Use the button below to browse the live roster — the $30 new-client credit still applies to any advisor you pick.`
      },
    ]
  : [
      {
        question: `Is ${readerDisplayName} accurate on Purple Garden?`,
        answer: `${readerDisplayName} has been evaluated based on client outcome logs, Journeys community verification, and modality consistency. Read our full analysis above for specific timeline accuracy and communication traits.`
      },
      {
        question: `How much does a reading with ${readerDisplayName} cost?`,
        answer: `${readerDisplayName}'s rate is currently ${frontmatter.pricing || '$4.99/min'} on Purple Garden. Pricing may vary depending on whether you choose Video, Phone, or Chat.`
      },
      {
        question: `What reading modality is best for ${readerDisplayName}?`,
        answer: `We recommend watching their pre-recorded video intro profile on the Purple Garden app first, then choosing the reading format (${frontmatter.bestFor || 'Live Video or Chat'}) that best fits your situation.`
      },
    ];

/* Cross-link block: platform review + guides relevant to this reader's niche. */
const relatedItems = [
  {
    title: 'Purple Garden Review 2026 — Full Platform Assessment',
    href: '/reviews/purple-garden/',
    description: 'My comprehensive review of Purple Garden — video readings, $30 free credit, Journeys community verification, and overall experience.',
    badge: 'Platform Review',
    badgeVariant: 'primary' as const,
  },
  ...gridGuides.map(g => ({
    title: g.title,
    href: `/guides/${g.slug}/`,
    description: g.description,
    badge: g.category || 'Guide',
    badgeVariant: 'sage' as const,
  })),
];
---

<ReviewLayout
  title={frontmatter.title}
  description={frontmatter.description}
  platformName={frontmatter.platformName}
  rating={frontmatter.rating}
  verdict={frontmatter.verdict}
  affiliateUrl={frontmatter.affiliateUrl}
  freeOffer={frontmatter.freeOffer}
  avatarUrl={frontmatter.avatarUrl}
  publishDate={frontmatter.publishDate}
  updatedDate={frontmatter.updatedDate}
  metaRobots={frontmatter.metaRobots}
  canonicalUrl={frontmatter.canonicalUrl}
  ogImage={frontmatter.ogImage}
  seoTitle={frontmatter.seoTitle || frontmatter.metaTitle}
  metaDescription={frontmatter.metaDescription}
  schemaAuthor={frontmatter.schemaAuthor}
  schemaDatePublished={frontmatter.schemaDatePublished}
  customSchema={frontmatter.customSchema}
  entities={frontmatter.entities}
>
  <Content />

  {(frontmatter.pros?.length > 0 || frontmatter.cons?.length > 0) && (
    <ProsCons pros={frontmatter.pros || []} cons={frontmatter.cons || []} />
  )}

  {/* Pre-CTA nudge paragraph — anchors the offer in the body, looks like
      body copy, then hands off to the highlighted CTABox below for the
      actual button. Author doesn't have to write this. */}
  <ReaderEndCTA platformName={frontmatter.platformName} />

  <div id="end-cta-anchor">
    <CTABox
      title={unavailable ? `Looking for a reader like ${readerDisplayName}?` : `Ready for a reading with ${readerDisplayName}?`}
      description={unavailable
        ? `${readerDisplayName} is no longer listed on Purple Garden. Browse the platform's live advisors and their current new-client offer.`
        : (frontmatter.freeOffer ? `Offer available: ${frontmatter.freeOffer}` : `Connect with ${readerDisplayName} on Purple Garden today.`)}
      buttonText={unavailable ? 'See Live Purple Garden Advisors →' : `Book ${readerDisplayName} on Purple Garden →`}
      buttonUrl={unavailable ? '/go/purple-garden/' : (frontmatter.affiliateUrl || '#')}
      variant="highlight"
    />
  </div>

  <FAQ items={readerFaqItems} title={`Frequently Asked Questions About ${readerDisplayName}`} />

  <!-- Breadcrumb navigation back to hub — placed at end of article for better reading flow -->
  <div class="hub-breadcrumb hub-breadcrumb--footer">
    <a href="/reviews/purple-garden/" class="hub-link">
      ← Back to Purple Garden Platform Review & All Readers
    </a>
  </div>

  <!-- Related Readers on Same Platform -->
  {otherReaders.length > 0 && (
    <section class="related-readers-section">
      <h3 class="section-heading">Other Top Purple Garden Readers to Consider</h3>
      <p class="text-muted text-sm mb-6">Compare reading styles and pricing across other vetted advisors on Purple Garden.</p>
      <div class="reader-grid stagger">
        {otherReaders.map(reader => (
          <ReaderCard
            name={reader.platformName}
            slug={reader.slug}
            platform="purple-garden"
            rating={reader.rating}
            verdict={reader.verdict}
            pricing={reader.pricing}
            bestFor={reader.bestFor}
            affiliateUrl={reader.affiliateUrl}
            freeOffer={reader.freeOffer}
            avatarUrl={reader.avatarUrl}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Cross-linking to platform review, comparisons, guides -->
  <RelatedContent title="Continue Your Research" items={relatedItems} />

  <!-- Infinite Content Flow: seamless scroll into the PG platform audit -->
  {flowGuide && (
    <InfiniteContentFlow
      guideTitle={flowGuide.title}
      guideDescription={flowGuide.description}
      guideSlug={flowGuide.slug}
      guideCategory={flowGuide.category}
    >
      <flowGuide.Content />
    </InfiniteContentFlow>
  )}
</ReviewLayout>

<style>
  .hub-breadcrumb--footer {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .hub-link {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-primary);
    text-decoration: none;
  }

  .hub-link:hover {
    text-decoration: underline;
  }

  .related-readers-section {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .section-heading {
    margin-bottom: var(--space-2);
  }

  .mb-6 {
    margin-bottom: var(--space-6);
  }
</style>
