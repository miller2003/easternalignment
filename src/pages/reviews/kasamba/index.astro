---
/**
 * Kasamba Platform Hub Page — /reviews/kasamba/
 * 
 * Sub-hub (Pillar Page) for Kasamba in the Hub & Spoke model.
 * Currently renders platform review only. Reader reviews can be added later.
 */
import ReviewLayout from '../../../layouts/ReviewLayout.astro';
import ProsCons from '../../../components/ProsCons.astro';
import CTABox from '../../../components/CTABox.astro';
import FAQ from '../../../components/FAQ.astro';
import ReaderCard from '../../../components/ReaderCard.astro';
import RelatedContent from '../../../components/RelatedContent.astro';
import ScorePanel from '../../../components/ScorePanel.astro';

/* Load the Kasamba platform review content */
const kasambaModule = await import('../../../content/reviews/kasamba.md');
const KasambaContent = kasambaModule.default;
const frontmatter = kasambaModule.frontmatter;

/* Load all Kasamba reader reviews */
const readerModules = import.meta.glob('../../../content/readers/kasamba/*.md', { eager: true });
const readers = Object.entries(readerModules)
  .map(([path, mod]: [string, any]) => ({
    ...mod.frontmatter,
    slug: path.split('/').pop()?.replace('.md', ''),
  }))
  .sort((a, b) => (b.rating || 0) - (a.rating || 0));

/* Load guides for cross-linking */
const guideModules = import.meta.glob('../../../content/guides/*.md', { eager: true });
const guides = Object.entries(guideModules).map(([path, mod]: [string, any]) => ({
  ...mod.frontmatter,
  slug: path.split('/').pop()?.replace('.md', ''),
}));

/* Load comparisons for cross-linking */
const comparisonModules = import.meta.glob('../../../content/comparisons/*.md', { eager: true });
const comparisons = Object.entries(comparisonModules)
  .map(([path, mod]: [string, any]) => ({
    ...mod.frontmatter,
    slug: path.split('/').pop()?.replace('.md', ''),
  }))
  .filter(c => c.platforms?.includes('Kasamba'));

const faqItems = [
  {
    question: `Is ${frontmatter.platformName} legitimate?`,
    answer: `Yes. ${frontmatter.platformName} is one of the longest-running online psychic reading platforms and has served millions of users. I've personally tested it through multiple paid sessions over an extended period.`
  },
  {
    question: `How much does ${frontmatter.platformName} cost?`,
    answer: `${frontmatter.platformName} pricing starts from ${frontmatter.pricing || '$1.99/min'} and varies depending on the psychic's experience level. ${frontmatter.freeOffer ? `New users can take advantage of ${frontmatter.freeOffer}.` : ''}`
  },
  {
    question: `Does ${frontmatter.platformName} offer a money-back guarantee?`,
    answer: `${frontmatter.platformName} does offer a satisfaction guarantee. If you're unhappy with your reading, you can reach out to customer support for credit or resolution. Check their current terms for specific details.`
  },
  {
    question: `How do I choose the best reader on ${frontmatter.platformName}?`,
    answer: `I've individually reviewed ${readers.length} readers on ${frontmatter.platformName}. Each review covers their reading style, pricing, accuracy track record, and who they're best suited for. Scroll down to see my full reader assessment series.`
  },
];

const relatedItems = [
  ...comparisons.map(c => ({
    title: c.title,
    href: `/comparisons/${c.slug}/`,
    description: c.description,
    badge: 'Comparison',
    badgeVariant: 'primary' as const,
  })),
  ...guides.filter(g => [
    'kasamba-love-readings-review',
    'best-love-psychics-kasamba-ranked',
    'brutally-honest-psychics-kasamba',
    'best-kasamba-psychics-ex-recovery',
    'kasamba-3-free-minutes-guide',
    'most-accurate-psychics-kasamba',
    'kasamba-twin-flame-reading',
    'kasamba-specific-person-reading',
    'kasamba-no-contact-love-reading',
  ].includes(g.slug)).map(g => ({
    title: g.title,
    href: `/guides/${g.slug}/`,
    description: g.description,
    badge: g.category || 'Guide',
    badgeVariant: 'sage' as const,
  })),
];
---

<ReviewLayout
  title={frontmatter.title}
  description={frontmatter.description}
  seoTitle={frontmatter.seoTitle || 'Kasamba Review 2026: 3 Free Minutes + 50% Off — 35 Readers Tested'}
  metaDescription={frontmatter.metaDescription}
  platformName={frontmatter.platformName}
  rating={frontmatter.rating}
  reviewCount={readers.length}
  verdict={frontmatter.verdict}
  affiliateUrl={frontmatter.affiliateUrl}
  freeOffer={frontmatter.freeOffer}
  publishDate={frontmatter.publishDate}
  updatedDate={frontmatter.updatedDate}
>
  <ScorePanel
    platform="kasamba"
    rating={frontmatter.rating}
    pricing={frontmatter.pricing}
    bestFor={frontmatter.bestFor}
    advisorsReviewed={readers.length}
    badge="Editor's Choice"
  />

  <KasambaContent />

  {(frontmatter.pros?.length > 0 || frontmatter.cons?.length > 0) && (
    <ProsCons pros={frontmatter.pros || []} cons={frontmatter.cons || []} />
  )}

  <CTABox
    title={`Ready to test ${frontmatter.platformName} risk-free?`}
    description="New clients get 3 free minutes with every new advisor, plus 50% off the first paid session — the safest first purchase in the industry."
    buttonText="Get 3 Free Minutes + 50% Off →"
    buttonUrl={frontmatter.affiliateUrl || '#'}
    variant="highlight"
  />

  <!-- Featured Roundup Section -->
  <section class="featured-roundup-box">
    <div class="roundup-card card card--elevated">
      <div class="roundup-badge">Featured Strategy Guide</div>
      <div class="roundup-content">
        <h3 class="roundup-title">Best Love Psychics on Kasamba: 2026 Review & Top 5 Ranked</h3>
        <p class="roundup-desc text-muted">
          Struggling with relationship uncertainty? I've analyzed Kasamba's top-rated love psychics based on verified session volume, pricing, and specific relationship expertise.
        </p>
        <div class="roundup-actions">
          <a href="/guides/best-love-psychics-kasamba-ranked/" class="btn btn--primary btn--sm">Read the Full Love Psychics Roundup →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Individual Reader Reviews Section -->
  {readers.length > 0 && (
    <section class="reader-reviews-section" id="kasamba-readers">
      <div class="section-intro">
        <span class="section-eyebrow text-xs text-uppercase text-muted">In-Depth Assessments</span>
        <h2 class="section-heading">Individual Kasamba Psychics Reader Reviews</h2>
        <p class="section-description text-muted">
          I've personally assessed {readers.length} individual psychic readers on Kasamba Psychics. Each review below covers their reading style, accuracy track record, pricing, and exactly who they're best suited for — so you can choose with confidence.
        </p>
      </div>

      <div class="reader-grid stagger">
        {readers.map(reader => (
          <ReaderCard
            name={reader.platformName}
            slug={reader.slug}
            platform="kasamba"
            rating={reader.rating}
            verdict={reader.verdict}
            pricing={reader.pricing}
            bestFor={reader.bestFor}
            affiliateUrl={reader.affiliateUrl}
            freeOffer={reader.freeOffer}
            avatarUrl={reader.avatarUrl}
          />
        ))}
      </div>
    </section>
  )}

  <FAQ items={faqItems} title={`${frontmatter.platformName} FAQ`} />

  <!-- Cross-linking to comparisons, guides, and other platforms -->
  <RelatedContent title="Related Reading" items={relatedItems} />

  <!-- Link back to all platform reviews -->
  <div class="all-reviews-cta">
    <a href="/reviews/" class="btn btn--ghost">← Back to All Platform Reviews</a>
  </div>
</ReviewLayout>

<style>
  .featured-roundup-box {
    margin: var(--space-10) 0;
  }

  .roundup-card {
    background: linear-gradient(to right, #fff, var(--color-bg-alt));
    border: 1px solid var(--color-accent);
    padding: var(--space-8);
    position: relative;
    overflow: hidden;
  }

  .roundup-badge {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background: var(--color-accent);
    color: var(--color-primary-dark);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .roundup-title {
    margin-top: 0;
    margin-bottom: var(--space-3);
    font-size: var(--text-2xl);
    color: var(--color-primary-dark);
    max-width: 85%;
  }

  .roundup-desc {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
    max-width: 700px;
  }

  .reader-reviews-section {
    margin: var(--space-10) 0;
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .section-intro {
    margin-bottom: var(--space-8);
  }

  .section-eyebrow {
    display: block;
    margin-bottom: var(--space-2);
    letter-spacing: 0.15em;
  }

  .section-heading {
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  .section-description {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    max-width: 600px;
  }

  .reader-grid {
    /* Global styles live in src/styles/global.css */
  }

  .all-reviews-cta {
    margin-top: var(--space-8);
    text-align: center;
  }

  @media (max-width: 768px) {
    .roundup-badge {
      position: static;
      display: inline-block;
      margin-bottom: var(--space-3);
    }
    .roundup-title {
      max-width: 100%;
    }
  }
</style>
