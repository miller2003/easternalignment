---
/**
 * /match —— Spiritual Intent Router + 个性化推荐引擎
 *
 * 这一层只做三件事：
 *   1. 在构建期把内容索引（162 位读者 / 112 篇指南）算好并压成精简 JSON
 *   2. 调 BaseLayout 输出外壳与样式
 *   3. 挂载 src/match/app.ts
 *
 * 所有业务逻辑在 src/match/{engine,config,content}，所有渲染在 src/match/ui。
 * 这里不再出现任何内联脚本、内联样式或 DOM 拼接。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { affiliateLinks } from '../data/affiliateLinks';
import { classifyReader, type RawReader } from '../match/content/readerClassifier';
import { buildArticle } from '../match/content/articleClassifier';
import type { ReaderMatchMetadata, ArticleMetadata } from '../match/types';
import '../match/styles/match.css';

/* ── 1. 读者索引 ──────────────────────────────────────────────────── */

const readerFiles = {
  kasamba: import.meta.glob('../content/readers/kasamba/*.md', { eager: true }),
  'purple-garden': import.meta.glob('../content/readers/purple-garden/*.md', { eager: true }),
  keen: import.meta.glob('../content/readers/keen/*.md', { eager: true }),
} as const;

const knownGoSlugs = new Set(Object.keys(affiliateLinks));
const readers: ReaderMatchMetadata[] = [];
const dropped: string[] = [];

for (const [platform, files] of Object.entries(readerFiles)) {
  for (const [path, mod] of Object.entries(files)) {
    const fm = ((mod as any).frontmatter ?? {}) as Record<string, unknown>;
    const slug = path.split('/').pop()!.replace(/\.md$/, '');
    const raw: RawReader = {
      slug,
      platform: platform as RawReader['platform'],
      platformName: fm.platformName as string | undefined,
      rating: fm.rating as number | undefined,
      affiliateUrl: fm.affiliateUrl as string | undefined,
      avatarUrl: fm.avatarUrl as string | undefined,
      bestFor: fm.bestFor as string | undefined,
      freeOffer: fm.freeOffer as string | undefined,
      unavailable: fm.unavailable as boolean | undefined,
    };

    const goSlug = (raw.affiliateUrl ?? '').replace(/^\/go\//, '').replace(/\/$/, '');
    if (goSlug && !knownGoSlugs.has(goSlug)) {
      dropped.push(`${platform}/${slug} → /go/${goSlug}/ 不存在`);
      continue;
    }

    const classified = classifyReader(raw);
    if (classified) readers.push(classified);
  }
}

// 分值相同时按 slug 稳定排序，保证同一画像每次得到同样的推荐顺序
readers.sort((a, b) => a.slug.localeCompare(b.slug));

/* ── 2. 文章索引 ──────────────────────────────────────────────────── */

const guideFiles = import.meta.glob('../content/guides/*.md', { eager: true });
const articles: ArticleMetadata[] = [];

for (const [path, mod] of Object.entries(guideFiles)) {
  const fm = ((mod as any).frontmatter ?? {}) as Record<string, unknown>;
  const slug = path.split('/').pop()!.replace(/\.md$/, '');
  const title = (fm.title as string) || slug.replace(/-/g, ' ');
  if (!title) continue;
  articles.push(buildArticle(slug, title));
}

articles.sort((a, b) => a.slug.localeCompare(b.slug));

/* ── 3. 构建期体检（问题在这里暴露，而不是等用户点开才发现） ────── */

if (dropped.length) {
  console.warn(`[match] ${dropped.length} 位读者因 /go/ 路由缺失被排除：\n  - ${dropped.join('\n  - ')}`);
}
const noAvatar = readers.filter((r) => !r.avatarUrl);
if (noAvatar.length) console.warn(`[match] ${noAvatar.length} 位读者缺少头像：${noAvatar.map((r) => r.slug).join(', ')}`);
console.log(`[match] 索引完成：读者 ${readers.length} 位，文章 ${articles.length} 篇`);

const readersJson = JSON.stringify(readers);
const articlesJson = JSON.stringify(articles);
---

<BaseLayout
  title="Find Your Spiritual Theme | Eastern Alignment"
  description="Answer seven quick questions and find what your current spiritual theme may be asking you to explore — plus the guides and readers that fit it."
  noindex={true}
  noCta={true}
  hideDisclosure={true}
  bareFooter={true}
>
  <main id="match-root">
    <div id="match-app">
      <section class="m-screen m-screen--center">
        <div class="m-computing">
          <div class="m-orb" aria-hidden="true"></div>
          <p>Preparing your reading…</p>
        </div>
      </section>
    </div>

    <noscript>
      <section class="m-screen m-screen--center">
        <div class="m-landing">
          <h1 class="m-h1">This tool needs JavaScript</h1>
          <p class="m-lede">
            The theme finder runs entirely in your browser — that is what keeps your answers private,
            and it is why it needs JavaScript enabled. In the meantime, these are the most-read pages on the site:
          </p>
          <p class="m-p">
            <a class="m-link" href="/reviews/kasamba/">Kasamba review</a> ·
            <a class="m-link" href="/reviews/purple-garden/">Purple Garden review</a> ·
            <a class="m-link" href="/guides/no-contact-psychic-readings-guide/">No contact and psychic readings</a> ·
            <a class="m-link" href="/guides/how-to-choose-a-psychic-reader/">How to choose a reader</a>
          </p>
        </div>
      </section>
    </noscript>
  </main>

  <script id="match-reader-data" type="application/json" set:html={readersJson}></script>
  <script id="match-article-data" type="application/json" set:html={articlesJson}></script>
</BaseLayout>

<script>
  import '../match/app';
</script>
