</style>
<script>
import type { UserProfile, ReaderMatchMetadata, RecommendationResult, QuizQuestion, QuizOption } from '../match/types';
import { QUIZ_QUESTIONS, getBranchedOptions } from '../match/questions';
import { buildProfile } from '../match/scoring';
import { getRecommendations } from '../match/recommendationEngine';
import { matchAnalytics } from '../match/analytics';
import { persistUTM, getAnonymousId } from '../match/attribution';
import { drawDailyCard, getCardInterpretation, storeDailyCard } from '../match/dailyCard';
import { classifyReader } from '../match/content/readerClassifier';

type ScreenId = 'landing' | 'assessment' | 'computing' | 'result' | 'card';
interface AppState {
  screen: ScreenId;
  questionIndex: number;
  answers: Record<string, string | string[]>;
  profile: UserProfile | null;
  recommendations: RecommendationResult | null;
}
const PROFILE_KEY = 'ea_match_profile';
const state: AppState = { screen: 'landing', questionIndex: 0, answers: {}, profile: null, recommendations: null };

function loadReaderData(): ReaderMatchMetadata[] {
  try {
    const el = document.getElementById('match-reader-data');
    if (!el || !el.textContent) return [];
    const raw = JSON.parse(el.textContent);
    return raw.map((r: any) => classifyReader(r));
  } catch (err) {
    console.error('Failed to load reader data', err);
    return [];
  }
}

function esc(s: string) {
  const p = document.createElement('p');
  p.textContent = s;
  return p.innerHTML;
}

function platformLabel(platform: string) {
  switch (platform) {
    case 'keen': return 'Keen';
    case 'kasamba': return 'Kasamba';
    case 'purple-garden': return 'Purple Garden';
    default: return platform;
  }
}

function suitEmoji(suit: string) {
  switch(suit.toLowerCase()) {
    case 'major': return '✦';
    case 'wands': return '🔥';
    case 'cups': return '💧';
    case 'swords': return '⚡';
    case 'pentacles': return '🌿';
    default: return '✦';
  }
}

function render() {
  const app = document.getElementById('match-app');
  if (!app) return;
  app.innerHTML = '';
  
  if (state.screen === 'landing') {
    app.appendChild(renderLanding());
  } else if (state.screen === 'assessment') {
    app.appendChild(renderAssessment());
  } else if (state.screen === 'computing') {
    app.appendChild(renderComputing());
  } else if (state.screen === 'result') {
    app.appendChild(renderResult());
  } else if (state.screen === 'card') {
    app.appendChild(renderCard());
  }
}

function renderLanding(): HTMLElement {
  const div = document.createElement('div');
  div.className = 'match-screen landing-screen';
  div.innerHTML = `
    <div class="landing-badge">✦ Spiritual Clarity</div>
    <h1 class="landing-headline">What's Really Going On In Your Life Right Now?</h1>
    <p class="landing-subtext">Answer a few quick questions and discover what your current spiritual theme may be asking you to explore.</p>
    <button id="start-btn" class="landing-cta-primary">Find My Spiritual Theme &rarr;</button>
    <button id="card-btn" class="landing-cta-secondary">I just want to draw a daily card</button>
    <div class="landing-trust">
      <span>✦ Takes about 2 minutes</span>
      <span>✦ No sign-up required</span>
      <span>✦ Personalized to you</span>
    </div>
  `;
  
  div.querySelector('#start-btn')?.addEventListener('click', () => {
    matchAnalytics.quizStarted('hero_cta');
    state.screen = 'assessment';
    state.questionIndex = 0;
    render();
  });
  
  div.querySelector('#card-btn')?.addEventListener('click', () => {
    matchAnalytics.dailyCardStarted();
    state.screen = 'card';
    render();
  });
  
  return div;
}

function renderAssessment(): HTMLElement {
  const q = QUIZ_QUESTIONS[state.questionIndex];
  if (!q) return renderLanding();
  
  const div = document.createElement('div');
  div.className = 'match-screen';
  
  const inner = document.createElement('div');
  inner.className = 'assessment-screen';
  
  const progress = document.createElement('div');
  progress.className = 'progress-track';
  for (let i = 0; i < QUIZ_QUESTIONS.length; i++) {
    const seg = document.createElement('div');
    seg.className = `progress-segment ${i < state.questionIndex ? 'filled' : i === state.questionIndex ? 'current' : ''}`;
    progress.appendChild(seg);
  }
  
  const step = document.createElement('span');
  step.className = 'question-step';
  step.textContent = `Question ${state.questionIndex + 1} of ${QUIZ_QUESTIONS.length}`;
  
  const title = document.createElement('h2');
  title.className = 'question-text';
  title.textContent = q.text;
  
  inner.appendChild(progress);
  inner.appendChild(step);
  inner.appendChild(title);
  
  if (q.subtext) {
    const sub = document.createElement('p');
    sub.className = 'question-subtext';
    sub.textContent = q.subtext;
    inner.appendChild(sub);
  }
  
  const currentAnswer = state.answers[q.id];
  let continueDisabled = true;
  
  if (q.type === 'single') {
    const optsGrid = document.createElement('div');
    optsGrid.className = 'options-grid';
    
    const opts = getBranchedOptions(q, state.answers);
    opts.forEach(opt => {
      const btn = document.createElement('button');
      btn.className = `option-btn ${currentAnswer === opt.id ? 'selected' : ''}`;
      btn.setAttribute('data-option', opt.id);
      btn.textContent = opt.text;
      btn.addEventListener('click', () => {
        state.answers[q.id] = opt.id;
        matchAnalytics.questionAnswered(q.id, opt.id);
        
        if (state.questionIndex < QUIZ_QUESTIONS.length - 1) {
          advanceOrFinish();
        } else {
          render(); // just update selected state, user clicks continue
        }
      });
      optsGrid.appendChild(btn);
    });
    inner.appendChild(optsGrid);
    continueDisabled = !currentAnswer;
  } else if (q.type === 'freetext') {
    const txt = document.createElement('textarea');
    txt.className = 'freetext-area';
    txt.id = 'freetext-input';
    txt.placeholder = 'Type your thoughts here...';
    txt.value = (currentAnswer as string) || '';
    txt.addEventListener('input', (e) => {
      const v = (e.target as HTMLTextAreaElement).value;
      state.answers[q.id] = v;
      const cbtn = document.getElementById('continue-btn') as HTMLButtonElement;
      if (cbtn) cbtn.disabled = v.trim().length === 0;
    });
    inner.appendChild(txt);
    continueDisabled = !(currentAnswer && (currentAnswer as string).trim().length > 0);
  }
  
  const nav = document.createElement('div');
  nav.className = 'nav-row';
  
  if (state.questionIndex > 0) {
    const backBtn = document.createElement('button');
    backBtn.className = 'back-btn';
    backBtn.textContent = '← Back';
    backBtn.addEventListener('click', () => {
      matchAnalytics.backNavigated(state.questionIndex);
      state.questionIndex--;
      render();
    });
    nav.appendChild(backBtn);
  } else {
    nav.appendChild(document.createElement('div'));
  }
  
  const isLast = state.questionIndex === QUIZ_QUESTIONS.length - 1;
  const rightNav = document.createElement('div');
  
  if (q.type === 'freetext') {
    const skipBtn = document.createElement('button');
    skipBtn.className = 'skip-btn';
    skipBtn.textContent = 'Skip';
    skipBtn.style.marginRight = '1rem';
    skipBtn.addEventListener('click', () => {
      state.answers[q.id] = '';
      advanceOrFinish();
    });
    rightNav.appendChild(skipBtn);
  }
  
  const contBtn = document.createElement('button');
  contBtn.className = 'continue-btn';
  contBtn.id = 'continue-btn';
  contBtn.textContent = isLast ? 'See My Reading →' : 'Continue →';
  contBtn.disabled = continueDisabled;
  contBtn.addEventListener('click', advanceOrFinish);
  rightNav.appendChild(contBtn);
  
  nav.appendChild(rightNav);
  inner.appendChild(nav);
  
  div.appendChild(inner);
  return div;
}

function advanceOrFinish() {
  if (state.questionIndex < QUIZ_QUESTIONS.length - 1) {
    state.questionIndex++;
    render();
  } else {
    state.screen = 'computing';
    render();
    
    setTimeout(async () => {
      const profile = buildProfile(state.answers);
      state.profile = profile;
      matchAnalytics.quizCompleted(profile);
      
      const readers = loadReaderData();
      const recs = getRecommendations(profile, readers);
      state.recommendations = recs;
      
      localStorage.setItem(PROFILE_KEY, JSON.stringify({
        profile,
        timestamp: Date.now()
      }));
      
      state.screen = 'result';
      render();
      
      matchAnalytics.resultViewed(profile);
      if (recs.readers.length > 0) {
        matchAnalytics.readerImpressions(recs.readers.map(r => r.slug));
      }
    }, 1800);
  }
}

function renderComputing(): HTMLElement {
  const div = document.createElement('div');
  div.className = 'match-screen computing-screen';
  div.innerHTML = `
    <div class="computing-orb"></div>
    <h2>Reading your energy&hellip;</h2>
    <p style="color:var(--color-text-muted); margin-top:0.5rem">Connecting your answers to spiritual themes</p>
  `;
  return div;
}

function renderResult(): HTMLElement {
  if (!state.recommendations || !state.profile) return renderLanding();
  
  const recs = state.recommendations;
  const n = recs.narrative;
  const div = document.createElement('div');
  div.className = 'match-screen';
  
  const inner = document.createElement('div');
  inner.className = 'result-screen';
  
  // 1. Theme
  inner.innerHTML += `
    <div class="result-badge">✦ Your Spiritual Theme</div>
    <h1 class="result-theme">${esc(n.theme)}</h1>
  `;
  
  // 2. Summary
  inner.innerHTML += `<div class="result-section-label">What may be happening</div>`;
  const summaryDiv = document.createElement('div');
  summaryDiv.className = 'result-paragraphs';
  n.summary.forEach(p => {
    summaryDiv.innerHTML += `<p>${esc(p)}</p>`;
  });
  inner.appendChild(summaryDiv);
  
  // 3. Deeper Question
  inner.innerHTML += `<blockquote class="deeper-question">${esc(n.deeperQuestion)}</blockquote>`;
  
  inner.innerHTML += `<hr class="result-divider" />`;
  
  // 5. What Next
  inner.innerHTML += `<div class="result-section-label">What to explore next</div>`;
  const wnl = document.createElement('div');
  wnl.className = 'what-next-list';
  n.whatNext.forEach((item, i) => {
    wnl.innerHTML += `
      <div class="what-next-item">
        <div class="what-next-icon">${i + 1}</div>
        <div>${esc(item)}</div>
      </div>
    `;
  });
  inner.appendChild(wnl);
  
  inner.innerHTML += `<hr class="result-divider" />`;
  
  // 7. Readers
  if (recs.readers.length > 0) {
    inner.innerHTML += `<div class="result-section-label">Readers who may fit your situation</div>`;
    const rGrid = document.createElement('div');
    rGrid.className = 'reader-cards-grid';
    recs.readers.forEach(r => {
      const card = document.createElement('div');
      card.className = 'reader-match-card';
      const av = r.avatarUrl 
        ? `<img src="${esc(r.avatarUrl)}" alt="${esc(r.slug)}" class="reader-avatar" />`
        : `<div class="reader-avatar-placeholder"></div>`;
      
      const freeOffer = r.freeOffer ? `<div style="font-size:var(--text-xs); color:var(--color-primary); font-weight:bold; margin-bottom:0.5rem">${esc(r.freeOffer)}</div>` : '';
      
      card.innerHTML = `
        ${av}
        <div class="reader-card-name">${esc(r.slug.replace(/-/g, ' '))}</div>
        <div class="reader-card-platform">${esc(platformLabel(r.platform))}</div>
        <div class="reader-card-rating">★ ${r.rating}</div>
        <div class="reader-card-bestfor">${esc(r.bestFor || 'General reading')}</div>
        ${freeOffer}
        <a href="${esc(r.affiliateUrl)}" target="_blank" rel="sponsored noopener noreferrer" class="reader-card-cta" data-slug="${esc(r.slug)}">View Profile</a>
      `;
      rGrid.appendChild(card);
    });
    
    rGrid.querySelectorAll('.reader-card-cta').forEach(a => {
      a.addEventListener('click', (e) => {
        const slug = (e.currentTarget as HTMLElement).getAttribute('data-slug');
        if (slug) matchAnalytics.readerClicked(slug);
      });
    });
    
    inner.appendChild(rGrid);
    inner.innerHTML += `<hr class="result-divider" />`;
  }
  
  // 9. Article
  if (recs.articles.length > 0) {
    const art = recs.articles[0];
    const artCard = document.createElement('div');
    artCard.className = 'article-card';
    artCard.innerHTML = `
      <div class="result-section-label">Recommended Reading</div>
      <div class="article-card-title">${esc(art.title)}</div>
      <a href="${esc(art.url)}" class="article-card-link" data-url="${esc(art.url)}">Read the guide &rarr;</a>
    `;
    
    artCard.querySelector('.article-card-link')?.addEventListener('click', (e) => {
      matchAnalytics.articleClicked(art.url);
    });
    
    inner.appendChild(artCard);
    inner.innerHTML += `<hr class="result-divider" />`;
  }
  
  // 11. Draw Card
  inner.innerHTML += `
    <div style="text-align:center">
      <div class="result-section-label">Need a specific message today?</div>
      <p style="color:var(--color-text-muted); margin-bottom:1rem">Draw a tarot card for immediate daily insight based on your current theme.</p>
      <button id="draw-card-btn" class="card-draw-btn">Draw Today's Card ✦</button>
    </div>
    <hr class="result-divider" />
  `;
  
  // 13. Email Section
  const emailSec = document.createElement('div');
  emailSec.className = 'email-section';
  emailSec.innerHTML = `
    <div class="email-section-title">Save your reading & get deeper insights</div>
    <p style="margin-bottom:1.5rem">We'll send you a copy of this reading, plus follow-up guidance on <strong>${esc(recs.recommended_email_topic.toLowerCase())}</strong>.</p>
    <form id="email-form" class="email-form">
      <input type="email" class="email-input" placeholder="Your best email" required />
      <button type="submit" class="email-submit-btn">Send My Reading</button>
    </form>
    <div id="email-msg" class="email-privacy">No spam, unsubscribe anytime.</div>
  `;
  
  inner.appendChild(emailSec);
  
  // 14. Disclaimer
  inner.innerHTML += `<div class="match-disclaimer">For entertainment purposes only. Not professional psychological, financial, or medical advice.</div>`;
  
  div.appendChild(inner);
  
  // Add listeners
  setTimeout(() => {
    matchAnalytics.emailFormViewed(state.profile!);
    
    const drawBtn = div.querySelector('#draw-card-btn');
    if (drawBtn) {
      drawBtn.addEventListener('click', () => {
        state.screen = 'card';
        render();
      });
    }
    
    const form = div.querySelector('#email-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = (form.querySelector('input') as HTMLInputElement).value;
        if (email) {
          matchAnalytics.emailSubmitted();
          const msg = div.querySelector('#email-msg');
          if (msg) {
            msg.className = 'email-success';
            msg.textContent = 'Reading sent! Check your inbox shortly.';
          }
        }
      });
    }
  }, 0);
  
  return div;
}

function renderCard(): HTMLElement {
  const anonId = getAnonymousId();
  const card = drawDailyCard(anonId);
  const interp = getCardInterpretation(card, state.profile || undefined);
  
  storeDailyCard({
    date: new Date().toISOString().split('T')[0],
    card,
    interpretation: interp,
    profile: state.profile || undefined
  });
  
  matchAnalytics.dailyCardCompleted(card.name, state.profile || undefined);
  
  const div = document.createElement('div');
  div.className = 'match-screen';
  
  const inner = document.createElement('div');
  inner.className = 'card-screen';
  
  inner.innerHTML = `
    <div class="result-badge">✦ Daily Insight</div>
    <h2 style="font-family:var(--font-heading); font-size:var(--text-3xl); margin-bottom:2rem">${esc(card.name)}</h2>
    
    <div class="card-face">
      <div class="card-face-orb">${suitEmoji(card.suit)}</div>
      <div class="card-face-name">${esc(card.name)}</div>
      <div class="card-face-suit">${esc(card.suit)}</div>
    </div>
    
    <p class="card-meaning">${esc(interp.text)}</p>
    <blockquote class="card-reflection"><strong>Reflection:</strong> ${esc(interp.reflection)}</blockquote>
  `;
  
  if (state.profile) {
    const btn = document.createElement('button');
    btn.className = 'card-back-link';
    btn.textContent = '← Back to your full reading';
    btn.addEventListener('click', () => {
      state.screen = 'result';
      render();
    });
    inner.appendChild(btn);
  } else {
    inner.innerHTML += `<p style="margin-bottom:1rem">Want deeper clarity on what's going on in your life?</p>`;
    const btn = document.createElement('button');
    btn.className = 'card-draw-btn';
    btn.textContent = 'Get your full spiritual reading →';
    btn.addEventListener('click', () => {
      state.screen = 'assessment';
      state.questionIndex = 0;
      render();
    });
    inner.appendChild(btn);
  }
  
  inner.innerHTML += `<div class="match-disclaimer">For entertainment purposes only.</div>`;
  div.appendChild(inner);
  
  return div;
}

function boot() {
  persistUTM();
  try {
    const saved = localStorage.getItem(PROFILE_KEY);
    if (saved) {
      const data = JSON.parse(saved);
      // If less than 30 days old
      if (Date.now() - data.timestamp < 30 * 24 * 60 * 60 * 1000) {
        state.profile = data.profile;
        const readers = loadReaderData();
        state.recommendations = getRecommendations(data.profile, readers);
        // We could jump to result, but UX-wise let's let them start again or we can restore state.
        // For now, we just have it in memory if they want to.
      }
    }
  } catch (e) {
    // ignore
  }
  
  render();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', boot);
} else {
  boot();
}
</script>