---
/**
 * src/pages/match.astro
 *
 * Dedicated Situation-Based Reader Match page.
 *
 * Layout (2026-10-02 redesign): the quiz no longer sits flat in the page.
 * The hero carries one gold CTA; the 7-question match runs in the shared
 * bottom-sheet overlay (ReaderMatch mode="modal" launcher="none"). The rest
 * of the page explains what the match returns, how each answer is weighted,
 * what it searches, and how to use the result — all numbers computed from
 * readers.json / offers.ts at build time, never hand-written.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import ReaderMatch from '../components/ReaderMatch.astro';
import FAQ from '../components/FAQ.astro';
import readersData from '../data/readers.json';
import { PLATFORM_OFFERS, PLATFORM_PRIORITY, goPath, type PlatformKey } from '../lib/offers';
import { buildWebApplication } from '../lib/toolSchema';
import Breadcrumb from '../components/Breadcrumb.astro';
import { auditStats } from '../lib/auditStats';
import { webPageNode, isoMax, fmtDate, PLATFORM_ORGS, TOPIC_ENTITIES } from '../lib/seo';
import pageMeta from '../data/page-meta.json';

const SITE_URL = 'https://easternalignment.com';
const readers = readersData as any[];
const totalReaders = readers.length;

/* ---- per-platform coverage, straight from the match dataset ---- */
const median = (xs: number[]) => {
  const s = [...xs].sort((a, b) => a - b);
  return s.length ? s[Math.floor(s.length / 2)] : 0;
};
const PLATFORM_FORMAT_NOTE: Record<PlatformKey, string> = {
  kasamba: 'Chat and phone. Chat sessions leave a saved transcript you can re-read later.',
  'purple-garden': 'The only platform with live video, plus chat and phone. Most readers post an intro video.',
  keen: 'Phone-first, with chat. Best if you think out loud and want a live back-and-forth.',
};
const platforms = PLATFORM_PRIORITY.map((key) => {
  const list = readers.filter((r) => r.platform === key);
  const rates = list.map((r) => r.pricePerMinute).filter((n: number) => Number.isFinite(n));
  return {
    key,
    name: PLATFORM_OFFERS[key].name,
    offer: PLATFORM_OFFERS[key].offer,
    count: list.length,
    medianRate: median(rates).toFixed(2),
    note: PLATFORM_FORMAT_NOTE[key],
    review: `/reviews/${key}/`,
    go: goPath(key),
  };
});
const videoCount = readers.filter((r) => (r.formats || []).includes('video')).length;

/* ---- the quiz steps and the points each one carries (engine/scoring.ts).
   weight 0 = shapes the written reading, not the ranking ---- */
const steps = [
  { label: 'What’s weighing on you', detail: 'A relationship, someone new, an ex, work or money, a big decision, someone you’ve lost, or something you can’t name yet.', weight: 35, note: 'Weighs the most. A reader’s documented track record on your type of question.' },
  { label: 'What’s actually happening', detail: 'Pulling away, hot and cold, no contact, a job offer… each area has its own options.', weight: 15, note: 'Separates readers who read other people from readers who coach you.' },
  { label: 'How long, how it feels, what you hope to hear', detail: 'Three quick taps about where you are emotionally.', weight: 0, note: 'Shapes your written reading and opening question. It never changes who ranks first.' },
  { label: 'Draw a card', detail: 'Pick one of three face-down tarot cards for your situation.', weight: 0, note: 'Part of your reading, not the ranking.' },
  { label: 'Reading style', detail: 'Pick up to two: straight to the point, gentle, practical, deep, or quick.', weight: 8, note: 'Matched against the styles clients actually describe in reviews.' },
  { label: 'Reading method', detail: 'Psychic, tarot, astrology, or let us choose. Grief questions always go to mediums.', weight: 20, note: 'Exact specialty scores higher than a side practice.' },
  { label: 'Chat, phone or video', detail: 'Or no preference.', weight: 10, note: 'Also a hard filter: readers who don’t offer your format are removed.' },
];

/* ---- browse-instead routes (existing guides only) ---- */
const situationRoutes = [
  { label: 'They went silent / no contact', href: '/guides/no-contact-psychic-readings-guide/' },
  { label: 'After a breakup', href: '/guides/best-psychics-for-breakups/' },
  { label: 'What is one person thinking?', href: '/guides/kasamba-specific-person-reading/' },
  { label: 'Love questions with tarot', href: '/guides/best-tarot-readers-for-love/' },
  { label: 'Career or money', href: '/guides/career-and-money-psychic-readings/' },
  { label: 'Reaching someone who passed', href: '/guides/evidential-mediums-passed-spouse/' },
  { label: 'My first reading ever', href: '/guides/first-psychic-reading-guide/' },
];

const matchFAQs = [
  {
    question: 'How does the match pick advisors?',
    answer: `It scores every active advisor in our dataset (${totalReaders} profiles across Kasamba, Purple Garden and Keen) out of 100 points: situation fit 35, reading method 20, what’s actually happening 15, format 10 and style 8. The last 12 points (price and live availability) are held level for everyone until we have live availability data, so they never change the order. The scores come from our own audit notes on each reader, not from an AI guessing. The same answers always return the same shortlist.`,
  },
  {
    question: 'Why not just book the highest-rated reader on the platform?',
    answer: 'Because a rating measures popularity, not fit. A reader with thousands of five-star reviews for life-path astrology can be the wrong person for decoding an ex’s silence. The match ranks readers on the kind of question you’re asking, then uses ratings and review volume as supporting evidence.',
  },
  {
    question: 'How do the intro offers work, and how should I use them?',
    answer: `Kasamba gives new clients ${PLATFORM_OFFERS.kasamba.offer} (the free minutes apply with each new advisor), Purple Garden gives ${PLATFORM_OFFERS['purple-garden'].offer}, and Keen gives ${PLATFORM_OFFERS.keen.offer}. Treat those first minutes as an audition: ask the opening question the match gives you, and end the session inside the intro window if the reader stays vague.`,
  },
  {
    question: 'Chat, phone or video: which should I choose?',
    answer: `Chat keeps a written transcript you can check against what happens later. Phone suits people who think out loud. Video lets you see the reader and the cards, but only Purple Garden offers it, so choosing video narrows the match to ${videoCount} advisors. If you have no preference, say so; you’ll get the widest pool.`,
  },
  {
    question: 'What happens to my answers?',
    answer: 'The matching runs in your browser, and you never type your name, email or a description of your situation. We log anonymous usage events (which step you reached and which option you tapped) so we can see where the quiz is confusing. They aren’t tied to your identity and we don’t sell them.',
  },
  {
    question: 'Does the match tell me which psychic is the most accurate?',
    answer: 'No. Nobody can verify psychic accuracy from the outside, and we don’t put a percentage on it. The match ranks how well a reader fits your kind of question, format and style, based on our audit notes. The intro minutes are how you test the reader: ask one specific question and see whether the answer is specific and checkable.',
  },
  {
    question: 'Is the reader match free, and do I need an account?',
    answer: 'It is free and needs no account, email or description of your situation; it takes about two minutes and runs in your browser. We may earn a commission if you book through our links, which never changes who ranks first.',
  },
  {
    question: 'Is the match paid placement?',
    answer: 'No. Readers can’t buy a higher score. We do earn a commission if you book through our links, which is why every match also tells you when to skip that reader.',
  },
];

/* ---- the short version: five rules for choosing a reader.
   One list feeds the visible section AND the HowTo schema, so they can't drift.
   Plain text only (schema text must not carry markup). ---- */
const overallMedian = median(readers.map((r) => r.pricePerMinute).filter((n: number) => Number.isFinite(n)));
const chooseRules = [
  {
    name: 'Start with your question, not the rating',
    text: 'Reading what another person is thinking, coaching you through a decision and reaching someone who has died are different skills. Choose the reader who is documented as good at yours; a high rating mostly reflects seniority and review volume.',
  },
  {
    name: 'Match the method to the question',
    text: 'Tarot is good at mapping patterns and obstacles. Direct intuitive readers are blunter and quicker. A medium should be judged on one thing: details about the person who died that you recognize and did not supply.',
  },
  {
    name: 'Pick the format you will be comfortable in',
    text: `Chat leaves a transcript you can check against what happens later, phone suits people who think out loud, and video lets you see the reader (only Purple Garden offers it, so choosing video narrows the match to ${videoCount} advisors).`,
  },
  {
    name: 'Judge the cost of a useful answer, not the per-minute rate',
    text: `The median listed rate across the ${totalReaders} advisors we audited is $${overallMedian.toFixed(2)} a minute, but a focused chat reader at $4.99 a minute can tell you more in eight minutes than a slow reader at half the rate does in twenty.`,
  },
  {
    name: 'Audition before you pay',
    text: `Use the new-client minutes (Kasamba: ${PLATFORM_OFFERS.kasamba.offer}; Purple Garden: ${PLATFORM_OFFERS['purple-garden'].offer}; Keen: ${PLATFORM_OFFERS.keen.offer}) to ask one specific question with as little backstory as possible. End the session if the answers are vague, pressure you to buy more minutes, or diagnose a curse.`,
  },
];

const modifiedISO = isoMax(pageMeta.match.updated, auditStats.lastUpdated);
const seoTitle = 'How to Choose a Psychic: Free 2-Minute Reader Match Quiz (2026)';
const metaDescription = `Not sure which psychic to book? Take our free 2-minute match: describe your situation and get 3 advisors from ${totalReaders} audited profiles. No sign-up.`;

const pageUrl = `${SITE_URL}/match/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    webPageNode({
      url: pageUrl,
      name: 'Psychic Reader Match',
      headline: seoTitle,
      description: metaDescription,
      type: 'WebPage',
      datePublished: pageMeta.match.published,
      dateModified: modifiedISO,
      about: [TOPIC_ENTITIES.psychic, TOPIC_ENTITIES.tarot, TOPIC_ENTITIES.mediumship, TOPIC_ENTITIES.astrology],
      mentions: PLATFORM_ORGS,
      speakable: ['.mt-title', '#how-to-choose .mt-rules-lede'],
      mainEntityId: `${pageUrl}#webapp`,
    }),
    {
      '@type': 'HowTo',
      '@id': `${pageUrl}#howto`,
      name: 'How to choose the right psychic reader',
      description: 'Five rules for choosing an online psychic reader: start with the question, match the method, pick the format, judge the cost of a useful answer, and audition before you pay.',
      step: chooseRules.map((r, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: r.name,
        text: r.text,
        url: `${pageUrl}#how-to-choose`,
      })),
    },
    {
      ...buildWebApplication({
      name: 'Eastern Alignment Reader Match',
      url: pageUrl,
      description: `A free situation-first quiz that writes you a short personal reading, then matches your situation, preferred reading method, format and style against ${totalReaders} audited psychic advisor profiles on Kasamba, Purple Garden and Keen.`,
      applicationSubCategory: 'Psychic advisor matching',
      featureList: [
        'Situation-based scoring across 5 weighted factors',
        'A personal reading built from your answers, with a tarot card draw',
        'Top 3 advisor shortlist with reasons and when-to-skip notes',
        'Suggested opening question for your intro minutes',
        'Runs in the browser, no sign-up',
      ],
    }),
      inLanguage: 'en-US',
      isAccessibleForFree: true,
      datePublished: pageMeta.match.published,
      dateModified: modifiedISO,
      mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
    },
  ],
};
---

<BaseLayout
  title="Psychic Reader Match: Find the Right Advisor for Your Situation (2026)"
  description={metaDescription}
  seoTitle={seoTitle}
  metaDescription={metaDescription}
  modifiedTime={modifiedISO}
  publishedTime={pageMeta.match.published}
  jsonLd={jsonLd}
>
  <!-- ═══ 1. HERO — the promise + one gold action ═══ -->
  <header class="mt-hero">
    <div class="container container--narrow mt-hero-inner">
      <div class="mt-crumb"><Breadcrumb items={[{ label: 'Reader Match' }]} /></div>
      <span class="mt-kicker">Free · About 2 minutes · No sign-up</span>
      <h1 class="hero-title mt-title">
        How to Choose the Right Psychic Reader <br />
        <span class="text-gradient">for Your Exact Situation</span>
      </h1>
      <p class="mt-sub">
        No reader is the best for everyone. The right one depends on what you’re asking about,
        and how you like to be read. Tell us what’s going on, get a short reading of your situation, and we’ll narrow
        {totalReaders} audited advisors down to the 3 who fit.
      </p>

      <div class="mt-cta-wrap">
        <a href="#start" class="mt-cta" data-match-open data-cta-source="match-hero">
          <span class="mt-cta-spark" aria-hidden="true">✦</span>
          <span data-match-open-label>Find My Reader →</span>
        </a>
        <p class="mt-cta-retake" data-match-retake-wrap style="display: none;">
          Want a fresh result? <button type="button" data-match-retake>Start over</button>
        </p>
      </div>

      <ul class="mt-assure" aria-label="About the match">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.5l5 5 10-11"/></svg>
          {totalReaders} audited advisors
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.4-3 8.4-7 10-4-1.6-7-5.6-7-10V6l7-3z"/></svg>
          No sign-up, no email
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg>
          Readers can’t pay to rank
        </li>
      </ul>
      <p class="mt-updated">
        Advisor data and scoring last updated <time datetime={modifiedISO}>{fmtDate(modifiedISO)}</time>
      </p>
    </div>
  </header>

  <!-- ═══ 1b. THE SHORT VERSION — five rules (also the HowTo schema) ═══ -->
  <section class="section mt-section mt-section--tight" id="how-to-choose">
    <div class="container container--narrow">
      <header class="mt-head">
        <p class="mt-eyebrow">The short version</p>
        <h2 class="mt-h2">How to choose a psychic reader: five rules</h2>
        <p class="mt-desc mt-rules-lede">
          Prefer to decide without the quiz? These are the rules the match is built on, from our testing on
          Kasamba, Purple Garden and Keen.
        </p>
      </header>
      <ol class="mt-protocol mt-rules">
        {chooseRules.map((r) => (
          <li>
            <h3>{r.name}</h3>
            <p>{r.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ 2. WHAT YOU GET — set expectations for the result screen ═══ -->
  <section class="section mt-section">
    <div class="container">
      <header class="mt-head">
        <p class="mt-eyebrow">What you’ll get</p>
        <h2 class="mt-h2">A shortlist you can act on in the next ten minutes</h2>
      </header>
      <div class="mt-gets">
        <article class="mt-get">
          <span class="mt-get-num">01</span>
          <h3>A read on your situation</h3>
          <p>The core dynamic in plain words, what’s already clear, and what a reading can actually help with.</p>
        </article>
        <article class="mt-get mt-get--feature">
          <span class="mt-get-num">02</span>
          <h3>Three advisors, ranked</h3>
          <p>Each with a fit score, the reasons they made the list, their rate and intro offer, and <strong>when to skip them</strong>.</p>
        </article>
        <article class="mt-get">
          <span class="mt-get-num">03</span>
          <h3>Your opening question</h3>
          <p>One sentence to copy into the intro minutes, so you can tell within two minutes whether the reader is any good.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══ 3. HOW IT WORKS — the quiz steps and their weights ═══ -->
  <section class="section section--alt mt-section">
    <div class="container container--narrow">
      <header class="mt-head">
        <p class="mt-eyebrow">How the match works</p>
        <h2 class="mt-h2">Your situation first, then 100 points</h2>
        <p class="mt-desc">
          Every advisor is scored out of 100. The bar shows how many points each answer controls,
          so you can see why your situation matters more than anything else.
        </p>
      </header>
      <ol class="mt-steps">
        {steps.map((s, i) => (
          <li class="mt-step">
            <span class="mt-step-n">{i + 1}</span>
            <div class="mt-step-body">
              <div class="mt-step-top">
                <h3>{s.label}</h3>
                <span class="mt-step-pts">{s.weight ? `${s.weight} pts` : "Your reading"}</span>
              </div>
              <p class="mt-step-detail">{s.detail}</p>
              {s.weight > 0 && <div class="mt-bar" aria-hidden="true"><span style={`width: ${(s.weight / 35) * 100}%`}></span></div>}
              <p class="mt-step-note">{s.note}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="mt-inline-cta">
        <a href="#start" class="mt-cta mt-cta--sm" data-match-open data-cta-source="match-howitworks">
          <span data-match-open-label>Start My Reading →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ 4. COVERAGE — what the match actually searches ═══ -->
  <section class="section mt-section">
    <div class="container">
      <header class="mt-head">
        <p class="mt-eyebrow">What the match searches</p>
        <h2 class="mt-h2">{totalReaders} advisors on three platforms we’ve tested</h2>
        <p class="mt-desc">
          Every profile has been through our review. Your format answer decides which platforms are in play.
        </p>
      </header>
      <div class="mt-plats">
        {platforms.map((p) => (
          <article class="mt-plat">
            <div class="mt-plat-top">
              <h3>{p.name}</h3>
              <span class="mt-plat-count"><strong>{p.count}</strong> advisors</span>
            </div>
            <p class="mt-plat-note">{p.note}</p>
            <dl class="mt-plat-facts">
              <div><dt>Median rate</dt><dd>${p.medianRate}/min</dd></div>
              <div><dt>New-client offer</dt><dd>{p.offer}</dd></div>
            </dl>
            <a href={p.review} class="mt-plat-link">Read our {p.name} review →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 5. EDITORIAL — why rating ≠ fit ═══ -->
  <section class="section section--alt mt-section">
    <div class="container container--narrow prose mt-prose">
      <h2>Why the top-rated reader is often the wrong one</h2>
      <p>
        Most people book the reader at the top of the platform’s homepage. On Kasamba, Purple Garden
        and Keen, that spot mostly reflects seniority and review volume. It says little about whether
        the reader is any good with your kind of question. In our reviews, skill turned out to be
        narrow in three ways:
      </p>
      <ul>
        <li>
          <strong>Reading another person vs. coaching you.</strong> To find out what an ex is
          thinking during no contact, you need a reader who reads the other person. A coaching-style
          reader will answer with advice on self-love, however good they are at it.
        </li>
        <li>
          <strong>The method has to suit the question.</strong> Tarot is good at mapping patterns and
          obstacles. Direct intuitive readers are blunter and quicker. Mediumship should be judged on
          one thing: details about the person who died that you can recognize.
        </li>
        <li>
          <strong>Pace matters more than price per minute.</strong> A focused chat reader at $4.99/min
          can tell you more in eight minutes than a slow reader at half the rate tells you in twenty.
          Judge the total cost of a useful answer, not the per-minute rate.
        </li>
      </ul>
      <p>
        The match is built around those three points, which is why it asks about your situation and
        whose head you need read before it asks about price.
      </p>
    </div>
  </section>

  <!-- ═══ 6. AFTER THE MATCH — the audition protocol ═══ -->
  <section class="section mt-section">
    <div class="container container--narrow">
      <header class="mt-head">
        <p class="mt-eyebrow">After you get your matches</p>
        <h2 class="mt-h2">Use the intro minutes as an audition</h2>
        <p class="mt-desc">
          Every platform gives new clients a cheap or free start. Here’s how we use it in our own testing.
        </p>
      </header>
      <ol class="mt-protocol">
        <li>
          <h3>Lead with one specific question</h3>
          <p>Use the opening question from your results, or write your own, e.g. <em>“What’s really stopping him from being honest with me?”</em> Skip “what do you see in my future?”</p>
        </li>
        <li>
          <h3>Give as little backstory as possible</h3>
          <p>A first name and, if asked, a birth date. Don’t hint at what you suspect. You want to see what the reader picks up without being told.</p>
        </li>
        <li>
          <h3>Expect something specific within two minutes</h3>
          <p>A good connection produces details you recognize. If you get leading questions or lines that would fit anyone, end the session while you’re still in the intro window.</p>
        </li>
      </ol>
      <div class="mt-flags">
        <p class="mt-flags-title">End the session if you hear:</p>
        <ul>
          <li>“There’s a curse or dark energy on you” followed by an offer to remove it</li>
          <li>Pressure to buy more minutes before you’ve heard anything specific</li>
          <li>Guaranteed outcomes or exact dates offered as certainties</li>
        </ul>
        <a href="/red-flags/" class="mt-flags-link">See the full red-flags guide →</a>
      </div>
    </div>
  </section>

  <!-- ═══ 7. BROWSE INSTEAD — situation guides ═══ -->
  <section class="section section--alt mt-section">
    <div class="container container--narrow">
      <header class="mt-head">
        <p class="mt-eyebrow">Prefer to read first?</p>
        <h2 class="mt-h2">Start from your situation</h2>
        <p class="mt-desc">Each guide names the readers we’d book for that question, and the ones we wouldn’t.</p>
      </header>
      <div class="mt-routes">
        {situationRoutes.map((r) => (
          <a href={r.href} class="mt-route">
            <span>{r.label}</span>
            <span class="mt-route-go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 8. FAQ ═══ -->
  <section class="section mt-section">
    <div class="container container--narrow">
      <FAQ items={matchFAQs} title="Questions about the reader match" />
    </div>
  </section>

  <!-- ═══ 9. CLOSING CTA ═══ -->
  <section class="mt-close">
    <div class="container container--narrow mt-close-inner">
      <h2 class="mt-close-title">Find the 3 readers who fit your situation</h2>
      <p class="mt-close-sub">About 2 minutes. You get a short reading of your situation, an opening question, and reasons to skip each reader too.</p>
      <a href="#start" class="mt-cta" data-match-open data-cta-source="match-close">
        <span class="mt-cta-spark" aria-hidden="true">✦</span>
        <span data-match-open-label>Find My Reader →</span>
      </a>
    </div>
  </section>

  <!-- Quiz runs in the shared bottom-sheet overlay; no visible launch card -->
  <ReaderMatch mode="modal" launcher="none" />
</BaseLayout>

<style>
  /* ---------- gold CTA ---------- */
  .mt-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 58px;
    padding: 0 2.4rem;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 1.06rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: #FFF8E7 !important;
    text-decoration: none !important;
    background: linear-gradient(180deg, #B98A2E 0%, #8A651A 55%, #6B4E0F 100%);
    border: 1px solid rgba(107, 78, 15, 0.55);
    box-shadow:
      inset 0 1px 0 rgba(255, 236, 190, 0.45),
      0 0 0 5px rgba(184, 147, 58, 0.12),
      0 10px 28px rgba(107, 78, 15, 0.32);
    overflow: hidden;
    isolation: isolate;
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
    -webkit-tap-highlight-color: transparent;
  }
  /* slow sheen sweep — draws the eye once the page settles */
  .mt-cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(115deg, transparent 30%, rgba(255, 240, 200, 0.38) 48%, transparent 66%);
    transform: translateX(-120%);
    animation: mt-sheen 4.8s ease-in-out 1.2s infinite;
  }
  @keyframes mt-sheen {
