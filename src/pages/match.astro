---
import BaseLayout from '../layouts/BaseLayout.astro';

// Load all reader markdown files at build time using the same pattern as other reader pages
// This is the correct approach for this project (existing pages use import.meta.glob, not getCollection)
const PLATFORMS = ['keen', 'kasamba', 'purple-garden'] as const;
type Platform = typeof PLATFORMS[number];

const keenFiles = import.meta.glob('../content/readers/keen/*.md', { eager: true });
const kasambaFiles = import.meta.glob('../content/readers/kasamba/*.md', { eager: true });
const pgFiles = import.meta.glob('../content/readers/purple-garden/*.md', { eager: true });

function extractReaders(files: Record<string, any>, platform: Platform) {
  return Object.entries(files)
    .map(([path, mod]) => {
      const fm = (mod as any).frontmatter ?? {};
      if (fm.unavailable) return null; // filter out unavailable readers
      const slug = path.split('/').pop()?.replace('.md', '') ?? '';
      return {
        slug,
        platform,
        platformName: fm.platformName ?? fm.title ?? slug,
        rating: fm.rating ?? 4.5,
        affiliateUrl: fm.affiliateUrl ?? '#',
        avatarUrl: fm.avatarUrl ?? null,
        bestFor: fm.bestFor ?? null,
        pricing: fm.pricing ?? null,
        freeOffer: fm.freeOffer ?? null,
        entities: fm.entities ?? [],
        unavailable: false,
      };
    })
    .filter(Boolean);
}

const allRawReaders = [
  ...extractReaders(keenFiles, 'keen'),
  ...extractReaders(kasambaFiles, 'kasamba'),
  ...extractReaders(pgFiles, 'purple-garden'),
];

const readerDataJson = JSON.stringify(allRawReaders);
---
<BaseLayout
  title="Find Your Spiritual Theme | Eastern Alignment"
  description="Answer a few questions and discover what your current spiritual theme may be asking you to explore."
  noindex={true}
  noCta={true}
>
  <main id="match-root" class="match-root">
    <div id="match-app" class="match-app">
      <div class="match-loading">
        <div class="match-loading-inner">
          <div class="match-orb"></div>
          <p>Preparing your reading&hellip;</p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script id="match-reader-data" type="application/json" set:html={readerDataJson}></script>
