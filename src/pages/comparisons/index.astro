---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LeftSidebar from '../../components/LeftSidebar.astro';

/* ── Existing written comparisons (kept, moved below the toolkit) ── */
const comparisonModules = import.meta.glob('../../content/comparisons/*.md', { eager: true });
const comparisons = Object.entries(comparisonModules).map(([path, mod]: [string, any]) => ({
  ...mod.frontmatter,
  slug: path.split('/').pop()?.replace('.md', ''),
}));

/* ── Real, computed comparison data (see methodology note) ──
   Numbers sourced from reader frontmatter on this site:
   - avg rating + advisors reviewed: computed across all published reviews
   - avg $/min: mean of every "$X.XX/min" mention in reviews
   - welcome-offer value + risk-free trial: editorial estimates from the
     real new-client offers (offers.ts), not invented statistics.            */
const PLATFORMS = [
  {
    key: 'kasamba',
    name: 'Kasamba',
    color: '#4a6ee0',
    go: '/go/kasamba/',
    offer: '3 free minutes + 50% off',
    offerShort: '3 Free Min + 50% Off',
    valueEst: '~$75 est. value',
    avgRating: 4.89,
    reviewed: 35,
    avgPrice: 9.38,
    editorChoice: true,
    scores: { rating: 100, price: 40, offer: 100, catalog: 56, risk: 58 },
  },
  {
    key: 'purple-garden',
    name: 'Purple Garden',
    color: '#6b4d8c',
    go: '/go/purplegarden/',
    offer: '$30 free credit',
    offerShort: '$30 Free Credit',
    valueEst: '$30 value',
    avgRating: 4.86,
    reviewed: 30,
    avgPrice: 4.78,
    editorChoice: false,
    scores: { rating: 74, price: 100, offer: 40, catalog: 40, risk: 100 },
  },
  {
    key: 'keen',
    name: 'Keen',
    color: '#004d40',
    go: '/go/keen/',
    offer: '5 minutes for $1',
    offerShort: '5 Min for $1',
    valueEst: '~$34 est. value',
    avgRating: 4.82,
    reviewed: 49,
    avgPrice: 7.0,
    editorChoice: false,
    scores: { rating: 40, price: 61, offer: 45, catalog: 100, risk: 72 },
  },
];

/* ── Radar axes: normalized 40–100 (best of three = 100) ── */
const RADAR_AXES = [
  { key: 'rating', label: 'Advisor Rating', vals: { kasamba: 100, 'purple-garden': 74, keen: 40 }, raw: { kasamba: '4.89★', 'purple-garden': '4.86★', keen: '4.82★' } },
  { key: 'catalog', label: 'Advisor Catalog', vals: { kasamba: 56, 'purple-garden': 40, keen: 100 }, raw: { kasamba: '35 reviewed', 'purple-garden': '30 reviewed', keen: '49 reviewed' } },
  { key: 'offer', label: 'Welcome Offer', vals: { kasamba: 100, 'purple-garden': 40, keen: 45 }, raw: { kasamba: '~$75', 'purple-garden': '$30', keen: '~$34' } },
  { key: 'price', label: 'Price Value', vals: { kasamba: 40, 'purple-garden': 100, keen: 61 }, raw: { kasamba: '$9.38/min', 'purple-garden': '$4.78/min', keen: '$7.00/min' } },
  { key: 'risk', label: 'Risk-Free Trial', vals: { kasamba: 58, 'purple-garden': 100, keen: 72 }, raw: { kasamba: '3 free min', 'purple-garden': '$30 credit', keen: '5 min for $1' } },
  { key: 'breadth', label: 'Specialty Breadth', vals: { kasamba: 100, 'purple-garden': 100, keen: 100 }, raw: { kasamba: '8 / 8 areas', 'purple-garden': '8 / 8 areas', keen: '8 / 8 areas' } },
];

/* ── "Best for" editorial scenarios ── */
const SCENARIOS = [
  { key: 'love', label: 'Love & Relationships', winner: 'kasamba', why: 'Highest average advisor rating (4.89★) and the deepest love & mediumship catalog in our reviews.' },
  { key: 'career', label: 'Career & Direction', winner: 'keen', why: 'Largest advisor pool (49 reviewed) means the best odds of a precise career match.' },
  { key: 'money', label: 'Money & Finance', winner: 'purple-garden', why: 'Lowest rate ($4.78/min) plus a $30 credit stretches a finance question furthest.' },
  { key: 'first', label: 'First-Timer / Lowest Risk', winner: 'purple-garden', why: 'A $30 free credit + the cheapest per-minute rate = the smallest commitment to start.' },
  { key: 'tarot', label: 'Tarot & Astrology', winner: 'kasamba', why: 'Top-rated readers and full tarot/astrology coverage across our reviewed advisors.' },
  { key: 'spiritual', label: 'Spiritual & Mediumship', winner: 'keen', why: 'Broadest catalog with strong spiritual, energy, and mediumship specialists.' },
];

/* ── Radar geometry (server-rendered) ── */
const CX = 260, CY = 250, R = 180;
const N = RADAR_AXES.length;
function pt(axisIndex: number, value: number) {
  const ang = (-90 + axisIndex * (360 / N)) * (Math.PI / 180);
  const r = R * (value / 100);
  return [CX + r * Math.cos(ang), CY + r * Math.sin(ang)];
}
const rings = [25, 50, 75, 100].map((lvl) =>
  RADAR_AXES.map((_, i) => pt(i, lvl).map((n) => n.toFixed(1)).join(',')).join(' ')
);
const axisLines = RADAR_AXES.map((_, i) => pt(i, 100));
const axisLabels = RADAR_AXES.map((ax, i) => {
  const [x, y] = pt(i, 118);
  const cos = Math.cos((-90 + i * (360 / N)) * (Math.PI / 180));
  const anchor = Math.abs(cos) < 0.2 ? 'middle' : cos > 0 ? 'start' : 'end';
  return { label: ax.label, x: x.toFixed(1), y: y.toFixed(1), anchor };
});
const platformPolys = PLATFORMS.map((p) => ({
  ...p,
  points: RADAR_AXES.map((ax, i) => pt(i, ax.vals[p.key]).map((n) => n.toFixed(1)).join(',')).join(' '),
  dots: RADAR_AXES.map((ax, i) => ({ ...pt(i, ax.vals[p.key]), raw: ax.raw[p.key], axis: ax.label, val: ax.vals[p.key] })),
}));

/* Feature matrix rows (real values) */
const MATRIX_ROWS = [
  { group: 'Welcome Offer', feature: 'New-client welcome deal', cells: { kasamba: '3 free min + 50% off', 'purple-garden': '$30 free credit', keen: '5 min for $1' }, type: 'text' },
  { group: 'Welcome Offer', feature: 'Estimated welcome value', cells: { kasamba: '~$75', 'purple-garden': '$30', keen: '~$34' }, type: 'text' },
  { group: 'Welcome Offer', feature: 'Risk-free to try', cells: { kasamba: 'Partial (3 min)', 'purple-garden': 'Full ($30 credit)', keen: 'Near-free (5 min/$1)' }, type: 'text' },
  { group: 'Pricing', feature: 'Average rate (our reviews)', cells: { kasamba: '$9.38/min', 'purple-garden': '$4.78/min', keen: '$7.00/min' }, type: 'text' },
  { group: 'Pricing', feature: 'Free to join', cells: { kasamba: true, 'purple-garden': true, keen: true }, type: 'bool' },
  { group: 'Quality', feature: 'Avg advisor rating (reviewed)', cells: { kasamba: 4.89, 'purple-garden': 4.86, keen: 4.82 }, type: 'rating' },
  { group: 'Quality', feature: 'Advisors individually reviewed', cells: { kasamba: 35, 'purple-garden': 30, keen: 49 }, type: 'num' },
  { group: 'Coverage', feature: 'Specialty areas covered', cells: { kasamba: '8 / 8', 'purple-garden': '8 / 8', keen: '8 / 8' }, type: 'text' },
  { group: 'Coverage', feature: 'iOS + Android app', cells: { kasamba: true, 'purple-garden': true, keen: true }, type: 'bool' },
  { group: 'Coverage', feature: 'Satisfaction guarantee', cells: { kasamba: 'Per-advisor', 'purple-garden': 'Up to $50 credit', keen: 'Per-advisor' }, type: 'text' },
  { group: 'Experience', feature: 'Chat + Phone + Video', cells: { kasamba: 'Chat + Phone', 'purple-garden': 'Chat + Phone + Video', keen: 'Chat + Phone' }, type: 'text' },
];
function rowIsDifferent(row: any) {
  const vals = PLATFORMS.map((p) => JSON.stringify(row.cells[p.key]));
  return new Set(vals).size > 1;
}

/* Rank-builder factor metadata */
const FACTORS = [
  { key: 'rating', label: 'Advisor Rating', icon: '★' },
  { key: 'price', label: 'Price Value', icon: '$' },
  { key: 'offer', label: 'Welcome Offer', icon: '🎁' },
  { key: 'catalog', label: 'Advisor Catalog', icon: '👥' },
  { key: 'risk', label: 'Risk-Free Trial', icon: '🛡' },
];
---

<BaseLayout
  title="Kasamba vs Purple Garden vs Keen: Interactive Comparison (2026)"
  description="Compare Kasamba, Purple Garden and Keen with interactive tools: a capability radar, a build-your-own ranking, a feature matrix, and per-need recommendations. Real ratings, prices and offers."
  seoTitle="Kasamba vs Purple Garden vs Keen — Interactive Comparison Tools (2026)"
  metaDescription="Interactive Kasamba vs Purple Garden vs Keen comparison: capability radar, weighted ranking builder, feature matrix, and best-for recommendations using real ratings, prices, and offers."
  topOfferPlatform="kasamba"
>
  <div class="page-with-sidebars">
    <LeftSidebar />

    <main class="main-col">
      <div class="comparisons-hub">
        <Breadcrumb items={[{ label: 'Comparisons' }]} />

        <header class="hub-header">
          <span class="hub-eyebrow">Interactive Comparison Toolkit</span>
          <h1>Kasamba vs Purple Garden vs Keen</h1>
          <p class="hub-description text-muted">
            Three of the largest psychic-reading platforms, measured side by side. Every number
            below comes from advisors we've actually reviewed on this site — average ratings,
            real per-minute rates, and the genuine new-client offers. Use the tools to find
            your fit, then read our head-to-head write-ups further down.
          </p>
        </header>

        <!-- SUB-NAV -->
        <nav class="comp-subnav" aria-label="Comparison sections">
          <a href="#radar">Capability Radar</a>
          <a href="#rank">Build Your Ranking</a>
          <a href="#matrix">Feature Matrix</a>
          <a href="#bestfor">Best For</a>
          <a href="#offers">Welcome Offers</a>
          <a href="#written">Written Comparisons</a>
        </nav>

        <!-- ============ 1. CAPABILITY RADAR ============ -->
        <section id="radar" class="comp-section">
          <div class="section-head">
            <span class="eyebrow">Capability Radar</span>
            <h2>How the three stack up, axis by axis</h2>
            <p class="section-sub text-muted">
              Each axis is normalized 40–100 relative to the three platforms (best of the three = 100).
              Toggle a platform to isolate it, and hover any point for the raw figure.
            </p>
          </div>

          <div class="radar-layout">
            <div class="radar-canvas">
              <svg viewBox="0 0 520 500" class="radar-svg" role="img" aria-label="Capability radar comparing the three platforms">
                <!-- rings -->
                {rings.map((r, i) => (
                  <polygon points={r} class={`radar-ring ${i === rings.length - 1 ? 'radar-ring--outer' : ''}`} />
                ))}
                <!-- axis lines -->
                {axisLines.map(([x, y]) => (
                  <line x1={CX} y1={CY} x2={x.toFixed(1)} y2={y.toFixed(1)} class="radar-axis" />
                ))}
                <!-- platform polygons -->
                {platformPolys.map((p) => (
                  <g class="radar-series" data-key={p.key} style={`--c:${p.color}`}>
                    <polygon points={p.points} class="radar-poly" />
                    {p.dots.map((d) => (
                      <circle cx={d[0].toFixed(1)} cy={d[1].toFixed(1)} r="4.5" class="radar-dot"
                        data-axis={d.axis} data-raw={d.raw} data-val={d.val} data-name={p.name} />
                    ))}
                  </g>
                ))}
                <!-- axis labels -->
                {axisLabels.map((l) => (
                  <text x={l.x} y={l.y} text-anchor={l.anchor} class="radar-label">{l.label}</text>
                ))}
              </svg>
              <div class="radar-tooltip" id="radarTooltip" hidden></div>
            </div>

            <div class="radar-side">
              <p class="radar-side__title">Toggle platforms</p>
              <div class="radar-legend">
                {platformPolys.map((p) => (
                  <button class="legend-btn is-active" data-key={p.key} style={`--c:${p.color}`} aria-pressed="true">
                    <span class="legend-swatch"></span>
                    <span class="legend-name">{p.name}</span>
                    {p.editorChoice && <span class="legend-badge">Editor's Choice</span>}
                  </button>
                ))}
              </div>
              <div class="radar-takeaways">
                <h4>What the shape says</h4>
                <ul>
                  <li><strong>Kasamba</strong> leads on rating and welcome-offer value, but carries the highest per-minute rate.</li>
                  <li><strong>Purple Garden</strong> wins price value and the risk-free trial ($30 credit), tying on breadth.</li>
                  <li><strong>Keen</strong> owns the deepest catalog and solid all-round value at a mid price.</li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- ============ 2. BUILD YOUR RANKING ============ -->
        <section id="rank" class="comp-section">
          <div class="section-head">
            <span class="eyebrow">Build Your Ranking</span>
            <h2>Weight what matters to you</h2>
            <p class="section-sub text-muted">
              Drag the sliders to tell us what you care about. The bars recompute live and re-rank
              the platforms by your personal priorities.
            </p>
          </div>

          <div class="rank-layout">
            <div class="rank-controls" id="rankControls">
              {FACTORS.map((f) => (
                <div class="rank-factor" data-factor={f.key}>
                  <div class="rank-factor__top">
                    <span class="rank-factor__icon">{f.icon}</span>
                    <span class="rank-factor__label">{f.label}</span>
                    <span class="rank-factor__val" data-out>{20}</span>
                  </div>
                  <input type="range" min="0" max="100" value="20" class="rank-slider" data-factor={f.key} aria-label={f.label} />
                </div>
              ))}
              <button class="rank-reset" id="rankReset" type="button">Reset to equal weights</button>
            </div>

            <div class="rank-results" id="rankResults" aria-live="polite">
              {PLATFORMS.map((p) => (
                <div class="rank-row" data-key={p.key} style={`--c:${p.color}`}>
                  <div class="rank-row__head">
                    <span class="rank-row__name">{p.name}</span>
                    <span class="rank-row__score" data-score>0</span>
                  </div>
                  <div class="rank-bar"><span class="rank-bar__fill" data-fill></span></div>
                  {p.editorChoice && <span class="rank-row__ec">Editor's Choice</span>}
                </div>
              ))}
              <p class="rank-winner" id="rankWinner"></p>
            </div>
          </div>
        </section>

        <!-- ============ 3. FEATURE MATRIX ============ -->
        <section id="matrix" class="comp-section">
          <div class="section-head">
            <span class="eyebrow">Feature Matrix</span>
            <h2>Every detail, in one table</h2>
            <p class="section-sub text-muted">
              Sortable by category. Flip the switch to hide rows where all three are identical.
            </p>
          </div>

          <div class="matrix-toolbar">
            <label class="matrix-toggle">
              <input type="checkbox" id="diffOnly" />
              <span class="matrix-toggle__track"><span class="matrix-toggle__thumb"></span></span>
              <span class="matrix-toggle__label">Show differences only</span>
            </label>
            <span class="matrix-hint text-muted">★ = average rating across reviewed advisors</span>
          </div>

          <div class="matrix-wrap">
            <table class="matrix-table">
              <thead>
                <tr>
                  <th class="matrix-th-feature">Feature</th>
                  {PLATFORMS.map((p) => (
                    <th class="matrix-th-plat" style={`--c:${p.color}`}>
                      {p.name}{p.editorChoice && <span class="matrix-ec">EC</span>}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {MATRIX_ROWS.map((row) => (
                  <tr class="matrix-row" class:list={[{ 'matrix-row--same': !rowIsDifferent(row) }]} data-group={row.group}>
                    <td class="matrix-feature">{row.feature}</td>
                    {PLATFORMS.map((p) => {
                      const v = row.cells[p.key];
                      if (row.type === 'bool') {
                        return (
                          <td class="matrix-cell"><span class={`cell-bool ${v ? 'yes' : 'no'}`}>{v ? '✓' : '—'}</span></td>
                        );
                      }
                      if (row.type === 'rating') {
                        const full = Math.round(Number(v));
                        return (
                          <td class="matrix-cell">
                            <span class="cell-rating">{Number(v).toFixed(2)}</span>
                            <span class="cell-stars" aria-hidden="true">{'★'.repeat(full)}{'☆'.repeat(5 - full)}</span>
                          </td>
                        );
                      }
                      return <td class="matrix-cell">{v}</td>;
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- ============ 4. BEST FOR ============ -->
        <section id="bestfor" class="comp-section">
          <div class="section-head">
            <span class="eyebrow">Best For</span>
            <h2>Pick your situation</h2>
            <p class="section-sub text-muted">
              Tell us what you need a reading for. We'll highlight the platform we'd point you to and why.
            </p>
          </div>

          <div class="bestfor-picker" id="bestforPicker">
            {SCENARIOS.map((s, i) => (
              <button class="bestfor-chip" data-scenario={s.key} data-winner={s.winner} aria-pressed="false">
                {s.label}
              </button>
            ))}
          </div>

          <div class="bestfor-result" id="bestforResult" hidden>
            <div class="bestfor-winner">
              <span class="bestfor-winner__label">Our pick</span>
              <span class="bestfor-winner__name" id="bfName"></span>
            </div>
            <p class="bestfor-why" id="bfWhy"></p>
          </div>

          <div class="bestfor-cards">
            {PLATFORMS.map((p) => (
              <div class="bestfor-card" data-key={p.key} style={`--c:${p.color}`}>
                <div class="bestfor-card__top">
                  <span class="bestfor-card__name">{p.name}</span>
                  {p.editorChoice && <span class="bestfor-card__ec">Editor's Choice</span>}
                </div>
                <p class="bestfor-card__offer">{p.offer}</p>
                <a href={p.go} class="bestfor-card__cta" data-ph-event="affiliate_click">Claim offer →</a>
              </div>
            ))}
          </div>
        </section>

        <!-- ============ 5. WELCOME OFFERS ============ -->
        <section id="offers" class="comp-section">
          <div class="section-head">
            <span class="eyebrow">Welcome Offers</span>
            <h2>The real new-client deals</h2>
            <p class="section-sub text-muted">
              No promo codes required — tap through and the offer applies at sign-up.
            </p>
          </div>

          <div class="offer-grid">
            {PLATFORMS.map((p) => (
              <article class="offer-card" style={`--c:${p.color}`} class:list={[{ 'offer-card--ec': p.editorChoice }]}>
                {p.editorChoice && <span class="offer-ribbon">Editor's Choice</span>}
                <div class="offer-card__head">
                  <span class="offer-card__name">{p.name}</span>
                  <span class="offer-card__value">{p.valueEst}</span>
                </div>
                <p class="offer-card__deal">{p.offer}</p>
                <div class="offer-card__meta">
                  <span>Avg {p.avgRating.toFixed(2)}★</span>
                  <span>·</span>
                  <span>{p.reviewed} reviewed</span>
                  <span>·</span>
                  <span>${p.avgPrice.toFixed(2)}/min</span>
                </div>
                <a href={p.go} class="offer-card__cta" data-ph-event="affiliate_click">Claim {p.offerShort} →</a>
                <p class="offer-card__micro">Free to join · No subscription</p>
              </article>
            ))}
          </div>
        </section>

        <!-- ============ EXISTING WRITTEN COMPARISONS (kept) ============ -->
        <section id="written" class="comp-section">
          <div class="prose">
            <h2 id="platform-battles">Head-to-Head Written Comparisons</h2>
            <p class="text-muted">Long-form, advisor-by-advisor breakdowns for when you want the full reasoning:</p>
            <div class="comparison-grid grid grid--2 stagger">
              {comparisons.map((comp) => (
                <a href={`/comparisons/${comp.slug}/`} class="comparison-card card card--elevated">
                  <div class="vs-badge">VS</div>
                  <h3 class="comparison-card-title">{comp.platforms?.join(' vs ')}</h3>
                  <p class="comparison-card-desc text-muted text-sm">{comp.description}</p>
                  {comp.winner && (
                    <div class="comparison-winner-line">
                      <span class="text-xs text-muted">Winner:</span>
                      <span class="text-sm" style="font-weight: 600; color: var(--color-sage);">{comp.winner}</span>
                    </div>
                  )}
                  <span class="comparison-card-link text-primary text-sm">Read Full Comparison →</span>
                </a>
              ))}
            </div>
          </div>
        </section>

        <p class="comp-methodology text-muted">
          <strong>Methodology:</strong> Average ratings, advisor counts and per-minute rates are computed from the
          individual psychic reviews published on this site. Welcome-offer value and risk-free-trial scores are
          editorial estimates based on each platform's genuine new-client promotion. Specialty breadth reflects the
          eight categories (love, career, money, tarot, astrology, mediumship, dreams, spiritual) covered in our
          reviewed advisors. This is an affiliate site; recommendations are independent of commission.
        </p>
      </div>
    </main>
  </div>
</BaseLayout>

<script define:vars={{ PLATFORMS, FACTORS, SCENARIOS }}>
  /* ── Radar: toggle platforms + tooltip ── */
  (function () {
    const svg = document.querySelector('.radar-svg');
    if (!svg) return;
    const tooltip = document.getElementById('radarTooltip');
    const legendBtns = document.querySelectorAll('.legend-btn');

    legendBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.key;
        const active = btn.classList.toggle('is-active');
        btn.setAttribute('aria-pressed', String(active));
        const series = svg.querySelector(`.radar-series[data-key="${key}"]`);
        if (series) series.classList.toggle('is-hidden', !active);
      });
    });

    svg.querySelectorAll('.radar-dot').forEach((dot) => {
      dot.addEventListener('mouseenter', (e) => {
        const r = dot.getBoundingClientRect();
        const wrap = svg.parentElement.getBoundingClientRect();
        tooltip.hidden = false;
        tooltip.innerHTML = `<strong>${dot.dataset.name}</strong><br>${dot.dataset.axis}: ${dot.dataset.raw}`;
        tooltip.style.left = (r.left - wrap.left + r.width / 2) + 'px';
        tooltip.style.top = (r.top - wrap.top - 10) + 'px';
      });
      dot.addEventListener('mouseleave', () => { tooltip.hidden = true; });
    });
  })();

  /* ── Build-your-own ranking ── */
  (function () {
    const sliders = document.querySelectorAll('.rank-slider');
    const rows = document.querySelectorAll('.rank-row');
    const winnerEl = document.getElementById('rankWinner');
    const resetBtn = document.getElementById('rankReset');
    if (!sliders.length || !rows.length) return;

    function compute() {
      const w = {};
      let total = 0;
      sliders.forEach((s) => { w[s.dataset.factor] = +s.value; total += +s.value; });
      // reflect numbers
      sliders.forEach((s) => {
        const out = s.closest('.rank-factor').querySelector('[data-out]');
        if (out) out.textContent = s.value;
      });
      const comp = {};
      PLATFORMS.forEach((p) => {
        let sum = 0;
        FACTORS.forEach((f) => { sum += (p.scores[f.key] || 0) * (w[f.key] || 0); });
        comp[p.key] = total > 0 ? sum / total : 0;
      });
      const max = Math.max(...Object.values(comp), 1);
      // sort platforms by composite desc
      const ordered = PLATFORMS.map((p) => ({ key: p.key, v: comp[p.key] })).sort((a, b) => b.v - a.v);
      rows.forEach((row) => {
        const v = comp[row.dataset.key];
        const fill = row.querySelector('[data-fill]');
        const score = row.querySelector('[data-score]');
        if (fill) fill.style.width = (v / max * 100).toFixed(1) + '%';
        if (score) score.textContent = (v / 100).toFixed(1);
        row.style.order = ordered.findIndex((o) => o.key === row.dataset.key);
      });
      if (winnerEl && ordered[0]) {
        const top = PLATFORMS.find((p) => p.key === ordered[0].key);
        winnerEl.innerHTML = `🏆 <strong>${top.name}</strong> is your best fit at these weights.`;
      }
    }
    sliders.forEach((s) => s.addEventListener('input', compute));
    if (resetBtn) resetBtn.addEventListener('click', () => {
      sliders.forEach((s) => { s.value = 20; });
      compute();
    });
    compute();
  })();

  /* ── Feature matrix: differences only ── */
  (function () {
    const toggle = document.getElementById('diffOnly');
    if (!toggle) return;
    toggle.addEventListener('change', () => {
      const on = toggle.checked;
      document.querySelectorAll('.matrix-row--same').forEach((row) => {
        row.style.display = on ? 'none' : '';
      });
    });
  })();

  /* ── Best-for picker ── */
  (function () {
    const picker = document.getElementById('bestforPicker');
    const result = document.getElementById('bestforResult');
    const nameEl = document.getElementById('bfName');
    const whyEl = document.getElementById('bfWhy');
    if (!picker) return;
    picker.querySelectorAll('.bestfor-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        picker.querySelectorAll('.bestfor-chip').forEach((c) => { c.classList.remove('is-active'); c.setAttribute('aria-pressed', 'false'); });
        chip.classList.add('is-active');
        chip.setAttribute('aria-pressed', 'true');
        const winner = chip.dataset.winner;
        const sc = SCENARIOS.find((s) => s.key === chip.dataset.scenario);
        if (nameEl) {
          const plat = PLATFORMS.find((p) => p.key === winner);
          nameEl.textContent = plat ? plat.name : winner;
        }
        if (whyEl && sc) whyEl.textContent = sc.why;
        if (result) result.hidden = false;
        document.querySelectorAll('.bestfor-card').forEach((card) => {
          card.classList.toggle('is-dim', card.dataset.key !== winner);
          card.classList.toggle('is-pick', card.dataset.key === winner);
        });
      });
    });
  })();
</script>

