---
import ComparisonLayout from '../../layouts/ComparisonLayout.astro';
import RelatedContent from '../../components/RelatedContent.astro';

export async function getStaticPaths() {
  const posts = import.meta.glob('../../content/comparisons/*.md');
  const paths = [];
  for (const path in posts) {
    const post = await posts[path]();
    const slug = path.split('/').pop().replace('.md', '');
    paths.push({
      params: { slug },
      props: post,
    });
  }
  return paths;
}

const { default: Content, frontmatter } = Astro.props;

/* Fetch platform reviews for cross-linking */
const reviewModules = import.meta.glob('../../content/reviews/*.md', { eager: true });
const reviews = Object.entries(reviewModules)
  .map(([path, mod]: [string, any]) => ({
    ...mod.frontmatter,
    slug: path.split('/').pop()?.replace('.md', ''),
  }))
  .sort((a, b) => (a.rank || 99) - (b.rank || 99));

/* Fetch guides */
const guideModules = import.meta.glob('../../content/guides/*.md', { eager: true });
const guides = Object.entries(guideModules).map(([path, mod]: [string, any]) => ({
  ...mod.frontmatter,
  slug: path.split('/').pop()?.replace('.md', ''),
}));

// Comparisons are decision pages. Keep their next-step links focused on the
// two platforms and the immediate relationship-use-case pages, rather than
// exposing a sitewide directory below the verdict.
const comparisonClusters: Record<string, { guides: string[]; reviews: string[] }> = {
  'purple-garden-vs-kasamba': {
    guides: ['purple-garden-love-readings-review', 'best-love-psychics-purple-garden', 'kasamba-love-readings-review', 'best-love-psychics-kasamba-ranked'],
    reviews: ['purple-garden', 'kasamba'],
  },
  'purple-garden-vs-keen': {
    guides: ['purple-garden-love-readings-review', 'best-love-psychics-purple-garden', 'keen-love-psychics-review', 'best-love-psychics-keen-ex-recovery'],
    reviews: ['purple-garden', 'keen'],
  },
};

const cluster = comparisonClusters[Astro.params.slug || ''];
const selectedReviews = cluster ? reviews.filter(r => cluster.reviews.includes(r.slug)) : reviews;
const selectedGuides = cluster ? guides.filter(g => cluster.guides.includes(g.slug)) : guides;

const relatedItems = [
  ...selectedReviews.map(r => ({
    title: `${r.platformName} Review 2026`,
    href: `/reviews/${r.slug}/`,
    description: r.verdict?.length > 120 ? r.verdict.substring(0, 120) + '…' : r.verdict,
    badge: `#${r.rank} Pick`,
    badgeVariant: 'primary' as const,
  })),
  ...selectedGuides.map(g => ({
    title: g.title,
    href: `/guides/${g.slug}/`,
    description: g.description,
    badge: g.category || 'Guide',
    badgeVariant: 'sage' as const,
  })),
];
---

<ComparisonLayout
  title={frontmatter.title}
  description={frontmatter.description}
  platforms={frontmatter.platforms}
  winner={frontmatter.winner}
  publishDate={frontmatter.publishDate}
  updatedDate={frontmatter.updatedDate}
  seoTitle={frontmatter.seoTitle}
  metaDescription={frontmatter.metaDescription}
  canonicalUrl={frontmatter.canonicalUrl}
  customSchema={frontmatter.customSchema}
>
  <Content />

  <!-- Cross-linking to individual platform reviews and guides -->
  <RelatedContent title="Dive Deeper" items={relatedItems} />
</ComparisonLayout>
