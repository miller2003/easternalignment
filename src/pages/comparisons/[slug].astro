---
import ComparisonLayout from '../../layouts/ComparisonLayout.astro';

export async function getStaticPaths() {
  const posts = import.meta.glob('../../content/comparisons/*.md');
  const paths = [];
  for (const path in posts) {
    const post = await posts[path]();
    const slug = path.split('/').pop().replace('.md', '');
    paths.push({
      params: { slug },
      props: post,
    });
  }
  return paths;
}

const { default: Content, frontmatter } = Astro.props;
---

<ComparisonLayout
  title={frontmatter.title}
  description={frontmatter.description}
  platforms={frontmatter.platforms}
  winner={frontmatter.winner}
  publishDate={frontmatter.publishDate}
  updatedDate={frontmatter.updatedDate}
>
  <Content />
</ComparisonLayout>
