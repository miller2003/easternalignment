---
import EsBaseLayout from '../../layouts/EsBaseLayout.astro';
import EsBreadcrumb from '../../components/es/EsBreadcrumb.astro';
import EsSpanishCTA from '../../components/es/EsSpanishCTA.astro';
import EsComparisonTable from '../../components/es/EsComparisonTable.astro';
import EsFAQ from '../../components/es/EsFAQ.astro';
import StarRating from '../../components/StarRating.astro';
import { getEsGuides, ES_GUIDE_CATEGORIES } from '../../lib/esGuides';

// 2026-10-02: escaparate de guías (6 más recientes) — enlace interno a /es/guias/
const homeGuides = getEsGuides().slice(0, 6);

const SITE_URL = 'https://easternalignment.com';
const canonicalUrl = `${SITE_URL}/es/`;

/* ── Conteos reales (dinámicos, misma técnica que la home EN) ──────────── */
const readerModules = import.meta.glob('../../content/es-readers/**/*.md', { eager: true });
const totalReaders = Object.keys(readerModules).filter(p => !p.includes('_plantilla')).length;
const totalPlatforms = 2;   // Psíquicos Web + Purple Garden (análisis a fondo)
const totalAnalisis = 2;    // páginas hub de plataforma publicadas

/* ── Tabla comparativa rápida — datos de nuestros análisis de plataforma ── */
const comparisonPlatforms = [
  {
    name: 'Psíquicos Web',
    affiliateUrl: '/go/psiquicos/',
    rating: 4.8,
    pricing: '$0.99–$14.99/min',
    freeOffer: '3 min gratis + hasta 60% de descuento',
    specialties: 'Baraja Española · Tradiciones hispanas · 140+ lectores',
    satisfaction: 'Reclamaciones de facturación vía soporte (24–48h)',
    availability: '24/7 · 883.000+ lecturas documentadas',
    communication: 'Chat · Teléfono',
  },
  {
    name: 'Purple Garden',
    affiliateUrl: '/go/purple-garden-es/',
    rating: 4.7,
    pricing: '$0.99–$24.99/min',
    freeOffer: '$30 de crédito en la primera compra',
    specialties: 'Video en vivo · Registro Journeys · Lectores hispanos verificados',
    satisfaction: 'Crédito de sitio por problemas técnicos',
    availability: '24/7 · 126 lectores en el catálogo español',
    communication: 'Video · Teléfono · Chat',
  },
];

/* ── Tarjetas de veredicto ──────────────────────────────────────────────── */
const verdictCards = [
  {
    name: 'Psíquicos Web',
    tag: 'Mejor 100% en Español',
    url: '/es/resenas/psiquicos-web/',
    affiliate: '/go/psiquicos/',
    offer: '3 minutos gratis + hasta 60% de descuento',
    body: 'La mayor plataforma de videncia operada íntegramente en español — 883.000+ lecturas documentadas en 144 perfiles nativos de LATAM y España, con Baraja Española y tradiciones hispanas que no existen en las plataformas anglófonas. Los 3 minutos gratis se activan con cada nuevo lector, lo que la convierte en la forma más segura de probar varios perfiles sin riesgo.',
  },
  {
    name: 'Purple Garden',
    tag: 'Mejor para Video y Móvil',
    url: '/es/resenas/purple-garden-es/',
    affiliate: '/go/purple-garden-es/',
    offer: '$30 de crédito en la primera compra',
    body: 'Video bios obligatorias y el registro público Journeys permiten auditar a un lector antes de gastar un dólar. Los lectores hispanohablantes valorados promedian 4,96★ y las tarifas de entrada arrancan desde $0.99/min — la opción más accesible para probar la plataforma con apps nativas.',
  },
];

/* ── Notas de campo — hallazgos documentados reales, con enlace a la fuente ── */
const fieldNotes = [
  {
    title: 'La Prueba de los 3 Minutos (Psíquicos Web)',
    stat: 'Los minutos gratis se reinician por LECTOR, no por cuenta',
    body: 'Puedes probar dos o tres videntes distintos sin riesgo: los 3 minutos gratis se activan la primera vez que conectas con cada lector. Úsalos con una pregunta concreta y juzga si la respuesta es específica o relleno.',
    link: '/es/resenas/psiquicos-web/',
    linkLabel: 'Leer el análisis completo de Psíquicos Web',
  },
  {
    title: 'El Dato Estadístico (Purple Garden)',
    stat: 'Luna Aestethic · 3.200+ reseñas · 5.0★ · $2.99/min',
    body: 'A ese volumen de reseñas verificadas, la calificación ya no es ruido de muestra pequeña: es el resultado consistente de ocho años de práctica ininterrumpida. El historial más documentado del catálogo hispanohablante de la plataforma.',
    link: '/es/resenas/purple-garden-es/luna-aestethic/',
    linkLabel: 'Leer la reseña de Luna Aestethic',
  },
  {
    title: 'La Excepción de Precio (Purple Garden)',
    stat: 'Luz tarot · 27 años · 909 lecturas en 5.0★ · $1.99/min',
    body: 'Que un perfil con ese historial mantenga un precio de entrada bajo es estadísticamente inusual — la mayoría de lectores con ese recorrido ya subieron tarifas. Una combinación que beneficia directamente al consultante.',
    link: '/es/resenas/purple-garden-es/luz-tarot/',
    linkLabel: 'Leer la reseña de Luz tarot',
  },
];

/* ── Testimonios documentados — extraídos de datos verificados en las reseñas ── */
const testaments = [
  {
    quote: 'Los 3 minutos gratis te ayudan a probar antes de gastar. Muy buenos tarotistas y puedo leer el historial de la conversación después.',
    source: 'Usuario verificado · Google Play (4.2/5, 5.200+ valoraciones)',
    link: '/es/resenas/psiquicos-web/',
  },
  {
    quote: 'Su feed de Journeys está lleno de predicciones fechadas y verificables: los clientes publican si se cumplieron, y ella no puede editar ni borrar esas publicaciones.',
    source: 'Purple Garden — registro público Journeys',
    link: '/es/resenas/purple-garden-es/luna-aestethic/',
  },
];

const homeFAQs = [
  {
    question: "¿Son confiables los videntes y tarotistas en línea?",
    answer: "Sí, siempre y cuando utilices plataformas legítimas que filtren a sus asesores y mantengan sistemas de reseñas transparentes. Nuestras reseñas se basan en historiales verificados: nos aseguramos de que los lectores recomendados tengan opiniones documentadas por usuarios reales y métricas públicas comprobables."
  },
  {
    question: "¿Cuánto cuesta una lectura psíquica en español?",
    answer: "Las tarifas van desde $0.99 y, en los perfiles más premium, superan los $20 por minuto, dependiendo de la experiencia del lector. Para reducir el riesgo inicial, recomendamos aprovechar ofertas como los 3 minutos gratis + descuento en Psíquicos Web o los $30 de crédito en Purple Garden."
  },
  {
    question: "¿Cómo evitar estafas al consultar a un vidente online?",
    answer: "Las estafas más comunes involucran promesas de 'quitar maldiciones' por dinero adicional o perfiles falsos con reseñas manipuladas. Para protegerte, elige plataformas con rendición de cuentas pública (como el sistema Journeys de Purple Garden) y nunca pagues por fuera de la plataforma oficial."
  },
  {
    question: "¿Qué plataforma es mejor para principiantes?",
    answer: "Psíquicos Web es la recomendación principal para la mayoría de hispanohablantes en 2026: los nuevos usuarios reciben <strong>3 minutos gratis con cada nuevo lector</strong> (más hasta 60% de descuento en la primera recarga), así que puedes probar varios videntes sin riesgo antes de gastar dinero. Si prefieres video, <a href=\"/es/resenas/purple-garden-es/\">Purple Garden</a> y sus $30 de crédito son el punto de entrada más accesible."
  },
  {
    question: "¿Qué plataforma es mejor para lecturas por video?",
    answer: "Purple Garden. Cada lector debe publicar una video introducción, y su registro público Journeys te permite verificar cómo le fue a otros clientes con predicciones anteriores. Es la única plataforma importante donde puedes ver e inspeccionar a un lector antes de gastar un dólar."
  },
  {
    question: "¿Cómo evaluáis las plataformas?",
    answer: "Evaluamos cada plataforma con datos verificables: calificaciones públicas documentadas, volumen de sesiones, precios reales comprobados y opiniones de usuarios verificados. No fabricamos testimonios ni aceptamos pagos de lectores individuales. Las comisiones de afiliado provienen de las plataformas — nunca influyen en las calificaciones. Consulta nuestra <a href=\"/es/divulgacion/\">declaración completa</a>."
  },
];

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Eastern Alignment en Español — Reseñas de Videntes Online",
  "description": "Análisis independiente y reseñas verificadas de plataformas de lectura psíquica en línea para hispanohablantes. Evaluamos Psíquicos Web y Purple Garden con datos reales.",
  "url": canonicalUrl,
  "inLanguage": "es",
  "isPartOf": {
    "@type": "WebSite",
    "name": "EasternAlignment | Honest Psychic Review",
    "url": SITE_URL,
  },
};
---

<EsBaseLayout
  title="Reseñas de Videntes Online en Español"
  description="Análisis independiente y reseñas verificadas de Psíquicos Web y Purple Garden — las principales plataformas de lectura psíquica para hispanohablantes. Datos reales, sin publicidad encubierta."
  seoTitle="Mejores Videntes y Tarotistas Online 2026: Reseñas Reales"
  metaDescription="¿Buscas videntes online de confianza? Analizamos las mejores plataformas en español (Psíquicos Web, Purple Garden). Precios, opiniones reales y ofertas gratis."
  canonicalUrl={canonicalUrl}
  jsonLd={homeSchema}
  hreflangEn={`${SITE_URL}/`}
  topOfferPlatform="psiquicos"
>
  <!-- Hero Section (paridad con la home EN: eyebrow + título degradado +
       subtítulo + CTAs + línea de meta) -->
  <section class="hero section--lg">
    <div class="container">
      <div class="hero-content">
        <span class="hero-eyebrow text-xs text-uppercase text-muted">Pruebas Objetivas · Reseñas Independientes · Datos Verificados</span>
        <h1 class="hero-title">Claridad en las <br /><span class="text-gradient">Lecturas Psíquicas Online</span></h1>
        <p class="hero-subtitle">
          Evaluamos de forma independiente las plataformas de lectura psíquica en español — reseñas objetivas y auténticas, documentadas sesión a sesión, para que encuentres orientación confiable sin tener que adivinar. {totalReaders} perfiles de lectores auditados en Psíquicos Web y Purple Garden, con calificaciones verificadas y precios reales.
        </p>
        <div class="hero-actions">
          <a href="#comparacion" class="btn btn--primary es-cta btn--lg">Comparar Plataformas</a>
          <a href="#plataformas" class="btn btn--secondary btn--lg">Ver Reseñas de Lectores</a>
        </div>
        <div class="hero-meta">
          <span class="hero-meta-item">Auditado por <a href="/es/acerca-de/">Eastern Alignment</a></span>
          <span class="hero-meta-dot" aria-hidden="true">·</span>
          <span class="hero-meta-item">Última actualización: {new Date().toLocaleDateString('es-ES', { month: 'long', year: 'numeric' })}</span>
          <span class="hero-meta-dot" aria-hidden="true">·</span>
          <span class="hero-meta-item">{totalReaders} auditorías de lectores publicadas</span>
          <span class="hero-meta-dot" aria-hidden="true">·</span>
          <span class="hero-meta-item">{totalAnalisis} análisis de plataforma en el sitio</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="trust-bar section--alt">
    <div class="container">
      <div class="trust-grid">
        <div class="trust-item">
          <span class="trust-number">{totalPlatforms}</span>
          <span class="trust-label">Plataformas Analizadas a Fondo</span>
        </div>
        <div class="trust-divider" aria-hidden="true"></div>
        <div class="trust-item">
          <span class="trust-number">{totalReaders}+</span>
          <span class="trust-label">Reseñas de Lectores Publicadas</span>
        </div>
        <div class="trust-divider" aria-hidden="true"></div>
        <div class="trust-item">
          <span class="trust-number">100%</span>
          <span class="trust-label">Datos Verificados, Sin Testimonios Fabricados</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparación rápida -->
  <section class="quick-compare section" id="comparacion">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow text-xs text-uppercase text-muted">Cara a Cara · Probadas en 2026</span>
        <h2 class="section-title">Las Mejores Plataformas de Videncia Comparadas</h2>
        <p class="section-desc text-muted">
          Dos plataformas, un mismo estándar: cada dato de esta tabla proviene de investigación directa — no de páginas de marketing. Psíquicos Web es nuestra opción #1 para la mayoría de hispanohablantes en 2026; Purple Garden es la más fuerte en video y móvil, con los lectores hispanos mejor calificados.
        </p>
      </div>

      <EsComparisonTable platforms={comparisonPlatforms} highlightIndex={0} />

      <div class="verdict-grid stagger">
        {verdictCards.map(card => (
          <div class="verdict-card card">
            <div class="verdict-card-head">
              <span class="badge badge--primary">{card.tag}</span>
              <h3 class="verdict-card-name">{card.name}</h3>
            </div>
            <p class="verdict-card-body text-muted">{card.body}</p>
            <div class="verdict-card-offer">
              <span class="offer-label">Oferta:</span>
              <span class="offer-value">{card.offer}</span>
            </div>
            <div class="verdict-card-actions">
              <a href={card.affiliate} class="btn btn--primary es-cta btn--sm" rel="nofollow sponsored" target="_blank">Visitar {card.name} →</a>
              <a href={card.url} class="btn btn--ghost btn--sm">Análisis Completo</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- La Versión Corta (editorial insignia) -->
  <section class="short-version section section--alt">
    <div class="container container--narrow">
      <div class="byline-card">
        <img src="/logo.jpg" alt="Eastern Alignment" class="byline-avatar" width="56" height="56" loading="lazy" />
        <div class="byline-text">
          <span class="text-xs text-uppercase text-muted">Escrito por</span>
          <span class="byline-name">El Equipo Editorial de Eastern Alignment</span>
          <span class="byline-title text-sm text-muted">Investigación independiente de plataformas de videncia · Datos verificados de usuarios reales</span>
        </div>
      </div>

      <div class="prose">
        <h2>La Versión Corta: Lo Que Recomendamos Después de Años de Pruebas</h2>
        <p class="text-muted">
          Re-verificamos cada plataforma, precio y oferta de bienvenida de esta página en septiembre de 2026 usando cuentas activas, no material de marketing. Las promociones anteriores — los 3 minutos gratis + descuento de Psíquicos Web y los $30 de crédito de Purple Garden — estaban activas al momento de la comprobación.
        </p>
        <p>
          Si solo lees una sección de esta página, que sea esta. Tras años de investigación directa en las plataformas principales — sesiones reales, observaciones documentadas y cada plataforma evaluada con dinero propio — la conclusión honesta es que no existe "la mejor" plataforma de videncia. Existe la mejor plataforma <em>para tu situación</em>, y las diferencias son más determinantes de lo que sugiere el marketing.
        </p>
        <p>
          <a href="/es/resenas/psiquicos-web/">Psíquicos Web</a> es nuestra recomendación #1 para la mayoría de hispanohablantes en 2026. Encabeza nuestras recomendaciones porque combina dos cosas genuinamente raras: el ecosistema de videncia 100% en español más grande del mercado — con Baraja Española, Tarot de Marsella y tradiciones latinoamericanas que las plataformas anglófonas no ofrecen — y <strong>3 minutos gratis con cada nuevo lector</strong> (más hasta 60% de descuento en la primera recarga). Si es tu primera lectura online, empieza aquí.
        </p>
        <p>
          <a href="/es/resenas/purple-garden-es/">Purple Garden</a> es la respuesta moderna al problema de confianza de esta industria. Cada lector debe publicar una video introducción de 60 segundos, y su registro público Journeys — donde los clientes documentan si las predicciones se cumplieron — es el único registro de resultados a nivel de plataforma que hemos encontrado. Sus <strong>$30 de crédito en la primera compra</strong> y sus tarifas de entrada por debajo del dólar lo convierten en la forma más accesible de empezar, especialmente si prefieres video o lees desde el móvil.
        </p>
        <p>
          El hilo común en cada plataforma que recomendamos: te permiten <em>verificar</em>. Las plataformas que aconsejamos evitar son las que ocultan su catálogo, borran reseñas negativas o monetizan el miedo. El hábito más útil que puedes construir es tratar cada lectura como una hipótesis por comprobar, no como un veredicto por obedecer.
        </p>
        <div class="section-cta">
          <a href="/es/resenas/" class="btn btn--primary es-cta">Ver Todas las Reseñas →</a>
          <a href="/es/divulgacion/" class="btn btn--secondary">Cómo Funciona Este Sitio →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Reseñas Destacadas -->
  <section class="featured-reviews section" id="plataformas">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow text-xs text-uppercase text-muted">Investigación Independiente y Ranking</span>
        <h2 class="section-title">Mejores Plataformas de Videncia 2026</h2>
        <p class="section-desc text-muted">
          Nuestro ranking se basa en experiencias reales — no en dólares publicitarios. Cada plataforma fue analizada de forma independiente, y el análisis completo documenta exactamente lo que encontramos: precios verificados, lectores destacados con historial y opiniones reales de usuarios.
        </p>
      </div>

      <div class="review-cards">
        <!-- Psíquicos Web -->
        <article class="platform-card card card--elevated card--highlight">
          <span class="top-pick-badge badge badge--primary">✦ Elección del Editor</span>
          <div class="platform-card-header">
            <span class="badge badge--rank">#1</span>
            <div class="platform-info">
              <h3 class="platform-name">
                <a href="/es/resenas/psiquicos-web/">Psíquicos Web</a>
              </h3>
              <StarRating rating={4.8} size="md" />
            </div>
          </div>
          <p class="platform-verdict">
            La mayor plataforma de videncia operada íntegramente en español. Evaluamos el historial de lectores individuales, sus calificaciones verificadas y la relación calidad-precio de cada sesión.
          </p>
          <div class="platform-best-for">
            <span class="best-for-label">Mejor para:</span>
            <span class="best-for-value">Ecosistema 100% en español, Baraja Española, Amor</span>
          </div>
          <div class="platform-offer">
            <span class="offer-icon">🎁</span>
            <span>3 minutos gratis + gran descuento inicial</span>
          </div>
          <ul class="platform-highlights">
            <li><span class="highlight-check" aria-hidden="true">✓</span><span>Lecturas de Tarot y Baraja Española</span></li>
            <li><span class="highlight-check" aria-hidden="true">✓</span><span>Amplia disponibilidad por chat y teléfono</span></li>
            <li><span class="highlight-check" aria-hidden="true">✓</span><span>Lectores con tradiciones hispanas auténticas</span></li>
          </ul>
          <div class="platform-actions">
            <EsSpanishCTA platform="psiquicos" variant="discount" size="md" source="home-card" />
            <a href="/es/resenas/psiquicos-web/" class="btn btn--ghost">
              Leer Análisis Completo
            </a>
          </div>
        </article>

        <!-- Purple Garden -->
        <article class="platform-card card card--elevated">
          <div class="platform-card-header">
            <span class="badge badge--rank">#2</span>
            <div class="platform-info">
              <h3 class="platform-name">
                <a href="/es/resenas/purple-garden-es/">Purple Garden</a>
              </h3>
              <StarRating rating={4.7} size="md" />
            </div>
          </div>
          <p class="platform-verdict">
            Plataforma con lectores en español integrados en una comunidad internacional. Evaluamos lectores individuales de habla hispana, sus calificaciones y si la experiencia de usuario justifica el precio.
          </p>
          <div class="platform-best-for">
            <span class="best-for-label">Mejor para:</span>
            <span class="best-for-value">Video en vivo, transparencia (Journeys)</span>
          </div>
          <div class="platform-offer">
            <span class="offer-icon">🎁</span>
            <span>$30 de crédito en primera compra</span>
          </div>
          <ul class="platform-highlights">
            <li><span class="highlight-check" aria-hidden="true">✓</span><span>Video Bios obligatorias de cada lector</span></li>
            <li><span class="highlight-check" aria-hidden="true">✓</span><span>Sistema Journeys para verificar predicciones</span></li>
            <li><span class="highlight-check" aria-hidden="true">✓</span><span>Lectores hispanohablantes verificados (4.9★)</span></li>
          </ul>
          <div class="platform-actions">
            <EsSpanishCTA platform="purple-garden-es" variant="discount" size="md" source="home-card" />
            <a href="/es/resenas/purple-garden-es/" class="btn btn--ghost">
              Leer Análisis Completo
            </a>
          </div>
        </article>
      </div>

      <div class="section-cta">
        <a href="/es/resenas/" class="btn btn--secondary">Ver Todas las Reseñas →</a>
      </div>
    </div>
  </section>

  <!-- Guías editoriales (2026-10-02) -->
  {homeGuides.length > 0 && (
    <section class="home-guides section" id="guias">
      <div class="container">
        <div class="section-header">
          <span class="section-eyebrow text-xs text-uppercase text-muted">Guías Editoriales</span>
          <h2 class="section-title">Antes de Consultar: Guías Sin Humo</h2>
          <p class="section-desc text-muted">
            Tu ex, el tarot del amor, las señales que se repiten y las trampas del sector — explicados con el mismo criterio de auditor que aplicamos a cada reseña.
          </p>
        </div>
        <div class="home-guides-grid">
          {homeGuides.map(g => (
            <a class="home-guide card" href={g.url}>
              <span class="home-guide-cat">{ES_GUIDE_CATEGORIES[g.category]?.label}</span>
              <span class="home-guide-title">{g.cardTitle || g.title}</span>
              <span class="home-guide-desc text-muted text-sm">{g.description}</span>
            </a>
          ))}
        </div>
        <div class="section-cta">
          <a href="/es/guias/" class="btn btn--secondary">Ver Todas las Guías →</a>
        </div>
      </div>
    </section>
  )}

  <!-- Notas de campo: evidencia documentada -->
  <section class="field-notes section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow text-xs text-uppercase text-muted">Evidencia Documentada</span>
        <h2 class="section-title">Notas de Campo: Los Hallazgos Detrás de Nuestras Reseñas</h2>
        <p class="section-desc text-muted">
          Cualquiera puede escribir una reseña. Estos son los hallazgos documentados detrás de las nuestras — afirmaciones verificables, datos de plataforma y observaciones de sesión, cada una con enlace a su fuente completa.
        </p>
      </div>

      <div class="field-notes-grid stagger">
        {fieldNotes.map(note => (
          <div class="field-note card">
            <h3 class="field-note-title">{note.title}</h3>
            <div class="field-note-stat">{note.stat}</div>
            <p class="field-note-body text-muted text-sm">{note.body}</p>
            <a href={note.link} class="field-note-link text-sm">{note.linkLabel} →</a>
          </div>
        ))}
      </div>

      <!-- Extractos documentados de sesiones -->
      <div class="testament-grid stagger">
        {testaments.map(t => (
          <figure class="testament-card card">
            <blockquote class="testament-quote">“{t.quote}”</blockquote>
