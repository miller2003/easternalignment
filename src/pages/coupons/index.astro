    top: 16px;
    right: -34px;
    transform: rotate(45deg);
    background: linear-gradient(135deg, var(--color-star), var(--color-accent));
    color: #fff;
    font-size: 10px;
    font-weight: var(--weight-bold);
    text-transform: uppercase;
