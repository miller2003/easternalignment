    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-success);
    margin: 0 0 var(--space-5);
  }

  .coupon-card__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
