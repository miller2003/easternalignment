---
/**
 * Psychic Coupons, Promo Codes & Free Offers — /coupons/
 *
 * SEO architecture (2026-10-02 rebuild)
 * ─────────────────────────────────────
 * Target intent: "psychic coupon / promo code / discount / free minutes" and the
 * brand + modifier long tail ("kasamba promo code", "keen 5 minutes for $1",
 * "purple garden 30free", "tarot reading discount", "free psychic reading"…).
 * SERP reality: the head terms are held by coupon aggregators and affiliate
 * roundups. What they all lack — and what we can win on — is (a) the offer
 * TERMS (what counts, what doesn't, who qualifies), (b) honest "no code needed"
 * answers, (c) a decision layer (which offer for which reading type) and
 * (d) real freshness + verification signals.
 *
 * Page order (answer-first, then depth):
 *   1. H1 + quick-answer box        → featured-snippet / AI-overview target
 *   2. At-a-glance comparison table → table snippet
 *   3. Three offer cards            → the conversion block (unchanged component CSS)
 *   4. How to claim                 → HowTo-style steps
 *   5. One H2 per platform          → brand + "coupon / promo code" long tail
 *   6. Offers by reading type       → tarot / love / medium / astrology / career…
 *   7. Free-reading reality check   → "free psychic reading" intent
 *   8. Savings playbook + "why coupon-site codes fail" + other-site checklist
 *   9. Per-reader bonuses (top N per platform, link to full roster)
 *  10. FAQ (FAQPage schema), update log, disclosure
 *
 * Single sources of truth — nothing below invents an offer:
 *   · offer copy / links     → src/lib/offers.ts
 *   · pricing / ratings      → each platform review's frontmatter
 *   · page date + verify date→ src/data/coupons-meta.json (also feeds the sitemap <lastmod>)
 *   · reader cards           → src/content/readers frontmatter
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQ from '../../components/FAQ.astro';
import ReaderCard from '../../components/ReaderCard.astro';
import { PLATFORM_OFFERS, PLATFORM_PRIORITY, goPath, platformLogo } from '../../lib/offers';
import couponsMeta from '../../data/coupons-meta.json';

const SITE = 'https://easternalignment.com';
const PAGE_URL = `${SITE}/coupons/`;

/* ───────── dates (shown on page AND in schema) ───────── */
const fmtDate = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', {
    year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
  });
const updatedISO: string = couponsMeta.updated;
const verifiedISO: string = couponsMeta.verified;
const updatedLabel = fmtDate(updatedISO);
const verifiedLabel = fmtDate(verifiedISO);
const verifiedMonthYear = new Date(`${verifiedISO}T12:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', timeZone: 'UTC',
});

/* ───────── platform review frontmatter (pricing / rating) ───────── */
const reviewModules = import.meta.glob('../../content/reviews/*.md', { eager: true });
const reviewFM: Record<string, any> = {};
for (const [p, mod] of Object.entries(reviewModules) as [string, any][]) {
  const slug = p.split('/').pop()?.replace('.md', '') || '';
  reviewFM[slug] = mod.frontmatter || {};
}

/* ───────── readers (content/readers/<platform>/*.md) ───────── */
const readerModules = import.meta.glob('../../content/readers/**/*.md', { eager: true });
const allReaders = Object.entries(readerModules)
  .map(([path, mod]: [string, any]) => {
    const parts = path.split('/');
    const slug = parts.pop()?.replace('.md', '') || '';
    const platformFolder = parts[parts.length - 1]; // 'kasamba' | 'keen' | 'purple-garden'
    return { ...(mod.frontmatter || {}), slug, platform: platformFolder };
  })
  .filter((r) => r.platform && ['kasamba', 'keen', 'purple-garden'].includes(r.platform) && r.rating);

const readersByPlatform: Record<string, any[]> = { kasamba: [], 'purple-garden': [], keen: [] };
for (const r of allReaders) {
  if (readersByPlatform[r.platform]) readersByPlatform[r.platform].push(r);
}
for (const k of Object.keys(readersByPlatform)) {
  readersByPlatform[k].sort((a, b) => (b.rating || 0) - (a.rating || 0));
}
/* Show the top N per platform here; the full roster lives on each platform hub.
   162 cards on one page diluted the topical focus and bloated the DOM/LCP. */
const READERS_SHOWN = 9;
const totalReaders = allReaders.length;
const editorChoice = PLATFORM_PRIORITY[0]; // kasamba

const price = (k: string) => reviewFM[k]?.pricing || '';
const rate = (k: string) => reviewFM[k]?.rating;

/* ───────── comparison table (at-a-glance) ───────── */
const glance = [
  {
    key: 'kasamba',
    code: 'None — applied through our link',
    best: 'Love & relationship chat readings; auditioning several advisors',
    guarantee: 'Account credit up to $50 on a first session with a new advisor',
  },
  {
    key: 'purple-garden',
    code: 'Web only: 30free if the credit is not applied automatically',
    best: 'Video readings and tarot; mobile-first users',
    guarantee: 'Support credits your account balance (no card refunds)',
  },
  {
    key: 'keen',
    code: 'None — applied at checkout',
    best: 'Phone readings; astrology & mediumship variety; a $1 test drive',
    guarantee: 'Up to $25 account credit if you ask within 72 hours',
  },
] as const;

/* ───────── offers by reading type ───────── */
const byType = [
  {
    type: 'Love, relationship & “does he like me” readings',
    pick: 'kasamba',
    why: 'Free minutes with every new advisor let you audition several relationship specialists before paying.',
    href: '/guides/best-love-psychics-kasamba-ranked/',
    link: 'Best love psychics on Kasamba',
  },
  {
    type: 'Breakup, ex-recovery & no-contact readings',
    pick: 'kasamba',
    why: 'Chat transcripts are saved, so you can re-read a timeline later instead of relying on memory.',
    href: '/guides/best-psychics-for-breakups/',
    link: 'Best psychics for breakups',
  },
  {
    type: 'Tarot reading discount (love or general)',
    pick: 'purple-garden',
    why: 'The $30 credit covers a first session, and 60-second video bios show how a tarot reader works before you book.',
    href: '/guides/best-tarot-readers-for-love/',
    link: 'Best tarot readers for love',
  },
  {
    type: 'Medium readings & connecting with a loved one',
    pick: 'keen',
    why: 'Keen’s roster covers the broadest range of disciplines in our review, mediumship included, and $1 for 5 minutes is a cheap first test.',
    href: '/guides/evidential-mediums-passed-spouse/',
    link: 'Evidential mediums guide',
  },
  {
    type: 'Astrology & zodiac compatibility readings',
    pick: 'keen',
    why: 'Astrology is part of Keen’s broad discipline range; start with the $1 intro and one focused question.',
    href: '/guides/zodiac-compatibility-psychic-readings/',
    link: 'Zodiac compatibility readings',
  },
  {
    type: 'Career & money readings',
    pick: 'kasamba',
    why: 'Short free-minute auditions suit practical, single-question topics like a job decision.',
    href: '/guides/career-and-money-psychic-readings/',
    link: 'Career & money psychic readings',
  },
  {
    type: 'Twin flame & soulmate readings',
    pick: 'purple-garden',
    why: 'Video bios and the public “Journeys” track-record feed help you filter for specific, dated claims.',
    href: '/guides/best-twin-flame-psychics-online/',
    link: 'Best twin flame psychics',
  },
  {
    type: 'The cheapest way to try a reading at all',
    pick: 'keen',
    why: 'Your first 5 minutes cost $1. Purple Garden chat starting near $0.99/min is the budget alternative.',
    href: '/guides/cheap-love-psychics-online/',
    link: 'Cheap psychic readings that are worth it',
  },
] as const;

/* ───────── FAQ (also emitted as FAQPage JSON-LD by the FAQ component) ───────── */
const faqItems = [
  {
    question: 'Is there a Kasamba promo code?',
    answer:
      'You do not need one. Kasamba’s new-client offer — 3 free minutes with each new advisor plus 50% off your first paid session — is attached to your account when you sign up through our promotional link. If a signup screen ever asks for a code, use the one shown on that screen. Be wary of random “Kasamba coupon codes” from coupon aggregators: they are usually expired or describe a different promotion. Details are in the <a href="#kasamba-coupon">Kasamba coupon section</a> above and in our <a href="/guides/kasamba-3-free-minutes-guide/">Kasamba 3 free minutes guide</a>.',
  },
  {
    question: 'Does Kasamba really give 3 free minutes with every advisor?',
    answer:
      'Kasamba states that new clients get three free minutes with each psychic who is new to them, which is why it is the best platform for auditioning several readers. The free minutes are chat minutes and apply to new accounts only. Promotions can change, so confirm the offer on the screen before you start a session.',
  },
  {
    question: 'Can I combine Kasamba’s free minutes with the 50% off?',
    answer:
      'Yes — they are designed to work in sequence. The free minutes cover the opening of a session with a new advisor, and the 50% discount applies to your first paid session afterwards. The discount is a one-time new-client offer, not a recurring one. Separate coupon-site codes generally cannot be stacked on top of a welcome offer.',
  },
  {
    question: 'What is the best Keen promo code or coupon for new customers?',
    answer:
      'Keen’s headline new-client offer is your first 5 minutes for $1. It applies to your first session on a new account and is not a recurring discount; after the intro minutes you pay the advisor’s regular per-minute rate. Some coupon sites advertise other Keen intro bundles — check the checkout screen to see which one actually applies to your account before you pay.',
  },
  {
    question: 'Does Purple Garden have a coupon code?',
    answer:
      'Yes, sort of. The $30 free credit is applied automatically in the app after a qualifying first purchase. On the website, if the credit is not applied after you register, enter the promo code <strong>30free</strong>. It is a one-time first-purchase bonus. See our <a href="/guides/purple-garden-30-credit-guide/">Purple Garden $30 credit guide</a> for what it covers.',
  },
  {
    question: 'Is the Purple Garden $30 credit actually free?',
    answer:
      'It is a bonus, not a no-strings trial. You make a small first purchase (about $10 when we last checked — confirm the current minimum at checkout) and Purple Garden adds $30 of credit to your account. The credit is usable toward readings, not withdrawable as cash.',
  },
  {
    question: 'Which psychic site has the best offer for first-timers?',
    answer:
      'For most people Kasamba, because free minutes with each new advisor let you test several readers at no cost and the 50% discount follows. Choose Keen if you want the lowest possible entry price ($1) for a phone reading, and Purple Garden if you want the most credit and prefer to watch a reader’s video bio before booking. Our <a href="/match/">reader match tool</a> can narrow it down to your question.',
  },
  {
    question: 'Can I get a free psychic reading with no credit card?',
    answer:
      'Free time is real but limited. Reputable platforms tie their free minutes to a new account, and a payment method is usually needed if you want a session to continue past the free window. Be skeptical of pages promising a full free reading while asking for card details up front, or “free readings” that are generic horoscopes delivered by email. Our <a href="/guides/free-psychic-readings-online-truth/">free psychic readings guide</a> shows how to tell the difference.',
  },
  {
    question: 'Do these coupons work for tarot, astrology and medium readings?',
    answer:
      'The welcome offers are account-level promotions for new clients, so they are not limited to one reading style — tarot readers, mediums, astrologers and general psychics are all on these platforms. Each advisor’s profile and the checkout screen show exactly what applies, so check there before you start a session.',
  },
  {
    question: 'Do psychic coupons and welcome offers expire?',
    answer:
      'They can change or end without notice, and they are for new accounts only — existing customers generally do not qualify. We re-check the three offers on this page regularly and show the last verification date near the top. If the checkout screen does not show the offer described here, the promotion has probably changed.',
  },
  {
    question: 'Do psychic sites run Black Friday or holiday deals?',
    answer:
      'Platforms can run limited-time seasonal promotions, but none are guaranteed and they are not published on a schedule. When we verify one, it is added to this page; otherwise the three welcome offers above are the stable, repeatable ones.',
  },
  {
    question: 'How much does a psychic reading cost after the coupon?',
    answer:
      'After the intro offer you pay each advisor’s own rate. Current ranges from our platform reviews: Kasamba ' + price('kasamba') + '; Keen ' + price('keen') + '; Purple Garden ' + price('purple-garden') + '. Rates change often, so confirm the live price on the advisor’s profile. Our <a href="/guides/psychic-reading-prices/">psychic reading price guide</a> explains how per-minute billing adds up.',
  },
  {
    question: 'What if I am not happy with a reading I used a coupon on?',
    answer:
      'Each platform has its own protection, usually as account credit rather than a card refund: Kasamba credits up to $50 for a first session with a new advisor; Keen credits up to $25 if you contact support within 72 hours; Purple Garden support credits your account balance. File promptly with the advisor name and date. See each platform review for the fine print.',
  },
  {
    question: 'Do you earn a commission if I use these links?',
    answer:
      'Yes. Eastern Alignment is reader-supported: if you sign up through a link here we may earn a commission at no extra cost to you. It never changes the offer you get, and it does not buy placement — read <a href="/disclosure/">how this site works</a> and <a href="/methodology/">how we test</a>.',
  },
  {
    question: 'Where are the Psychic Source, California Psychics or Oranum coupons?',
    answer:
      'We only list platforms we have tested with our own paid sessions — Kasamba, Purple Garden and Keen — so we do not publish offers for other sites. If you are comparing welcome offers elsewhere, use the <a href="#judge-any-offer">checklist for judging any psychic offer</a> on this page.',
  },
];

/* ───────── structured data (WebSite / Organization / Person come from BaseLayout) ───────── */
const offerNode = (key: 'kasamba' | 'purple-garden' | 'keen', description: string, url: string) => ({
  '@type': 'Offer',
  name: `${PLATFORM_OFFERS[key].name} new-client offer: ${PLATFORM_OFFERS[key].offer}`,
  description,
  url,
  category: 'New-client welcome offer',
  eligibleCustomerType: 'New customers only',
  seller: { '@type': 'Organization', name: PLATFORM_OFFERS[key].name },
  itemOffered: {
    '@type': 'Service',
    name: `Online psychic reading on ${PLATFORM_OFFERS[key].name}`,
    serviceType: 'Online psychic reading (chat, phone or video)',
    provider: { '@type': 'Organization', name: PLATFORM_OFFERS[key].name },
  },
});

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['CollectionPage', 'WebPage'],
      '@id': `${PAGE_URL}#webpage`,
      url: PAGE_URL,
      name: 'Psychic Coupons, Promo Codes & Free Minutes (2026)',
      headline: 'Psychic Reading Coupons & Promo Codes: Free Minutes, Credit & Discounts',
      description:
        'Current new-client psychic reading coupons and promo codes for Kasamba, Keen and Purple Garden — what each offer includes, whether a code is needed, the fine print, and which deal suits tarot, love, medium or astrology readings.',
      inLanguage: 'en-US',
      isPartOf: { '@id': `${SITE}/#website` },
      publisher: { '@id': `${SITE}/#organization` },
      author: { '@id': `${SITE}/#sarah` },
      reviewedBy: { '@id': `${SITE}/#sarah` },
      datePublished: '2026-08-25',
      dateModified: updatedISO,
      lastReviewed: verifiedISO,
      about: [
        { '@type': 'Thing', name: 'Psychic reading coupons' },
        { '@type': 'Thing', name: 'Psychic reading promo codes' },
        { '@type': 'Thing', name: 'Free psychic reading minutes' },
      ],
      mentions: [
        { '@type': 'Organization', name: 'Kasamba' },
        { '@type': 'Organization', name: 'Keen' },
        { '@type': 'Organization', name: 'Purple Garden' },
      ],
      mainEntity: { '@id': `${PAGE_URL}#offers` },
      primaryImageOfPage: { '@type': 'ImageObject', url: `${SITE}/og-default.jpg` },
    },
    {
      '@type': 'ItemList',
      '@id': `${PAGE_URL}#offers`,
      name: 'Current psychic reading welcome offers',
      itemListOrder: 'https://schema.org/ItemListOrderDescending',
      numberOfItems: 3,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          item: offerNode(
            'kasamba',
            'New clients get 3 free chat minutes with each new advisor plus 50% off their first paid session. No promo code is needed through the promotional link.',
            `${SITE}/reviews/kasamba/`,
          ),
        },
        {
          '@type': 'ListItem',
          position: 2,
          item: offerNode(
            'purple-garden',
            'New clients get $30 of free credit with a first purchase. Applied automatically in the app; on the web use promo code 30free if it is not credited.',
            `${SITE}/reviews/purple-garden/`,
          ),
        },
        {
          '@type': 'ListItem',
          position: 3,
          item: offerNode(
            'keen',
            'New clients pay $1 for their first 5 minutes with an advisor, then the advisor’s regular per-minute rate.',
            `${SITE}/reviews/keen/`,
          ),
        },
      ],
    },
  ],
};

const jumpLinks = [
  { href: '#compare', label: 'Compare offers' },
  { href: '#kasamba-coupon', label: 'Kasamba' },
  { href: '#purple-garden-coupon', label: 'Purple Garden' },
  { href: '#keen-promo-code', label: 'Keen' },
  { href: '#by-reading-type', label: 'Tarot, love & more' },
  { href: '#free-psychic-reading', label: 'Free readings' },
  { href: '#savings-playbook', label: 'Save more' },
  { href: '#readers-kasamba', label: 'Per-reader bonuses' },
  { href: '#faq', label: 'FAQ' },
];
---

<BaseLayout
  title="Psychic Coupons & Promo Codes 2026: Free Minutes, Credit & Deals"
  description="Current psychic reading coupons and promo codes for Kasamba, Keen and Purple Garden — 3 free minutes + 50% off, 5 minutes for $1, $30 free credit — with the terms, the fine print and which deal fits tarot, love or medium readings."
  seoTitle="Psychic Coupons & Promo Codes 2026: Free Minutes & Deals"
  metaDescription="Psychic reading coupons & promo codes for 2026: Kasamba 3 free minutes + 50% off, Keen 5 min for $1, Purple Garden $30 credit (code 30free). Terms explained."
  canonicalUrl={PAGE_URL}
  jsonLd={pageSchema}
>
  <div class="container coupons-body">
    <Breadcrumb items={[{ label: 'Coupons & Free Offers' }]} />

    <!-- ============ HERO + QUICK ANSWER ============ -->
    <header class="coupon-hero">
      <span class="eyebrow eyebrow--center">New-Client Offers · Hand-Checked</span>
      <h1 class="section-title">Psychic Reading Coupons &amp; Promo Codes <span class="nowrap">(2026)</span></h1>
      <p class="coupon-hero__lede">
        The psychic coupons and free-minute offers worth claiming right now — what each one actually includes,
        whether you need a promo code, and the fine print coupon sites leave out.
      </p>
      <p class="coupon-hero__meta">
        <span>Page updated <time datetime={updatedISO}>{updatedLabel}</time></span>
        <span aria-hidden="true">·</span>
        <span>Offers last hand-verified {verifiedMonthYear}</span>
        <span aria-hidden="true">·</span>
        <span>By <a href="/about/">Sarah</a></span>
      </p>
    </header>

    <section class="answer-box" aria-labelledby="quick-answer">
      <h2 id="quick-answer" class="answer-box__title">Quick answer: which psychic coupon is best?</h2>
      <p>
        For most first-timers, <strong>Kasamba</strong> has the best psychic reading coupon:
        <strong>3 free minutes with every new advisor plus 50% off your first paid session</strong>.
        <strong>Keen</strong> is the cheapest way to try a phone reading (<strong>5 minutes for $1</strong>), and
        <strong>Purple Garden</strong> gives the most room for a first video reading (<strong>$30 free credit</strong>).
      </p>
      <p>
        You don’t need a coupon-site code for any of them. The only code in play is Purple Garden’s
        <code>30free</code>, and only on the web if the credit isn’t applied automatically. All three offers are
        for <strong>new accounts only</strong>.
      </p>
      <div class="answer-box__cta">
        <a
          href={goPath('kasamba')}
          class="btn btn--primary"
          rel="nofollow sponsored"
          target="_blank"
          data-cta-source="coupons-answerbox"
          data-cta-platform="kasamba"
        >{PLATFORM_OFFERS.kasamba.ctaLabel}</a>
        <a href="#compare" class="answer-box__alt">Compare all three offers ↓</a>
      </div>
    </section>

    <nav class="jump-nav" aria-label="On this page">
      {jumpLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <!-- ============ AT-A-GLANCE TABLE ============ -->
    <section id="compare" class="prose-section">
      <h2 class="section-title section-title--md">Psychic Coupons Compared: Offers, Codes &amp; Fine Print</h2>
      <p class="section-desc">
        Side-by-side view of every new-client psychic reading discount on this page. Prices are the per-minute
        ranges from our platform reviews — advisors set their own rates, so confirm the live number on a profile.
      </p>
      <div class="table-wrap" role="region" aria-label="Psychic coupon comparison table" tabindex="0">
        <table class="compare-table">
          <caption class="sr-only">Comparison of Kasamba, Purple Garden and Keen new-client offers</caption>
          <thead>
            <tr>
              <th scope="col">Platform</th>
              <th scope="col">Welcome offer</th>
              <th scope="col">Promo code needed?</th>
              <th scope="col">Best for</th>
              <th scope="col">Per-minute range</th>
              <th scope="col">Safety net</th>
              <th scope="col"><span class="sr-only">Claim</span></th>
            </tr>
          </thead>
          <tbody>
            {glance.map((g) => {
              const o = PLATFORM_OFFERS[g.key];
              return (
                <tr>
                  <th scope="row">
                    {o.name}
                    {rate(g.key) && <span class="compare-table__rating">{rate(g.key)}★ expert rating</span>}
                  </th>
                  <td><strong>{o.offer}</strong></td>
                  <td>{g.code}</td>
                  <td>{g.best}</td>
                  <td>{price(g.key)}</td>
                  <td>{g.guarantee}</td>
                  <td>
                    <a
                      href={goPath(g.key)}
                      class="btn btn--primary btn--sm"
                      rel="nofollow sponsored"
                      target="_blank"
                      data-cta-source="coupons-table"
                      data-cta-platform={g.key}
                    >Claim</a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ============ PLATFORM OFFER CARDS ============ -->
    <section id="platform-offers" class="offer-section">
      <div class="section-head section-head--center">
        <span class="eyebrow eyebrow--center">The Big Three</span>
        <h2 class="section-title section-title--md">Claim a Psychic Reading Welcome Offer</h2>
        <p class="section-desc">
          Each card mirrors that platform’s current new-client promotion. Claim through our promotional link — if the
          signup page asks for a code, use the code shown there.
        </p>
      </div>

      <div class="offer-grid">
        {PLATFORM_PRIORITY.map((key) => {
          const offer = PLATFORM_OFFERS[key];
          const isChoice = key === editorChoice;
          return (
            <article class:list={['coupon-card', { 'coupon-card--featured': isChoice }]}>
              {isChoice && <span class="coupon-card__ribbon">Editor's Choice</span>}

              <div class="coupon-card__top">
                <span class="coupon-card__brand">
                  <img
                    src={platformLogo(key, 64)}
                    alt=""
                    class="coupon-card__logo"
                    width="34"
                    height="34"
                    loading="lazy"
                    aria-hidden="true"
                  />
                  {offer.name}
                </span>
                <span class="coupon-card__count">{(readersByPlatform[key] || []).length} reader profiles published</span>
              </div>

              <div class="coupon-card__offer">
                <span class="coupon-card__offer-label">Welcome Offer</span>
                <span class="coupon-card__offer-value">{offer.offer}</span>
              </div>

              <p class="coupon-card__deal">{offer.dealLine}</p>

              <span class="coupon-card__perf" aria-hidden="true"></span>

              <p class="coupon-card__micro">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                {offer.microLine}
              </p>

              <div class="coupon-card__actions">
                <a
                  href={goPath(key)}
                  class="btn btn--primary btn--lg btn--full"
                  rel="nofollow sponsored"
                  target="_blank"
                  data-cta-source="coupons-platform"
                  data-cta-platform={key}
                >
                  {offer.ctaLabel}
                </a>
                <a href={`/reviews/${key}/`} class="coupon-card__reviewlink">
                  Read the full {offer.name} review →
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <!-- How it works -->
      <div class="how-strip">
        <div class="how-step">
          <span class="how-step__num">1</span>
          <div>
