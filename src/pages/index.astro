            <span class="sit-detail">{s.detail}</span>
            <span class="sit-go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <nav class="topic-links" aria-label="Browse all guides by topic">
        <span class="topic-links__label">Or browse all {totalGuides} guides by topic:</span>
        {homeTopics.map((t) => <a href={t.url}>{t.label}</a>)}
        <a href="/guides/" class="topic-links__all">All guides →</a>
      </nav>
    </div>
  </section>

  <ReaderMatch
    id="match"
    mode="modal"
    showHeader={false}
    title="Rather get names for your situation?"
    subtitle={`Tell us what’s going on and how you like to be read. You get a short reading of your situation, then a shortlist from ${siteStats.total} audited advisors with the reason each one made it. It runs privately in your browser.`}
  />

  <!-- ═══ 6. SHORTLIST — advisors who topped our audits (algorithmic) ═══ -->
  <section class="section" id="advisors">
    <div class="container">
      <header class="sec-head">
        <p class="kicker">From our audits</p>
        <h2 class="sec-title">Advisors who earned the top of our list</h2>
        <p class="sec-desc">
          The highest-scored advisor on each platform, plus the best one at ${VALUE_CAP}/min or less.
          Picked automatically from our audit scores — nobody pays to be here.
        </p>
      </header>

      <div class="advisors">
        {shortlist.map((r) => (
          <article class="adv">
            <div class="adv-top">
              <span class="adv-avatar" aria-hidden="true">
                <span class="adv-initial">{r.name.charAt(0)}</span>
