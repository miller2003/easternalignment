---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlatformCard from '../components/PlatformCard.astro';
import FAQ from '../components/FAQ.astro';

/* Fetch reviews for the platform cards */
const reviewModules = import.meta.glob('../content/reviews/*.md', { eager: true });
const reviews = Object.entries(reviewModules)
  .map(([path, mod]: [string, any]) => ({
    ...mod.frontmatter,
    slug: path.split('/').pop()?.replace('.md', ''),
  }))
  .sort((a, b) => (a.rank || 99) - (b.rank || 99));

/* Fetch guides */
const guideModules = import.meta.glob('../content/guides/*.md', { eager: true });
const guides = Object.entries(guideModules).map(([path, mod]: [string, any]) => ({
  ...mod.frontmatter,
  slug: path.split('/').pop()?.replace('.md', ''),
}));

const homeFAQs = [
  {
    question: "Are online psychic readings legitimate?",
    answer: "Many online psychic reading platforms employ screened, experienced advisors who provide genuine intuitive guidance. The key is choosing reputable platforms (like the ones I review) that vet their psychics and offer satisfaction guarantees. My reviews are based on personal testing to help you distinguish quality from pretenders."
  },
  {
    question: "How much does an online psychic reading cost?",
    answer: "Prices typically range from $1.99 to $30+ per minute, depending on the psychic's experience and the platform. Most major platforms offer generous free introductory minutes, so you can test the experience without financial commitment."
  },
  {
    question: "How do you review psychic platforms?",
    answer: "I personally sign up for and test each platform over weeks or months. I evaluate the psychic roster quality, pricing transparency, user experience, customer support, satisfaction guarantees, and the accuracy and helpfulness of actual readings I receive."
  },
  {
    question: "Which psychic reading platform is best for beginners?",
    answer: "I generally recommend Kasamba for beginners because of its large psychic selection, generous free trial (3 free minutes per psychic), and user-friendly interface. It lets you explore different reading styles without a big upfront investment."
  },
];


const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "EasternAlignment",
  "url": "https://easternalignment.com",
  "logo": "https://easternalignment.com/logo.jpg",
  "description": "Honest, independent reviews of online psychic reading platforms. Personally tested by real users.",
  "founder": {
    "@type": "Person",
    "name": "Sarah"
  }
};
---

<BaseLayout
  title="Best Online Psychic Reading Platforms 2026 — Honest Reviews"
  description="Honest, independent reviews of online psychic reading platforms. Personally tested and ranked to help you find clarity and guidance."
  jsonLd={orgSchema}
>
  <!-- Hero Section -->
  <section class="hero section--lg">
    <div class="container">
      <div class="hero-content">
        <span class="hero-eyebrow text-xs text-uppercase text-muted">Honest Reviews · Personally Tested · Independent</span>
        <h1 class="hero-title">Finding Clarity<br />When Life Feels Uncertain</h1>
        <p class="hero-subtitle">
          I've spent 3+ years personally testing every major online psychic reading platform — so you can find the right guidance without the guesswork.
        </p>
        <div class="hero-actions">
          <a href="/reviews/" class="btn btn--primary btn--lg">See My Top Picks</a>
          <a href="/guides/what-is-psychic-reading/" class="btn btn--secondary btn--lg">New to This? Start Here</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="trust-bar section--alt">
    <div class="container">
      <div class="trust-grid">
        <div class="trust-item">
          <span class="trust-number">6+</span>
          <span class="trust-label">Platforms Reviewed</span>
        </div>
        <div class="trust-divider" aria-hidden="true"></div>
        <div class="trust-item">
          <span class="trust-number">100+</span>
          <span class="trust-label">Hours of Testing</span>
        </div>
        <div class="trust-divider" aria-hidden="true"></div>
        <div class="trust-item">
          <span class="trust-number">50+</span>
          <span class="trust-label">Readings Completed</span>
        </div>
        <div class="trust-divider" aria-hidden="true"></div>
        <div class="trust-item">
          <span class="trust-number">100%</span>
          <span class="trust-label">Independent & Honest</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Reviews -->
  <section class="featured-reviews section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow text-xs text-uppercase text-muted">Personally Tested & Ranked</span>
        <h2 class="section-title">Best Psychic Reading Platforms 2026</h2>
        <p class="section-desc text-muted">
          My rankings are based on real experiences — not advertising dollars. Every platform below has been independently tested.
        </p>
      </div>

      <div class="review-cards stagger">
        {reviews.map(review => (
          <PlatformCard
            rank={review.rank}
            name={review.platformName}
            slug={review.slug}
            rating={review.rating}
            verdict={review.verdict}
            bestFor={review.bestFor || 'General readings'}
            highlights={review.highlights || []}
            affiliateUrl={review.affiliateUrl}
            freeOffer={review.freeOffer}
            isTopPick={review.rank === 1}
          />
        ))}
      </div>

      <div class="section-cta">
        <a href="/reviews/" class="btn btn--secondary">View All Reviews →</a>
      </div>
    </div>
  </section>

  <!-- How I Review -->
  <section class="methodology section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow text-xs text-uppercase text-muted">My Process</span>
        <h2 class="section-title">How I Review Platforms</h2>
        <p class="section-desc text-muted">
          I don't just browse websites and call it a review. Here's what sets my process apart.
        </p>
      </div>

      <div class="method-grid grid grid--3 stagger">
        <div class="method-card card">
          <span class="method-number">01</span>
          <h3 class="method-title">I Sign Up & Pay</h3>
          <p class="method-desc text-muted text-sm">
            I create real accounts, pay with real money, and go through the exact same experience you would. No special treatment from platforms.
          </p>
        </div>
        <div class="method-card card">
          <span class="method-number">02</span>
          <h3 class="method-title">I Get Readings</h3>
          <p class="method-desc text-muted text-sm">
            Multiple readings across different specialties, with different psychics. I test chat, phone, and video options when available.
          </p>
        </div>
        <div class="method-card card">
          <span class="method-number">03</span>
          <h3 class="method-title">I Share Honestly</h3>
          <p class="method-desc text-muted text-sm">
            The good, the bad, and the mediocre. I tell you about my worst experiences just as candidly as my best ones. No sugar coating.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Guides -->
  <section class="latest-guides section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow text-xs text-uppercase text-muted">Learn & Explore</span>
        <h2 class="section-title">Helpful Guides</h2>
      </div>

      <div class="guides-grid grid grid--2 stagger">
        {guides.map(guide => (
          <a href={`/guides/${guide.slug}/`} class="guide-card card card--elevated">
            {guide.category && <span class="badge badge--sage">{guide.category}</span>}
            <h3 class="guide-card-title">{guide.title}</h3>
            <p class="guide-card-desc text-muted text-sm">{guide.description}</p>
            <span class="guide-card-link text-primary text-sm">Read Guide →</span>
          </a>
        ))}
        <a href="/comparisons/" class="guide-card card card--elevated">
          <span class="badge badge--primary">Compare</span>
          <h3 class="guide-card-title">Platform Comparisons</h3>
          <p class="guide-card-desc text-muted text-sm">Head-to-head breakdowns to help you choose between top platforms.</p>
          <span class="guide-card-link text-primary text-sm">See Comparisons →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- About Teaser -->
  <section class="about-teaser section section--alt">
    <div class="container container--narrow" style="text-align: center;">
      <img src="/sarah-avatar.jpg" alt="Sarah — Founder of EasternAlignment" class="about-avatar" width="80" height="80" loading="lazy" />
      <h2 class="section-title" style="margin-top: var(--space-6);">Hi, I'm Sarah</h2>
      <p class="text-muted" style="max-width: 520px; margin: 0 auto var(--space-6);">
        After a devastating breakup led me to try online psychic readings out of desperation, I discovered that finding the right advisor can genuinely change your perspective. Now I help others navigate this space with honest, first-hand reviews.
      </p>
      <a href="/about/" class="btn btn--secondary">Read My Story →</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="home-faq section">
    <div class="container container--narrow">
      <FAQ items={homeFAQs} title="Common Questions" />
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    text-align: center;
    padding-top: var(--space-16);
    padding-bottom: var(--space-10);
  }

  .hero-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .hero-eyebrow {
    display: block;
    margin-bottom: var(--space-4);
    letter-spacing: 0.15em;
  }

  .hero-title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-6);
    line-height: 1.15;
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Trust Bar */
  .trust-bar {
    padding: var(--space-8) 0;
  }

  .trust-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .trust-item {
    text-align: center;
  }

  .trust-number {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: var(--space-1);
  }

  .trust-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .trust-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border);
  }

  /* Section Headers */
  .section-header {
    text-align: center;
    margin-bottom: var(--space-6);
  }

  .section-eyebrow {
    display: block;
    margin-bottom: var(--space-3);
    letter-spacing: 0.15em;
  }

  .section-title {
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  .section-desc {
    max-width: 540px;
    margin: 0 auto;
    line-height: var(--leading-normal);
  }

  .section-cta {
    text-align: center;
    margin-top: var(--space-6);
  }

  /* Review Cards */
  .review-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 800px;
    margin: 0 auto;
  }

  /* Method Cards */
  .method-card {
    text-align: center;
    padding: var(--space-8) var(--space-6);
  }

  .method-number {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-accent-light);
    margin-bottom: var(--space-4);
    line-height: 1;
  }

  .method-title {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-3) 0;
  }

  .method-desc {
    margin: 0;
  }

  /* Guides Grid */
  .guide-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-decoration: none;
    padding: var(--space-6);
  }

  .guide-card-title {
    font-size: var(--text-lg);
    margin: 0;
    transition: color var(--transition-fast);
  }

  .guide-card:hover .guide-card-title {
    color: var(--color-primary);
  }

  .guide-card-desc {
    margin: 0;
    flex: 1;
  }

  .guide-card-link {
    font-weight: var(--weight-medium);
  }

  /* About Teaser */
  .about-avatar {
    display: block;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 20%;
    border: 3px solid var(--color-border-light);
    margin: 0 auto;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: var(--space-10);
    }

    .trust-divider {
      display: none;
    }

    .trust-grid {
      gap: var(--space-6);
    }
  }
</style>