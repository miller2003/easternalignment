---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlatformCard from '../components/PlatformCard.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FAQ from '../components/FAQ.astro';

const SITE_URL = 'https://easternalignment.com';

/* Fetch reviews for the platform cards */
const reviewModules = import.meta.glob('../content/reviews/*.md', { eager: true });
const reviews = Object.entries(reviewModules)
  .map(([path, mod]: [string, any]) => ({
    ...mod.frontmatter,
    slug: path.split('/').pop()?.replace('.md', ''),
  }))
  .sort((a, b) => (a.rank || 99) - (b.rank || 99));

/* Fetch guides */
const guideModules = import.meta.glob('../content/guides/*.md', { eager: true });
const guides = Object.entries(guideModules).map(([path, mod]: [string, any]) => ({
  ...mod.frontmatter,
  slug: path.split('/').pop()?.replace('.md', ''),
}));

/* Load all reader reviews to count them */
const readerModules = import.meta.glob('../content/readers/**/*.md', { eager: true });
const totalReaders = Object.keys(readerModules).length;
const totalPlatforms = reviews.length;
const totalGuides = guides.length;

/* Curated "Start Here" guides — the best entry points for new readers */
const curatedSlugs = [
  'what-is-psychic-reading',
  'questions-to-ask-a-psychic',
  'how-to-choose-a-psychic-reader',
  'how-much-does-a-psychic-reading-cost',
  'best-psychic-hotlines-2026',
  'signs-your-ex-is-coming-back',
  'clairs-the-four-psychic-abilities-guide',
  'karmic-relationships-signs-and-lessons',
];
const curatedGuides = curatedSlugs
  .map(slug => guides.find(g => g.slug === slug))
  .filter(Boolean);

/* Quick comparison table data — sourced from the full platform reviews.
   Order: Kasamba (No.1, highest rating) → Purple Garden (No.2) → Keen (No.3).
   Updated 2026-08-25 with the site-wide default rating reset. */
const comparisonPlatforms = [
  {
    name: 'Kasamba',
    affiliateUrl: '/go/kasamba/',
    rating: 4.9,
    pricing: '$1.99–$30+/min',
    freeOffer: '3 free min per reader + 50% off',
    specialties: 'Chat readings · Relationship specialists · Auto-saved transcripts',
    satisfaction: 'Credit for unsatisfied sessions',
    availability: '24/7 · 500+ advisors',
    communication: 'Chat · Phone',
  },
  {
    name: 'Purple Garden',
    affiliateUrl: '/go/purple-garden/',
    rating: 4.88,
    pricing: '$0.99–$15+/min',
    freeOffer: '$30 credit on first purchase',
    specialties: 'Video readings · Journeys outcome ledger · Mobile app',
    satisfaction: 'Site credit for technical issues',
    availability: '24/7 · Curated mid-size roster',
    communication: 'Video · Phone · Chat',
  },
  {
    name: 'Keen',
    affiliateUrl: '/go/keen/',
    rating: 4.8,
    pricing: '$1.99–$20+/min',
    freeOffer: '5 minutes for $1',
    specialties: 'Phone readings · Deepest roster · Un-deletable reviews',
    satisfaction: 'Account credit, up to $25',
    availability: '24/7 · Thousands of advisors',
    communication: 'Phone · Chat',
  },
];

/* Verdict cards — first card is the site-wide #1 (BEST OVERALL), then the
   niche winners. Kasamba now wears "Best Overall"; Purple Garden keeps
   "Best for Video & Mobile"; Keen's new niche tag is "Best for Phone"
   (its $1/5min voice entry is its strongest play, not the overall crown). */
const verdictCards = [
  {
    name: 'Kasamba',
    tag: 'Best Overall',
    url: '/reviews/kasamba/',
    affiliate: '/go/kasamba/',
    offer: '3 free minutes per new reader',
    body: 'The highest overall score in my 2026 testing — and the safest platform to start on: 3 free minutes with every new advisor, permanent chat transcripts, and a relationship-specialist roster that no competitor matches at the same entry price.',
  },
  {
    name: 'Purple Garden',
    tag: 'Best for Video & Mobile',
    url: '/reviews/purple-garden/',
    affiliate: '/go/purple-garden/',
    offer: '$30 credit on first purchase',
    body: 'Mandatory video intros and the public Journeys ledger let you see and audit an advisor before spending a dollar. The most accessible entry price.',
  },
  {
    name: 'Keen',
    tag: 'Best for Phone',
    url: '/reviews/keen/',
    affiliate: '/go/keen/',
    offer: '5 minutes for $1',
    body: 'The deepest roster in the industry, the finest phone infrastructure, and the most transparent review ledger. The strongest choice for a phone-first seeker on the tightest budget.',
  },
];

/* Field notes — real, documented findings from my testing (each links to its source review) */
const fieldNotes = [
  {
    title: 'The $1 Elite Test (Keen)',
    stat: '$1 buys 5 minutes with a $15\u2013$20/min reader',
    body: 'If an elite reader cannot deliver a profound, specific hit within five minutes, they are not worth your ongoing investment at any price. That single test beats an hour of reading reviews.',
    link: '/reviews/keen/',
    linkLabel: 'Read the full Keen review',
  },
  {
    title: 'The Transcript Audit (Kasamba)',
    stat: 'Every chat session is saved permanently',
    body: 'Predictions with windows become checkable claims. When an advisor says \u201ccommunication in 14 days,\u201d you pull the transcript three weeks later and audit it with clinical precision.',
    link: '/reviews/kasamba/',
    linkLabel: 'Read the full Kasamba review',
  },
  {
    title: 'The 12-Month Purple Garden Audit',
    stat: '12 months \u00b7 $840 \u00b7 24 advisors \u00b7 150 Journeys threads',
    body: '78% of the Journeys threads I tracked contained authentic client follow-ups confirming whether a prediction materialized. Advisors cannot edit or delete those posts.',
    link: '/guides/is-purple-garden-legit/',
    linkLabel: 'Read the legitimacy audit',
  },
  {
    title: 'The Reader Who Earned Her Rating (Keen)',
    stat: 'Krys Britton \u00b7 49,000 readings \u00b7 4.82 stars',
    body: '8,523 verified ratings, 93% five-star, at $2.25/min \u2014 the best price-to-experience ratio I have documented in any review series. Reddit users independently contacted 15 former clients to verify her predictions.',
    link: '/reviews/keen/krys-britton-on-keen-review-2026/',
    linkLabel: 'Read Krys Britton\u2019s review',
  },
  {
    title: 'The Dedicated Medium (Keen)',
    stat: 'Eye of Pheobe \u00b7 24 years \u00b7 2,680 sessions',
    body: 'The only dedicated medium in my nine-reader Keen series. Her 4.69 rating is the hardest number in the series to earn, because mediumship has a single success condition: recognizable connection.',
    link: '/reviews/keen/eye-of-pheobe-on-keen-review-2026/',
    linkLabel: 'Read Eye of Pheobe\u2019s review',
  },
  {
    title: 'The Chat Value Test (Purple Garden)',
    stat: 'Tarot by Elena \u00b7 8-minute session \u00b7 complete reading',
    body: '4,100+ readings delivered as card-by-card breakdowns. A fast, structured reader produces more usable content in 8 minutes than a slow one does in 20 \u2014 density, not rate, is the real price.',
    link: '/reviews/purple-garden/tarot-by-elena/',
    linkLabel: 'Read Tarot by Elena\u2019s review',
  },
];

/* Testimonial-style excerpts — paraphrased from documented session notes in the reviews */
const testaments = [
  {
    quote: 'Intensity is not the same thing as spiritual compatibility. What the cards show here is a karmic mirror \u2014 designed to trigger the wound so you finally build internal sovereignty.',
    source: 'Twin Flame Specialist Aria, Purple Garden \u2014 8-minute video session',
    link: '/reviews/purple-garden/twin-flame-specialist-aria/',
  },
  {
    quote: 'He is not silent because he doesn\u2019t care. He is silent because his emotional bandwidth is consumed by external stress \u2014 and his attachment style treats vulnerability as a loss of autonomy.',
    source: 'Empathic Intuitive Marcus, Purple Garden \u2014 voice session, minute 3',
    link: '/reviews/purple-garden/empathic-intuitive-marcus/',
  },
  {
    quote: '84% of clients who logged a specific timeline prediction from Chloe returned within two months to confirm it landed inside her projected window.',
    source: 'Psychic Medium Chloe, Purple Garden \u2014 3-hour Journeys audit',
    link: '/reviews/purple-garden/psychic-medium-chloe/',
  },
];

const homeFAQs = [
  {
    question: "Are online psychic readings legitimate?",
    answer: "Many online platforms employ screened, experienced advisors who provide genuine intuitive guidance. The key is choosing reputable platforms that vet their psychics and offer satisfaction guarantees. My reviews are based on personal testing \u2014 real accounts, real money, documented sessions \u2014 to help you distinguish quality from pretenders."
  },
  {
    question: "How much does an online psychic reading cost?",
    answer: "Prices typically range from $0.99 to $30+ per minute, depending on the platform, the modality, and the reader\u2019s experience. Entry-level chat runs $1\u2013$5/min, professional readers with track records run $5\u2013$15/min, and elite specialists run $15\u2013$30+/min. Most major platforms offer free or heavily discounted introductory minutes so you can test the connection before committing. See the full <a href=\"/guides/how-much-does-a-psychic-reading-cost/\">pricing guide</a>."
  },
  {
    question: "How do you review psychic platforms?",
    answer: "I sign up for and test each platform personally over weeks or months. I evaluate roster quality, pricing transparency, user experience, customer support, satisfaction guarantees, and the accuracy of the readings I actually receive. Where available, I audit public outcome ledgers and session transcripts \u2014 for example, my 12-month, $840 audit of Purple Garden tracked 150 Journeys threads."
  },
  {
    question: "Which psychic reading platform is best for beginners?",
    answer: "I generally recommend <a href=\"/go/kasamba\" rel=\"nofollow sponsored\" target=\"_blank\">Kasamba</a> for beginners \u2014 it is my #1 overall platform in 2026. New clients get <strong>3 free minutes with every new advisor</strong> (plus 50% off the first paid session), so you can test multiple relationship specialists risk-free before spending a dollar, and every chat session is saved as a permanent transcript you can audit later."
  },
  {
    question: "Which platform is best for phone readings?",
    answer: "Keen. Its telephone infrastructure is the best in the industry: immediate connections, a flawless callback system for busy readers, and an un-deletable review ledger that makes every advisor\u2019s track record public. If you trust your ears, Keen is the platform."
  },
  {
    question: "Which platform is best for chat readings with permanent records?",
    answer: "Kasamba. Every chat session is saved automatically, turning every prediction into a written claim you can audit weeks later. Its 3 free minutes with every new advisor also make it the safest platform for testing many readers risk-free."
  },
  {
    question: "Which platform is best for video readings?",
    answer: "Purple Garden. Every advisor is required to post a 60-second video introduction, and its public Journeys ledger lets you audit how clients\u2019 predictions actually landed. It is the only major platform where you can see and inspect an advisor before spending a dollar."
  },
  {
    question: "What is the difference between a psychic and a medium?",
    answer: "A psychic perceives information about your circumstances, relationships, or likely path through extrasensory perception. A medium specifically works with people who have died. All mediums are psychics, but not all psychics are mediums \u2014 mediumship is a specialized discipline with a much harder standard of evidence. See the full <a href=\"/guides/psychic-vs-medium-vs-tarot-reader/\">breakdown</a>."
  },
  {
    question: "How do I avoid psychic scams?",
    answer: "The industry\u2019s scam patterns are consistent: manufactured fear (curses, dark energy, blocks), escalating paid \u201cremovals,\u201d guaranteed outcomes, and the waiting loop that keeps clients paying month after month. A legitimate reading leaves you clearer, not more afraid. I\u2019ve documented every pattern in the <a href=\"/guides/how-to-spot-fake-psychic/\">fake psychic detection guide</a>."
  },
  {
    question: "How do I prepare for my first reading?",
    answer: "Write down one focused question before the session, give the reader minimal backstory, and let them demonstrate unprompted specificity before you confirm anything. The question quality determines the reading quality. My <a href=\"/guides/questions-to-ask-a-psychic/\">question guide</a> and <a href=\"/guides/first-psychic-reading-guide/\">first-reading guide</a> walk through the whole protocol."
  },
];

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Eastern Alignment",
  "url": "https://easternalignment.com",
  "logo": "https://easternalignment.com/logo.jpg",
  "description": "Honest, independent reviews of online psychic reading platforms. Personally tested by real users.",
  "founder": {
    "@type": "Person",
    "name": "Sarah"
  }
};
---

<BaseLayout
  title="Best Online Psychic Reading Platforms 2026"
  description="Honest, independent reviews of online psychic reading platforms. Personally tested and ranked to help you find clarity and guidance."
  jsonLd={orgSchema}
  hreflangEs={`${SITE_URL}/es/`}
  topOfferPlatform="kasamba"
>
  <!-- Hero Section -->
  <section class="hero section--lg">
    <div class="container">
      <div class="hero-content">
        <span class="hero-eyebrow text-xs text-uppercase text-muted">Honest Reviews · Personally Tested · Independent</span>
        <h1 class="hero-title">Finding Clarity in <br /><span class="text-gradient">Online Psychic Readings</span></h1>
        <p class="hero-subtitle">
          I've spent 3+ years personally testing every major online psychic reading platform — so you can find the right guidance without the guesswork. Every recommendation below was paid for with my own money and documented session by session.
        </p>
        <div class="hero-actions">
          <a href="#comparison" class="btn btn--primary btn--lg">Compare Top Platforms</a>
          <a href="/guides/what-is-psychic-reading/" class="btn btn--secondary btn--lg">New to This? Start Here</a>
        </div>
        <div class="hero-meta">
          <span class="hero-meta-item">Written by <a href="/about/">Sarah</a></span>
          <span class="hero-meta-dot" aria-hidden="true">·</span>
          <span class="hero-meta-item">Last tested: July 2026</span>
          <span class="hero-meta-dot" aria-hidden="true">·</span>
          <span class="hero-meta-item">{totalGuides} guides &amp; comparisons on site</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="trust-bar section--alt">
    <div class="container">
      <div class="trust-grid">
        <div class="trust-item">
          <span class="trust-number">{totalPlatforms}</span>
          <span class="trust-label">Platforms Tested In-Depth</span>
        </div>
        <div class="trust-divider" aria-hidden="true"></div>
        <div class="trust-item">
          <span class="trust-number">{totalReaders}+</span>
          <span class="trust-label">Individual Reader Reviews</span>
        </div>
        <div class="trust-divider" aria-hidden="true"></div>
        <div class="trust-item">
          <span class="trust-number">100+</span>
          <span class="trust-label">Hours of Documented Testing</span>
        </div>
        <div class="trust-divider" aria-hidden="true"></div>
        <div class="trust-item">
          <span class="trust-number">{totalGuides}</span>
          <span class="trust-label">Guides &amp; Comparisons</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Comparison -->
  <section class="quick-compare section" id="comparison">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow text-xs text-uppercase text-muted">Side-by-Side · Tested in 2026</span>
        <h2 class="section-title">The Best Psychic Platforms Compared</h2>
        <p class="section-desc text-muted">
          Three platforms, one standard: every number below comes from my full, paid testing — not from marketing pages. Kasamba is my #1 overall pick for most seekers in 2026; Purple Garden is the strongest video/mobile choice, and Keen remains the best phone-first platform at the lowest entry price.
        </p>
      </div>

      <ComparisonTable platforms={comparisonPlatforms} highlightIndex={0} />

      <div class="verdict-grid stagger">
        {verdictCards.map(card => (
          <div class="verdict-card card">
            <div class="verdict-card-head">
              <span class="badge badge--primary">{card.tag}</span>
              <h3 class="verdict-card-name">{card.name}</h3>
            </div>
            <p class="verdict-card-body text-muted">{card.body}</p>
            <div class="verdict-card-offer">
              <span class="offer-label">Offer:</span>
              <span class="offer-value">{card.offer}</span>
            </div>
            <div class="verdict-card-actions">
              <a href={card.affiliate} class="btn btn--primary btn--sm" rel="nofollow sponsored" target="_blank">Visit {card.name} →</a>
              <a href={card.url} class="btn btn--ghost btn--sm">Full Review</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The Short Version (flagship editorial) -->
  <section class="short-version section section--alt">
    <div class="container container--narrow">
      <div class="byline-card">
        <img src="/sarah-avatar.jpg" alt="Sarah — founder of Eastern Alignment" class="byline-avatar" width="56" height="56" loading="lazy" />
        <div class="byline-text">
          <span class="text-xs text-uppercase text-muted">Written by</span>
          <span class="byline-name">Sarah</span>
          <span class="byline-title text-sm text-muted">Spiritual Wellness Researcher · 3+ years testing psychic platforms</span>
        </div>
      </div>

      <div class="prose">
        <h2>The Short Version: What I Recommend After 3+ Years of Testing</h2>
        <p>
          If you only read one section of this page, read this one. After years of paid testing across the major platforms — dozens of sessions, hundreds of documented hours, and every platform reviewed below evaluated with my own money — the honest conclusion is that there is no single "best" psychic platform. There is the best platform <em>for your situation</em>, and the differences are more consequential than the marketing suggests.
        </p>
        <p>
          <a href="/reviews/kasamba/">Kasamba</a> is my #1 overall recommendation for most people in 2026. It earned the highest score in my latest testing because it pairs two genuinely rare things: a relationship-specialist roster that no competitor matches at the same entry price, and <strong>3 free minutes with every new advisor</strong> (plus 50% off the first paid session). The permanent chat transcripts make every prediction a claim you can audit later. If you are new to online readings, start here.
        </p>
        <p>
          <a href="/reviews/purple-garden/">Purple Garden</a> is the modern answer to the industry\u2019s core trust problem. Every advisor is required to post a 60-second video introduction, and its public Journeys ledger — where clients document whether predictions came true — is the only platform-level outcome record I have found anywhere. Its <strong>$30 first-purchase credit</strong> and sub-$1 entry rates make it the most accessible way to start, especially if you prefer video or are on mobile.
        </p>
        <p>
          <a href="/reviews/keen/">Keen</a> is the choice for voice-first seekers on the tightest budget. It has the deepest roster in the industry, the finest phone infrastructure, and — most importantly — the only truly un-deletable public review ledger I have found. Quality is visible on Keen if you are willing to look, and its <strong>5 minutes for $1</strong> trial lets you test a top-tier phone reader for pocket change.
        </p>
        <p>
          The common thread in every platform I recommend: they let you <em>verify</em>. The platforms I tell people to avoid are the ones that hide their rosters, scrub negative reviews, or monetize fear. I have documented the scam patterns in my <a href="/guides/how-to-spot-fake-psychic/">fake psychic guide</a> — and the single most useful habit you can build is treating every reading as a hypothesis to be checked, not a verdict to be obeyed.
        </p>
        <div class="section-cta">
          <a href="/reviews/" class="btn btn--primary">Read All Platform Reviews →</a>
          <a href="/comparisons/" class="btn btn--secondary">See the Comparisons →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Reviews -->
  <section class="featured-reviews section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow text-xs text-uppercase text-muted">Personally Tested & Ranked</span>
        <h2 class="section-title">Best Psychic Reading Platforms 2026</h2>
        <p class="section-desc text-muted">
          My rankings are based on real experiences — not advertising dollars. Every platform below has been independently tested, and the full review for each documents what I actually found.
        </p>
      </div>

      <div class="review-cards stagger">
        {reviews.map(review => (
          <PlatformCard
            rank={review.rank}
            name={review.platformName}
            slug={review.slug}
            rating={review.rating}
            verdict={review.verdict}
            bestFor={review.bestFor || 'General readings'}
            highlights={review.highlights || []}
            affiliateUrl={review.affiliateUrl}
            freeOffer={review.freeOffer}
            isTopPick={review.rank === 1}
          />
        ))}
      </div>

      <div class="section-cta">
        <a href="/reviews/" class="btn btn--secondary">View All Reviews →</a>
      </div>
    </div>
  </section>

  <!-- Field Notes: documented testing evidence -->
  <section class="field-notes section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow text-xs text-uppercase text-muted">Documented Evidence</span>
        <h2 class="section-title">Field Notes: Proof I Actually Tested These</h2>
        <p class="section-desc text-muted">
          Anyone can write a review. These are the documented findings behind mine — specific numbers, verifiable claims, and session records, each linked to the full source.
        </p>
      </div>

      <div class="field-notes-grid stagger">
        {fieldNotes.map(note => (
          <div class="field-note card">
            <h3 class="field-note-title">{note.title}</h3>
            <div class="field-note-stat">{note.stat}</div>
            <p class="field-note-body text-muted text-sm">{note.body}</p>
            <a href={note.link} class="field-note-link text-sm">{note.linkLabel} →</a>
          </div>
        ))}
      </div>

      <!-- Documented session excerpts -->
      <div class="testament-grid stagger">
        {testaments.map(t => (
          <figure class="testament-card card">
            <blockquote class="testament-quote">“{t.quote}”</blockquote>
            <figcaption class="testament-source text-sm text-muted">{t.source}</figcaption>
            <a href={t.link} class="testament-link text-sm">See the session notes →</a>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- How I Review -->
  <section class="methodology section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow text-xs text-uppercase text-muted">My Process</span>
        <h2 class="section-title">How I Review Platforms</h2>
        <p class="section-desc text-muted">
          I don't just browse websites and call it a review. Here's what sets my process apart — and why every number on this page is worth trusting.
        </p>
      </div>

      <div class="method-grid grid grid--3 stagger">
        <div class="method-card card">
          <span class="method-number">01</span>
          <h3 class="method-title">I Sign Up & Pay</h3>
          <p class="method-desc text-muted text-sm">
            I create real accounts and pay with real money — no free press passes, no special treatment. My 12-month Purple Garden audit alone cost $840 out of pocket and covered 24 advisors across video, voice, and chat.
          </p>
        </div>
        <div class="method-card card">
          <span class="method-number">02</span>
          <h3 class="method-title">I Get Readings & Keep Records</h3>
          <p class="method-desc text-muted text-sm">
            Multiple sessions per platform, across different specialties and advisors. I keep transcripts, note exact predictions with their windows, and audit them against reality weeks later — the same way you should.
          </p>
        </div>
        <div class="method-card card">
          <span class="method-number">03</span>
          <h3 class="method-title">I Share Honestly — Both Directions</h3>
          <p class="method-desc text-muted text-sm">
            The good, the bad, and the mediocre, with the same candor. I've documented readers who told paying clients hard truths at their own financial cost, and platforms whose guarantees I deliberately stress-tested.
          </p>
        </div>
      </div>

      <div class="ledger-strip">
        <div class="ledger-item">
          <span class="ledger-value">{totalPlatforms}</span>
          <span class="ledger-label">Platforms tested</span>
        </div>
        <div class="ledger-item">
          <span class="ledger-value">{totalReaders}+</span>
          <span class="ledger-label">Readers reviewed</span>
        </div>
        <div class="ledger-item">
          <span class="ledger-value">100+</span>
          <span class="ledger-label">Hours documented</span>
        </div>
        <div class="ledger-item">
          <span class="ledger-value">12 mo</span>
          <span class="ledger-label">Longest single audit</span>
        </div>
        <div class="ledger-item">
          <span class="ledger-value">$840</span>
          <span class="ledger-label">Purple Garden audit spend</span>
        </div>
        <div class="ledger-item">
          <span class="ledger-value">150</span>
          <span class="ledger-label">Journeys threads audited</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Start Here: curated guides -->
  <section class="latest-guides section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow text-xs text-uppercase text-muted">Learn & Explore</span>
        <h2 class="section-title">Start Here: The Guides I Send Everyone To</h2>
        <p class="section-desc text-muted">
          Whether you're brand new to readings or deep into a specific question, these are the guides that will save you money and protect you from the industry's traps.
        </p>
      </div>

      <div class="guides-grid grid grid--2 stagger">
        {curatedGuides.map(guide => (
          <a href={`/guides/${guide.slug}/`} class="guide-card card card--elevated">
