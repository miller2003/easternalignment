            <div class="pick-actions">
              <a href={p.affiliateUrl} class="btn btn--primary btn--full" rel="nofollow sponsored" target="_blank" data-cta-source="home-verdict">{p.ctaLabel}</a>
              <a href={p.reviewUrl} class="pick-review">Read the full {p.name} review →</a>
            </div>
          </article>
        ))}
      </div>

      <p class="verdict-foot">
