---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import ReaderMatch from '../components/ReaderMatch.astro';
import { PLATFORM_OFFERS, platformLogo, type PlatformKey } from '../lib/offers';
import { siteStats } from '../lib/siteStats';
import { auditStats, lastReviewUpdate } from '../lib/auditStats';
import { TOPIC_META, TOPIC_ORDER, topicUrl } from '../lib/guideHub';
import { webPageNode, isoMax, fmtDate, fmtMonthYear, PLATFORM_ORGS, TOPIC_ENTITIES, IDS } from '../lib/seo';
import pageMeta from '../data/page-meta.json';

const SITE_URL = 'https://easternalignment.com';

/* ──────────────────────────────────────────────────────────────────────
   DATA — every number on this page is read from content at build time.
     platform score / price range / rank / dates → content/reviews/*.md
     welcome-offer wording + CTA labels         → lib/offers.ts
     profile counts                             → lib/siteStats.ts
     advisor cards + median rates               → content/readers/** frontmatter
   Do not hand-write a rating, price, count or date anywhere below.
   (readers.json is NOT used here: its reviewRating is a 4.9 placeholder.)
   ────────────────────────────────────────────────────────────────────── */

const reviewModules = import.meta.glob('../content/reviews/*.md', { eager: true });
const reviews = Object.entries(reviewModules)
  .map(([path, mod]: [string, any]) => ({
    ...mod.frontmatter,
    key: path.split('/').pop()!.replace('.md', '') as PlatformKey,
  }))
  .sort((a, b) => (a.rank || 99) - (b.rank || 99));

const guideModules = import.meta.glob('../content/guides/*.md', { eager: true });
const guideSlugs = new Set(Object.keys(guideModules).map((p) => p.split('/').pop()!.replace('.md', '')));
const totalGuides = guideSlugs.size;

const readerModules = import.meta.glob('../content/readers/**/*.md', { eager: true });
const readerEntries = Object.entries(readerModules)
  .map(([path, mod]: [string, any]) => {
    const fm = mod.frontmatter ?? {};
    const platform = /readers\/([a-z-]+)\//.exec(path)?.[1] as PlatformKey;
    const slug = path.split('/').pop()!.replace('.md', '');
    const rate = Number(/\$(\d+(?:\.\d+)?)/.exec(String(fm.pricing ?? ''))?.[1]);
    return {
      platform,
      slug,
      name: String(fm.platformName ?? slug).split(':').slice(1).join(':').trim() || slug,
      rating: Number(fm.rating) || 0,
      rate: Number.isFinite(rate) && rate > 0 ? rate : null,
      avatarUrl: fm.avatarUrl as string | undefined,
      bestFor: String(fm.bestFor ?? ''),
      proof: (fm.highlights ?? [])[0] as string | undefined,
      affiliateUrl: (fm.affiliateUrl as string) || `/go/${PLATFORM_OFFERS[platform]?.goSlug}/`,
      url: `/reviews/${platform}/${slug}/`,
    };
  })
  .filter((r) => r.platform in PLATFORM_OFFERS);

/* ── helpers ── */
const median = (xs: number[]) => {
  const s = [...xs].sort((a, b) => a - b);
  const m = Math.floor(s.length / 2);
  return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2;
};
const money = (n: number) => `$${n.toFixed(2)}`;
const fmtRange = (p: string) => String(p).replace('/min to ', '–').replace(/\.00/g, '');
const fmtMonth = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const shorten = (s: string, max = 115) => {
  const first = s.split(/\s[—–-]\s/)[0].trim();
  if (first.length <= max) return first.replace(/[.,;:]$/, '');
  return first.slice(0, first.lastIndexOf(' ', max)).replace(/[.,;:]$/, '') + '…';
};

const lastChecked = fmtMonth(
  new Date(Math.max(...reviews.map((r) => new Date(r.updatedDate || r.publishDate).getTime())))
);

const lastCheckedShort = lastChecked.replace(/^(\w{3})\w*/, '$1'); // "Sep 2026"

/* ── freshness + original-data layer (2026-10-02 SEO/GEO pass) ──
   Page date = the later of "someone edited this page" (data/page-meta.json) and
   "an audit behind it changed" (lib/auditStats). Same two sources feed the
   sitemap <lastmod> in astro.config.mjs, so label, schema and sitemap agree. */
const modifiedISO = isoMax(pageMeta.home.updated, auditStats.lastUpdated);
const modifiedLabel = fmtDate(modifiedISO);
const auditMonthYear = fmtMonthYear(auditStats.lastUpdated);
const ov = auditStats.overall;
const auditRows = auditStats.platforms;

/* One quotable sentence on the spread between platforms. Handles ties. */
const byMedian = [...auditRows].sort((a, b) => b.medianListedRate - a.medianListedRate);
const hiMedian = byMedian[0].medianListedRate;
const loMedian = byMedian[byMedian.length - 1].medianListedRate;
const nameList = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}` : xs[0]);
const hiNames = nameList(byMedian.filter((p) => p.medianListedRate === hiMedian).map((p) => p.name));
const loNames = nameList(byMedian.filter((p) => p.medianListedRate === loMedian).map((p) => p.name));
const spreadSentence = hiMedian === loMedian
  ? `All three platforms share the same median listed rate, ${money(hiMedian)}/min.`
  : `${hiNames} ${hiNames.includes(' and ') ? 'have' : 'has'} the highest median listed rate (${money(hiMedian)}/min); ${loNames} ${loNames.includes(' and ') ? 'sit' : 'sits'} lowest at ${money(loMedian)}/min.`;

const homeTopics = TOPIC_ORDER.map((id) => ({ id, label: TOPIC_META[id].label, url: topicUrl(id) }));

const ratesByPlatform = (k: PlatformKey) =>
  readerEntries.filter((r) => r.platform === k && r.rate).map((r) => r.rate as number);
const allRates = readerEntries.filter((r) => r.rate).map((r) => r.rate as number);
const medianAll = median(allRates);

/* ──────────────────────────────────────────────────────────────────────
   EDITORIAL — judgement calls, not data. Policy terms ($50 / $25 / 72h /
   $10 first purchase) mirror each platform review's FAQ; if a review's
   terms change, update the matching line here in the same commit.
   ────────────────────────────────────────────────────────────────────── */
const EDITORIAL: Record<PlatformKey, {
  tag: string;
  situation: string;
  chooseIf: string;
  why: string;
  skipIf: string;
  formats: string;
  guarantee: string;
  weakness: string;
  catches: string[];
  play: string;
}> = {
  kasamba: {
    tag: 'Our #1 overall',
    situation: 'Love, breakups and “will they come back”',
    chooseIf: 'your question is about a relationship and you want the answer in writing.',
    why: 'The free minutes reset with every new advisor, so you can audition two or three relationship specialists before paying — and every chat is saved as a transcript you can check against what actually happens.',
    skipIf: 'you want to see the reader. Kasamba is chat and phone only — no video.',
    formats: 'Chat · Phone',
    guarantee: 'Account credit up to $50 for a disappointing first session with a new advisor. Credit, not a card refund.',
    weakness: 'The best-rated advisors charge $20+/min, and the huge roster is full of generalists you have to filter out.',
    catches: [
      'The 3 free minutes repeat with every new advisor; the 50% discount does not — it applies once, to your first paid session.',
      'Top-rated advisors scale to $20+/min. Check the rate before your free minutes run out, not after.',
    ],
    play: 'Ask the same single question to two or three advisors inside their free minutes. Pay only the one who told you something specific you didn’t give them.',
  },
  'purple-garden': {
    tag: 'Best for video',
    situation: 'Seeing the reader before you pay',
    chooseIf: 'you want to watch a reader before spending anything, or you mostly read on your phone.',
    why: 'Every advisor posts a 60-second video intro, and the public Journeys feed shows clients coming back to say whether a prediction landed — advisors can’t edit or delete those posts.',
    skipIf: 'you read on a desktop. The website feels like an afterthought next to the app.',
    formats: 'Video · Phone · Chat',
    guarantee: 'Account credit for verified technical problems, such as a dropped call. No refunds for advice you didn’t like.',
    weakness: 'The sub-$2/min chat tier has high turnover and the occasional copy-paste reading.',
    catches: [
      'The $30 credit unlocks with your first purchase (typically $10 or more). It is account credit, not cash, and it expires if unused.',
      'Video, phone and chat are priced separately on the same advisor. Check the rate on the channel you’ll actually use.',
    ],
    play: 'Watch three video intros, then scan each advisor’s Journeys for dated predictions with client follow-ups. Spend the credit on the one with the most confirmed hits.',
  },
  keen: {
    tag: 'Best for phone',
    situation: 'Phone readings for the least money down',
    chooseIf: 'you’d rather talk than type, and want to test a top-tier reader for pocket change.',
    why: 'Keen’s client reviews can’t be deleted, so every advisor’s full track record is public — and its phone line connects instantly, with callbacks when a busy reader frees up.',
    skipIf: 'you want a saved transcript to check later. Keen’s chat is an afterthought next to its phone service.',
    formats: 'Phone · Chat',
    guarantee: 'Up to $25 in Keen Dollars (account credit), requested within 72 hours, once every 30 days.',
    weakness: 'An open marketplace: quality varies widely, so you have to read the review ledger before you call.',
    catches: [
      '5 minutes for $1 is a one-time welcome offer on your first session. After that you pay the advisor’s normal per-minute rate.',
      'Coupon sites also push a “3 free minutes” variant. The $1 package is the one Keen itself promotes — claim that one.',
    ],
    play: 'Spend the $1 on the highest-rated advisor you can find, ask one specific question, and decide from the first answer whether they’re worth full price.',
  },
};

const platforms = reviews
  .filter((r) => r.key in EDITORIAL)
  .map((r) => {
    const o = PLATFORM_OFFERS[r.key];
    const rates = ratesByPlatform(r.key);
    return {
      key: r.key,
      name: o.name,
      rank: r.rank,
      rating: r.rating,
      range: fmtRange(r.pricing),
      offer: o.offer,
      ctaLabel: o.ctaLabel,
      affiliateUrl: r.affiliateUrl,
      reviewUrl: `/reviews/${r.key}/`,
      logo: platformLogo(r.key),
      profiles: siteStats.count(r.key),
      medianRate: rates.length ? median(rates) : null,
      ...EDITORIAL[r.key],
    };
  });

/* Comparison rows — each value is either data or a one-line editorial
   fact; the playbook section below carries the longer fine print. */
const compareRows: { label: string; hint?: string; value: (p: (typeof platforms)[number]) => string }[] = [
  { label: 'Our score', hint: '<a href="/methodology/#platform-methodology">How we score</a>', value: (p) => `<strong class="cmp-score">${p.rating}</strong><span class="cmp-unit">/5</span>` },
  { label: 'Pick it for', value: (p) => p.situation },
  { label: 'Welcome offer', value: (p) => `<strong>${p.offer}</strong>` },
  { label: 'Per-minute range', value: (p) => p.range },
  { label: 'Typical rate of advisors we audited', hint: 'Median listed rate', value: (p) => (p.medianRate ? `${money(p.medianRate)}/min` : '—') },
  { label: 'Reading formats', value: (p) => p.formats },
  { label: 'If a reading goes wrong', value: (p) => p.guarantee },
  { label: 'Biggest weakness', value: (p) => p.weakness },
  { label: 'Advisor profiles we’ve audited', value: (p) => `<a href="${p.reviewUrl}">${p.profiles} profiles →</a>` },
];

/* Advisor shortlist — algorithmic, so it can't drift from the audits:
   per platform, (1) our highest-scored advisor and (2) our highest-scored
   advisor at or under VALUE_CAP/min. Ties → cheaper rate wins. */
const VALUE_CAP = 7;
const byScore = (a: (typeof readerEntries)[number], b: (typeof readerEntries)[number]) =>
  b.rating - a.rating || (a.rate ?? 99) - (b.rate ?? 99) || a.slug.localeCompare(b.slug);
type Pick = (typeof readerEntries)[number] & { pick: string; platformName: string };
const picksByPlatform = platforms.map((p) => {
  const pool = readerEntries.filter((r) => r.platform === p.key && r.rate).sort(byScore);
  const top = pool[0];
  const value = pool.find((r) => r !== top && (r.rate as number) <= VALUE_CAP);
  return {
    top: top && { ...top, pick: `Top score on ${p.name}`, platformName: p.name },
    value: value && { ...value, pick: `Best value on ${p.name}`, platformName: p.name },
  };
});
// Row 1 = top scores, row 2 = best values → each grid column is one platform.
const shortlist = [
  ...picksByPlatform.map((x) => x.top),
  ...picksByPlatform.map((x) => x.value),
].filter(Boolean) as Pick[];

/* Situation router → the strongest existing guide for each intent. */
const situations = [
  { label: 'My ex went silent', detail: 'No contact and mixed signals — the real signs they’re coming back, and the false hope to ignore.', slug: 'signs-your-ex-is-coming-back' },
  { label: 'Does he actually like me?', detail: 'New relationships and situationships — which readers give a straight answer.', slug: 'does-he-like-me-psychics' },
  { label: 'Twin flame or soulmate?', detail: 'Readers who will tell you what they see, not what you want to hear.', slug: 'best-twin-flame-psychics-online' },
  { label: 'Someone I’ve lost', detail: 'Evidential mediums — and what genuine evidence of contact sounds like.', slug: 'evidential-mediums-passed-spouse' },
  { label: 'A career or money decision', detail: 'Practical readings for work crossroads, without mystical padding.', slug: 'career-and-money-psychic-readings' },
  { label: 'My very first reading', detail: 'What to ask, what to hold back, and how to spend free minutes well.', slug: 'first-psychic-reading-guide' },
].filter((s) => guideSlugs.has(s.slug));

const redFlags = [
  { title: 'A curse, “dark energy” or a blockage', body: '— followed by a paid removal. End the session.' },
  { title: 'A guaranteed outcome', body: '“He’ll be back within 30 days, 100%.” Readings describe possibilities; guarantees are a sales script.' },
  { title: 'Pressure to stay on the clock', body: 'Urgency, cliffhangers, “I’m seeing more — don’t go yet.” The meter is the motive.' },
  { title: 'A move off the platform', body: 'Paying or talking elsewhere removes every refund and dispute right you have.' },
];

/* Quotable lead for the verdict section. Offers come from lib/offers.ts; the
   statistics from lib/auditStats.ts — nothing hand-written that could drift. */
const P = Object.fromEntries(platforms.map((p) => [p.key, p])) as Record<PlatformKey, (typeof platforms)[number]>;
const shortAnswer =
  `For most first-time clients, ${P.kasamba.name} is the best psychic site: ${P.kasamba.offer}, and every chat is saved as a transcript. ` +
  `${P['purple-garden'].name} is best if you want to see the reader first (${P['purple-garden'].offer}, video-based) and ` +
  `${P.keen.name} is best for phone readings (${P.keen.offer}). Across the ${siteStats.total} advisor profiles we audited, ` +
  `the median listed rate is ${money(ov.medianListedRate)}/min and ${ov.shareAtOrUnder5PerMin}% of advisors list $5/min or less.`;

const homeFAQs = [
  {
    question: 'Which psychic site is best for a first reading?',
    answer: `<a href="/reviews/kasamba/">Kasamba</a>, for most people. The 3 free minutes repeat with every new advisor, so you can try two or three readers before paying anyone, and every chat is saved as a transcript. If you want to see the reader first, start with <a href="/reviews/purple-garden/">Purple Garden</a>; if you only want to talk on the phone, start with <a href="/reviews/keen/">Keen</a>.`,
  },
  {
    question: 'Are Kasamba, Purple Garden and Keen legitimate?',
    answer: `Yes — all three are established platforms with published refund or credit policies, and we have tested each as an ordinary paying customer (<a href="/reviews/kasamba/">Kasamba</a>, <a href="/reviews/purple-garden/">Purple Garden</a>, <a href="/reviews/keen/">Keen</a>). A legitimate platform does not make every advisor on it good, though: quality varies by reader, which is why we audit advisor profiles individually. The red flags that matter are in <a href="/guides/how-to-tell-if-an-online-psychic-is-legitimate/">How to tell if an online psychic is legitimate</a>.`,
  },
  {
    question: 'Do I need a promo code for a psychic reading?',
    answer: `Usually not. Kasamba’s 3 free minutes + 50% off and Keen’s 5 minutes for $1 need no code. Purple Garden’s $30 credit applies automatically in the app; on the website, enter code 30free if it isn’t applied after you register. Every one of these is for new accounts only. The exact terms, and why coupon-site codes tend to fail, are on our <a href="/coupons/">psychic coupons page</a>.`,
  },
  {
    question: 'How do I choose the right psychic reader?',
    answer: `Match the reader to the kind of question, not to the highest rating: reading what another person thinks is a different skill from coaching you through a decision, and tarot, intuitive and mediumship readers each suit different questions. Then audition the reader inside the free or intro minutes with one specific question. Our free <a href="/match/">reader match</a> does the first step for you, and <a href="/guides/how-to-choose-a-psychic-reader/">How to choose a psychic reader</a> explains the reasoning.`,
  },
  {
    question: 'What is the cheapest way to try a psychic reading?',
    answer: `Kasamba costs nothing to try — 3 free minutes with each new advisor — but three minutes is only enough for one question. Keen’s 5 minutes for $1 is the cheapest way to get a slightly longer first session with a top-tier reader. Purple Garden’s $30 credit is the most money, but it requires a first purchase (typically $10 or more) and is account credit, not cash.`,
  },
  {
    question: 'How much does a psychic reading actually cost?',
    answer: `Platform rates run from under $1 to over $30 a minute. Across the ${allRates.length} advisor profiles we’ve audited, the median listed rate is ${money(medianAll)}/min — so a focused 15-minute reading with a well-rated advisor costs roughly $${Math.round(medianAll * 15)}. The full breakdown is in our <a href="/guides/how-much-does-a-psychic-reading-cost/">pricing guide</a>.`,
  },
  {
    question: 'Can I get a refund if a reading is bad?',
    answer: `Rarely in cash. All three platforms compensate with account credit: Kasamba up to $50 for a disappointing first session with a new advisor, Keen up to $25 in Keen Dollars if you ask within 72 hours, and Purple Garden for verified technical problems. None of them refund a reading because you didn’t like the answer — which is why auditioning readers inside the free minutes matters.`,
  },
  {
    question: 'Are online psychic readings legit?',
    answer: `The platforms are real businesses with real refund policies; the readers vary enormously. A good reading leaves you with specific, checkable statements and a clearer head. A bad one is vague, flattering, or tries to sell you a fix for a problem it just invented. We review platforms and advisors so you can tell the two apart before paying — see <a href="/methodology/">how we test</a>.`,
  },
  {
    question: 'How do I spot a fake psychic?',
    answer: `Walk away from anyone who diagnoses a curse or “dark energy” and offers a paid removal, guarantees an outcome, pressures you to stay on the clock, or asks to continue off the platform. We’ve documented every pattern in <a href="/guides/how-to-spot-fake-psychic/">How to Spot a Fake Psychic</a>.`,
  },
  {
    question: 'How does Eastern Alignment make money — and does it affect the rankings?',
    answer: `If you sign up through our links, the platform may pay us a commission at no cost to you. It doesn’t buy a score: our scoring weights are published and fixed before testing, no platform can negotiate them, and advisors who use fear tactics are excluded regardless of rating. Details are in our <a href="/disclosure/">disclosure</a> and <a href="/methodology/">methodology</a>.`,
  },
];

/* Organization / WebSite / Person nodes are emitted site-wide by BaseLayout
   (and carry the @ids used below). The homepage adds: the WebPage itself with
   freshness + speakable, the ranked platform list, and the audit Dataset that
   backs the "What our audits show" section and /data/psychic-platform-audit.json. */
const HOME_URL = `${SITE_URL}/`;
const seoTitle = 'Best Psychic Reading Sites 2026: Kasamba, Keen & Purple Garden';
const metaDescription = `Best online psychic sites compared: Kasamba, Purple Garden and Keen, tested on paid accounts. Prices, free minutes, refund rules and ${siteStats.total} audited advisors.`;

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    webPageNode({
      url: HOME_URL,
      name: 'Eastern Alignment — independent psychic platform reviews',
      headline: seoTitle,
      description: metaDescription,
      type: ['WebPage', 'CollectionPage'],
      dateModified: modifiedISO,
      lastReviewed: lastReviewUpdate,
      about: [TOPIC_ENTITIES.psychic, TOPIC_ENTITIES.tarot, TOPIC_ENTITIES.mediumship, TOPIC_ENTITIES.astrology],
      mentions: PLATFORM_ORGS,
      speakable: ['.hero-title', '#short-answer .answer-capsule__text'],
      mainEntityId: `${HOME_URL}#platforms`,
    }),
    {
      '@type': 'ItemList',
      '@id': `${HOME_URL}#platforms`,
      name: 'Best online psychic reading platforms (2026)',
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      numberOfItems: platforms.length,
      itemListElement: platforms.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: `${p.name}: ${p.tag}`,
        description: `${p.situation}. Welcome offer: ${p.offer}. Listed per-minute range ${p.range}.`,
        url: `${SITE_URL}${p.reviewUrl}`,
      })),
    },
    {
      '@type': 'Dataset',
      '@id': `${HOME_URL}#audit-dataset`,
      name: 'Online psychic platform audit: listed rates and audit scores for Kasamba, Purple Garden and Keen',
      description:
        `Platform-level figures from Eastern Alignment’s audit of ${siteStats.total} public advisor profiles on Kasamba, Purple Garden and Keen: ` +
        'median, lowest and highest listed per-minute rate, share of advisors at or under $5/min, average audit score, and each platform’s new-client welcome offer.',
      url: `${HOME_URL}#audit-data`,
      keywords: ['psychic reading prices', 'psychic reading cost per minute', 'Kasamba', 'Purple Garden', 'Keen', 'online psychic platforms'],
      creator: { '@id': IDS.organization },
      publisher: { '@id': IDS.organization },
      isAccessibleForFree: true,
      dateModified: auditStats.lastUpdated,
      temporalCoverage: auditStats.lastUpdated.slice(0, 4),
      isBasedOn: `${SITE_URL}/methodology/`,
      measurementTechnique:
        'Manual audit of each advisor’s public profile. Listed rate = the lowest per-minute rate shown on the profile; audit score = our editorial 1–5 score under the published scoring weights.',
      variableMeasured: [
        { '@type': 'PropertyValue', name: 'Listed per-minute rate', unitText: 'USD per minute' },
        { '@type': 'PropertyValue', name: 'Audit score', minValue: 1, maxValue: 5 },
        { '@type': 'PropertyValue', name: 'Share of advisors at or under $5 per minute', unitText: 'percent' },
      ],
      distribution: [
        {
          '@type': 'DataDownload',
          encodingFormat: 'application/json',
          contentUrl: `${SITE_URL}/data/psychic-platform-audit.json`,
        },
      ],
      citation: `Eastern Alignment (${auditStats.lastUpdated.slice(0, 4)}). Online psychic platform audit. ${SITE_URL}/`,
    },
  ],
};
---

<BaseLayout
  title="Eastern Alignment: Psychic Reviews Tested Before You Pay (2026)"
  description={metaDescription}
  seoTitle={seoTitle}
  metaDescription={metaDescription}
  modifiedTime={modifiedISO}
  jsonLd={pageSchema}
  hreflangEs={`${SITE_URL}/es/`}
  topOfferPlatform="kasamba"
>
  <link slot="head" rel="alternate" type="application/json" href="/data/psychic-platform-audit.json" title="Online psychic platform audit data (JSON)" />
  <!-- ═══ 1. HERO — the promise, the proof, two ways forward ═══ -->
  <section class="home-hero">
    <div class="container hero-inner">
      <p class="kicker">Independent psychic reviews · tested on paid accounts</p>
      <h1 class="hero-title">
        Know which psychic is worth paying <span class="text-gradient">before you pay.</span>
      </h1>
      <p class="hero-sub">
        We test Kasamba, Purple Garden and Keen as ordinary paying customers, audit advisors’ public
        track records, and publish the fine print the platforms bury — so your first reading goes to
        the right person.
      </p>
      <div class="hero-actions">
        <a href="/match/" class="btn btn--primary btn--lg" data-match-open>Find my reader — 2-minute match</a>
        <a href="#verdict" class="btn btn--secondary btn--lg">See the verdict</a>
      </div>
      <ul class="hero-proof" aria-label="About our testing">
        <li><strong>{siteStats.total}</strong><span>advisor profiles audited</span></li>
        <li><strong>{platforms.length}</strong><span>platforms tested with our own money</span></li>
        <li><strong>{totalGuides}</strong><span>buyer guides</span></li>
        <li><strong>{lastCheckedShort}</strong><span>offers last re-checked</span></li>
      </ul>
    </div>
  </section>

  <!-- ═══ 2. VERDICT — the answer, with the reason to skip each pick ═══ -->
  <section class="section verdict" id="verdict">
    <div class="container">
      <header class="sec-head">
        <p class="kicker">The 30-second answer</p>
        <h2 class="sec-title">Which psychic site should you use?</h2>
        <p class="sec-desc">
          There is no single best site — there is a best one for how you want your reading.
          Every pick below comes with the reason <em>not</em> to choose it.
        </p>
      </header>

      <div class="answer-capsule" id="short-answer">
        <p class="answer-capsule__label">
          Short answer · updated <time datetime={modifiedISO}>{modifiedLabel}</time>
        </p>
        <p class="answer-capsule__text">{shortAnswer}</p>
      </div>

      <div class="picks">
        {platforms.map((p, i) => (
