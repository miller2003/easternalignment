---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import GuideCard from '../../components/guides/GuideCard.astro';
import GuidesCta from '../../components/guides/GuidesCta.astro';
import FAQ from '../../components/FAQ.astro';
import { loadTopics, guideKind, formatDate } from '../../lib/guideHub';
import { PLATFORM_OFFERS } from '../../lib/offers';
import { auditStats } from '../../lib/auditStats';
import { webPageNode, isoMax, fmtDate, PLATFORM_ORGS, TOPIC_ENTITIES } from '../../lib/seo';
import pageMeta from '../../data/page-meta.json';

/* Guides hub — topic-card entrances (2026-10-02 redesign).
 * Same URL. The old one-page dump of all guides is split into topic pages at
 * /guides/<topic-id>/ (see src/lib/guideHub.ts); this page is the front door:
 * a bento grid of topic cards, a "start here" path, and fresh updates.
 * Legacy deep links like /guides/#love (guide breadcrumbs, MCP answers) are
 * forwarded to the topic page by the inline script below. */

const topics = loadTopics();
const all = topics.flatMap((t) => t.items.map((g) => ({ ...g, topic: t })));
const total = all.length;
const roundups = all.filter((g) => guideKind(g) === 'Top Picks').length;
const latest = all.map((g) => g.date ?? '').sort().pop();

// Bento layout: card size + hub order (topic pages keep TOPIC_ORDER).
const HUB_LAYOUT: Record<string, { size: 'hero' | 'wide' | 'std'; previews: number }> = {
  love: { size: 'hero', previews: 7 },
  'breakups-ex-recovery': { size: 'std', previews: 2 },
  mediumship: { size: 'std', previews: 2 },
  tarot: { size: 'std', previews: 2 },
  'career-money': { size: 'std', previews: 2 },
  'getting-started': { size: 'wide', previews: 4 },
  spirituality: { size: 'std', previews: 2 },
  'more-guides': { size: 'std', previews: 2 },
};
const HUB_ORDER = Object.keys(HUB_LAYOUT);
const cards = [...topics].sort((a, b) => HUB_ORDER.indexOf(a.id) - HUB_ORDER.indexOf(b.id));

// "Start here" — the beginner path, in reading order.
const START_SLUGS = [
  'first-psychic-reading-guide',
  'how-to-choose-a-psychic-reader',
  'how-much-does-a-psychic-reading-cost',
  'how-to-spot-fake-psychic',
];
const startHere = START_SLUGS.map((s) => all.find((g) => g.slug === s)).filter(Boolean) as typeof all;

// Hero panel: each headline topic's lead (commercial-first) guide.
const picks = ['love', 'breakups-ex-recovery', 'mediumship']
  .map((id) => topics.find((t) => t.id === id))
  .filter(Boolean)
  .map((t) => ({ guide: t!.items[0], topic: t! }));

// Fresh updates, one per topic first so a single busy topic can't take
// every slot (skip the start-here picks).
const byDate = all
  .filter((g) => !START_SLUGS.includes(g.slug))
  .sort((a, b) => String(b.date ?? '').localeCompare(String(a.date ?? '')));
const seenTopics = new Set<string>();
const recent = byDate.filter((g) => !seenTopics.has(g.topic.id) && seenTopics.add(g.topic.id));
for (const g of byDate) if (recent.length < 6 && !recent.includes(g)) recent.push(g);
recent.splice(6);
recent.sort((a, b) => String(b.date ?? '').localeCompare(String(a.date ?? '')));

// Compact client-side search index.
const searchIndex = all.map((g) => ({
  t: g.title,
  u: `/guides/${g.slug}/`,
  c: g.topic.meta.label,
  a: g.topic.meta.accent,
  k: guideKind(g),
}));

const topicIds = topics.map((t) => t.id);

const SITE = 'https://easternalignment.com';
const HUB_URL = `${SITE}/guides/`;

/* Page date = the later of "this page was edited" (data/page-meta.json) and
 * "the newest guide changed". Same two sources feed the sitemap <lastmod>. */
const modifiedISO = isoMax(pageMeta.guidesHub.updated, latest);

const seoTitle = `Psychic Reading Guides 2026: ${total} Guides by Topic & Question`;
const metaDescription = `${total} psychic reading guides: love, breakups, mediums, tarot, career, costs and red flags. Tested on paid accounts, dated, and re-checked when prices change.`;

/* Quick answers — each links to the guide that answers it in depth. Numbers and
 * offers are computed (lib/auditStats, lib/offers), never hand-written. */
const median = auditStats.overall.medianListedRate;
const money = (n: number) => `$${n.toFixed(2)}`;
const faqs = [
  {
    question: 'How much does a psychic reading cost?',
    answer: `Across the ${auditStats.overall.profiles} advisor profiles we have audited on Kasamba, Purple Garden and Keen, the median listed rate is ${money(median)} per minute, so a focused 15-minute reading with a typical advisor costs about $${Math.round(median * 15)}. Individual advisors list from ${money(auditStats.overall.lowestListedRate)} to ${money(auditStats.overall.highestListedRate)} per minute depending on experience and format. See <a href="/guides/how-much-does-a-psychic-reading-cost/">How much does a psychic reading cost?</a> and <a href="/guides/psychic-reading-prices/">psychic reading prices</a> for the hidden costs.`,
  },
  {
    question: 'Are online psychic readings real?',
    answer: `Online psychic platforms are real businesses with real refund or credit policies, but no reading can guarantee an outcome and quality varies enormously by reader. Treat a reading as an outside perspective on a situation, not a prediction you can bank on. Our guides on <a href="/guides/are-psychics-real/">whether psychics are real</a> and <a href="/guides/how-to-tell-if-an-online-psychic-is-legitimate/">how to tell if an online psychic is legitimate</a> explain what to look for.`,
  },
  {
    question: 'How can I tell if a psychic is fake?',
    answer: `Walk away from anyone who diagnoses a curse or “dark energy” and offers a paid removal, guarantees an outcome, pressures you to keep the meter running, or asks to continue off the platform. The full list of warning signs is in <a href="/guides/how-to-spot-fake-psychic/">How to spot a fake psychic</a>.`,
  },
  {
    question: 'What should I ask a psychic?',
    answer: `Lead with one specific, answerable question rather than “what do you see in my future?”, and give as little backstory as you can so you can see what the reader picks up unaided. Good questions and the ones to avoid are in <a href="/guides/questions-to-ask-a-psychic/">Questions to ask a psychic</a>; if it is your first reading, start with <a href="/guides/first-psychic-reading-guide/">the first reading guide</a>.`,
  },
  {
    question: 'Can a psychic tell me if my ex is coming back?',
    answer: `A reader can describe the dynamics and the possibilities, not guarantee an outcome, so be wary of anyone who offers exact dates or certainty. Our guides cover <a href="/guides/signs-your-ex-is-coming-back/">the signs readers actually look for</a> and <a href="/guides/no-contact-psychic-readings-guide/">how to use a reading during no contact</a>.`,
  },
  {
    question: 'Which psychic site has the best free minutes or credit for new clients?',
    answer: `New-client offers: Kasamba gives ${PLATFORM_OFFERS.kasamba.offer} (the free minutes repeat with every new advisor), Purple Garden gives a ${PLATFORM_OFFERS['purple-garden'].offer}, and Keen gives ${PLATFORM_OFFERS.keen.offer}. Terms, the one promo code in play and the fine print are on our <a href="/coupons/">psychic coupons page</a>, with step-by-step guides for <a href="/guides/kasamba-3-free-minutes-guide/">Kasamba</a> and <a href="/guides/purple-garden-30-credit-guide/">Purple Garden</a>.`,
  },
  {
    question: 'What is the difference between a psychic, a medium and a tarot reader?',
    answer: `A psychic offers intuitive insight into a person or situation, a medium focuses on communication with people who have died, and a tarot reader uses a card spread as a structured way into your question. They suit different questions; <a href="/guides/psychic-vs-medium-vs-tarot-reader/">our comparison</a> explains what each can and cannot do, and the free <a href="/match/">reader match</a> picks one for your situation.`,
  },
  {
    question: 'How are these guides written and kept up to date?',
    answer: `Sarah writes them from paid-account testing and audits of public advisor profiles, scored under <a href="/methodology/">published weights</a>, and every guide carries its date. When prices, offers or advisor rates change, the affected guides are re-checked and re-dated. If you sign up through our links we may earn a commission, which does not change a score; see our <a href="/disclosure/">disclosure</a>.`,
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    webPageNode({
      url: HUB_URL,
      name: 'Psychic Reading Guides',
      headline: seoTitle,
      description: metaDescription,
      type: ['CollectionPage', 'WebPage'],
      datePublished: pageMeta.guidesHub.published,
      dateModified: modifiedISO,
      about: [TOPIC_ENTITIES.psychic, TOPIC_ENTITIES.tarot, TOPIC_ENTITIES.mediumship, TOPIC_ENTITIES.astrology],
      mentions: PLATFORM_ORGS,
      speakable: ['.gh-hero__title', '.gh-hero__answer'],
      mainEntityId: `${HUB_URL}#topics`,
    }),
    {
      '@type': 'ItemList',
      '@id': `${HUB_URL}#topics`,
      name: 'Psychic reading guide topics',
      numberOfItems: cards.length,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: cards.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: t.heading,
        description: `${t.intro} (${t.items.length} guides)`,
        url: `${SITE}${t.url}`,
      })),
    },
  ],
};
---

<BaseLayout
  title="Psychic Reading Guides — Learn Before You Book"
  description={metaDescription}
  seoTitle={seoTitle}
  metaDescription={metaDescription}
  modifiedTime={modifiedISO}
  publishedTime={pageMeta.guidesHub.published}
  topOfferPlatform="kasamba"
  jsonLd={jsonLd}
>
  <script is:inline define:vars={{ topicIds }}>
    (function () {
      var h = decodeURIComponent(location.hash.slice(1));
      if (topicIds.indexOf(h) !== -1) location.replace('/guides/' + h + '/' + location.search);
    })();
  </script>

  <div class="gh">
    <!-- HERO -->
    <section class="gh-hero">
      <div class="gh-wrap">
        <Breadcrumb items={[{ label: 'Guides' }]} />
        <div class="gh-hero__grid">
          <div class="gh-hero__main">
            <p class="gh-hero__eyebrow">The guide library</p>
            <h1 class="gh-hero__title">Guides &amp; Resources</h1>
            <p class="gh-hero__intro">
              Honest, tested guides to psychic readings — organized by what you're actually going through. Pick a topic to begin.
            </p>
            <p class="gh-hero__answer">
              Eastern Alignment publishes {total} psychic reading guides in {topics.length} topics, from love, breakups
              and mediumship to tarot, career and money. {roundups} are tested reader roundups; the rest explain costs,
              free-minute offers, red flags and how readings work. Every guide is dated and re-checked when
              prices or offers change.
            </p>

            <div class="gh-search" role="search">
              <svg class="gh-search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
              <label for="gh-q" class="sr-only">Search all guides</label>
              <input id="gh-q" type="search" placeholder={`Search ${total} guides…`} autocomplete="off" enterkeyhint="search" />
              <button type="button" class="gh-search__clear" aria-label="Clear search" hidden>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
              </button>
            </div>

            <ul class="gh-hero__stats">
              <li><strong>{total}</strong> guides</li>
              <li><strong>{topics.length}</strong> topics</li>
              <li><strong>{roundups}</strong> tested reader roundups</li>
              <li>Updated <strong><time datetime={modifiedISO}>{fmtDate(modifiedISO)}</time></strong></li>
            </ul>
          </div>

          <aside class="gh-picks" aria-label="Editor's picks">
            <p class="gh-picks__label">Editor's picks</p>
            <ul>
              {picks.map(({ guide, topic }) => (
                <li>
                  <a href={`/guides/${guide.slug}/`} style={`--accent:${topic.meta.accent};--tint:${topic.meta.tint}`}>
                    <span class="gh-picks__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={topic.meta.icon} />
                    </span>
                    <span class="gh-picks__body">
                      <span class="gh-picks__topic">{topic.meta.label}</span>
                      <span class="gh-picks__title">{guide.title}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <!-- SEARCH RESULTS -->
    <section class="gh-results" hidden aria-live="polite">
      <div class="gh-wrap">
        <p class="gh-results__count"></p>
        <ul class="gh-results__list"></ul>
      </div>
    </section>

    <div class="gh-browse">
      <!-- TOPICS -->
      <section class="gh-section gh-section--topics" aria-labelledby="gh-topics-title">
        <div class="gh-wrap">
          <div class="gh-head">
            <h2 id="gh-topics-title" class="gh-head__title">Browse by topic</h2>
            <p class="gh-head__sub">Every guide lives in exactly one topic.</p>
          </div>

          <div class="gh-bento">
            {cards.map((t) => {
              const layout = HUB_LAYOUT[t.id] ?? { size: 'std', previews: 2 };
              const previews = t.items.slice(0, layout.previews);
              return (
                <article
                  class:list={['tc', `tc--${layout.size}`]}
                  style={`--accent:${t.meta.accent};--tint:${t.meta.tint}`}
                >
                  <svg class="tc__watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.meta.icon} />
                  <div class="tc__top">
                    <span class="tc__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={t.meta.icon} />
                    </span>
                    <span class="tc__count"><strong>{t.items.length}</strong> guides</span>
                  </div>
                  <h3 class="tc__title">
                    <a href={t.url} class="tc__link">{t.meta.label}</a>
                  </h3>
                  <p class="tc__tagline">{layout.size === 'hero' ? t.intro : t.meta.tagline}</p>
                  {previews.length > 0 && (
                    <ul class="tc__previews">
                      {previews.map((g) => (
                        <li><a href={`/guides/${g.slug}/`}>{g.title}</a></li>
                      ))}
                    </ul>
                  )}
                  <span class="tc__cta" aria-hidden="true">
                    {layout.size === 'std' ? 'Explore' : `Explore all ${t.items.length}`}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </span>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <!-- START HERE -->
      {startHere.length > 0 && (
        <section class="gh-section gh-section--start" aria-labelledby="gh-start-title">
          <div class="gh-wrap">
            <div class="gh-head">
              <h2 id="gh-start-title" class="gh-head__title">New to readings? Start here</h2>
              <p class="gh-head__sub">Four short reads that will save you money on your first session.</p>
            </div>
            <ol class="gh-path">
              {startHere.map((g, i) => (
                <li>
                  <a href={`/guides/${g.slug}/`} class="gh-step">
                    <span class="gh-step__n">{String(i + 1).padStart(2, '0')}</span>
                    <span class="gh-step__body">
                      <span class="gh-step__title">{g.title}</span>
                      <span class="gh-step__meta">{g.minutes} min read</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )}

      <!-- RECENTLY UPDATED -->
      <section class="gh-section" aria-labelledby="gh-recent-title">
        <div class="gh-wrap">
          <div class="gh-head">
            <h2 id="gh-recent-title" class="gh-head__title">Recently updated</h2>
            <p class="gh-head__sub">Re-verified pricing, readers and offers.</p>
          </div>
          <ul class="gh-grid">
            {recent.map((g) => (
              <li><GuideCard guide={g} accent={g.topic.meta.accent} tint={g.topic.meta.tint} /></li>
            ))}
          </ul>
        </div>
      </section>
    </div>

    <!-- QUICK ANSWERS (FAQPage schema comes from the FAQ component) -->
    <section class="gh-section gh-section--faq" aria-label="Quick answers about psychic readings">
      <div class="gh-wrap gh-wrap--narrow">
        <FAQ items={faqs} title="Quick answers about psychic readings" />
      </div>
    </section>

    <!-- HOW THE GUIDES ARE MADE — trust links, machine-readable via Organization schema -->
    <section class="gh-section gh-trust" aria-label="How our guides are made">
      <div class="gh-wrap">
        <ul class="gh-trust__list">
          <li><strong>Tested, not summarised.</strong> Written from paid-account testing and audits of public advisor profiles. <a href="/methodology/">How we test</a></li>
          <li><strong>Dated and re-checked.</strong> Prices, offers and rates are re-verified and the date on the page changes when they do. <a href="/coupons/">See current offers</a></li>
          <li><strong>Funding disclosed.</strong> We may earn a commission from links; it never changes a score. <a href="/disclosure/">Advertiser disclosure</a></li>
        </ul>
      </div>
    </section>

    <GuidesCta />
  </div>

  <script type="application/json" id="gh-index" set:html={JSON.stringify(searchIndex)} />
</BaseLayout>

<script>
  type Entry = { t: string; u: string; c: string; a: string; k: string };

  function initGuideSearch() {
    const input = document.querySelector<HTMLInputElement>('#gh-q');
    if (!input || input.dataset.ready) return;
    input.dataset.ready = '1';
    const data: Entry[] = JSON.parse(document.getElementById('gh-index')?.textContent || '[]');
    const lower = data.map((d) => `${d.t} ${d.c} ${d.k}`.toLowerCase());
    const browse = document.querySelector<HTMLElement>('.gh-browse')!;
    const results = document.querySelector<HTMLElement>('.gh-results')!;
    const count = results.querySelector<HTMLElement>('.gh-results__count')!;
    const list = results.querySelector<HTMLElement>('.gh-results__list')!;
    const clear = document.querySelector<HTMLButtonElement>('.gh-search__clear')!;

    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    function run() {
      const q = input!.value.trim().toLowerCase();
      clear.hidden = q.length === 0;
      if (q.length < 2) {
        results.hidden = true;
        browse.hidden = false;
        return;
      }
      const words = q.split(/\s+/);
      const hits = data.filter((_, i) => words.every((w) => lower[i].includes(w)));
      browse.hidden = true;
      results.hidden = false;
      count.textContent = hits.length
        ? `${hits.length} ${hits.length === 1 ? 'guide' : 'guides'} matching “${input!.value.trim()}”`
        : `No guides match “${input!.value.trim()}” — try a broader word like “love” or “tarot”.`;
      list.innerHTML = hits
        .map(
          (d) =>
            `<li><a href="${d.u}" style="--accent:${d.a}"><span class="gh-hit__topic">${esc(d.c)}</span><span class="gh-hit__title">${esc(d.t)}</span></a></li>`,
        )
        .join('');
    }

    input.addEventListener('input', run);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        input.value = '';
        run();
      }
    });
    clear.addEventListener('click', () => {
      input.value = '';
      run();
      input.focus();
    });
    if (input.value) run();
  }
  initGuideSearch();
  document.addEventListener('astro:page-load', initGuideSearch);
</script>

<style>
  .gh-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  /* ── Hero ── */
  .gh-hero {
    padding: var(--space-6) 0 var(--space-12);
    background:
      radial-gradient(ellipse 55% 80% at 95% 0%, rgba(196, 149, 106, 0.18), transparent 70%),
      radial-gradient(ellipse 40% 60% at 0% 100%, rgba(122, 139, 111, 0.12), transparent 70%),
      linear-gradient(180deg, var(--color-bg-alt), var(--color-bg));
    border-bottom: 1px solid var(--color-border-light);
  }
  .gh-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    align-items: end;
    gap: var(--space-12);
  }
  .gh-hero__eyebrow {
    margin: var(--space-8) 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-hover);
  }
  .gh-hero__title {
    margin: 0;
    font-size: clamp(2.4rem, 1.6rem + 3.4vw, 4.2rem);
    line-height: 1.05;
  }
  .gh-hero__intro {
    max-width: 620px;
    margin: var(--space-5) 0 0;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .gh-search {
    position: relative;
    max-width: 560px;
    margin-top: var(--space-8);
  }
  .gh-search__icon {
    position: absolute;
    left: 1.1rem;
    top: 50%;
    width: 20px;
    height: 20px;
    transform: translateY(-50%);
    color: var(--color-text-light);
    pointer-events: none;
  }
  .gh-search input {
    width: 100%;
    height: 56px;
    padding: 0 3.25rem;
    font: inherit;
    font-size: 1rem; /* ≥16px: no iOS zoom on focus */
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md);
    -webkit-appearance: none;
    appearance: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .gh-search input::-webkit-search-cancel-button { display: none; }
  .gh-search input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 4px rgba(196, 149, 106, 0.18), var(--shadow-md);
  }
  .gh-search__clear {
    position: absolute;
    right: 0.6rem;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .gh-search__clear[hidden] { display: none; }
  .gh-search__clear svg { width: 16px; height: 16px; }

  .gh-hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }
  .gh-hero__stats li {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .gh-hero__stats strong { color: var(--color-text); font-weight: var(--weight-semibold); }

  /* Editor's picks panel */
  .gh-picks {
    padding: var(--space-5);
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 24px;
    box-shadow: var(--shadow-xl);
    backdrop-filter: blur(10px);
  }
  .gh-picks__label {
