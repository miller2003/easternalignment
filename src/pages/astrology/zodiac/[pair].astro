---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { SIGNS, signByName, allPairs, pairSlug, compatibilityScore, elementNarrative, modalityNarrative, ELEMENTS } from '../../../data/zodiac';

export function getStaticPaths() {
  return allPairs().map(([a, b]) => ({
    params: { pair: pairSlug(a, b) },
    props: { a, b },
  }));
}

const { a, b } = Astro.props;
const score = compatibilityScore(a, b);
const elementStory = elementNarrative(a, b);
const modalityStory = modalityNarrative(a, b);
const isOpposite = a.opposite === b.name;

const pageTitle = `${a.name} and ${b.name} Compatibility`;
const pageDesc = `${a.name} and ${b.name} compatibility in love and relationships — our ${score.score}/10 match rating, how ${a.element} ${a.name} and ${b.element} ${b.name} connect, communicate, and whether the relationship lasts.`;

const pairSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDesc,
  "about": [
    { "@type": "Thing", "name": `${a.name} zodiac sign` },
    { "@type": "Thing", "name": `${b.name} zodiac sign` },
    { "@type": "Thing", "name": "Zodiac compatibility" },
  ],
};
---

<BaseLayout title={pageTitle} description={pageDesc} jsonLd={pairSchema} noindex={true}>
  <div class="page-with-sidebars">
    <main class="main-col">
      <div class="pair-page">
        <Breadcrumb items={[{ label: 'Astrology', href: '/astrology/' }, { label: `${a.name} + ${b.name}` }]} />

        <header class="pair-hero">
          <div class="pair-symbols">
            <span class="pair-sym">{a.symbol}</span>
            <span class="pair-plus">+</span>
            <span class="pair-sym">{b.symbol}</span>
          </div>
          <span class="badge badge--sage">Zodiac Compatibility</span>
          <h1>{a.name} and {b.name} Compatibility</h1>
          <p class="pair-desc text-muted">
            {a.name} ({a.element} · {a.ruler}) and {b.name} ({b.element} · {b.ruler}) — a {isOpposite ? 'polarity-axis pairing with maximum magnetism' : `${a.element.toLowerCase()} + ${b.element.toLowerCase()} combination`}.
          </p>
        </header>

        {/* Score card */}
        <div class="score-card card">
          <div class="score-main">
            <span class="score-value">{score.score}<span class="score-max">/10</span></span>
            <div class="score-meta">
              <span class="score-label badge badge--primary">{score.label}</span>
              <span class="score-sub text-sm text-muted">Overall Compatibility</span>
            </div>
          </div>
          <div class="score-bars">
            <div class="score-bar-row">
              <span class="bar-label">Romance</span>
              <div class="bar-track"><div class="bar-fill" style={`width: ${score.romance * 10}%`}></div></div>
              <span class="bar-num">{score.romance}</span>
            </div>
            <div class="score-bar-row">
              <span class="bar-label">Communication</span>
              <div class="bar-track"><div class="bar-fill" style={`width: ${score.communication * 10}%`}></div></div>
              <span class="bar-num">{score.communication}</span>
            </div>
            <div class="score-bar-row">
              <span class="bar-label">Long-Term</span>
              <div class="bar-track"><div class="bar-fill" style={`width: ${score.longTerm * 10}%`}></div></div>
              <span class="bar-num">{score.longTerm}</span>
            </div>
          </div>
        </div>

        <div class="prose">
          <h2>{a.name} and {b.name} at a Glance</h2>
          <table>
            <tbody>
              <tr><td><strong>Element Match</strong></td><td>{a.element} + {b.element} — {a.element === b.element ? 'same element, natural resonance' : ELEMENTS[a.element].harmonious.includes(b.element) ? 'harmonious element flow' : ELEMENTS[a.element].challenging.includes(b.element) ? 'challenging element friction that can become growth' : 'complementary'}</td></tr>
              <tr><td><strong>Modality</strong></td><td>{a.modality} + {b.modality} {a.modality === b.modality ? '(shared rhythm)' : '(complementary tempos)'}</td></tr>
              <tr><td><strong>Ruling Planets</strong></td><td>{a.ruler} + {b.ruler}</td></tr>
              <tr><td><strong>Overall Score</strong></td><td>{score.score}/10 — {score.label}</td></tr>
            </tbody>
          </table>

          <h2>The Element Connection: {elementStory.split(':')[0].split(' meet ')[0]}</h2>
          <p>{elementStory}</p>

          <h2>The Modality Dynamic</h2>
          <p>{modalityStory}</p>

          {isOpposite && (
            <>
              <h2>The Opposites Dynamic: Maximum Magnetism, Maximum Heat</h2>
              <p>
                {a.name} and {b.name} are opposite signs — {a.symbol} sits directly across {b.symbol} on the zodiac wheel. In astrology, opposites are the most magnetic axis in the chart: the two signs share the same core axis (the Aries-Libra axis runs relationship-versus-self, for example), which means they trigger each other's deepest themes. This pairing has explosive chemistry, real complementarity, and equally real conflict potential. When it works, it works because each partner completes something the other lacks. When it fails, it fails because each partner insists the other should become more like them.
              </p>
            </>
          )}

          <h2>Love, Romance & Chemistry</h2>
          <p>
            As a romantic match, {a.name} and {b.name} {score.romance >= 8 ? 'have serious chemistry. ' : score.romance >= 6.5 ? 'have genuine warmth and attraction. ' : 'have a connection that takes real effort to sustain. '}
            {a.name} brings {a.element === 'Fire' ? 'passion and boldness' : a.element === 'Earth' ? 'steadiness and devotion' : a.element === 'Air' ? 'wit and mental spark' : 'emotional depth and intuition'} to the relationship, while {b.name} contributes {b.element === 'Fire' ? 'passion and boldness' : b.element === 'Earth' ? 'steadiness and devotion' : b.element === 'Air' ? 'wit and mental spark' : 'emotional depth and intuition'}.
            {score.romance >= 8 ? 'The spark is real and both partners feel it immediately.' : score.romance >= 6.5 ? 'The attraction builds steadily as each partner comes to appreciate what the other brings.' : 'Neither partner can coast on chemistry alone — the bond has to be built deliberately.'}
          </p>

          <h2>Communication Between {a.name} and {b.name}</h2>
          <p>
            {a.element === 'Air' || b.element === 'Air' ? 'With air energy present, communication is one of this pairing\'s strengths — both partners are willing to talk things through, and the conversation rarely runs dry.' : 'Neither sign is naturally verbal-first, which means communication takes conscious effort — but when it happens, it tends to be honest and deep.'}
            {a.modality === b.modality ? ' Their shared modality means they resolve conflict at the same pace, which prevents most blowups from escalating.' : ' Their different modalities mean one partner wants to resolve conflict immediately while the other needs space — learning that rhythm is the key to lasting harmony.'}
          </p>

          <h2>Long-Term Potential</h2>
          <p>
            For a lasting relationship, {a.name} and {b.name} score {score.longTerm}/10.
            {score.longTerm >= 7.5 ? ' This is a pairing with real staying power — the differences complement rather than clash, and both partners are willing to do the work.' : score.longTerm >= 6 ? ' The relationship can last, but it will require both partners to consciously accommodate the other\'s nature rather than expecting change.' : ' This pairing faces structural headwinds long-term. The attraction can be real, but sustaining it takes more deliberate effort than most relationships.'}
            {isOpposite ? ' As an opposite-sign pair, the long-term question is whether the magnetism becomes a stable bond or a repeating cycle — opposites either complete each other or exhaust each other, and the deciding factor is usually how well each partner handles conflict.' : ''}
          </p>

          <div class="cta-box">
            <h3>Is This Match Right for Your Specific Chart?</h3>
            <p>
              Zodiac compatibility by sun sign is the starting point — but your full birth chart (moon, rising, Venus, Mars) tells a much more specific story. A live psychic reading can compare your actual charts and give you a read on whether this connection has real potential, what the hidden friction points are, and what timing looks like. I've tested astrology-focused readers on <a href="/reviews/keen/">Keen</a> and <a href="/reviews/kasamba/">Kasamba</a>, and both offer trial minutes so you can test before committing.
            </p>
            <div class="cta-flex" style="display: flex; gap: 1rem; margin-top: 1.5rem; flex-wrap: wrap;">
              <a href="/go/keen/" class="btn btn--primary">Get 5 Minutes for $1 on Keen →</a>
              <a href="/go/kasamba/" class="btn btn--secondary">Try Kasamba: 3 Free Minutes →</a>
            </div>
          </div>

          <h2>Explore More Zodiac Compatibility</h2>
          <div class="related-pairs">
            <a href={`/astrology/zodiac/${a.name.toLowerCase()}/`} class="related-pair">{a.symbol} {a.name} Sign Overview</a>
            <a href={`/astrology/zodiac/${b.name.toLowerCase()}/`} class="related-pair">{b.symbol} {b.name} Sign Overview</a>
            <a href="/astrology/" class="related-pair">All Zodiac Compatibility →</a>
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .page-with-sidebars {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-6) var(--space-12);
  }

  .main-col {
    flex: 1;
    min-width: 0;
    max-width: var(--max-width-content);
  }

  .pair-hero {
    text-align: center;
    margin: var(--space-6) 0;
  }

  .pair-symbols {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .pair-sym {
    font-size: 4rem;
    line-height: 1;
    color: var(--color-accent);
  }

  .pair-plus {
    font-size: 1.8rem;
    color: var(--color-text-light);
  }

  .pair-hero h1 {
    margin: var(--space-3) 0;
  }

  .pair-desc {
    max-width: 520px;
    margin: 0 auto;
    line-height: var(--leading-relaxed);
  }

  /* Score card */
  .score-card {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
  }

  .score-main {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-shrink: 0;
  }

  .score-value {
    font-family: var(--font-heading);
    font-size: 4rem;
    line-height: 1;
    color: var(--color-primary);
  }

  .score-max {
    font-size: 1.5rem;
    color: var(--color-text-light);
  }

  .score-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-items: flex-start;
  }

  .score-bars {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .score-bar-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .bar-label {
    width: 110px;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .bar-track {
    flex: 1;
    height: 8px;
    background: var(--color-bg-alt);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--color-accent), var(--color-primary));
    border-radius: var(--radius-full);
  }

  .bar-num {
    width: 32px;
    text-align: right;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
  }

  .related-pairs {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .related-pair {
    display: block;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    transition: border-color var(--transition-fast);
  }

  .related-pair:hover {
    border-color: var(--color-primary-light);
  }

  @media (max-width: 640px) {
    .score-card {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-6);
    }
    .score-main {
      justify-content: center;
    }
  }
</style>
