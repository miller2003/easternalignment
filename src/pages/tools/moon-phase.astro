---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { buildWebApplication } from '../../lib/toolSchema';

const toolSchema = {
  "@context": "https://schema.org",
  "@graph": [
    buildWebApplication({
      name: "Moon Phase Tracker",
      url: "https://easternalignment.com/tools/moon-phase/",
      description: "Free moon phase tracker showing the current lunar phase, illumination, and a countdown to the next full moon and new moon.",
    }),
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What phase is the moon in tonight?",
          "acceptedAnswer": { "@type": "Answer", "text": "The tool computes the current lunar phase from your local date using the standard synodic month (29.53 days), showing the phase name, illumination percentage, and lunar day of the cycle." }
        },
        {
          "@type": "Question",
          "name": "When is the next full moon?",
          "acceptedAnswer": { "@type": "Answer", "text": "The tracker counts down to the next full moon (the point of 100% illumination in the cycle) and shows the exact date from your current date." }
        },
        {
          "@type": "Question",
          "name": "What do the moon phases mean spiritually?",
          "acceptedAnswer": { "@type": "Answer", "text": "In spiritual practice, the new moon is for setting intentions, the waxing phases for building momentum, the full moon for culmination and release, and the waning phases for letting go." }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title="Moon Phase Today: Tracker & Next Full Moon"
  description="What phase is the moon in today? Free moon phase tracker showing the current lunar phase, illumination, and a countdown to the next full moon and new moon."
  jsonLd={toolSchema}
  noindex={false}
>
  <div class="tool-page section">
    <div class="container container--narrow">
      <Breadcrumb items={[{ label: 'Tools', href: '/tools/' }, { label: 'Moon Phase' }]} />

      <header class="tool-header">
        <span class="badge badge--sage">Free Tool</span>
        <h1>Moon Phase Tracker</h1>
        <p class="tool-desc text-muted">
          What phase is the moon in tonight? This tool computes the current lunar phase from your local date, shows how illuminated the moon is, and counts down to the next full moon and new moon.
        </p>
      </header>

      <div class="tool-card card" id="moon-app">
        <div class="moon-stage">
          <div class="moon-disc" id="moon-disc" aria-hidden="true"></div>
          <div class="moon-info">
            <div class="moon-phase-name" id="moon-phase-name">—</div>
            <div class="moon-phase-sub text-muted" id="moon-phase-sub">Calculating…</div>
          </div>
        </div>

        <div class="moon-stats">
          <div class="moon-stat card">
            <span class="stat-label">Illumination</span>
            <span class="stat-value" id="stat-illumination">—</span>
          </div>
          <div class="moon-stat card">
            <span class="stat-label">Lunar Day</span>
            <span class="stat-value" id="stat-lunarday">—</span>
          </div>
          <div class="moon-stat card">
            <span class="stat-label">Today's Date</span>
            <span class="stat-value" id="stat-date">—</span>
          </div>
        </div>

        <div class="moon-countdown">
          <div class="countdown-item">
            <span class="countdown-label">Next Full Moon</span>
            <span class="countdown-value" id="next-fullmoon">—</span>
          </div>
          <div class="countdown-item">
            <span class="countdown-label">Next New Moon</span>
            <span class="countdown-value" id="next-newmoon">—</span>
          </div>
        </div>
      </div>

      <div class="prose tool-prose">
        <h2>What the Moon Phases Mean</h2>
        <p>
          In spiritual and magical practice, the moon's cycle is a calendar of intention. The <strong>new moon</strong> is for setting intentions and beginning projects; the <strong>waxing phases</strong> are for building momentum; the <strong>full moon</strong> is for culmination, release, and clarity; the <strong>waning phases</strong> are for letting go. Many seekers time their rituals, their decisions, and even their readings to the lunar cycle.
        </p>
        <p>
          The moon also drives some of the most emotionally charged timing questions in the psychic world — reconciliation windows, "when will I hear from him," and major life decisions all get asked against the lunar backdrop. If your question feels tied to timing, the readers I've tested on <a href="/reviews/kasamba/">Kasamba</a>, <a href="/reviews/purple-garden/">Purple Garden</a>, and <a href="/reviews/keen/">Keen</a> can layer lunar timing onto your specific situation.
        </p>

        <h2>How This Tool Works</h2>
        <p>
          The phase is computed using the standard synodic month (29.53 days) anchored to the known new moon of January 6, 2000. The calculation is accurate to within a fraction of a day for current dates. Illumination is the fraction of the moon's disc lit as seen from Earth.
        </p>

        <h2>Use the Moon for Your Next Reading</h2>
        <p>
          If you book a reading during a full moon, the energy is at its peak for clarity and release; during a new moon, it is at its best for intention-setting. Either way, come with one focused question — my <a href="/guides/questions-to-ask-a-psychic/">question guide</a> will help you shape it.
        </p>
        <div class="cta-flex" style="display: flex; gap: 1rem; margin-top: 1.5rem; flex-wrap: wrap;">
          <a href="/go/kasamba/" class="btn btn--primary">Try Kasamba: 3 Free Minutes →</a>
          <a href="/go/purple-garden/" class="btn btn--secondary">Try Purple Garden: $30 Credit →</a>
          <a href="/go/keen/" class="btn btn--secondary">Get 5 Minutes for $1 on Keen →</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .tool-page { padding-top: var(--space-10); }
  .tool-header { margin: var(--space-6) 0; }
  .tool-header h1 { margin: var(--space-3) 0; font-size: clamp(2.2rem, 4vw, 3rem); }
  .tool-desc { font-size: var(--text-lg); line-height: var(--leading-relaxed); }
  .tool-card { padding: var(--space-10); margin-bottom: var(--space-10); }

  .moon-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .moon-disc {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: var(--color-text);
    box-shadow: inset -30px 0 0 0 var(--color-bg), inset -35px 0 8px rgba(196,149,106,0.15), 0 8px 24px rgba(45,42,38,0.25);
    transition: box-shadow 0.8s ease;
  }

  .moon-phase-name {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .moon-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .moon-stat {
    text-align: center;
    padding: var(--space-4);
  }

  .stat-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
  }

  .stat-value {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
  }

  .moon-countdown {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .countdown-item {
    text-align: center;
    padding: var(--space-5);
    background: var(--color-bg-alt);
    border-radius: var(--radius-lg);
  }

  .countdown-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .countdown-value {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-primary-dark);
  }

  @media (max-width: 640px) {
    .tool-card { padding: var(--space-6); }
    .moon-stats, .moon-countdown { grid-template-columns: 1fr; }
  }
</style>

<script>
  const SYNODIC = 29.53058867; // days
  const KNOWN_NEW_MOON = Date.UTC(2000, 0, 6, 18, 14); // reference new moon

  const PHASES = [
    { name: 'New Moon', start: 0.0, end: 0.025 },
    { name: 'Waxing Crescent', start: 0.025, end: 0.235 },
    { name: 'First Quarter', start: 0.235, end: 0.265 },
    { name: 'Waxing Gibbous', start: 0.265, end: 0.485 },
    { name: 'Full Moon', start: 0.485, end: 0.515 },
    { name: 'Waning Gibbous', start: 0.515, end: 0.735 },
    { name: 'Last Quarter', start: 0.735, end: 0.765 },
    { name: 'Waning Crescent', start: 0.765, end: 0.985 },
    { name: 'New Moon', start: 0.985, end: 1.0 },
  ];

  function moonInfo(now: Date) {
    const days = (now.getTime() - KNOWN_NEW_MOON) / (1000 * 60 * 60 * 24);
    const cycles = days / SYNODIC;
    const age = ((cycles % 1) + 1) % 1; // 0..1, 0 = new moon
    const illumination = (1 - Math.cos(2 * Math.PI * age)) / 2;
    let phase = PHASES.find(p => age >= p.start && age < p.end) || PHASES[0];
    // next full moon: age of 0.5
    const toFull = ((0.5 - age) % 1 + 1) % 1;
    const toNew = ((1 - age) % 1 + 1) % 1;
    return {
      phase: phase.name,
      ageDays: age * SYNODIC,
      illumination: Math.round(illumination * 100),
      nextFull: new Date(now.getTime() + toFull * SYNODIC * 24 * 60 * 60 * 1000),
      nextNew: new Date(now.getTime() + toNew * SYNODIC * 24 * 60 * 60 * 1000),
    };
  }

  const disc = document.getElementById('moon-disc');
  const phaseName = document.getElementById('moon-phase-name');
  const phaseSub = document.getElementById('moon-phase-sub');
  const statIllum = document.getElementById('stat-illumination');
  const statDay = document.getElementById('stat-lunarday');
  const statDate = document.getElementById('stat-date');
  const nextFull = document.getElementById('next-fullmoon');
  const nextNew = document.getElementById('next-newmoon');

  function fmtDate(d: Date) {
    return d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
  }

  function render() {
    const now = new Date();
    const info = moonInfo(now);

    phaseName!.textContent = info.phase;
    phaseSub!.textContent = `Lunar day ${Math.round(info.ageDays)} of the cycle`;
    statIllum!.textContent = `${info.illumination}%`;
    statDay!.textContent = String(Math.round(info.ageDays));
    statDate!.textContent = fmtDate(now);
    nextFull!.textContent = fmtDate(info.nextFull);
    nextNew!.textContent = fmtDate(info.nextNew);

    // Simple moon disc shading: waxing = light on right, waning = light on left
    const lit = info.illumination / 100;
    const waxing = info.ageDays <= SYNODIC / 2;
    if (lit < 0.03) {
      disc!.style.boxShadow = 'inset 0 0 0 0, inset 0 0 0 0 rgba(196,149,106,0.15), 0 8px 24px rgba(45,42,38,0.25)';
    } else if (waxing) {
      disc!.style.boxShadow = `inset ${-160 * lit}px 0 0 0 var(--color-bg), inset ${-165 * lit}px 0 8px rgba(196,149,106,0.15), 0 8px 24px rgba(45,42,38,0.25)`;
    } else {
      disc!.style.boxShadow = `inset ${160 * (1 - lit)}px 0 0 0 var(--color-bg), inset ${165 * (1 - lit)}px 0 8px rgba(196,149,106,0.15), 0 8px 24px rgba(45,42,38,0.25)`;
    }
  }

  render();
</script>
