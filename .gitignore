# build output
dist/
dist2/
# dated build snapshots — never commit (2,200+ files each; restore-able by rebuild)
dist.bak.*/
# 2026-09-23: dist.stale-20260922 was committed by accident (200 files) and had to be
# git-rm'd out. Any dated snapshot prefix must stay ignored.
dist.stale*/
# dated whole-tree / file-level backups (src.content.bak.YYYYMMDD, *.ts.bak-YYYYMMDD)
*.bak.*/
*.bak-*
out-verify/
out-verify2/
out-verify3/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# scratch/ is a local-only workspace (one-off scripts, scrape dumps, fix
# staging, AI notes). Nothing in it belongs in version control — the whole
# directory is ignored. Keep valuable artifacts here locally only.
scratch/

# scripts/ — only these dev tools are tracked; everything else is a
# run-once content-fix script kept locally only.
# audit-cta-source.mjs 是长期维护工具（每次加 CTA 都要跑），必须入库。
# build-reader-database.mjs 是 npm run build 的第一步（readers.json 唯一生成器），
# 2026-09-22: 漏交导致 Cloudflare Pages 构建直接失败、/mcp 部署不上——必须入库。
# 2026-09-28: postback 的两个工具是「回传契约」的可执行文档，docs/lead-postback-setup.md
#   直接引用它们，因此必须入库——否则手册指向的文件在仓库里不存在。
#   · test-postback-classify.mjs  离线回归（lead/sale 判定 + $insert_id 幂等兼容性）
#   · postback-selftest.mjs       线上端到端自检（dry-run + 可选写入）
scripts/*
!scripts/audit-cta-source.mjs
!scripts/build-reader-database.mjs
!scripts/test-markdown-for-agents.mjs
!scripts/fetch-reader-avatars.mjs
!scripts/validate-reviews.mjs
!scripts/test-postback-classify.mjs
!scripts/postback-selftest.mjs
# 2026-10-01: 审计/核验工具从 scratch/ 迁到 scripts/ 并入库。
# 原因：这些脚本被 skill 引用（ea-site-predeploy-audit / ea-es-reader-rating-sync /
#   visual-qa-headless-chrome / ea-indexnow-full-push），而 scratch/ 是「只留报告、
#   脚本用完即删」的本地目录——两者冲突，清理 scratch 会把 skill 依赖的脚本删掉。
#   移入 scripts/ 并入库后，skill 的依赖变成版本控制中的持久文件。
# 注意：迁移时 ROOT 由 path.resolve(import.meta.dirname, '../..') 改为 '..'
#   （scratch/es-readers/ 是两层深，scripts/ 是一层）。
!scripts/predeploy-audit.mjs
!scripts/verify-es-dist.mjs
!scripts/check-es-links.mjs
!scripts/avatar-render-audit.mjs
!scripts/verify-pg-deeplinks.mjs
!scripts/scroll-back-verify.mjs
!scripts/indexnow.mjs
# 2026-10-02: auditoría de /es/guias/ (las rutas no pasan por zod; este script es la validación)
!scripts/audit-es-guides.mjs

# throwaway repo-cleanup audit report (one-time, never commit)
REPO_CLEANUP_AUDIT_2026-08-27.md
