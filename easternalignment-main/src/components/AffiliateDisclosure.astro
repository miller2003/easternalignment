---
interface Props {
  variant?: 'inline' | 'full';
}

const { variant = 'inline' } = Astro.props;
---

{variant === 'inline' ? (
  <div class="aff-disclosure aff-disclosure--inline">
    <p>
      <strong>Disclosure:</strong> I may earn a small commission when you sign up through my links — at no extra cost to you. This funds my research. My reviews are always independent and honest. <a href="/disclosure/">Here's how it works</a>.
    </p>
  </div>
) : (
  <div class="aff-disclosure aff-disclosure--full">
    <h4 class="aff-disclosure-title">Affiliate Disclosure</h4>
    <p>
      EasternAlignment is independently run and reader-supported. When you click links on this site and create an account on a psychic reading platform, I may earn an affiliate commission. This compensation never influences my reviews, recommendations, or editorial content. I only recommend platforms I have personally tested and believe provide genuine value.
    </p>
    <p>
      Everything on this site represents my genuine opinion based on first-hand experience. No platform can buy a positive review here.
    </p>
  </div>
)}

<style>
  .aff-disclosure--inline {
    margin: var(--space-3) 0 var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-alt);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-celestial);
  }

  .aff-disclosure--inline p {
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    margin: 0;
  }

  .aff-disclosure--inline a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .aff-disclosure--full {
    max-width: var(--max-width-content);
    margin: var(--space-8) 0;
  }

  .aff-disclosure-title {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    margin: 0 0 var(--space-4) 0;
  }

  .aff-disclosure--full p {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .aff-disclosure--full p:last-child {
    margin-bottom: 0;
  }
</style>
