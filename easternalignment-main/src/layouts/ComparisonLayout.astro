---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AuthorBio from '../components/AuthorBio.astro';

interface Props {
  title: string;
  description: string;
  platforms: string[];
  winner?: string;
  publishDate: string;
  updatedDate?: string;
}

const {
  title,
  description,
  platforms,
  winner,
  publishDate,
  updatedDate,
} = Astro.props;

const displayDate = updatedDate || publishDate;
const formattedDate = new Date(displayDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": {
    "@type": "Person",
    "name": "Sarah",
  },
  "datePublished": publishDate,
  ...(updatedDate ? { "dateModified": updatedDate } : {}),
};
---

<BaseLayout title={title} description={description} ogType="article" jsonLd={articleSchema}>
  <div class="comparison-page">
    <!-- Breadcrumb -->
    <div class="container container--narrow">
      <Breadcrumb items={[
        { label: 'Comparisons', href: '/comparisons/' },
        { label: platforms.join(' vs ') }
      ]} />
    </div>

    <!-- Comparison Hero -->
    <header class="comparison-hero">
      <div class="container container--narrow">
        <div class="comparison-hero-meta">
          <span class="badge badge--primary">Comparison</span>
          <span class="comparison-date">
            {updatedDate ? 'Updated' : 'Published'} {formattedDate}
          </span>
        </div>

        <h1 class="comparison-title">{title}</h1>

        {winner && (
          <div class="comparison-winner">
            <span class="winner-label">My Pick:</span>
            <span class="winner-name">{winner}</span>
          </div>
        )}

        <AffiliateDisclosure variant="inline" />
      </div>
    </header>

    <!-- Comparison Content -->
    <article class="comparison-content container container--narrow">
      <div class="prose">
        <slot />
      </div>

      <AuthorBio />
    </article>
  </div>
</BaseLayout>

<style>
  .comparison-page {
    padding-top: var(--space-4);
  }

  .comparison-hero {
    padding: var(--space-4) 0 var(--space-6);
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: var(--space-6);
  }

  .comparison-hero-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .comparison-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .comparison-title {
    margin-bottom: var(--space-6);
  }

  .comparison-winner {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background: var(--color-success-bg);
    border: 1px solid rgba(107, 143, 94, 0.2);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }

  .winner-label {
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }

  .winner-name {
    font-weight: var(--weight-bold);
    color: var(--color-sage);
  }

  .comparison-content {
    padding-bottom: var(--space-8);
  }
</style>
